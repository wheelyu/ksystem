            </list-property>
            <xml-property name="queryText"><![CDATA[select pps.ppsnobuk,
       pps.ppsplg,
       pps.ppstotal,
       pps.ppscab,
       pps.ppssisa,
       pps.ppssisprc,
       psm.psmcab,
       pps.ppsnomst,
       pps.ppsthbl,
       pps.ppstotbyr,
       pps.ppsdata,
       bkd.bkdbukll,
       bkd.bkdtotal,
       bkd.bkdnobuk,
       bkm.bkmnobuk, 
       asd.asdnobuk,
       asd.asdtotal5,
       cab.cabnama,
       asd.asddata,
       pps.ppsnobuk2,
       bkd.bkdtgl,
       mid(ppsnobuk2,3,4),
       mid(ppsnobuk,7,4),
       mid(ppsnobuk,8,4),
       left(ppsnobuk,4),
       pik.piknobuk,
       pik.piksts,
       pps.ppssts,
       pps.ppsstsprc,
       pps.ppstglbuk,
       cab.cabnama as namacabang,
       pps.ppscab as cabang,
       pps.ppsket as keterangan,
       pps.ppstype as type,
       pps.ppsscr as screen,
       btm.btmtypdeb as jnsDebitur,
       btm.btmnopj as fakturRO,
       bkm305.bkmnobuk as faktur305,
       if(bkm305.bkmnobuk is not null,bkm305.bkmnobuk,pps.ppsnobuk2) as nokontrak,
       if(pik.piksts is not null, pik.piksts,pik1.piksts)	as stsnokontrak
       
       
         
 
from cab force index(cabkodidx) 

right join pps as pps force index(ppsdatstscab)       on  ppsdata <> "" and pps.ppssts <> "" and pps.ppscab = cab.cabkode 
left join psm as psm  force index(psmkodidx)          on psm.psmkode = pps.ppsplg		
left join cab as cab2 force index(cabkodidx)          on cab2.cabkode = psm.psmcab
left join asd as asd  force index(asdbukidx)          on asd.asdnobuk = pps.ppsnobuk 
left join bkd as bkd force index(bkdbukllidx)         on bkd.bkdbukll = pps.ppsnobuk and bkd.bkdnobbm <> "" and bkd.bkdscr <> "201"
left join bkm as bkm force index(bkmbukidx)           on bkm.bkmnobuk = bkd.bkdnobuk
left join btm as btm force index(btmbukidx)		  	  on btm.btmnobuk = pps.ppsnomst and btm.btmdata ="BUKUTAMU"
left join bkm as bkm305 force index(bkmstsbsidx)	  on bkm305.bkmsts = "CLSD" and bkm305.bkmnobs = pps.ppsnomst
left join pik as pik force index(pikdatbukidx)        on pik.pikdata ="DTPIU" and pik.piknobuk = bkm305.bkmnobuk
left join pik as pik1 force index(pikdatbukidx)		  on pik1.pikdata = 'DTPIU' and pik1.piknobuk = pps.ppsnobuk2


where pps.ppssisprc > 1 and pps.ppssisa > 1
and ((pps.ppssts <> 'CLSD' and pps.ppssisprc <> "CLSD" and pps.ppssts <> "BTL" and left(pps.ppsnobbm,3) <> "108" 
and pps.ppskdpm = "DTAWAL" and pps.ppsthbl >= "2001") 
or (pps.ppsplg = "ANG-M4W" and pps.ppssts <> 'CLSD' and pps.ppssisprc <> "CLSD" and pps.ppssts <> "BTL") 
or (left(ppsnobuk,3) = "M4W" and pps.ppssts <> 'CLSD' and pps.ppssisprc <> "CLSD" and pps.ppssts <> "BTL" 
	and left(pps.ppsnobbm,3) <> "108")
or (left(ppsnobuk,4) = "AM4W" and pps.ppssts <> 'CLSD' and pps.ppssisprc <> "CLSD" and pps.ppssts <> "BTL" 
	and left(pps.ppsnobbm,3) <> "108"))







]]></xml-property>
        </oda-data-set>
    </data-sets>
