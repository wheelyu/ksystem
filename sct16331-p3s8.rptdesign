            <list-property name="computedColumns">
                <structure>
                    <property name="name">THBL2</property>
                    <expression name="expression">if(row["ppsthbl"]== "" &amp;&amp; row["ppsnobuk2"] == row["piknobuk"]) {row["mid(ppsnobuk2,3,4)"]}&#13;
if (row["ppsthbl"]== "" &amp;&amp; (row["left(ppsnobuk,4)"] == "KMHL" || row["left(ppsnobuk,4)"] == "KMLL") &amp;&amp; row["ppsnomst"] != "") {row["mid(ppsnobuk,8,4)"]}&#13;
if (row["ppsthbl"]== "" &amp;&amp; (row["left(ppsnobuk,4)"] == "KMHL" || row["left(ppsnobuk,4)"] == "KMLL") &amp;&amp; row["ppsnomst"] == "") {row["mid(ppsnobuk,7,4)"]}&#13;
if (row["ppsthbl"]!= "") {row["ppsthbl"]}</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">kontrak</property>
                    <expression name="expression">if (row["faktur305"] != null) {row["fakturRO"]}
else {row["ppsnobuk2"]}</expression>
                    <property name="dataType">string</property>
                </structure>
