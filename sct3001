HELP(transa)
 Masukkan field yang diproteksi gdffld

/* ------------------ djoinfld --------------*/
DBCALCS(djoinfld)
	DBC_COMMAND	JOIN
	DBC_TARGET 	gdftpgpfdidx     lblanktype grpnam gdffld

CALCS()
cjoinfld0	djoinfld == 0 || gdffld == ~gdffld

MAP(mdum)
lBtype		lBtype		REPLACE

HOOKS(transa)
AFTER_INPUT		cur_field=gdffld	DO_MAP SHOW
			IF cjoinfld0 mdum
			ELSE HKCURSOR STAY
			HKMSG Field ini sudah di Proteksi

CALCS()
cbkndashb  gdfdata != "DASHBOARD"

SUBFILE(transa)
SFL_TITLE(transat)
SFL_SELECT cbkndashb
SFL_LINES(9)    /* total number of lines sfl takes up on screen  */

SFL_TARGET
gdftpgpfdidx            lblanktype grpnam  

