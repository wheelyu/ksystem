lrequestreply   INIT    "reply"
lsavedata	INIT	1
lVERSI	        INIT	06082026

lmstlabel       INIT    "status"
lmstfields      INIT    "lstatus"
lmsttitle       INIT    ""

lm4996		INIT	m4996	
l4996		INIT	4996

CALCS()
cOK		"OK"

MAP(mmapahm)
lCHATBOT	ahmdata		REPLACE
