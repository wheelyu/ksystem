SPCALCS(spmaster)
	DO_LIB			ap_dbclc(DNAME dmapmap,DCOMMAND MAPMAP,DMAP mstatus);
	DO_LIB			ap_jsnmt(lrequestreply,lmsttitle,lmstlabel,lmstfields);
	DO_LIB			ap_nxpst(l4996,lm4996);

POSTING(master)
   PST_COMMAND     spmaster


