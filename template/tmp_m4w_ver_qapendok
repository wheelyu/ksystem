caprpendok	((tkdnourt==49 || tkdnourt==34) && g_grpnam != "COO" && g_usrkode != "1326445" && g_grpnam!="B.M4WCOO" && g_grpnam!="B.M4WDVH" && g_grpnam!="B.M4WADHDVH" && g_grpnam!="B.M4WADHSPV" && g_grpnam!="B.M4WADHHEAD" && g_grpnam!="RI") || 
