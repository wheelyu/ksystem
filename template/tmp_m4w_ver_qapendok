		tkdjwbstr2!="ACC"
caprpendokrm	g_grpnam!="B.M4WRM" && g_grpnam!="RAS" && g_grpnam!="B.M4WADHDVH" && g_grpnam!="B.M4WADHSPV" && g_grpnam!="B.M4WADHHEAD"
