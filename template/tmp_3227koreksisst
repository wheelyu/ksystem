DO_LIB_IF ckor2nomssthbs ap_adjrn(l1,tldnobbm,ppsnobuk,tldket,gv_D,lKR,tldtotdis,g_tgltrn,g_scrnumstr,tldcab,tldbisnis,tlddvs,tldnoll,l2,lnamamap);
DO_LIB_IF ckor2nomssthbs ap_adjrn(l1,tldukrwrn,ppsnobuk,tldket,gv_K,lKR,tldtotdis,g_tgltrn,g_scrnumstr,tldcab,tldbisnis,tlddvs,tldnoll,l2,lnamamap);
DO_LIB_IF ckor2nomssthbs ap_dbclc(DNAME dupdaktkor2nom,DCOMMAND ADD,DFILE akt,DMAP maddaktkor2nom);
DO_LIB_IF ckor2nomsst ap_dbclc(DNAME dupdbrgkor2nom,DCOMMAND UPDATE,DTARGET brgdatkodidx gv_dtbiaya tldnoll,DMAP mupdbrgkor2nom);

DO_LIB_IF ckor2opensst ap_adjrn(l1,tldnobbm,ppsnobuk,tldket,gv_D,lKR,tldjml,g_tgltrn,g_scrnumstr,tldcab,tldbisnis,tlddvs,tldnoll,l2,lnamamap);
DO_LIB_IF ckor2opensst ap_adjrn(l1,tldukrwrn,ppsnobuk,tldket,gv_K,lKR,tldjml,g_tgltrn,g_scrnumstr,tldcab,tldbisnis,tlddvs,tldnoll,l2,lnamamap);
DO_LIB_IF ckor2opensst ap_dbclc(DNAME dupdbrgkor2open,DCOMMAND UPDATE,DTARGET brgdatkodidx gv_dtbiaya tldnoll,DMAP mupdbrgkor2open);
DO_LIB_IF ckor2opensst ap_dbclc(DNAME daddaktkor2open,DCOMMAND ADD,DFILE akt,DMAP maddaktkor2open);
DO_LIB_IF ckor2opensst ap_dbclc(DNAME dupdaktkor2open3127,DCOMMAND UPDATE_RANGE,DTARGET aktbrgtglidx tldnoll,DMAP mupdaktkor2open3127);
DO_LIB_IF ckor2opensst ap_dbclc(DNAME dupdaktkor2open3227,DCOMMAND UPDATE_RANGE,DTARGET	aktkod2typid ppsnobuk ppstype,DMAP mupdaktkor2open3227);
