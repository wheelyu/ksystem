DO_LIB_IF ckor2opensst ap_adjrn(l1,lREKHL,ppsnobuk,tldket,gv_D,lKR,tldsubtot,g_tgltrn,g_scrnumstr,tldcab,tldbisnis,tlddvs,tldnoll,l2,lnamamap);
