IMAGE(tmptrans)

FIELD(tmptranst)
svinama                 PROTECT                 INPUTRI         1
svidf6			NOCHANGE		INPUTRI 	2
svidf7			NOCHANGE		INPUTRI 	3
svidf2    		NOCHANGE		INPUTRI		3
svidf1    		NOCHANGE		INPUTRI		3
svidf5			NOCHANGE 		INPUTRI		4
svists			NOCHANGE		INPUTRI 	5
luplok1	 	        TOMBOL		        INPUTRI 8

DEFAULTS(tmptranst)
lFOTOSVY11		INIT		FOTOSVY
lFOTORUMAH11		INIT		FOTORUMAH
luplok1			INIT		"UPLOAD OK"
lYok			INIT		Y

CALCS()
cjalanap	DO_LIB ap_dsGPS(svidf2,svidf1,svidf6,svidf7,&ljarak);
cadajarak       svidf1!=BLANKS && svidf2!=BLANKS && svidf6!=BLANKS && svidf7!=BLANKS
cjarak          (ljarak/1000)/1000
cjoingedung	djoinmastergedung==1 && djoinlatlon == 1 && sviyt1 == "Y"
cfr001		svikode == "FR001"
csudahok	sviyt1 == "Y" 

MAP(mupdsvi1)
g_fotolat1	svidf6		REPLACE_IF csudahok
g_fotolon1	svidf7		REPLACE_IF csudahok
g_fototime1	svidf8		REPLACE_IF csudahok
llatgedung	svidf2		REPLACE_IF cjoingedung
llongedung	svidf1		REPLACE_IF cjoingedung
c0		svidf5		DO_CALC
cjalanap  	svidf5		DO_CALC_IF cadajarak
cjarak		svidf5	 	DO_CALC_IF csudahok                  

MAP(mok)
lYok		sviyt1		REPLACE


DBCALCS(dbgpsrumahok)
        DCOMMAND UPDATE
        DTARGET sviprmidx sviprm
        DMAP mok  
DBCALCS(dbgpsrumah)
        DCOMMAND UPDATE
        DTARGET sviprmidx sviprm
        DMAP mupdsvi1  

MAP(mupdbtmdf1)
cjalanap        btmdf1          DO_CALC_IF cadajarak
cjarak          btmdf1          DO_CALC

SPCALCS(supdmasker)
	dbgpsrumah
        DO_LIB_IF cfr001  ap_dbclc(DNAME dupdbtmdf1,DCOMMAND UPDATE,DTARGET btmbukidx svinobuk,DMAP mupdbtmdf1);

HOOKS(tmptranst)
CLICKED         cur_field=luplok1  IF	csudahok  DO_SPCALCS supdmasker
				   ELSE t.UplFotoDulu

CALCS()
cdarihp		(btmsts == "668" && btmflag1 == "SRVY" && g_mobile == 1) || g_grpnam == "RI" || g_grpnam == "IT" ||
		g_grpnam == "B.M4WCM" || g_grpnam == "B.M4WDVH" || g_grpnam == "B.M4WCOO" || g_grpnam == "B.UMROH" || g_grpnam == "B.M4WADHDVH" ||
		g_grpnam == "B.M4WMSPV" || g_grpnam == "B.M4WMHEAD" || g_grpnam == "B.M4WCA"
cfotorumahsvy	svitype == "FOTOSRVY"

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_UPLFLD_DBCALCS dbgpsrumahok
SFL_COND cdarihp
SFL_SELECT	cfotorumahsvy
SFL_UPL_DIRFLD  btmtgl
SFL_UPLFLD btmnobuk     svikode
SFL_UPL_DELCOND c0
SFL_TARGET
	svidatbuktyp   lFOTOSRVY11 btmnobuk


