lketstr1	ketstr1 REPLACE
lketstr2	ketstr2 REPLACE
lketstr3	ketstr3 REPLACE
DEBUG ldum ldum REPLACE

MAP(mjoinket)
ketstr1	lketstr1	REPLACE
ketstr2	lketstr2	REPLACE
ketstr3	lketstr3	REPLACE


DBCALCS(djoinket)
        DBC_COMMAND     JOIN
        DBC_TARGET      ketdatbukkod   gv_infolain  mtsnobuk  
		DBC_MAP		mjoinket

DBCALCS(djoinketupd)
        DBC_COMMAND     JOIN
        DBC_TARGET      ketdatbukkod   gv_infolain  mtsnobuk  


MAP(mjointbdhrglama)
tbdkode		ltbdkode		REPLACE

MAP(mjoinrtmhrglama)
rtmkode		lrtmkode		REPLACE

MAP(mjoinbrc)
