DBC_TARGET      tbddtmstidx	gv_dttabel gv_survey21 lAREAFIXHARPAS mtsnoasal
DBC_MAP		mjointbdhrglama

DBCALCS(djoinrtmhrglama)
DBC_COMMAND	JOIN
DBC_TARGET      rtmdtkod2tgl   lBRG1406 lBRG1406 mtdbrg
DBC_MAP		mjoinrtmhrglama

DBCALCS(djoinbrc)
DBC_COMMAND	JOIN
DBC_TARGET      brcdttypidx	lMODEL lrtmkode ltbdkode gv_BEKAS mtdgrup2
DBC_MAP		mjoinbrc

EDITS(tmptranst)
e.Mandatory mtdkat 		MANDATORY
e.Mandatory	mtdgrup2	MANDATORY
e.Mandatory	mtdjml3		MANDATORY

e.ValidateMerk mtdbrg VALIDATE tbddatkodidx  mtbdMerk stbd {Pgv_dttabel} {PlSURVEY} {PlMASTERBRG1406}

CALCS()
cdjoinketurl g_curcmd==0 && djoinket==1

MAP(mtbdMerk)
tbdkode		mtdbrg		REPLACE
cBLANKS		lketstr1 DO_CALC_IF ckosongin
cBLANKS		lketstr2 DO_CALC_IF ckosongin
cBLANKS		lketstr3 DO_CALC_IF ckosongin

lketstr1	lketstr1 REPLACE_IF cdjoinketurl
lketstr2	lketstr2 REPLACE_IF cdjoinketurl
lketstr2	lketstr2 REPLACE_IF cdjoinketurl


MAP(mjoinmts6bulan)
mtssts		lmts6bulan	REPLACE
mtsstsapr	lmtsstsapr6bulan	REPLACE
mtsdari		lmtsdari6bulan	REPLACE
mtstgl		lmtstgl6bulan	REPLACE

DBCALCS(djoinmts6bulan)	
	DBC_COMMAND	JOIN
	DBC_TARGET	mtsbukidx aktnobuk
	DBC_MAP		mjoinmts6bulan

CALCS()
cdjoinbrc1	 djointbdhrglama==1 && djoinrtmhrglama==1 && djoinbrc==1
cdjoinmts6bulan1	djoinmts6bulan==1 && lmtstgl6bulan>=20241101 && lmtsdari6bulan=="HARGAPSR" && ((lmts6bulan=="CLSD" && lmtsstsapr6bulan=="OK") || (lmts6bulan=="OPEN" && (lmtsstsapr6bulan=="" || lmtsstsapr6bulan=="IN" || lmtsstsapr6bulan=="OK")))	
caddket g_curcmd==1
cupdket	g_curcmd==2 && djoinketupd==1


MAP(mharga)
lbrcdf2		mtdjml2		REPLACE_IF cdjoinbrc1


chrgm		mtdnoll		DO_CALC_IF ccekhrgm
chrgb           mtdnoll         DO_CALC_IF ccekhrgb

MAP(mscanakt6bln)
c1	lada6bulan	DO_CALC_IF cdjoinmts6bulan1

DBCALCS(dbscanakt6bln)
	DBC_COMMAND	SCANSCAN
	DBC_TARGET	aktbrgtglidx   laktbrg lHRGPSR lHRGPSR21 ltgl6bulan
	DBC_LAST_TARGET	aktbrgtglidx   laktbrg lHRGPSR lHRGPSR21 g_tgltrn
	DBC_SUM_MAP	mscanakt6bln

CALCS()
cgabung         STRIP(mtsnoasal) + STRIP(mtdbrg)
ctdkada6bln	lada6bulan==0 || (mtdgrup2!="2010" && mtdgrup2!="2011" && mtdgrup2!="2012" && mtdgrup2!="2013" && mtdgrup2!="2014" && mtdgrup2!="2015" && mtdgrup2!="2016" && mtdgrup2!="2017" && mtdgrup2!="2018" && mtdgrup2!="2019" && mtdgrup2!="2020" && mtdgrup2!="2021" && mtdgrup2!="2022" && mtdgrup2!="2023" && mtdgrup2!="2024" && mtdgrup2!="2025" && mtdgrup2!="2026") || g_grpnam!="TUTUP"
cjalanscan	laktbrg!=BLANKS

MAP(mgabung)
cgabung		laktbrg		DO_CALC
c0		lada6bulan	DO_CALC

HOOKS(tmptranst)
BEFORE_INPUT 	cur_field=mtdbrg  	DO_MAP SHOW murut  
AFTER_INPUT	cur_field=mtdbrg	DO_MAP SHOW mgabung
AFTER_INPUT	cur_field=mtdgrup2	DO_MAP SHOW mharga
AFTER_INPUT     cur_field=mtdgrup2      DO_SCAN IF cjalanscan dbscanakt6bln
/*AFTER_INPUT	cur_field=mtdbrg	DO_MAP SHOW
		IF cjoinmtd1u mdum
		ELSE HKCURSOR STAY
		HKMSG h.BrgDup*/
AFTER_INPUT    cur_field=mtdjml3       DO_MAP SHOW 
				IF chrgpersen mdum
				ELSE HKCURSOR STAY
                HKMSG t.BatasPengajuan


AFTER_INPUT     cur_field=mtdgrup2        DO_MAP SHOW
                IF ctdkada6bln mdum
                ELSE HKCURSOR STAY
                HKMSG t.MasihAda6Bulan

AFTER_INPUT     cur_keybd=EN		DO_MAP SHOW
                IF ctdkada6bln mdum
                ELSE HKCURSOR STAY
                HKMSG t.MasihAda6Bulan

BEFORE_INPUT    cur_field=lketstr1      DO_SKIP_IF cnospmb
BEFORE_INPUT    cur_field=lketstr2      DO_SKIP_IF cnospmb
BEFORE_INPUT    cur_field=lketstr3      DO_SKIP_IF cnospmb



