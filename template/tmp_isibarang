	mtdkat      			PROTECT       		 INPUTRI              2 /* Kategori */
	mtdbrg      			ALLCAPS 		     INPUTRI   			3
	mtdgrup2    			ALLCAPS              INPUTRI              4 /* Tahun Motor*/
	mtdnoll     			PROTECT              INPUTRI              5/* Nama Finco lain*/
	mtdtmp1     			NUMERIC              INPUTRI              6 /* Harga Finco Lain */
	mtdjml2     			NUMERIC PROTECT      INPUTRI              7 /* Harga Pasaran */
	mtdjml3     			NUMERIC              INPUTRI              8 /* Harga Pasaran */
	mtdket      			TEXTAREA SCROLL      INPUTRI              11 /* Keterangan*/
	lketstr1				TEXTAREA SCROLL	     INPUTRI 			  12
	lketstr2    			TEXTAREA SCROLL      INPUTRI              13
	lketstr3    			TEXTAREA SCROLL      INPUTRI              14


CALCS()
chrgpersen	(mtdnoll=="HARGA MARKET-PLACE" && mtdgrup2 < THBLS_YYYY(g_tgltrn) && mtdjml3 >= (mtdtmp1 * 0.9) && mtdjml3 <= mtdtmp1) 
||(mtdnoll=="HARGA BROSUR" && mtdgrup2 == THBLS_YYYY(g_tgltrn) && mtdjml3 >= (mtdtmp1 * 0.8) && mtdjml3 <= (mtdtmp1 * 0.85))
chrgb	"HARGA BROSUR"
chrgm	"HARGA MARKET-PLACE"
ccekhrgm		mtdgrup2 < THBLS_YYYY(g_tgltrn)
ccekhrgb                mtdgrup2 ==  THBLS_YYYY(g_tgltrn)
cnospmb			mtdkat != "SPMB"
ckosongin	g_curcmd==0


