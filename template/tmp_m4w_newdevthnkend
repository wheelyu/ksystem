IMAGE(tmptrans)

FIELDS(tmptranst)
        svists          PROTECT                   INPUTRI 1
        svistr5         PROTECT                   INPUTRI 1
        svikode         PROTECT QPROTECT UNSEEN   INPUTRI 1
        svistr2         NOCHANGE                  INPUTRI 2
        svistr32        NOCHANGE                  INPUTRI 2
        svidf1          NOCHANGE                  INPUTRI 2
        lketisih        TEXTAREA 2 ALLCAPS         INPUTRI 2
        lketisi2h       TEXTAREA 2 ALLCAPS         INPUTRI 2
        svistr1         NOCHANGE                  INPUTRI 3
        svitgl1         PROTECT {DD-MM-YYYY}      INPUTRI 4
        svinobuk        PROTECT UNSEEN            INPUTRI 5
        svitblkode      PROTECT UNSEEN            INPUTRI 5
        lupld8          TOMBOL                    INPUTRI 1
        svistr33        ALLCAPS                   INPUTRI 6
        svistr7         TEXTAREA 2 ALLCAPS        INPUTRI 20
        lketisi2        NOCHANGE                  INPUTRI 21


EDITS(tmptranst)
e.stsbukan707     svikode         VALIDATE ftmdatbukidx mftm5 sftm6 {PlMULTI4W}
e.isiket          lketisih        MANDATORY
e.ket             svitblkode      VALIDATE ketdatbukkod mket8  0     {Psvidata} {Psvinobuk}
e.isiaccrm        svistr33        MANDATORY_IF cinpgd
e.isiket          svistr7         MANDATORY_IF crmT


DEFAULTS(tmptranst)
svistr33           DFALT_SCAN_BLANKS Y T



MAP(mket8)
lketisih         ketisi            REPLACE_IF cadaket1b
cBLANKS         lketisih           DO_CALC
ketisi          lketisih           REPLACE
lketisi2h        ketisi2            REPLACE_IF cadaket1b
cBLANKS         lketisi2h           DO_CALC
ketisi2         lketisi2h          REPLACE


MAP(mftm5)
ftmtahun        svistr2         REPLACE
ftmkode7        svistr32        REPLACE
ftmsubtot3      svidf1          REPLACE



MAP(maddket8)
svinobuk        ketnobuk          REPLACE
svidata         ketdata           REPLACE
svitype         ketkode           REPLACE
lketisih         ketisi            REPLACE_IF cadaket0
lketisi2h        ketisi2           REPLACE_IF cadaket0

MAP(mupdsvi8)
lketisic        ketisi            REPLACE_IF cadaket1b
cBLANKS         lketisic          DO_CALC
ketisi          lketisic          REPLACE
lketisi2c       ketisi2            REPLACE_IF cadaket1b
cBLANKS         lketisi2c          DO_CALC
ketisi2         lketisi2c          REPLACE


MAP(mupdsviftmandx8)
cIN             svistr1         DO_CALC_IF cksong2
g_tgltrn        svitgl1         REPLACE
gv_INPG         svists          REPLACE_IF cinpg


MAP(mupload8)
g_tgltrn        svitgl1         REPLACE_IF cuplok
cOK             svistr1         DO_CALC_IF cuplok

MAP(mmapmap8a)
ldum            ldum              REPLACE
svinourt        lurt              REPLACE
ckuncidev1      lkunci2           DO_CALC

MAP(mkuncirm8)
gv_CLSD         abksts            REPLACE_IF cnipsama

MAP(mkuncirm28)
gv_CLSD         abksts            REPLACE



SPCALCS(saddket8)
DO_LIB                 ap_dbclc(DNAME dmapmap8a,DCOMMAND MAPMAP,DMAP mmapmap8a);
DO_LIB_IF cadaket0     ap_dbclc(DNAME dket8,DCOMMAND ADD,DFILE ket,DMAP maddket8);
DO_LIB_IF cadaket1     ap_dbclc(DNAME dupdsvi8,DCOMMAND UPDATE,DTARGET ketdatbukkod svidata svinobuk svitblkode,DMAP mupdsvi8);


SPCALCS(sdelket8)
DO_LIB_IF cadaket1     ap_dbclc(DNAME ddelket8,DCOMMAND DELETE,DTARGET ketdatbukkod svidata svinobuk svitblkode); 

SPCALCS(suploadd8)
DO_LIB                 ap_dbclc(DNAME dmapupl8,DCOMMAND MAPMAP,DMAP mmapmap8a);
DO_LIB_IF crm          ap_dbclc(DNAME ddevb8,DCOMMAND ADD,DFILE abk,DMAP madddevrm);
DO_LIB                 ap_dbclc(DNAME dupload8d,DCOMMAND UPDATE,DTARGET sviprmidx sviprm,DMAP mupload8);

SPCALCS(sbkkunci8)
DO_LIB                 ap_dbclc(DNAME dmapmaprm8,DCOMMAND MAPMAP,DMAP mmapmap1a);
DO_LIB_IF crmok2       ap_dbclc(DNAME dupdrmok8,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lkunci2 l643,DMAP mkuncirm8);
DO_LIB_IF crmT2        ap_dbclc(DNAME dupdrmT8,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lkunci2 l643,DMAP mkuncirm28);
DO_LIB_IF cdvh         ap_dbclc(DNAME ddevf8,DCOMMAND ADD,DFILE abk,DMAP madddevdvh);


DBCALCS(dbftupl8)
        DCOMMAND UPDATE
        DTARGET sviprmidx sviprm
        DMAP mupdsviftmandx8
MAP(mapr9)
gv_OPEN         svists          REPLACE_IF cksong
cOKRM           svistr34        DO_CALC_IF crmok
ctKRM           svistr34        DO_CALC_IF crmT
gv_TACC         svists          REPLACE_IF crmT


HOOKS(tmptranst)
CLICKED         cur_field=lupld8        DO_SPCALCS suploadd8
AFTER_INPUT     cur_keybd=EN              DO_MAP SHOW mapr9
AFTER_INPUT     cur_keybd=EN            DO_SPCALCS sbkkunci8
AFTER_INPUT     cur_field=lketisih       DO_MAP SHOW mketcab
AFTER_INPUT     cur_field=lketisih       DO_MAP
                IF ccabisih mdum
                ELSE HKCURSOR STAY
                HKMSG harus 200 karabker
BEFORE_INPUT    cur_field=svistr33      DO_SKIP_IF copend
BEFORE_INPUT    cur_field=svistr7       DO_SKIP_IF copend
BEFORE_INPUT    cur_field=lketisih      DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=lketisi2h     DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=svistr2       DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=svidf1        DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=svistr1       DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=svistr32      DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=svistr1       DO_SKIP_IF cinpgd



