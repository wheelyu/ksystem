FIELD(tmptranst)
g_usrkode         PROTECT UNSEEN      INPUTRI   1 /* validasi user kode, trigger kosong lokal */
svikode           PROTECT UNSEEN      INPUTRI   1 /* kode foto bukti pekerjaan */

/* Informasi dari pembuktian yang dikirim */
lsifatbukti       PROTECT             INPUTRI   2 /* sifat bukti dr cmo mandatory / tambahan */
lsifatPengisian   PROTECT             INPUTRI   2 /* sifat pengisian harus diisi apa tidak */

/* Field Konten */
lpembuktian       TEXTAREA 3 PROTECT  INPUTRI   3 /* pembuktian pekerjaan dari masteran */
lverifikasi       TEXTAREA 3 PROTECT  INPUTRI   4 /* verifikasi dari masteran */
sviket2           TEXTAREA 3          INPUTRI   5 /* keterangan pembuktian pekerjaan, tergantung cbukanfreetext */
svistr33          NOCHANGE            INPUTRI   6 /* jawaban CMS, tergantung cmandatory */
lenter            NOCHANGE            INPUTRI   7 /* trigger enter */

