        DO_LIB                  ap_dbclc(DNAME dmapupdhis,DCOMMAND MAPMAP,DMAP mmapmap1);
	DO_LIB_IF caddabkhis	ap_dbclc(DNAME daddabkhis,DCOMMAND ADD,DFILE abk,DMAP maddabkhis);
	DO_LIB                  ap_dbclc(DNAME dmapupdhis2,DCOMMAND MAPMAP,DMAP mmapmap2);
