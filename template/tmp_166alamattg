IMAGE(tmptranst)
/-------------------------------------------------\
|/--t.AlamatTinggal------------------------------\|
||spasi                                          ||
||t.SmDgnKtp  : ___                      	 ||
||t.Alm       : _________________________________||
||t.RtRw      : ___     ___                      ||
||t.Prop      : __________  _____________________||
||t.Kota      : __________  _____________________||
||t.Kec       : __________  _____________________||
||t.Kel       : __________  _____________________||
||t.KdPos     : ___________                      ||
|\-----------------------------------------------/|
\-------------------------------------------------/

IMAGE(tmptrans)

FIELDS(tmptranst)
almnama       NOCHANGE                INPUTRI         1
almjalan      ALLCAPS                 INPUTRI         2

almrt         ALLCAPS                 INPUTRI         3
almrw         ALLCAPS                 INPUTRI         4

almprop       ALLCAPS                 INPUTRI         5
almnamprop    PROTECT                 INPUTRI         6
almkota       ALLCAPS                 INPUTRI         7
almnamkota    PROTECT                 INPUTRI         8
almkec        ALLCAPS                 INPUTRI         9
almnamkec     PROTECT                 INPUTRI         10
almkel        ALLCAPS                 INPUTRI         11
almnamkel     PROTECT                 INPUTRI         12
almkdpos      ALLCAPS                 INPUTRI         13

DEFAULTS(tmptranst)
almnama         DFALT_SCAN_BLANKS       Y       "Ya"
                                        T       "Tidak"

EDITS(tmptranst)
e.MandatoryProp almprop MANDATORY
e.MandatoryKota almkota MANDATORY
e.MandatoryKec  almkec  MANDATORY
e.Mandatory     almkdpos MANDATORY
e.Mandatory     almnama MANDATORY
e.Mandatory     almjalan MANDATORY
e.Mandatory     almrt MANDATORY
e.Mandatory     almrw MANDATORY
e.ValidateProp  almprop VALIDATE dtmdtkodidx  mdtmProp2 sdtmProp {Pgv_dtkota}
e.ValidateKota  almkota VALIDATE tbldtdtmkod  mtblKota2 stblKota {Pgv_dtkota} {Palmprop}
e.ValidateKec   almkec VALIDATE tbddatkodidx  mtbdKec2 stbd {Pgv_dtkota} {Palmprop} {Palmkota}
e.ValidateKel   almkel VALIDATE tbtdattypkod  mtbtKel2 stbt {Pgv_dtkota} {Pgv_dtkota21} {Palmprop} {Palmkota} {Palmkec}

MAP(mdtmProp2)
dtmkode                 almprop               	REPLACE
dtmket                  almnamprop              REPLACE

MAP(mtblKota2)
tblkode                 almkota                 REPLACE
tblket                  almnamkota              REPLACE

MAP(mtbdKec2)
tbdkode                 almkec                  REPLACE
tbdket                  almnamkec               REPLACE

MAP(mtbtKel2)
tbtkode                 almkel                  REPLACE
tbtket                  almnamkel               REPLACE
tbtkat			almkdpos		REPLACE

MAP(mcaripjgrt2)
cpjgrt                  lpanjangrt              DO_CALC

MAP(mcaripjgrw2)
cpjgrw                  lpanjangrw              DO_CALC

MAP(mcaripjgpos2)
cpjgpos                 lpanjangpos             DO_CALC

CALCS()
csamaktp	almnama=="Y"
csamaktpx	almnama=="Y" && djoinalmktp==1

MAP(malamatktp)
lalmjalan       almjalan        REPLACE_IF csamaktpx
lalmrt          almrt           REPLACE_IF csamaktpx
lalmrw          almrw           REPLACE_IF csamaktpx
lalmprop        almprop         REPLACE_IF csamaktpx
lalmnamprop     almnamprop      REPLACE_IF csamaktpx
lalmkota        almkota         REPLACE_IF csamaktpx
lalmnamkota     almnamkota      REPLACE_IF csamaktpx
lalmkec         almkec          REPLACE_IF csamaktpx
lalmnamkec      almnamkec       REPLACE_IF csamaktpx
lalmkdpos       almkdpos        REPLACE_IF csamaktpx
lalmkel         almkel          REPLACE_IF csamaktpx
lalmnamkel      almnamkel       REPLACE_IF csamaktpx

HOOKS(tmptranst)
AFTER_INPUT     cur_field=almnama      DO_MAP SHOW malamatktp
AFTER_INPUT     cur_field=almrt        DO_MAP SHOW mcaripjgrt2
AFTER_INPUT     cur_field=almrw        DO_MAP SHOW mcaripjgrw2
AFTER_INPUT     cur_field=almkdpos     DO_MAP SHOW mcaripjgpos2
BEFORE_INPUT    cur_field=almjalan     DO_SKIP_IF csamaktp
BEFORE_INPUT    cur_field=almprop      DO_SKIP_IF csamaktp
BEFORE_INPUT    cur_field=almkota      DO_SKIP_IF csamaktp
BEFORE_INPUT    cur_field=almkec       DO_SKIP_IF csamaktp
BEFORE_INPUT    cur_field=almkel       DO_SKIP_IF csamaktp
BEFORE_INPUT    cur_field=almkdpos     DO_SKIP_IF csamaktp
BEFORE_INPUT    cur_field=almrt        DO_SKIP_IF csamaktp
BEFORE_INPUT    cur_field=almrw        DO_SKIP_IF csamaktp
AFTER_INPUT     cur_field=almrt        DO_MAP SHOW
                IF crt mdum
                ELSE HKCURSOR STAY
                HKMSG t.PjgRT3

AFTER_INPUT     cur_field=almrw        DO_MAP SHOW
                IF crw mdum
                ELSE HKCURSOR STAY
                HKMSG t.PjgRW3

AFTER_INPUT     cur_field=almkdpos     DO_MAP SHOW
                IF cpos mdum
                ELSE HKCURSOR STAY
                HKMSG t.PjgKdPos5

AFTER_INPUT     cur_keybd=EN           DO_MAP SHOW
                IF crt mdum
                ELSE HKCURSOR STAY
                HKMSG t.PjgRT3

AFTER_INPUT     cur_keybd=EN           DO_MAP SHOW
                IF crw mdum
                ELSE HKCURSOR STAY
                HKMSG t.PjgRW3

AFTER_INPUT     cur_keybd=EN           DO_MAP SHOW
                IF cpos mdum
                ELSE HKCURSOR STAY
                HKMSG t.PjgKdPos5

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_TARGET
        almdatotobuk   gt_psmtinggal  hrmnobuk

SFL_MAP
gt_psmtinggal   	almdata         REPLACE
hrmnobuk  		almbukoto       REPLACE

