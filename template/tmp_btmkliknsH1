FIELD(tmptranst)
tldnobuk        PROTECT	        INPUTRI 1
tldbrg          ALLCAPS SCROLL	INPUTRI 2
tldkirim        PROTECT         INPUTRI 3
tldket          PROTECT         INPUTRI 4
tldlok          ALLCAPS SCROLL  INPUTRI 6
lnamaklikns     PROTECT         INPUTRI 7
tldukrwrn       PROTECT         INPUTRI 8
tldkirim        ALLCAPS         INPUTRI 9
tldgrup		ALLCAPS		INPUTRI	10 /* ket buka kunci adm */
btmsales	PROTECT		INPUTRI	11
tldgrup2	ALLCAPS		INPUTRI	12 /* ket buka kunci spv */
lnipspvKLIK	PROTECT		INPUTRI	13
tldlok2		ALLCAPS		INPUTRI	14 /* ket buka kunci subhead */
lnipsheadKLIK	PROTECT		INPUTRI	15
lenter          ALLCAPS         INPUTRI 50

DEFAULTS(tmptranst)
