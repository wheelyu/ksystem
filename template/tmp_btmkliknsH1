tldgrup2		DFALT_SCAN_BLANKS	SUDAH
tldlok2			DFALT_SCAN_BLANKS	SUDAH

MAP(mjointldc)
tldnourt        	lsvturt         REPLACE

DBCALCS(djointldc)
        DBC_COMMAND     JOIN
        DBC_TARGET      tldbukbrglok   bkmnobuk
        DBC_MAP         mjointldc

CALCS()
cdjointldc0             djointldc == 0
cdjointldc1             djointldc == 1
curt1d                  lsvturt + 1
cblhisi                 g_grpnam=="DIGMKTDVH" || g_grpnam=="KLIKNSSHMCM2WHEAD" || g_grpnam=="HMCSPV" ||  g_grpnam=="DIGMKT" || g_grpnam=="RI" || g_grpnam=="IT" || g_grpnam=="ROOT" || g_grpnam == "RAS"
/* chanyadigi1          djointbdubah == 1 */
/* chanyadigi           (djoinpsitld == 1 && lpsidep == "DIGITALDANACEPAT") || g_usrkode=="1523157" */
cbukutamu               tlddata == btmdata
cadaisiklikns	        btmrekomen!=BLANKS
cklikns_HO     	        g_grpnam!="IT" && g_grpnam!="RAS" && g_usrkode!="2215292"
cadaisi1                tldlok!=" " && g_usrkode!="1523157"
cadaisi2                tldbrg!=" " && g_usrkode!="1523157"
cdjoincadspvKLIK	btmsales != BLANKS && djoincadspvKLIK == 1
cdjoincadsheadKLIK	btmsales != BLANKS && djoincadspvKLIK == 1 && lnipspvKLIK != BLANKS && djoincadsheadKLIK == 1
cbukanadm		g_usrkode != btmsales && g_grpnam != "RAS" && g_grpnam != "IT" && g_grpnam != "RI"
cbukanspv		g_usrkode != lnipspvKLIK && g_grpnam != "RAS" && g_grpnam != "IT" && g_grpnam != "RI"
cbukanshead		g_usrkode != lnipsheadKLIK && g_grpnam != "RAS" && g_grpnam != "IT" && g_grpnam != "RI"

EDITS(tmptranst)
e.Mandatory     	tldlok                  MANDATORY
t.KryNull       	tldlok                  VALIDATE psikodidx mpsiC  0
t.KryNull		btmsales		VALIDATE psikodidx mpsiD  0
e.Mandatory		tldgrup			MANDATORY_IF cadakunciadm
e.Mandatory		tldgrup2		MANDATORY_IF cadakuncispv
e.Mandatory		tldlok2			MANDATORY_IF cadakuncishead

MAP(mpsiC)
psikode			tldlok			REPLACE
psinama         	lnamaklikns     	REPLACE

MAP(mpsiD)
psinama			lnamaklikns		REPLACE
g_strksg		lnipspvKLIK		REPLACE
lnipspvKLIK		lnipspvKLIK		REPLACE_IF cdjoincadspvKLIK
g_strksg		lnipsheadKLIK		REPLACE
lnipsheadKLIK		lnipsheadKLIK		REPLACE_IF cdjoincadsheadKLIK

MAP(murutd)
c1              	tldnourt        	DO_CALC_IF cdjointldc0
curt1d          	tldnourt        	DO_CALC_IF cdjointldc1
btmrekomen		tldbrg			REPLACE_IF cadaisiklikns
btmcab                  tldcab                  REPLACE

HOOKS(tmptranst)
AFTER_INPUT     cur_field=tldlok        DO_MAP SHOW murutd
BEFORE_INPUT    cur_field=tldbrg        DO_SKIP_IF cklikns_HO
BEFORE_INPUT    cur_field=tldlok        DO_SKIP_IF cadaisi1
BEFORE_INPUT    cur_field=tldbrg        DO_SKIP_IF cadaisi2
BEFORE_INPUT	cur_field=tldgrup	DO_SKIP_IF cbukanadm 
BEFORE_INPUT	cur_field=tldgrup2	DO_SKIP_IF cbukanspv
BEFORE_INPUT	cur_field=tldlok2	DO_SKIP_IF cbukanshead

