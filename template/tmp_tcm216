SPCALCS(spcaladd1)
DO_LIB ap_dbclc(DNAME dupdppsa2d,DCOMMAND UPDATE,DTARGET ppsbukidx tcmbank,DMAP mupdppsa);

SPCALCS(spcalupd1)
DO_LIB ap_dbclc(DNAME dupdppsu2d,DCOMMAND UPDATE,DTARGET ppsbukidx tcmbank,DMAP mupdppsu);
DO_LIB_IF ctdksama ap_dbclc(DNAME dupdppsu3d,DCOMMAND UPDATE,DTARGET ppsbukidx ~tcmbank,DMAP mupdppsd);

SPCALCS(spcaldel1)
DO_LIB ap_dbclc(DNAME dupdppsd2d,DCOMMAND UPDATE,DTARGET ppsbukidx ~tcmbank,DMAP mupdppsd);

POSTING(tmptrans)
 	PST_ADDCMD 	spcaladd1
	PST_UPDCMD 	spcalupd1
	PST_DELCMD 	spcaldel1
