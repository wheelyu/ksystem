/*
CALCS()
caddtlm1	   tlmperdisd + tcmtotbuk

cupdtlm1	   tlmperdisd + tcmtotbuk - ~tcmtotbuk

cupdtlmd1	   tlmperdisd - ~tcmtotbuk

MAP(mupdtlma2)
caddtlm1	  tlmperdisd	DO_CALC

MAP(mupdtlmu2)
cupdtlm1	  tlmperdisd      DO_CALC

MAP(mupdtlmd2)
cupdtlmd1	  tlmperdisd	DO_CALC
*/
CALCS()
cppssisprca	ppssisprc - tcmtotbuk
cppssisprcu	ppssisprc + ~tcmtotbuk - tcmtotbuk
cppssisprcd	ppssisprc + ~tcmtotbuk
ctdksama	tcmbank != ~tcmbank
csama		tcmbank == ~tcmbank

MAP(mupdppsa)
cppssisprca	ppssisprc	DO_CALC
gv_RCLS		ppsstsprc	REPLACE

MAP(mupdppsu)
cppssisprcu	ppssisprc	DO_CALC_IF csama
cppssisprca	ppssisprc	DO_CALC_IF ctdksama
gv_RCLS		ppsstsprc	REPLACE

MAP(mupdppsd)
cppssisprcd	ppssisprc	DO_CALC
gv_INPG		ppsstsprc	REPLACE

