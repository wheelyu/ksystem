FIELD(tmptranst)
   tcmtype       NOCHANGE INPUTRI         	1 /* nomor cek */
   tcmnocek      ALLCAPS SCROLL INPUTRI        	2 /* nomor cek */
   tcmkode	 ALLCAPS SCROLL INPUTRI	  	3 /* Kota Bank */
   tcmbank	 ALLCAPS SCROLL INPUTRI	  	3 /* Kota Bank */
   tcmnobbm  	 NOCHANGE INPUTRI 	  	4 /* Nama Bank */
   tcmtgljtp     PROTECT {DD-MM-YYYY} NONE 	6 /* Tanggal jt */
