cjoinsvikode1	djoinsvikode == 1
cnori		g_grpnam != "RI"


DEFAULT(tmptrans)
IF cpil2 tbtkat                   DFALT_SCAN                      BLANKS 
								  ADA ""
								  TDK_ADA ""
IF cpil3 tbtkat			  DFALT_SCAN			  BLANKS
								  ADA ""
								  TDK_ADA ""
								  TDK_MANDATORY ""


EDITS(tmptrans)
e.Mandatory		tbtkat		MANDATORY_IF cnori


SUBFILE(tmptrans)
