cadaygbelumisi	(djoinsvicekdokbm == 0 || (djoinsvicekdokbm == 1 && djoinsvicekdokbm2 == 1)) && (btmflag1 == "BM" ||  (btmflag1 == "SDVY" && btmwrn != "REGULER")) && btmsts == "701" && (g_grpnam == "B.M4WADH" || g_grpnam == "B.M4WBM" || g_grpnam == "B.M4WRM")
