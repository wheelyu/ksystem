IMAGE(tmptrans)

FIELDS(tmptranst)
spknobuk                PROTECT                         INPUTRI 1               /*Nobuk*/
spktgl                  PROTECT                         INPUTRI 2               /*Tanggal Input*/
spktgg                  PROTECT                         INPUTRI 3               /*Activity*/
lketacttmp              PROTECT                         INPUTRI 4               /*Ket Activity*/
spknoasal               PROTECT                         INPUTRI 5               /*VarKpi*/
spktgg2                 PROTECT                         INPUTRI 6               /*NIP PDCA*/
lpdcatmp                PROTECT                         INPUTRI 7               /*Nama PDCA*/
spktgg3                 PROTECT                         INPUTRI 8               /*NIP PIC*/
lpictmp                 PROTECT                         INPUTRI 9               /*Nama PIC*/
spktgg4                 PROTECT                         INPUTRI 10              /*NIP Head*/
lheadpdcatmp            PROTECT                         INPUTRI 11              /*Nama Head*/
spkkat                  NOCHANGE                        INPUTRI 12               /*Sesuai? YA-TIDAK*/
spkket                  TEXTAREA                        INPUTRI 13              /*Keterangan*/
spkreview2              TEXTAREA                        INPUTRI 14              /*Next Check*/
spkkat6                 NOCHANGE                        INPUTRI 15              /*Variabel KPI (1)*/
spkreview3              TEXTAREA                        INPUTRI 16              /*Problem*/
spkreview4              TEXTAREA                        INPUTRI 17              /*Eskalasi ke Divisi*/
lenter                  NOCHANGE                        INPUTRI 18              /*Enter*/
spkhasil2               NOCHANGE                        INPUTRI 19              /*Approval Head PDCA*/

DEFAULT(tmptranst)
spktgl                  INIT_ADD                        {g_tgltrn}

spkkat                  DFALT_SCAN_BLANKS               YA
                                                        TIDAK

spkhasil2               DFALT_SCAN_BLANKS               ACC
                                                        TACC

EDITS(tmptranst)
e.Mandatory                     spkket          MANDATORY
e.Wajib Isi Next Check          spkreview2      MANDATORY
e.Wajib Isi Problem             spkreview3      MANDATORY
e.Wajib Isi Eskalasi Divisi     spkreview4      MANDATORY

e.Validate Activity             spktgg          VALIDATE tbddatkodidx mactivitytmp15 {Pgv_dttabel} {PlSPKPDCA21} {PlACTIVITY}
e.Validate PDCA                 spktgg2         VALIDATE psikodidx    mpsipdcatmp15  0
e.Validate PIC                  spktgg3         VALIDATE psikodidx    mpsipictmp15   0
e.Validate HEAD PDCA            spktgg4         VALIDATE psikodidx    mpsiheadtmp15  0


MAP(mactivitytmp15)
tbdkode                 spktgg          REPLACE
tbdket                  lketacttmp      REPLACE
tbtkettype              spknoasal       REPLACE

MAP(mpsipdcatmp15)
psikode                 spktgg2         REPLACE
psinama                 lpdcatmp        REPLACE

MAP(mpsipictmp15)
psikode                 spktgg3         REPLACE
psinama                 lpictmp         REPLACE

MAP(mpsiheadtmp15)
psikode                 spktgg4         REPLACE
psinama                 lheadpdcatmp    REPLACE

MAP(mdataact15)
lINPACT                 spkdata         REPLACE
lINPACT15	        spktype         REPLACE
tlmnobuk                spknobuk        REPLACE
tlmnobbm                spktgg          REPLACE
tlmuntuk                spktgg2         REPLACE
tlmplg                  spktgg3         REPLACE
tlmbisnis               spktgg4         REPLACE

MAP(mmapkodefoto15)
ckode1                  lspkkode        DO_CALC
lspkkode                spkkode         REPLACE

HOOKS(tmptranst)
BEFORE_INPUT            cur_field=spkkat                DO_MAP SHOW mdataact15
AFTER_INPUT             cur_field=spkkat                DO_MAP SHOW mmapkodefoto15

BEFORE_INPUT            cur_field=spkkat                DO_SKIP_IF clogusrinput
BEFORE_INPUT            cur_field=spkket                DO_SKIP_IF clogusrinput
BEFORE_INPUT            cur_field=spkreview2            DO_SKIP_IF clogusrinput
BEFORE_INPUT            cur_field=spkkat6               DO_SKIP_IF clogusrinput
BEFORE_INPUT            cur_field=spkreview3            DO_SKIP_IF clogusrinput
BEFORE_INPUT            cur_field=spkreview4            DO_SKIP_IF clogusrinput
BEFORE_INPUT            cur_field=lenter                DO_SKIP_IF clogusrinput

BEFORE_INPUT            cur_field=spkhasil2             DO_SKIP_IF cloghead

MAP(mupdact15b)
cY                      spkfoto3         DO_CALC
DBCALCS(dupdact15b)
        DBC_COMMAND     UPDATE
        DBC_TARGET      spkprmidx spkprm
        DBC_MAP         mupdact15b

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_DOCUPLFLD          spknobuk spkkode  /*upload Dokumen Mandatory*/
SFL_DOCUPLFLD_DBCALCS  dupdact15b
SFL_TARGET
        spkdatbuktyp    lINPACT tlmnobuk lINPACT15

