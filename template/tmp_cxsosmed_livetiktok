ljumlahKomen	NUMERIC		INPUTRI	ZERO 5	/* Jumlah komen (tldhrg) */
ljumlahView	NUMERIC		INPUTRI	ZERO 6	/* Jumlah view (tldtotdis) */
ljumlahShare	NUMERIC		INPUTRI	ZERO 7	/* Jumlah share (tldsubtot) */
ljumlahEngagement NOCHANGE NOCHANGE        INPUTRI ZERO 8       /* JumlahEngagementTotal */
ljammulai	NUMERIC		INPUTRI 9		/* Durasi Mulai Live */
ljamselesai	NUMERIC		INPUTRI 10		/* Durasi Selesai Live */	
tldsatbsr       NOCHANGE         INPUTRI ZERO 11       /* DurasiLive */
