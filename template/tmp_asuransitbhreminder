AFTER_INPUT     cur_keybd=EN            DO_MAP SHOW misitbhrmnd
AFTER_INPUT	cur_keybd=EN		DO_MAP SHOW
		IF ctdkadarmnd mdum
		ELSE HKCURSOR STAY
