MAP(misitbhrmnd)
tlmpst		aktcab		REPLACE_IF cblmadaniprmnd
g_usrkode	aktkode2	REPLACE
g_tgltrn	aktcrttgl	REPLACE
lbukabkassrmd	aktkode		REPLACE
g_scrnumstr	akttype		REPLACE
ldatarmnd	aktdata		REPLACE

HOOKS(tmptranst)
