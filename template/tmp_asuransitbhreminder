abksts		PROTECT			INPUTRI	2
aktcab		ALLCAPS			INPUTRI	3
aktkode2	PROTECT			INPUTRI	4
aktket		TEXTAREA NONE		INPUTRI	5

CALCS()
cblmadaniprmnd	aktcab==BLANKS && g_curcmd == 1
