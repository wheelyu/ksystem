cusradhg2ok     ((lusrstr2=="ADH" || lusrstr2=="BM") && svistr2 != ~svistr2) || svistr2 == ~svistr2 || svistr2 == BLANKS
cusrbumg2ok     (lusrstr3=="BUM" && svistr3 != ~svistr3) || svistr3 == ~svistr3 || svistr3 == BLANKS
cusrkwlg2ok     (lusrstr4=="KAWIL" && svistr4 != ~svistr4) || svistr4 == ~svistr4 || svistr4 == BLANKS*/

EDITS(tmptranst)
t.Validatepsi1  svistr1 VALIDATE psikodidx mpsi12g2 0
