CALCS()
cstspicg2ok     (lstsstr1=="INPG" && svistr1 != ~svistr1) || svistr1 == ~svistr1
cstsadhg2ok     (lstsstr2=="INPG" && svistr2 != ~svistr2) || svistr2 == ~svistr2
