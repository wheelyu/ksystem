DEBUG		ldum	ldum	REPLACE

CALCS()
ckodepaket	"PPIU" + THBLS(tldtglfak) + STRIP(lurut)

MAP(menter)
ckodepaket	tldukrwrn	DO_CALC_IF ctambah

HOOKS(tmptranst)
AFTER_INPUT             cur_field=tldtglfak        DO_MAP SHOW mtglpo
AFTER_INPUT             cur_keybd=EN            DO_MAP SHOW mtglpo
AFTER_INPUT		cur_keybd=EN		DO_MAP SHOW menter

