lpatokan		INIT		3 
lhrmin14		INIT		29


CALCS()
cjointgm	djointgm==1
cscantgm	dscantgm==1 || dscantgm==0
ctgljlnmin14	tldtglfak - 14 
chkmin		(dscantgm==1 || dscantgm==0) && ltglhlrangejln == 2 && djointgm1==1 && ltgm1type=="HL"
/*chkmin1		(dscantgm==1 || dscantgm==0) && ltglhlrangejln >= 2 && djointgm1==1 && ltgm1type=="HK"
*/
ctglpo		tldtglfak - (14 + ltglhlrangejln)
ctglpo1		tldtglfak - (14 + ltglhlrangejln + 1)	
ctambah		g_curcmd == 1

MAP(mtglpo)
cBLANKS		ltglpo14	DO_CALC
ctgljlnmin14	ltglpo14	DO_CALC_IF cjointgm
cBLANKS		ltglpo		DO_CALC
ctglpo		ltglpo		DO_CALC_IF cscantgm
