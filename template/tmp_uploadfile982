LOCAL
PGM_FIELDS
lsubmitprn		STRING		 7
ldoneprn		STRING		 7
lPRN982			STRING		11
lnamafile		STRING	        11
lenterdisini            STRING          11
lpathfile		STRING	       256
lfields              	STRING         201
lpos1                 	INT2             2
lpos2                 	INT2             2
lpos3                 	INT2             2
lpos4                 	INT2             2
lpos5                 	INT2             2
lpos6                 	INT2             2
lpos7                 	INT2             2
lpos8                   INT2             2
lpos9                   INT2             2
lpos10                  INT2             2
ldatetype             	INT2             2
lmap                    STRING          21
lnamacalc               STRING          50
ljmlgagal               INT2             2
lKetPRN         	STRING		21
lKetPRN2        	STRING		21
lKetPRN2a       	STRING		21
lKetPRNFINAL    	STRING		21
lblndpn			DATE		 8
ltgl5			DATE		 8

DBCALCS(djoinprn982)
        DBC_COMMAND     JOIN
        DBC_TARGET      psddatpsmurt    lPRN982 tlmnobuk

CALCS()
cnamafile_uplibd        "docupload/" + THBLS(tlmtgl) + "/" + STRIP(tlmnobuk) + STRIP(lPRN982)+ "/" + "prn982.txt"
cfields			"spkdata+spklmtg+spkkat+spkket+spktglft+spkkat2+spkkat3+spkkat4+spkcab+spkkat5"
clblndpn		DO_LIB ap_tambl(tlmtgl,l1,&lblndpn);
ctgl5blndpn		THBLS_YYYY(lblndpn) + THBLS_MM(lblndpn) + "05"
csdhsubmit              psdstr2 == "OK" && psdstr3 == BLANKS
ctam1                   g_curcmd == 1 && djoinprn982 == 0
ctam1a                  g_curcmd == 1 && djoinprn982 == 1
cnorutprn               psdnourt + 1
csdhprn		        psdstr1 == BLANKS && psdstr3 == BLANKS

