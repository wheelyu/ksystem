IMAGE(tmptrans)

FIELDS(tmptranst)
psdnourt	        PROTECT		        INPUTRI	1               /*Nourut*/
psdpsmkode              PROTECT        	        INPUTRI 2               /*Nobuk*/
lnamafile               PROTECT                 INPUTRI 3               /*nama file upload*/
lpathfile               TEXTAREA 2 PROTECT      INPUTRI 4               /*path file upload*/      
psdstr1                 PROTECT                 INPUTRI 6               /*tanda sudah upload*/
lenterdisini            NOCHANGE                INPUTRI 5               /*Enter Disini*/  
lsubmitprn	        TOMBOL		        INPUTRI	7               /*tombol submit*/
psdstr2                 PROTECT                 INPUTRI 8               /*tanda sudah submit*/
ldoneprn	        TOMBOL		        INPUTRI	9               /*tombol prn*/
psdstr3                 PROTECT                 INPUTRI 10               /*tanda sudah prn*/

DEFAULTS(tmptranst)
psddata		        INIT		        "DTPDCA"
lPRN982		        INIT		        "PRN982"
lsubmitprn	        INIT		        "SUBMIT"
ldoneprn	        INIT		        "PRN"
lnamafile	        INIT		        "prn982.txt"
lenterdisini            INIT_LABEL              "Enter Disini"
lpathfile	        INIT		        {cnamafile_uplibd}
lpos1		        INIT		        1
lpos2		        INIT		        2
lpos3		        INIT		        3
lpos4		        INIT		        4
lpos5		        INIT		        5
lpos6		        INIT		        6
lpos7		        INIT		        7
lpos8		        INIT		        8
lpos9		        INIT		        9
lpos10		        INIT		        10
lfields		        INIT		        {cfields}
lmap		        INIT		        "mapprn"
lblndpn		        INIT		        {clblndpn}
ltgl5		        INIT		        {ctgl5blndpn}
lKetPRN                 INIT		        "PRN target BD"
lKetPRN2                INIT		        "Cek PRN AM"
lKetPRN2a               INIT		        "PRN target BD"
lKetPRNFINAL            INIT		        "ISI TGT BD"

MAP(misiprn)
gv_int1                 psdnourt                REPLACE_IF ctam1
cnorutprn               psdnourt                DO_CALC_IF ctam1a

MAP(mapprn)
psdpsmkode              spknoasal	        REPLACE
gv_OPEN                 spktype                 REPLACE   
DEBUG ldum              ldum                    REPLACE

MAP(mupdtandasubmitprn)
cOK                     psdstr2                 DO_CALC

MAP(mupdtandasubmitprn2)
cOK                     psdstr3                 DO_CALC


/*********************** SUBMIT PRN *****************************/
SPCALCS(saddprn)
DO_LIB                          ap_arfld(lfields,lpos1,lpos2,lpos3,lpos4,lpos5,lpos6,lpos7,lpos8,lpos9,lpos10);
DO_LIB                          ap_imtab(lpathfile,lfields,ldatetype,lmap,lnamacalc,&ljmlgagal);
DO_LIB                          ap_dbclc(DNAME dupdtandasubmitprn,DCOMMAND UPDATE,DTARGET psdprmidx psdprm,DMAP mupdtandasubmitprn);
                        
/*********************** PROSES PRN *************************/
SPCALCS(sdoprn)
DO_LIB_IF csdhsubmit            ap_nxpst(l4857,lmnextprn);
DO_LIB_IF csdhsubmit            ap_nxpst(l4857,lmnexthitung);
DO_LIB_IF csdhsubmit            ap_dbclc(DNAME dupdtandasubmitprn2,DCOMMAND UPDATE,DTARGET psdprmidx psdprm,DMAP mupdtandasubmitprn2);


HOOKS(tmptranst)
AFTER_INPUT                     cur_field=lenterdisini          DO_MAP SHOW misiprn
CLICKED		                cur_field=lsubmitprn	        DO_SPCALCS saddprn
CLICKED		                cur_field=ldoneprn	        DO_SPCALCS sdoprn

/*tanda upload prn*/
MAP(muplprn)
cOK		psdstr1		DO_CALC
DBCALCS(duplprn)
        DBC_COMMAND	UPDATE
        DBC_TARGET	psdprmidx	psdprm
        DBC_MAP		muplprn

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_SHOW_NEXT
SFL_COND cinpg
SFL_UPL_DIRFLD tlmtgl
SFL_DOCUPLFLD psdpsmkode psddata
SFL_DOCUPLFLD_DBCALCS duplprn
SFL_DOCUPL_DELCOND csdhprn
SFL_TARGET
psddatpsmurt  lPRN982 tlmnobuk

SFL_MAP
lPRN982         psddata
tlmnobuk        psdpsmkode


