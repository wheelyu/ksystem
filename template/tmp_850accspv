FIELD(tmptranst)
svitype2                NOCHANGE SCROLL                 INPUTRI 1  /*Revisi */
svistr3                 NOCHANGE SCROLL                 INPUTRI 2  /*ACC*/
svinama                 ALLCAPS                         INPUTRI 3  /*Ket Fraud */
svistr5                 NOCHANGE SCROLL                 INPUTRI 4  /*SPV FRAUD*/
svinourt                PROTECT NOLIMIT {DD-MM-YY}      INPUTRI 5
svitgl1                 PROTECT NOLIMIT {DD-MM-YY}      INPUTRI 5
svistr2                 PROTECT SCROLL                  INPUTRI 6
lnama4                  PROTECT SCROLL                  INPUTRI 6
svistr4                 PROTECT SCROLL                  INPUTRI 7
sviket                  TEXTAREA PROTECT                INPUTRI 8
sviket2                 TEXTAREA PROTECT 	        INPUTRI 9
sviket3                 TEXTAREA PROTECT 	        INPUTRI 10

DEFAULTS(tmptranst)
