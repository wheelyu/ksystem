e.Mandatory2	spknama		MANDATORY_IF cred
e.Mandatory3	spkkat		MANDATORY_IF cred
e.Mandatory4	spkkat2		MANDATORY_IF ctipegrup2
e.Mandatory5	spkkat3		MANDATORY_IF cred
e.Mandatory6	spkket		MANDATORY_IF cred
e.Mandatory7	spkkode9	MANDATORY_IF catasanshrmed

e.Validate	spkkat		VALIDATE tbddatkodidx mtbtshare stbdapk {Pgv_dttabel} {PlSPK21} {PlTIPESHARING} 
e.Validate	spkkat2		VALIDATE tbddatkodidx mtbdjmlpeserta stbdapk {Pgv_dttabel} {PlSPK21} {PlJMLPESERTA}

MAP(mtbtshare)
tbdkode		spkkat		REPLACE

MAP(mtbdjmlpeserta)
tbdkode		spkkat2		REPLACE

MAP(mupdabkrevatasan)
gv_CLSD         abksts          REPLACE_IF cnobukss
DEBUG	ldum	ldum	REPLACE

MAP(mupdtkmsharesos)
gv_CLSD         tkmsts          REPLACE

MAP(mupdtkmsharesos2)
