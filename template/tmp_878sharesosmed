FIELD(tmptranst)
spknobuk        PROTECT UNSEEN          INPUTRI 1
spktgl		PROTECT {DD-MM-YYYY}	INPUTRI	2
spknoasal	PROTECT			INPUTRI	3
spkjam          ALLCAPS 		INPUTRI 4
spknama		ALLCAPS SCROLL		INPUTRI	5
spkkat		ALLCAPS SCROLL		INPUTRI	6
spkkat2		ALLCAPS SCROLL		INPUTRI 7
spkkat3		ALLCAPS SCROLL		INPUTRI	9
spkket		TEXTAREA ALLCAPS	INPUTRI	10
lENTER2		NOCHANGE		INPUTRI	11
spkkode9	ALLCAPS SCROLL		INPUTRI	12
lENTER		NOCHANGE		INPUTRI	13

CALCS()
ctipegrup      	spkkat != "GRUP/KOMUNITAS"
ctipegrup2     	spkkat == "GRUP/KOMUNITAS"
crevatasan	spkkode9 == "T"
crevatasan2	spkkode9 == "Y"
crevatasan3	spkkode9 == "T" && tkmsts == "INPG"
cbesok		g_tgltrn + 1
cpulang		djoinabdDTG == 1 && (labdtype == "HADIR" || labdtype == "HADIR129")
cblmpulang	djoinabdDTG == 1 && labdtype == "DATANG"
cnobukss	abknobuk == tkmnobuk
cpjgjam		spkjam > ljam00
cbhakhb	        DO_LIB ap_akhbl(tkmtgl,&lbhtglakhb);
cblmin3	        ststglprjgl - 3
cbhmin3	        lbhtglakhb - 3
cjoinabklalu	djoinabk == 0 && djoinabk2 == 1
cbhnobuk	"SOSMED" + THBLS_DD(lbhtglmin3) + THBLS_MM(lbhtglmin3) + THBLS_YYYY(lbhtglmin3)
cbhnobuk2	"SOSMED" + THBLS_DD(lblmin3) + THBLS_MM(lblmin3) + THBLS_YYYY(lblmin3)
cbhhr1	        djoinbhtgm == 1 && lbhhari == 1
cbhhr2	        djoinbhtgm == 1 && lbhhari == 2
cbhhr3	        djoinbhtgm == 1 && lbhhari == 3
cbhhr4	        djoinbhtgm == 1 && lbhhari == 4
cbhhr5	        djoinbhtgm == 1 && lbhhari == 5
cbhhr61	        djoinbhtgm == 1 && lbhhari == 6 && lbhminggu == 1
cbhhr62	        djoinbhtgm == 1 && lbhhari == 6 && lbhminggu == 2
cbhhr63	        djoinbhtgm == 1 && lbhhari == 6 && lbhminggu == 3
cbhhr64	        djoinbhtgm == 1 && lbhhari == 6 && lbhminggu == 4
cbhhr65         djoinbhtgm == 1 && lbhhari == 6 && lbhminggu == 5

DEFAULT(tmptranst)
lbhtglakhb	                INIT	{cbhakhb}
lbhtglmin3	                INIT	{cbhmin3}
lblmin3                         INIT    {cblmin3}
lbhnobuk	                INIT	{cbhnobuk}
lbhnobuk2                       INIT    {cbhnobuk2}
IF cjoinabklalu	lbhtglmin3	INIT	{cblmin3}
IF cjoinabklalu	lbhnobuk	INIT	{cbhnobuk2}
IF cbhhr1	lbhhrnama	INIT	"SENIN"
IF cbhhr2	lbhhrnama	INIT	"SELASA"
IF cbhhr3	lbhhrnama	INIT	"RABU"
IF cbhhr4	lbhhrnama	INIT	"KAMIS"
IF cbhhr5	lbhhrnama	INIT	"JUMAT"
IF cbhhr61	lbhhrnama	INIT	"SABTU13"
IF cbhhr62	lbhhrnama	INIT	"SABTU24"
IF cbhhr63	lbhhrnama	INIT	"SABTU13"
IF cbhhr64	lbhhrnama	INIT	"SABTU24"
IF cbhhr65      lbhhrnama       INIT    "SABTU13"
spktgl          INIT_UPDATE     {g_tgltrn}
spkkode9        DFALT_LIST      BLANKS  Y
                                        T
spkjam          INIT_LABEL      JAM:MENIT
lREV878         INIT            "REV 878 SHARE MEDSOS"
ljam00		INIT		00:00:00

EDITS(tmptranst)
