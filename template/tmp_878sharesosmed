cbesok          tkmtgl          DO_CALC_IF cpulang

MAP(mupdabkkoreksiss)
gt_RINP		abksts		REPLACE_IF cpulang
gv_INPG		abksts 		REPLACE_IF cblmpulang
cbesok		abktgl		DO_CALC_IF cpulang
DEBUG		ldum	ldum	REPLACE

MAP(mupdspksharesos)
cBLANKS		spkfoto		DO_CALC
DEBUG		ldum	ldum	REPLACE

MAP(mblanksss2)
cBLANKS		spkkat2		DO_CALC

SPCALCS(supdabkatasan)
	DO_LIB_IF crevatasan	ap_dbclc(DNAME dupdabksharesos, DCOMMAND UPDATE_RANGE, DTARGET abkdatstskym lKUNCIABSEN gv_CLSD tkmplg l8785 g_tgltrn tkmnobuk, DMAP mupdabkkoreksiss);
        DO_LIB_IF catasanshrmed ap_dbclc(DNAME dupdabkrevatasan,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lKUNCIABSEN gv_INPG lREV878 l8785 g_tgltrn,DMAP mupdabkrevatasan);
	DO_LIB_IF crevatasan    ap_dbclc(DNAME dupdtkmsharesos2,DCOMMAND UPDATE, DTARGET tkmbukidx tkmnobuk,DMAP mupdtkmsharesos2);
        DO_LIB_IF crevatasan2   ap_dbclc(DNAME dupdtkmsharesos,DCOMMAND UPDATE, DTARGET tkmbukidx tkmnobuk,DMAP mupdtkmsharesos);

HOOKS(tmptranst)
