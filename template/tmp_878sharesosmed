BEFORE_INPUT	cur_field=spkjam	DO_SKIP_IF catasanshrmed
BEFORE_INPUT    cur_field=spknama       DO_SKIP_IF catasanshrmed
BEFORE_INPUT    cur_field=spkkat        DO_SKIP_IF catasanshrmed
BEFORE_INPUT    cur_field=spkkat2       DO_SKIP_IF catasanshrmed
BEFORE_INPUT    cur_field=spkkat3       DO_SKIP_IF catasanshrmed
BEFORE_INPUT    cur_field=spkket        DO_SKIP_IF catasanshrmed
BEFORE_INPUT    cur_field=lENTER2       DO_SKIP_IF catasanshrmed
BEFORE_INPUT    cur_field=spkkode9      DO_SKIP_IF cred
BEFORE_INPUT    cur_field=lENTER        DO_SKIP_IF cred

