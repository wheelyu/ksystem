DO_LIB_IF cjoinabkpam1  ap_dbclc(DNAME dupdabkpam, DCOMMAND UPDATE_RANGE, DTARGET abkdatbukidx lkunciabsen lnobukpam, DMAP mupdabkpam);
DO_LIB_IF cyapam                ap_dbclc(DNAME dupdabkpam2, DCOMMAND UPDATE_RANGE, DTARGET abkdatbukidx lkunciabsen tbdkode, DMAP mupdabkpam,DBC_COND cselabkpamga);
DO_LIB_IF cyapam                ap_dbclc(DNAME dupdabkpam5, DCOMMAND UPDATE_RANGE, DTARGET abkdatbukidx lkunciabsen tbdkode, DMAP mupdabkpam,DBC_COND cselabkpam);
DO_LIB_IF ctdkpam               ap_dbclc(DNAME dupdabkpam3, DCOMMAND UPDATE_RANGE, DTARGET abkdatbukidx lkunciabsen tbdkode, DMAP mupdabkpaminpg,DBC_COND cselabkpam);
DO_LIB_IF ctdkpam               ap_dbclc(DNAME dupdabkpam4, DCOMMAND UPDATE_RANGE, DTARGET abkdatbukidx lkunciabsen tbdkode, DMAP mupdabkpam, DBC_COND cselabkpamga);
*/
DO_LIB_IF cyapam         ap_dbclc(DNAME dupdabkdetpam,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lketpam,DMAP mupdabkpam);
DO_LIB_IF cyapam         ap_dbclc(DNAME dupdabkdetpam2,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gt_RINP lketpam,DMAP mupdabkpam);


SPCALCS(spupdfotopam)
        DO_LIB_IF cgpsoklis        ap_dbclc(DNAME dupdfotopam,DCOMMAND UPDATE, DTARGET tbtotoidx tbtoto,DMAP mupdfotopam);
        DO_LIB_IF cgpsoklis        ap_dbclc(DNAME dupdabkpamm,DCOMMAND UPDATE_RANGE,DTARGET abkdatbukidx lkunciabsen tbdkode,DMAP mupdabk,DBC_COND cselabkpam);
        DO_LIB_IF cgpsoklis        ap_dbclc(DNAME daddabk106gaoffpam,DCOMMAND ADD,DFILE abk,DMAP maddabk106gaoffpam);
        DO_LIB_IF cgpsoklis        ap_dbclc(DNAME daddabk106gaheadpam,DCOMMAND ADD,DFILE abk,DMAP maddabk106gaheadpam);

POSTING(tmptrans)
        PST_ADDCMD      spupdabkpam
        PST_UPDCMD      spupdabkpam
