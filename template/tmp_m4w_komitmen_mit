lketKM001	INIT		"Foto Surat Perjanjian di TTD Mitra"
lketKM002	INIT		"Foto Mitra Dan Upline Memegang Surat Perjanjian bersama"
aktcrtusr	INIT_UPDATE 	{g_usrkode}
lKOMMIT5	INIT		KOMMIT5
lKOMMIT11	INIT		KOMMIT11
lmastertgt	INIT		MASTERTARGET

CALCS()
cjoinkomitmitra1		djoinkomitmitra1==0
cjoinkomitmitra2		djoinkomitmitra1== 1 && djoinkomitmitra2==0
cprodukbeda			(djoinkomitmitra1== 1 && lprodukmitra == aktlok) || djoinkomitmitra1==0

