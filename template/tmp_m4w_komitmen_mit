CALCS()
csdm		g_grpnam != "B.M4WMSPV" && g_grpnam != "RI"
caddkomit	psmstssup == "INPG" && (djoinkomitmitra1==0 || (djoinkomitmitra1==1 && djoinkomitmitra2==0))
cupdkomit	aktcrttgl != BLANKS && (g_grpnam=="B.M4WMSPV" || g_grpnam=="RI")

