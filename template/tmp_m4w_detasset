e.Validate		astpsmkode 	VALIDATE_IF cnontambah psmkodidx mpsm 0	

CALCS()
cjnsbpkb		astjns == "BPKB"
cjnsserti		astjns == "SERTIFIKAT"
clabel1bpkb		"No. BPKB"
clabel2bpkb		"Faktur BPKB"
clabel1serti		"No. PBB"
clabel2serti		"No Sertifikat"
cubah			g_curcmd == 2

MAP(mpsm)
psmkode			astpsmkode		REPLACE
clabel1bpkb		llabel1			DO_CALC_IF cjnsbpkb
clabel2bpkb		llabel2			DO_CALC_IF cjnsbpkb
clabel1serti		llabel1			DO_CALC_IF cjnsserti
clabel2serti		llabel2			DO_CALC_IF cjnsserti

MAP(misilabel)
clabel1bpkb		llabel1			DO_CALC_IF cjnsbpkb
clabel2bpkb		llabel2			DO_CALC_IF cjnsbpkb
clabel1serti		llabel1			DO_CALC_IF cjnsserti
clabel2serti		llabel2			DO_CALC_IF cjnsserti

HOOKS(tmptranst)
AFTER_INPUT		cur_field=astjns	DO_MAP SHOW misilabel
BEFORE_INPUT		cur_field=astjns	DO_SKIP_IF cubah

SUBFILE(tmptrans)
SFL_LINES(1)       
SFL_TITLE(tmptranst)
SFL_TARGET
	astdatkodidx   gv_dtassets tlmplg gv_bpkb            

CALCS()
casset_edit0		0

PERMIT(tmptrans)
  PMT_ADD_COND  	casset_edit0
  PMT_UPDALL_COND 	casset_edit0
  PMT_DEL_COND  	casset_edit0
