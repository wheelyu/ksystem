astmerk			PROTECT SCROLL		INPUTRI 11
asttype			PROTECT SCROLL		INPUTRI 12
astbrg			PROTECT SCROLL		INPUTRI 12
astwarna		PROTECT SCROLL		INPUTRI 13
astjnsbbm		PROTECT SCROLL		INPUTRI 14
astnopol		PROTECT SCROLL		INPUTRI 15
astrangka		PROTECT SCROLL		INPUTRI 16
astmesin		PROTECT SCROLL		INPUTRI 17
aststnk			PROTECT SCROLL		INPUTRI 19		
