MAP(misibuk)
mtsnobuk	svinobuk	REPLACE
mtsnoasal	svidtmkode	REPLACE

CALCS()
cjb3            svitgl1 <= (g_tgltrn + 3)
ctglmaju3       svitgl1 > g_tgltrn

HOOKS(tmptranst)
BEFORE_INPUT  cur_field=svinobuk DO_MAP SHOW IF coty misibuk
AFTER_INPUT  cur_field=svistr31 DO_MAP SHOW mketkta1
AFTER_INPUT  cur_field=svidf2   DO_MAP SHOW mketkta2
AFTER_INPUT  cur_field=svidf4   DO_MAP SHOW mketkta3
BEFORE_INPUT  cur_field=svidf4   DO_SKIP_IF cisibyr01
BEFORE_INPUT  cur_field=svitgl1   DO_SKIP_IF cisibyr01

AFTER_INPUT     cur_field=svitgl1       DO_MAP SHOW
                IF cjb3 mdum3
                ELSE HKCURSOR STAY
                HKMSG t.TglJbMax3hrKunj

AFTER_INPUT     cur_field=svitgl1       DO_MAP SHOW
                IF ctglmaju3 mdum3
                ELSE HKCURSOR STAY
                HKMSG t.InputTglJbTdkBsMundur


