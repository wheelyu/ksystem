SFL_SORT_UPDOWN DOWN
SFL_TARGET
        aktkodtypidx   tlmnobuk lHSLVERIF11 lHSLVERIF
SFL_MAP
tlmnobuk        aktkode                 REPLACE
lHSLVERIF       aktdata                REPLACE
lHSLVERIF       akttype                 REPLACE


SPCALCS(spd4to2)
