DEFAULTS(tmptranst)

CALCS()
cisiomzet	djoinftmcapacity==1 && (lftmdvs2=="AG" || lftmdvs2=="TN" || lftmdvs2=="TP" || lftmdvs2=="TR" || lftmdvs2=="W1" || lftmdvs2=="W2"|| lftmdvs2=="D1" || lftmdvs2=="D2" || lftmdvs2=="NL")
cisisupplier	djoinftmcapacity==1 && (lftmdvs2=="AG" || lftmdvs2=="TN" || lftmdvs2=="TP" || lftmdvs2=="TR" || lftmdvs2=="W1" || lftmdvs2=="D2")
cisiluasrmhjmlkry	djoinftmcapacity==1 && (lftmdvs2=="TN" || lftmdvs2=="W1" || lftmdvs2=="W2" || lftmdvs2=="D2" || lftmdvs2=="TR")
cisijadwaloperasional	djoinftmcapacity==1 && (lftmdvs2=="AG" || lftmdvs2=="NL" || lftmdvs2=="W1" || lftmdvs2=="W2" || lftmdvs2=="D1" || lftmdvs2=="D2")
cisibuktikepemilikan	djoinftmcapacity==1 && lftmdvs2=="TN"

ctdkisiomzet	djoinftmcapacity==1 && lftmdvs2!="AG" && lftmdvs2!="TN" && lftmdvs2!="TP" && lftmdvs2!="TR" && lftmdvs2!="W1" && lftmdvs2!="W2" && lftmdvs2!="D1" && lftmdvs2!="D2"
ctdkisisupplier	djoinftmcapacity==1 && lftmdvs2!="AG" && lftmdvs2!="TN" && lftmdvs2!="TP" && lftmdvs2!="TR" && lftmdvs2!="W1"&& lftmdvs2!="D2"
ctdkisijadwalops	djoinftmcapacity==1 && lftmdvs2!="AG" && lftmdvs2!="NL" && lftmdvs2!="W1" && lftmdvs2!="W2" && lftmdvs2!="D1" && lftmdvs2!="D2"
ctdkisiluasrmhjmlkry	djoinftmcapacity==1 && lftmdvs2!="TN" && lftmdvs2!="W1" && lftmdvs2!="W2" && lftmdvs2!="D2" && lftmdvs2=="TR"
ctdkisibuktikepemilikan	djoinftmcapacity==1 && lftmdvs2!="TN"

EDITS(tmptranst)
