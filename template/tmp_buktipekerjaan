e.mandatory	ftmnama1	MANDATORY_IF cisisupplier
e.mandatory	ftmkode1	MANDATORY_IF cisisupplier
e.Mandatory	ftmhrg1		MANDATORY_IF cisijadwaloperasional
e.mandatory	ftmjml2		MANDATORY_IF cisisupplier
e.Mandatory	ftmjml3		MANDATORY_IF cisiluasrmhjmlkry
e.Mandatory	ftmjml4		MANDATORY_IF cisiluasrmhjmlkry

e.mandatory	ftmkode2	MANDATORY_IF cisibuktikepemilikan

HOOKS(tmptranst)

BEFORE_INPUT	cur_field=ftmjml1	DO_SKIP_IF ctdkisiomzet

