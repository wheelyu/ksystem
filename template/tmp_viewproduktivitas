LOCAL
PGM_FIELDS
ltbdkode	STRING		21
lnilai		DFLOAT		8
lit		STRING		21
ldtbobot	STRING		21
ltbddf1		DFLOAT		8
ltomtotal	STRING		21
lbkmjns		STRING		21
ltlmtype1	STRING		21
lmtsuntuk	STRING		21
ltkmkode	STRING		21
lbtlscrtrn	STRING		21
ltlddata	STRING		21
lpmbgrup	STRING		21
ltotal 		DFLOAT		8
ltotalmnt 	DFLOAT		8


MAP(mjointbdbobot)
tbddf1		ltbddf1		REPLACE

DBCALCS(djointbdbobot)
        DBC_COMMAND     JOIN
        DBC_TARGET      tbddatkodidx gv_dttabel lit ldtbobot ltbdkode
	DBC_MAP		mjointbdbobot


MAP(mjoinbkm)
bkmjns		lbkmjns		REPLACE
DBCALCS(djoinbkm)
	DBC_COMMAND	JOIN
	DBC_TARGET	bkmbukidx lognobuk
	DBC_MAP 	mjoinbkm


MAP(mjointlm)
tlmtype1        ltlmtype1       REPLACE
DBCALCS(djointlm)
        DBC_COMMAND     JOIN
        DBC_TARGET      tlmbukidx lognobuk
        DBC_MAP         mjointlm

MAP(mjoinmts)
mtsuntuk        lmtsuntuk       REPLACE
DBCALCS(djoinmts)
        DBC_COMMAND     JOIN
        DBC_TARGET      mtsbukidx lognobuk
        DBC_MAP         mjoinmts

MAP(mjointkm)
tkmkode         ltkmkode        REPLACE
DBCALCS(djointkm)
        DBC_COMMAND     JOIN
        DBC_TARGET      tkmbukidx lognobuk
        DBC_MAP         mjointkm

MAP(mjoinbtl)
btlscrtrn       lbtlscrtrn      REPLACE
DBCALCS(djoinbtl)
        DBC_COMMAND     JOIN
        DBC_TARGET      btlbukstsidx lognobuk
        DBC_MAP         mjoinbtl

MAP(mjointld)
tlddata         ltlddata        REPLACE
DBCALCS(djointld)
        DBC_COMMAND     JOIN
        DBC_TARGET      tldbukurtidx lognobuk
        DBC_MAP         mjointld

