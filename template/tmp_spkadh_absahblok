svistr37        PROTECT         INPUTRI 21


DEFAULTS(tmptranst)
lverabs			INIT			2606.18v1
svistr34		DFALT_SCAN_BLANKS	1 "ACC"
						2 "TACC"
svistr35		DFALT_SCAN_BLANKS	3 "ACC"
						4 "TACC"
ltombuplabs		INIT			"UPLOAD OK"
ltompjabs               INIT                    "SELESAI REV PJ HO"
ltomdvhabs              INIT                    "SELESAI REV DVH"
IF chnypjho svitype2    INIT_UPDATE             {g_usrkode}


CALCS()
cbtsabsah       	svidf1 < 2
ctdabsah        	svidf1 + 1
cABSAH			"OK_ABSAH"
cBPKB			"OK_BPKB"
csdhuplabs		svistr6 == "OK_ABSAH" && svistr7 == "OK_BPKB"
cmenitabsah		svistr2 != "OK" && svistr3 != "OK" && svistr6 == "OK_ABSAH" && svistr7 == "OK_BPKB"
cjoinurtabsah0  	djoinurutabsah == 0 && g_curcmd == 1
cjoinurtabsah1  	djoinurutabsah == 1 && g_curcmd == 1
cjoinnamadeb		djoinnamadeb == 1
curtabsah1      	FLD_TO_STRING(svinourt) + "SRTABSAH"
curtabsah2      	FLD_TO_STRING(svinourt) + "FSBPKB"
crev1abs        	svistr34 == "1" && svitype == "ABSAHBLOK"
crev1aabs       	svistr35 == "1" && svitype == "ABSAHBLOK"
crev2abs        	svistr34 == "2" && svitype == "ABSAHBLOK"
crev2aabs       	svistr35 == "2" && svitype == "ABSAHBLOK"
cpjhosdhrevabs  	svistr34 != BLANKS
cdvhsdhrevabs   	svistr35 != BLANKS
cbisaabsah		svists != "BTL" && svists != "DBL" && svists != "TACC"
cbkncab			lbtmcab == tkmcab

