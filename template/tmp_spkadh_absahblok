sviket2         TEXTAREA        INPUTRI 14  /*isi ket review HO*/
svistr35        NOCHANGE        INPUTRI 15  /*ket Rev DVH*/
svistr5         PROTECT         INPUTRI 16
sviket3         TEXTAREA        INPUTRI 17  /*isi ket review DVH*/

ltompjabs       TOMBOL          INPUTRI 18
ltomdvhabs      TOMBOL          INPUTRI 20
