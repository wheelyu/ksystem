DEBUG   ldum    ldum    REPLACE

MAP(mmapmapver)
DEBUG   ldum    ldum    REPLACE

SPCALCS(spverifamgaji)
/*buka kuncian am*/
DO_LIB  ap_dbclc(DNAME dmamapver,DCOMMAND MAPMAP,DMAP mmapmapver);
DO_LIB ap_dbclc(DNAME dupdabkverifgaji,DCOMMAND UPDATE_RANGE,DTARGET abkdatbukidx lKUNCIABSEN btmnobuk,DMAP mupdabkveriggaji);

POSTING(tmptrans)
