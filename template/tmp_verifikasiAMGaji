e.validate      lindustripm     VALIDATE tbtdattypkod mtbt2_1x stbt {Pgv_dttabel} {Pgv_dttabel21} {PlDETPEKERJAAN} {Pldetpekerjaan13hp} {Pldetkerjapm}


MAP(mtbd2_1x)
tblket		    lketkerja       REPLACE
