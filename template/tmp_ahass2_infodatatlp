DEFAULTS(tmptranst)
condata   INIT   TELP
condata   INIT_UPDATE   TELP
ltypehp		INIT	TYPEHP
lSURVEY		INIT	SURVEY
lJAMTELPON	INIT	JAMTELPON
lfungsihp	INIT	FUNGSIHP

CALCS()
cpanjangnom             DO_LIB ap_strln(conhp,&ljumlahnomor);
