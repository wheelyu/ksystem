AFTER_INPUT     cur_field=psdtype2      DO_MAP SHOW mtbd_ijazahxd
AFTER_INPUT	cur_keybd=EN     	DO_MAP SHOW mket
AFTER_INPUT	cur_field=psdstr3	DO_MAP SHOW
		IF cFu_done mdum
		HKMSG t.FuHarusSelesai
AFTER_INPUT     cur_field=psdtgl1  DO_MAP SHOW
                IF ctglinterview mdum
                ELSE HKCURSOR STAY
                HKMSG i.TglTdkBlhLebihHariIni

