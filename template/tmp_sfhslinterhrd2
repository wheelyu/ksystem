ctdk		"TIDAK LOLOS"
cUNIVERSITASxd    "UNIVERSITAS"
cSMKxd            "SMK"
cSMAxd            "SMA"
cjns_univxd       psdtype2=="S1" || psdtype2=="S2" || psdtype2=="S3" || psdtype2=="D1" || psdtype2=="D2" || psdtype2=="D3" || psdtype2=="D4"
cjns_smkxd        psdtype2=="SMK"
cjns_smaxd        psdtype2=="SMU" || psdtype2=="SMA"

MAP(mket)
