cSMKxd            ljns_pendidikan DO_CALC_IF cjns_smkxd
cSMAxd            ljns_pendidikan DO_CALC_IF cjns_smaxd

CALCS()
ctglinterview   psdtgl1 <= g_tgltrn
cFu_done        ((djoinpsd_FU1==1 && lpilhrd_FU1=="LANJUT_INTERVIEW") || (djoinpsd_FU2==1 && lpilhrd_FU2=="LANJUT_INTERVIEW") || (djoinpsd_FU3==1 && lpilhrd_FU3=="LANJUT_INTERVIEW"))

HOOKS(tmptranst)
BEFORE_INPUT cur_field=amtstr1_3 DO_SKIP_IF cacc
