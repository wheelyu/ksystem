IMAGE(tmptrans)
|t.NipBaru   ________ ___________ | ____ |

FIELD(tmptrans)
ltipenip        NOCHANGE        INPUTRI         1
lnipganti       ALLCAPS         INPUTRI         2
lenter2         NOCHANGE        INPUTRI         3

DEFAULTS(tmptrans)
ltipenip        DFALT_SCAN              PEMBUAT  " "
                                        PENERIMA " "

lenter2         INIT                    ENTER

EDITS(tmptrans)
e.Validate lnipganti VALIDATE psikodidx mpsiacc spsiINPG

MAP(mpsiacc)
psikode         lnipganti       REPLACE

CALCS()
cblhganti       tlmsts != "CLSD" && ((tlmcab != "KGW31" && (g_grpnam == "ADHHEAD" || g_grpnam == "ADHAM" || g_grpnam == "ADHDVH" || g_grpnam == "ADHSPV" || g_grpnam == "B.M4WADHSPV" || g_grpnam == "B.M4WADHHEAD" ||
		g_grpnam == "B.M4WADHDVH" || g_grpnam == "RI" || g_grpnam == "FINBPKBCO")) || (tlmcab == "KGW31" && (g_grpnam == "FINBPKBCO" || g_grpnam == "RI")))

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_APP_TYPE
SFL_COND cblhganti
SFL_SHOW_NEXT
SFL_TARGET tlmbukidx tlmnobuk


CALCS()
cgantinip        lnipganti != BLANKS
cpembuat         ltipenip == "PEMBUAT"
cpenerima        ltipenip == "PENERIMA"
cnobukTC2        "TC-"+STRIP(tlmnobuk)
cadaabk861tc    lnipganti != BLANKS && ltipenip == "PENERIMA" && djoinabk861tc == 1


MAP(mupdtlmgantinip)
lnipganti       tlmgrup2       REPLACE_IF cpembuat
lnipganti       tlmbrdoto      REPLACE_IF cpenerima

MAP(mmapabk861)
lblanks         lnoabk861tc     REPLACE
cnobukTC2       lnoabk861tc     DO_CALC

MAP(mupdabk861kgwkecab)
lnipganti       abkkym         REPLACE


SPCALCS(spgantinip)
DO_LIB ap_dbclc(DNAME dmmapabk861, DCOMMAND MAPMAP,DMAP mmapabk861);
DO_LIB_IF cgantinip  ap_dbclc(DNAME dupdtlmgantinip,DCOMMAND UPDATE, DTARGET tlmbukidx tlmnobuk,DMAP mupdtlmgantinip);
DO_LIB_IF cadaabk861tc ap_dbclc(DNAME dupdabk861kgwcab,DCOMMAND UPDATE_RANGE,DBC_TARGET abkdatbukidx lkunciabsen lnoabk861tc,DMAP mupdabk861kgwkecab);

POSTING(tmptrans)
PST_COMMAND spgantinip
