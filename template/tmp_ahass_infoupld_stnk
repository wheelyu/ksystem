LOCAL
PGM_FIELDS

lscr620                 STRING          5 
lbtmass			STRING		21
lnipADHHO	        STRING          21

CALCS()
ckondisikabeng          abkkym2 == "UPLOAD STNK 620" && abknoll == "KABENG"
ckondisisa              abkkym2 == "UPLOAD STNK 620" && abknoll == "SA"
ckondisifd              abkkym2 == "UPLOAD STNK 620" && abknoll == "FD"
ckondisiadhdca          abkkym2 == "ACC STNK 620" && abknoll == "ADHDCA"
ckondisiadhho           abkkym2 == "ACC STNK 620" && abknoll == "ADHHO"

DBCALCS(djoinabkKABENG)
        DBC_COMMAND     JOIN
        DBC_TARGET      abkdatbukidx    lKUNCIABSEN btmnobuk
        DBC_SELECT      ckondisikabeng

DBCALCS(djoinabkSA)
        DBC_COMMAND     JOIN
        DBC_TARGET      abkdatbukidx    lKUNCIABSEN btmnobuk
        DBC_SELECT      ckondisisa

DBCALCS(djoinabkFD)
        DBC_COMMAND     JOIN
        DBC_TARGET      abkdatbukidx    lKUNCIABSEN btmnobuk
        DBC_SELECT      ckondisifd

DBCALCS(djoinabkADHDCA)
        DBC_COMMAND     JOIN
        DBC_TARGET      abkdatbukidx    lKUNCIABSEN btmnobuk
        DBC_SELECT      ckondisiadhdca

DBCALCS(djoinabkADHHO)
        DBC_COMMAND     JOIN
        DBC_TARGET      abkdatbukidx    lKUNCIABSEN btmnobuk
        DBC_SELECT      ckondisiadhho

