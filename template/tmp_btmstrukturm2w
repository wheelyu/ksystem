btmthn			PROTECT	UNSEEN				INPUTRI	25

CALCS()
ctenormin		btmlmang >= lhasil1tenmax
ctenormax		btmlmang <= lhasil2tenmax
cCairbesar		btmdf1 <= btmhrg
cmincair		btmdf1 >= 1000000
cmincairRO		(btmhrg >= 4500000 && (btmsoa == "RO" || btmsoa == "TOPUP" || btmsoa == "AO")) || (btmsoa != "RO" && btmsoa != "TOPUP" && btmsoa != "AO")

EDITS(tmptranst)
e.Mandatory             btmtotal		MANDATORY
e.Mandatory             btmdf1          	MANDATORY
e.Mandatory             btmlmang		MANDATORY

t.ValidateKuota		btmcab			VALIDATE_IF cjoinalmsurv1 cabstsushkod mcabkuota 0 {Pgv_INPG} {Pgv_finco11}
e.ValidateThn           btmthn			VALIDATE tbddatkodidx mtbdTHN stbdLok {Pgv_dttabel} {Pgv_infoumum} {Pgv_tahun}

MAP(mtenormax)
crmdgabtenormax         lrmdgabtenormax         DO_CALC

MAP(mtenor)
btmlmang		nhmtenor_2		REPLACE

HOOKS(tmptranst)
BEFORE_INPUT		cur_field=btmhrg	DO_SKIP_IF chrgisi
BEFORE_INPUT            cur_field=btmtotal      DO_SKIP_IF cRenc
BEFORE_INPUT            cur_field=btmdf1        DO_SKIP_IF cRenc
BEFORE_INPUT            cur_field=btmlmang      DO_SKIP_IF cRenc

AFTER_INPUT             cur_field=btmlmang	DO_MAP SHOW mtenor
AFTER_INPUT             cur_field=btmdf1        DO_MAP SHOW mtenormax
AFTER_INPUT             cur_field=btmdf1        DO_LIB_IF cjoinrmdtenormax1 ap_ambts(gv_INPG,lrmdgabtenormax,btmdf1,lNol,lNol,&lhasil1tenmax,&lhasil2tenmax,&lhasil3tenmax,lhasilstr1,lhasilstr2);

AFTER_INPUT             cur_field=btmdf1        DO_MAP SHOW
                        IF cCairbesar mdumstr
                        ELSE HKCURSOR STAY
                        HKMSG t.PengCairLessHrgPsr

AFTER_INPUT             cur_field=btmdf1        DO_MAP SHOW
                        IF cmincair mdumstr
                        ELSE HKCURSOR STAY
                        HKMSG t.MinCair1Juta

AFTER_INPUT 		cur_keybd=EN DO_MAP SHOW
	    		IF cmincairRO mdumstr
	    		ELSE HKCURSOR STAY
	    		HKMSG t.MinCair4Juta

AFTER_INPUT             cur_field=btmlmang      DO_MAP SHOW
                        IF ctenormax mdumstr
                        ELSE HKCURSOR btmlmang
                        HKMSG t.MaxTenorDiAtasBts

AFTER_INPUT             cur_keybd=EN            DO_MAP SHOW
                        IF ctenormax mdumstr
                        ELSE HKCURSOR STAY
                        HKMSG t.MaxTenorDiAtasBts

AFTER_INPUT             cur_field=btmlmang      DO_MAP SHOW
                        IF ctenormin mdumstr
                        ELSE HKCURSOR btmlmang
                        HKMSG t.MinTenorDiBwhBts
			
AFTER_INPUT             cur_keybd=EN            DO_MAP SHOW
                        IF ctenormin mdumstr
                        ELSE HKCURSOR STAY
                        HKMSG t.MinTenorDiBwhBts

