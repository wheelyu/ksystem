btmtotal                NUMERIC                                 INPUTRI 3       /* Besar Angsuran */
btmdf1                  NUMERIC                                 INPUTRI 4       /* Pengajuan Cair */
btmlmang                NUMERIC                                 INPUTRI 5       /* Lama Angsuran */

lcountpik               PROTECT                                 INPUTRI 6
lcountbeda              PROTECT                                 INPUTRI 7
lcountperbeda           PROTECT                                 INPUTRI 9
