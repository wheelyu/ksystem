IMAGE(tmptrans)

FIELDS(tmptranst)
spknobuk                PROTECT                         INPUTRI 1               /*Nobuk*/
spktgl                  PROTECT                         INPUTRI 2               /*Tanggal Input*/
spktgg                  PROTECT                         INPUTRI 3               /*Activity*/
lketacttmp              PROTECT                         INPUTRI 4               /*Ket Activity*/
spknoasal               PROTECT                         INPUTRI 5               /*VarKpi*/
spktgg2                 PROTECT                         INPUTRI 6               /*NIP PDCA*/
lpdcatmp                PROTECT                         INPUTRI 7               /*Nama PDCA*/
spktgg3                 PROTECT                         INPUTRI 8               /*NIP PIC*/
lpictmp                 PROTECT                         INPUTRI 9               /*Nama PIC*/
spktgg4                 PROTECT                         INPUTRI 10              /*NIP Head*/
lheadpdcatmp            PROTECT                         INPUTRI 11              /*Nama Head*/
spkkat                  NOCHANGE                        INPUTRI 12              /*Sesuai? YA-TIDAK*/
spkket                  TEXTAREA                        INPUTRI 13              /*Keterangan*/
spkket2                 TEXTAREA                        INPUTRI 14              /*Topik Pembahasan*/
lenter                  NOCHANGE                        INPUTRI 15              /*Enter*/
spkhasil2               NOCHANGE                        INPUTRI 16              /*Approval Head PDCA*/

DEFAULT(tmptranst)
spktgl                  INIT_ADD                        {g_tgltrn}

spkkat                  DFALT_SCAN_BLANKS               YA
                                                        TIDAK

spkhasil2               DFALT_SCAN_BLANKS               ACC
                                                        TACC

EDITS(tmptranst)
e.Mandatory                     spkket          MANDATORY
e.Wajib Isi Topik Pembahasan    spkket2         MANDATORY

e.Validate Activity             spktgg          VALIDATE tbddatkodidx mactivitytmp10 {Pgv_dttabel} {PlSPKPDCA21} {PlACTIVITY}
e.Validate PDCA                 spktgg2         VALIDATE psikodidx    mpsipdcatmp10  0
e.Validate PIC                  spktgg3         VALIDATE psikodidx    mpsipictmp10   0
e.Validate HEAD PDCA            spktgg4         VALIDATE psikodidx    mpsiheadtmp10  0


MAP(mactivitytmp10)
tbdkode                 spktgg          REPLACE
tbdket                  lketacttmp      REPLACE
tbtkettype              spknoasal       REPLACE

MAP(mpsipdcatmp10)
psikode                 spktgg2         REPLACE
psinama                 lpdcatmp        REPLACE

MAP(mpsipictmp10)
psikode                 spktgg3         REPLACE
psinama                 lpictmp         REPLACE

MAP(mpsiheadtmp10)
psikode                 spktgg4         REPLACE
psinama                 lheadpdcatmp    REPLACE

MAP(mdataact10)
lINPACT                 spkdata         REPLACE
lINPACT10	        spktype         REPLACE
tlmnobuk                spknobuk        REPLACE
tlmnobbm                spktgg          REPLACE
tlmuntuk                spktgg2         REPLACE
tlmplg                  spktgg3         REPLACE
tlmbisnis               spktgg4         REPLACE

MAP(mmapkodefoto10)
ckode2                  lspkkode2       DO_CALC
ckode3                  lspkkode3       DO_CALC
lspkkode2               spkkode2        REPLACE
lspkkode3               spkkode3        REPLACE

HOOKS(tmptranst)
BEFORE_INPUT            cur_field=spkkat                DO_MAP SHOW mdataact10
AFTER_INPUT             cur_field=spkkat                DO_MAP SHOW mmapkodefoto10

BEFORE_INPUT            cur_field=spkkat                DO_SKIP_IF clogusrinput
BEFORE_INPUT            cur_field=spkket                DO_SKIP_IF clogusrinput
BEFORE_INPUT            cur_field=spkket2               DO_SKIP_IF clogusrinput
BEFORE_INPUT            cur_field=lenter                DO_SKIP_IF clogusrinput

BEFORE_INPUT            cur_field=spkhasil2             DO_SKIP_IF cloghead

MAP(mupdact10a)
cY                      spkfoto2         DO_CALC
DBCALCS(dupdact10a)
        DBC_COMMAND     UPDATE
        DBC_TARGET      spkprmidx spkprm
        DBC_MAP         mupdact10a

MAP(mupdact10b)
cY                      spkfoto3         DO_CALC
DBCALCS(dupdact10b)
        DBC_COMMAND     UPDATE
        DBC_TARGET      spkprmidx spkprm
        DBC_MAP         mupdact10b

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_UPLFLD             spknobuk spkkode2  /*upload Pica*/
SFL_DOCUPLFLD          spknobuk spkkode3  /*upload Dokumen Mandatory*/
SFL_UPLFLD_DBCALCS     dupdact10a
SFL_DOCUPLFLD_DBCALCS  dupdact10b
SFL_TARGET
        spkdatbuktyp    lINPACT tlmnobuk lINPACT10

