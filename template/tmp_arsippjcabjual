AFTER_INPUT     cur_keybd=EN    DO_MAP SHOW
                IF cusrbumg1ok mdum
                ELSE HKCURSOR STAY
                HKMSG Bukan BUM
AFTER_INPUT     cur_keybd=EN    DO_MAP SHOW
                IF cusrkwlg1ok mdum
                HKMSG Bukan KAWIL*/

