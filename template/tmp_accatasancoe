ketstr2		NOCHANGE		INPUTRI	6       /*ACC ATASAN*/
ketstr3		ALLCAPS			INPUTRI	7       /*KET ACC ATASAN*/
ketnobuk	PROTECT SCROLL		INPUTRI	8       /*Nobuk*/

CALCS()
cdataatasan     ((tlmytppn == "Y" && ketnama == lSESUAITGT) || (tlmytppn == "T" && ketnama == lTDKSESUAITGT)) && 
                ((tlmsts == "INPG" && (ketstr2 == BLANKS || ketstr2 == "ACC" || ketstr2 == "TACC")) || (tlmsts == "TACC" && ketstr2 == "TACC") || tlmsts == "CLSD")
cacc		ketstr2 == "ACC"
ctacc		ketstr2 == "TACC"
cupdacc		ketstr2 == "ACC" && g_curcmd == 2
csts            tlmsts != "OPEN"

