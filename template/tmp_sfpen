IMAGE(tmptrans)

FIELDS(tmptranst)
psdkode         ALLCAPS 		INPUTRI 1	/*kode sekolah*/
lnamaskl	PROTECT 		INPUTRI 2	/*nama sekolah*/
lalamatskl	TEXTAREA PROTECT 	INPUTRI 3	/*alamat sekolah*/	
lpropskl	PROTECT 		INPUTRI 4	/*propinsi sekolah*/
lkabskl		PROTECT 		INPUTRI 5	/*kab atau kota sekolah*/
lkecskl		PROTECT 		INPUTRI 6	/*kecamatan sekolah*/
lkelskl		PROTECT 		INPUTRI 7	/*kelurahan sekolah*/
lrt		PROTECT 		INPUTRI 8	/*rt*/
lrw		PROTECT 		INPUTRI 9	/*rw*/
lnotlpskl	PROTECT 		INPUTRI 10	/*nomor sekolah*/
psdtot2		ALLCAPS 		INPUTRI 11	/*kelas*/
psdtype2	ALLCAPS 		INPUTRI 12	/*jurusan*/
psdtot3		ALLCAPS 		INPUTRI 13	/*estimasi bulan lulus*/
lketblnlls	PROTECT			INPUTRI	14
psdtot4		ALLCAPS			INPUTRI 15	/*estimasi tahun lulus*/
psdket		ALLCAPS 		INPUTRI 16	/*nama guru PA(Pebimbing akademik)*/
psdstr1		DIGITS	 		INPUTRI 17	/*nomor telpon guru */
psdstr2		ALLCAPS 		INPUTRI 18	/*bidang studi guru*/
psdtot5		ALLCAPS 		INPUTRI 19	/*durasi pkl*/
lketdurasi	PROTECT			INPUTRI	20	
psdstr3		ALLCAPS	 		INPUTRI 21	/*Nama kontak darurat 1*/
psdstr4		DIGITS	 		INPUTRI 22	/*kontak darurat 1*/

DEFAULT(tmptranst)
lalmdata	INIT			ALAMATEDU
psddata 	INIT_ADD		PENDIDIKAN
psdtype		INIT			OK
psdtot3         DFALT_SCAN_BLANKS      	1 "jan"	2 "Feb"  3 "Mar"   4 "Apr"  5 "Mei"  6 "Jun" 
					7 "Jul" 8 "Agus" 9 "Sept" 10 "Okt" 11 "Nov" 12 "Des"
psdtot4         DFALT_SCAN_BLANKS      	2024 2025 2026 2027 2028 2029 2030
psdtot5		DFALT_SCAN_BLANKS	1 "3 BULAN" 2 "6 BULAN" 

CALCS()
cbln1           psdtot3==1      
cbln2           psdtot3==2
cbln3           psdtot3==3      
cbln4           psdtot3==4
cbln5           psdtot3==5      
cbln6           psdtot3==6
cbln7           psdtot3==7      
cbln8           psdtot3==8
cbln9           psdtot3==9      
cbln10          psdtot3==10
cbln11          psdtot3==11     
cbln12          psdtot3==12
cjan            "JANUARI"       
cfeb            "FEBRUARI"
cmar            "MARET"         
capr            "APRIL"
cmei            "MEI"           
cjun            "JUNI"
cjul            "JULI"          
cags            "AGUSTUS"
csep            "SEPTEMBER"     
cokt            "OKTOBER"
cnov            "NOVEMBER"      
cdes            "DESEMBER"
clam1           "3 BULAN"       
clam2           "6 BULAN"
clama1          psdtot5==1      
clama2          psdtot5==2
        
EDITS(tmptranst)
e.Mandatory     psdkode         	MANDATORY
e.Mandatory	lnotlpskl		MANDATORY
e.Mandatory	psdtot2 		MANDATORY
e.Mandatory	psdtype2		MANDATORY
e.Mandatory	psdtot3			MANDATORY
e.Mandatory	psdtot4			MANDATORY
e.Mandatory	psdket 			MANDATORY
e.Mandatory	psdstr1			MANDATORY
e.Mandatory	psdstr2			MANDATORY
e.Mandatory	psdtot5			MANDATORY
e.Mandatory	psdstr3			MANDATORY
e.Mandatory	psdstr4			MANDATORY
e.ValidateProp  psdkode  VALIDATE almdatbukidx   malmSKL salm {Plalmdata}

MAP(malmSKL)
	almnobuk	psdkode		REPLACE
	almnama		lnamaskl        REPLACE
	almjalan	lalamatskl      REPLACE
	almprop		lpropskl        REPLACE
	almkota		lkabskl         REPLACE
	almkec		lkecskl         REPLACE         
	almkel		lkelskl         REPLACE         
	almrt		lrt             REPLACE         
	almrw		lrw             REPLACE         
	almnamprop	lnotlpskl	REPLACE
	cjan            lketblnlls      DO_CALC_IF cbln1
        cfeb            lketblnlls      DO_CALC_IF cbln2
        cmar            lketblnlls      DO_CALC_IF cbln3
        capr            lketblnlls      DO_CALC_IF cbln4
        cmei            lketblnlls      DO_CALC_IF cbln5
        cjun            lketblnlls      DO_CALC_IF cbln6
        cjul            lketblnlls      DO_CALC_IF cbln7
        cags            lketblnlls      DO_CALC_IF cbln8
        csep            lketblnlls      DO_CALC_IF cbln9
        cokt            lketblnlls      DO_CALC_IF cbln10
        cnov            lketblnlls      DO_CALC_IF cbln11
        cdes            lketblnlls      DO_CALC_IF cbln12
	clam1           lketdurasi      DO_CALC_IF clama1
        clam2           lketdurasi      DO_CALC_IF clama2
	
MAP(mdurasipkl)
	clam1		lketdurasi	DO_CALC_IF clama1
	clam2		lketdurasi	DO_CALC_IF clama2

MAP(mbulanlulus)
	cjan		lketblnlls	DO_CALC_IF cbln1
	cfeb		lketblnlls	DO_CALC_IF cbln2
	cmar		lketblnlls	DO_CALC_IF cbln3
	capr		lketblnlls	DO_CALC_IF cbln4
	cmei		lketblnlls	DO_CALC_IF cbln5
	cjun		lketblnlls	DO_CALC_IF cbln6
	cjul		lketblnlls	DO_CALC_IF cbln7
	cags		lketblnlls	DO_CALC_IF cbln8
	csep		lketblnlls	DO_CALC_IF cbln9
	cokt		lketblnlls	DO_CALC_IF cbln10
	cnov		lketblnlls	DO_CALC_IF cbln11
	cdes		lketblnlls	DO_CALC_IF cbln12

HOOKS(tmptranst)
        AFTER_INPUT	cur_field=psdtot3  DO_MAP SHOW mbulanlulus
        AFTER_INPUT	cur_field=psdtot5  DO_MAP SHOW mdurasipkl

