LOCAL
PGM_FIELDS
lurtc		INT2  		2
lKSU		STRING		21
lLOKMOTOR	STRING		21

MAP(mjointldc)
tldnourt        lurtc           REPLACE
DBCALCS(djointldc)
        DBC_COMMAND     JOIN_LAST_SFL
        DBC_TARGET      tldbukurtidx    tlmnobuk
        DBC_MAP         mjointldc

IMAGE(tmptranst)
/------t-------------------t------------------t-------------t------------t------------\
|t.No  |t.Brg              |t.Lok             |t.Jumlah     |t.Latitude  |t.Longitude |
\------.-------------------.------------------.-------------.------------.------------/
IMAGE(tmptrans)
|______|___________________|__________________|_____________|___.________|___.________|

FIELDS(tmptrans)
tldnourt        	PROTECT                 INPUTRI         1
tldnobbm     		ALLCAPS SCROLL		INPUTRI		1
tlddvs    		ALLCAPS SCROLL		INPUTRI		2
tldjml			ALLCAPS SCROLL		INPUTRI		4
tldperdis4      	PROTECT                 INPUTRI         4
tldperdis5      	PROTECT                 INPUTRI         4

DEFAULTS(tmptrans)
tldtglfak		INIT_ADD	{g_tgltrn}
tldplg          	INIT_ADD        {g_usrkode}
tldsts			INIT_ADD	ADD
lKSU			INIT		KSU
lLOKMOTOR		INIT		LOKMOTOR

CALCS()
curtc           lurtc + 1
cjointld0c      djointldc == 0 && g_curcmd == 1
cjointld1c      djointldc == 1 && g_curcmd == 1
cubhksu		g_curcmd == 2
cubhksux	g_curcmd != 2

EDITS(tmptrans)
e.MandatoryBrg		tldnobbm	MANDATORY
e.MandatoryLok		tlddvs		MANDATORY
/*e.MandatoryJml		tldjml		MANDATORY*/
e.ValidateLok           tlddvs          VALIDATE_IF cubhksux	tbddatkodidx mtbd1 stbd {Pgv_dttabel} {Pgv_barang} {Pgv_lokmotor}
e.Dupkey		tlddvs		DUPKEY			tldbukbbmidx {Ptlmnobuk} {Ptldnobbm} {Ptlmcab} 

MAP(mtbd1)
tbdkode         tlddvs          REPLACE


MAP(murtc)
gv_int1         tldnourt        REPLACE_IF cjointld0c
curtc           tldnourt        DO_CALC_IF cjointld1c


HOOKS(tmptrans)
BEFORE_INPUT    cur_field=tldnobbm      DO_MAP SHOW murtc
BEFORE_INPUT    cur_field=tldnobbm      DO_SKIP_IF cubhksu
BEFORE_INPUT    cur_field=tlddvs        DO_SKIP_IF cubhksu

SUBFILE(tmptrans)
SFL_TITLE(tmptranst)
SFL_LINES(10)
SFL_COND cksu
SFL_SELECT      cbknSISTEMa
SFL_TARGET
tldbukurtidx    tlmnobuk   

SFL_MAP
tlmnobuk        tldnobuk        REPLACE
tlmdata         tlddata         REPLACE
tlmcab          tldcab          REPLACE
tlmtype1        tldgrup         REPLACE
g_lat         	tldperdis4      REPLACE
g_lon         	tldperdis5      REPLACE

CALCS()
cplus1e         tlmtotal + 1
cmins1e         tlmtotal - 1
cplus1e2        tlmjml + 1
cmins1e2        tlmjml - 1

MAP(mupdtlmadde)
cplus1e         tlmtotal        DO_CALC
cplus1e2        tlmjml          DO_CALC

MAP(mupdtlmupde)
cmins1e         tlmtotal        DO_CALC
cmins1e2        tlmjml          DO_CALC


SPCALCS(sptrans2adde)
DO_LIB          ap_dbclc(DNAME dupdtlmadde, DCOMMAND UPDATE, DTARGET tlmbukidx tldnobuk, DMAP mupdtlmadde);

SPCALCS(sptrans2upde)
DO_LIB          ap_dbclc(DNAME dupdtlmupde, DCOMMAND UPDATE, DTARGET tlmbukidx tldnobuk, DMAP mupdtlmupde);

POSTING(tmptrans)
        PST_ADDCMD      sptrans2adde
        PST_DELCMD      sptrans2upde


