		IF cnofakok1 mdum
		ELSE HKCURSOR STAY
		HKMSG Faktur Tidak INPG
AFTER_INPUT	cur_field=ppdnomst2		DO_MAP SHOW
		IF cnofakok2 mdum
		ELSE HKCURSOR STAY
		HKMSG Faktur Belum WO / Blm Periode Lelang JTP Blm > 15 Hari
