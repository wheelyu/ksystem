g_fotolon1      svidf7          REPLACE
cok5            sviyt2          DO_CALC_IF cadalonlat5

DBCALCS(dupdsviftpmhok)
        DCOMMAND        UPDATE
        DTARGET         sviprmidx sviprm
        DMAP            mupdsviftpmhok

SPCALCS(spcaluplftpmhok)
dupdsviftpmhok
DO_LIB ap_nxpst(l4461,lm4461det2);

HOOKS(tmptranst)
CLICKED         cur_field=lklikok5       DO_SPCALCS IF csdhupload5 spcaluplftpmhok

CALCS()
