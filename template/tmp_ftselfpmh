MAP(mupdsviftpmh)
cY              sviyt1          DO_CALC
cSYSTIME         svidf8          DO_CALC
g_tgltrn        svitgl2         REPLACE

DBCALCS(dupdsviftpmh)
        DCOMMAND UPDATE
        DTARGET sviprmidx sviprm
        DMAP mupdsviftpmh

CALCS()
cok5             "OK"
cadalonlat5      svidf7!=0 && (g_fotodate1==g_tgltrn || g_grpnam=="RI" || g_grpnam=="IT")
