IMAGE(tmptranst)
/----------t---------t--------------t----------t--------------------------------------------------\
|  t.No    | t.User  | t.TglAwl     |t.TglAkh  |                  t.Ket                           |
\----------.---------.--------------.----------.--------------------------------------------------/

IMAGE(tmptrans)
|__________|_________|______________|__________|__________________________________________________| 

FIELD(tmptrans)
psdnourt        PROTECT SCROLL          INPUTRI 1
psdstr1		PROTECT SCROLL		INPUTRI 2 
psdtgl1         ALLCAPS NOLIMIT {DD-MM-YY}  INPUTRI 3
psdtgl2         ALLCAPS NOLIMIT {DD-MM-YY} INPUTRI 4
psdket          ALLCAPS SCROLL          INPUTRI 10

EDITS(tmptrans)
t.Mandatory	psdtgl1	MANDATORY
t.Mandatory	psdtgl2	MANDATORY
t.Mandatory	psdket 	MANDATORY

CALCS()
ctambah1	ltambah+1
cjoinpsdPT_0	djoinpsdPT==0
cjoinpsdPT_1	djoinpsdPT==1
ckode2		FLD_TO_STRING(psdnourt)+STRIP(lHISTORISPT)

MAP(mnourt2)
c1		psdnourt	DO_CALC_IF cjoinpsdPT_0
ctambah1	psdnourt	DO_CALC_IF cjoinpsdPT_1
g_usrkode	psdstr1		REPLACE

MAP(mkode2)
ckode2		psdtype		DO_CALC

HOOKS(tmptrans)
BEFORE_INPUT	cur_field=psdtgl1	DO_MAP SHOW mnourt2
AFTER_INPUT	cur_field=psdtgl2	DO_MAP SHOW mkode2

SUBFILE(tmptrans)
SFL_LINES(10)
SFL_TITLE(tmptranst)
SFL_TARGET
psddatpsmkod    gv_historisdm hrmnobuk lHISTORISPT 

SFL_MAP
gv_historisdm   psddata REPLACE
hrmnobuk        psdpsmkode      REPLACE
lHISTORISPT	psdkode	REPLACE
