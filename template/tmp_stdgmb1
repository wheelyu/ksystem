cxperluberubah	tldkat == "TIDAK"
cupdateapi	tldlok == "SESUAI"
cxupdateapi	tldlok == "TIDAK_SESUAI"
cdoperubahan	tldkirim == "SUDAH"
cxdoperubahan	tldkirim == "BELUM"
cberhasilubah	tldsat == "BERHASIL"
cxberhasilubah	tldsat == "BELUM"

