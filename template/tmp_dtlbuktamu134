                (btmsts=="138" && (btmsurveyor=="ACC_GAJI" || btmsurveyor=="CETAK_SPK")) ||
                (btmsts=="139" && (btmsurveyor=="FOTO" || btmsurveyor=="REVFOTO" )) ||
                (btmsts=="140" && (btmsurveyor=="ACC_FOTO" || btmsurveyor=="ACC_FOTO_ADH" || btmsurveyor=="SDK_JARI"))

cpilbknmdf      tldnoll!="MD"
