cbkn_hrdx        g_grpnam!="RI" && g_grpnam!="HRDHEAD" && djointbdakshrdheada==0 && djointbdakshrdheadb==0 && g_grpnam!="HRDREC" && g_grpnam!="HRDRECAREA" && g_grpnam!="SPVMPP" && g_grpnam!="HRDSPV" &&
                g_grpnam!="B.IVAROHRD" && g_grpnam!="B.PARTHRD" && g_grpnam!="IT"
cpilvoidbuktam     (tldnoll==gv_VOID && (djointbddtlbuktamuvoid == 1 || g_grpnam == "IT")) || tldnoll!=gv_VOID
cpilmdbuktam     (tldnoll==lMD && (djointbddtlbuktamumd == 1 || g_grpnam == "IT" || g_grpnam == "RI")) || tldnoll!=lMD
cpilnrbuktam     (tldnoll==lNORESPON && (djointbddtlbuktamunr == 1 || g_grpnam == "IT")) || tldnoll!=lNORESPON
cpilbfra	(tldnoll=="BFRA" && (g_grpnam == "HRDHEAD" || g_grpnam == "SUPPORT" || g_grpnam == "RI")) || tldnoll!="BFRA"

