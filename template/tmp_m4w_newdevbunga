IMAGE(tmptrans)

FIELDS(tmptranst)
        svinobuk        PROTECT QPROTECT UNSEEN   INPUTRI 1
        svikode         PROTECT QPROTECT UNSEEN   INPUTRI 2
        svists          PROTECT                   INPUTRI 3 
        svistr5         PROTECT                   INPUTRI 4
        svidtmkode      NOCHANGE QPROTECT UNSEEN  INPUTRI 5
        svidf1          PROTECT                   INPUTRI 6
        svidf2          ALLCAPS                   INPUTRI 7
        svidf6          PROTECT                   INPUTRI 8
        svidf3          PROTECT                   INPUTRI 9
        svidf5          PROTECT                   INPUTRI 10
        svidf4          PROTECT                   INPUTRI 11
        lketisi         TEXTAREA 2 ALLCAPS         INPUTRI 12
        lketisi2        TEXTAREA 2 ALLCAPS         INPUTRI 13
        svistr1         PROTECT                   INPUTRI 14
        svitgl1         PROTECT {DD-MM-YYYY}      INPUTRI 15
        svinobuk        PROTECT QPROTECT UNSEEN   INPUTRI 16
        svitblkode      PROTECT QPROTECT UNSEEN   INPUTRI 17
        lupld           TOMBOL                    INPUTRI 18
        svistr33        ALLCAPS                   INPUTRI 19
        svistr7         TEXTAREA 2 ALLCAPS        INPUTRI 20
        lketisi2        NOCHANGE                  INPUTRI 21

CALCS()
cOK             "OK"
c0               0
cbts17           svidf2 <= 17
crate            svidf1 - svidf2
cadaket0         djoinket == 0 
cadaket1         djoinket == 1 && g_curcmd != 1
cadaket1b        djoinket == 1 && g_curcmd == 2 
crmok2           svistr33 == "Y" && g_grpnam == "B.M4WRM" 
crmT2            svistr33 == "T" && g_grpnam == "B.M4WRM" 
cinpgd           svists == "INPG"      
copend           svists == "OPEN" || svists == BLANKS 

EDITS(tmptranst)
e.stsbukan707     svikode         VALIDATE ftmdatbukidx mftm2 sftm6 {PlMULTI4W}
e.isiajuanrate    svidf2          MANDATORY
e.isiket          lketisi         MANDATORY
e.isiaccrm        svistr33        MANDATORY_IF cinpgd  
e.isiket          svistr7         MANDATORY_IF crmT
e.ket             svitblkode      VALIDATE ketdatbukkod mket  0     {Psvidata} {Psvinobuk}

DEFAULTS(tmptranst)
svistr33           DFALT_SCAN_BLANKS Y T

MAP(mket)
lketisi         ketisi            REPLACE_IF cadaket1b
cBLANKS         lketisi           DO_CALC
ketisi          lketisi           REPLACE
lketisi2        ketisi2           REPLACE_IF cadaket1b
cBLANKS         lketisi2          DO_CALC
ketisi2         lketisi2          REPLACE


MAP(mftm2)
ftmsubtot2        svidf1          REPLACE
ftmtahun          svidf3          REPLACE
ftmjml2           svidf5          REPLACE
svidf5            ltenor          REPLACE
ftmsubtot3        svidf4          REPLACE
crate             svidf6          DO_CALC

MAP(mupdsviftmandx)
cIN             svistr1         DO_CALC_IF cksong2
g_tgltrn        svitgl1         REPLACE
gv_INPG         svists          REPLACE_IF cinpg 

MAP(mapr)
gv_OPEN         svists          REPLACE_IF cksong            
cOKRM           svistr34        DO_CALC_IF crmok
ctKRM           svistr34        DO_CALC_IF crmT 
gv_TACC         svists          REPLACE_IF crmT

MAP(mmapmap1a) 
ldum            ldum              REPLACE
svinourt        lurt              REPLACE
ckuncidev1      lkunci2           DO_CALC

MAP(maddket)
svinobuk        ketnobuk          REPLACE
svidata         ketdata           REPLACE
svitype         ketkode           REPLACE
lketisi         ketisi            REPLACE_IF cadaket0
lketisi2        ketisi2           REPLACE_IF cadaket0


MAP(mupdsvi)
lketisi         ketisi            REPLACE_IF cadaket1b
cBLANKS         lketisi           DO_CALC
ketisi          lketisi           REPLACE
lketisi2        ketisi2           REPLACE_IF cadaket1b
cBLANKS         lketisi2          DO_CALC
ketisi2         lketisi2          REPLACE

MAP(mupload)
g_tgltrn        svitgl1         REPLACE_IF cuplok
cOK             svistr1         DO_CALC_IF cuplok

MAP(mkuncirm)
gv_CLSD         abksts           REPLACE_IF cnipsama

MAP(mkuncirm2)
gv_CLSD         abksts           REPLACE


SPCALCS(saddket)
DO_LIB                 ap_dbclc(DNAME dmapmap1a,DCOMMAND MAPMAP,DMAP mmapmap1a);
DO_LIB_IF cadaket0     ap_dbclc(DNAME dket,DCOMMAND ADD,DFILE ket,DMAP maddket);
DO_LIB_IF cadaket1     ap_dbclc(DNAME dupdsvi,DCOMMAND UPDATE_RANGE,DTARGET ketdatbukkod svidata svinobuk svitblkode,DMAP mupdsvi);

SPCALCS(sdelket)
DO_LIB_IF cadaket1     ap_dbclc(DNAME ddelket,DCOMMAND DELETE,DTARGET ketdatbukkod svidata svinobuk svitblkode);

SPCALCS(suploadd)
DO_LIB                 ap_dbclc(DNAME dmapupl,DCOMMAND MAPMAP,DMAP mmapmap1a);
DO_LIB_IF crm          ap_dbclc(DNAME ddevb,DCOMMAND ADD,DFILE abk,DMAP madddevrm);
DO_LIB                 ap_dbclc(DNAME duploadd,DCOMMAND UPDATE,DTARGET sviprmidx sviprm,DMAP mupload);

SPCALCS(sbkkunci)
DO_LIB                 ap_dbclc(DNAME dmapmaprm,DCOMMAND MAPMAP,DMAP mmapmap1a);
DO_LIB_IF cdvh         ap_dbclc(DNAME ddeve,DCOMMAND ADD,DFILE abk,DMAP madddevdvh);
DO_LIB_IF crmok2       ap_dbclc(DNAME dupdrmok,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lkunci2 l643,DMAP mkuncirm);
DO_LIB_IF crmT2        ap_dbclc(DNAME dupdrmT,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lkunci2 l643,DMAP mkuncirm2);


HOOKS(tmptranst)
CLICKED         cur_field=lupld         DO_SPCALCS suploadd
AFTER_INPUT     cur_keybd=EN            DO_MAP SHOW mapr      
AFTER_INPUT     cur_keybd=EN            DO_SPCALCS sbkkunci
AFTER_INPUT     cur_field=svidf2        DO_MAP
                IF cbts17  mdum
                ELSE HKCURSOR STAY
                HKMSG melebihi batas
AFTER_INPUT     cur_field=lketisi       DO_MAP SHOW mketcab 
AFTER_INPUT     cur_field=lketisi       DO_MAP
                IF ccabisi mdum
                ELSE HKCURSOR STAY
                HKMSG harus 200 karabker
BEFORE_INPUT    cur_field=svistr33      DO_SKIP_IF copend   
BEFORE_INPUT    cur_field=svistr7       DO_SKIP_IF copend    
BEFORE_INPUT    cur_field=svidf2        DO_SKIP_IF cinpgd  
BEFORE_INPUT    cur_field=lketisi       DO_SKIP_IF cinpgd  
BEFORE_INPUT    cur_field=lketisi2      DO_SKIP_IF cinpgd  




DBCALCS(dbftupl)
        DCOMMAND UPDATE
        DTARGET sviprmidx sviprm
        DMAP mupdsviftmandx

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_UPLFLD_DBCALCS dbftupl
SFL_UPLFLD tlmnobuk     svitype
SFL_UPL_DELCOND c0
SFL_UPL_DIRFLD tlmtgl
SFL_SELECT   ckodedev
SFL_TARGET
        svidatbuktyp   tlmdata   tlmnobuk     
SFL_MAP
tlmnobuk        svinobuk        REPLACE
tlmuntuk        svidtmkode      REPLACE
tlmnoasal       svikode         REPLACE
tlmdata         svidata         REPLACE
tmpkode         svitype         REPLACE
tmpnourt        svinourt        REPLACE
tmpkode         svitblkode      REPLACE

POSTING(tmptrans)
        PST_ADDCMD saddket   
        PST_UPDCMD saddket   
        PST_DELCMD sdelket   


PERMIT(tmptrans)
  PMT_ADD_COND  cdjoindevslik
  PMT_UPDALL_COND  cdevopen
  PMT_DEL_COND  cdevopen 
