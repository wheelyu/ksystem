lh2		STRING	21
ldcoohmc	STRING	21
lthbl21         STRING  21
lniphmc		STRING	21
lkawil          STRING  21
lnipkawil       STRING  21
lheadhass	STRING	21
lnipheadahass	STRING	21
lnipSPVahass	STRING	21
lspvahass	STRING	21
lnipGAhead	STRING	21
lgahead		STRING	21



IMAGE(tmptranst)
