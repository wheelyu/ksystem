SPCALCS(spaddtmptrans)
DO_LIB ap_dbclc(DNAME daddbtmdgi,DCOMMAND UPDATE,DTARGET btmbukidx almnobuk,DMAP mupdbtmPemdgi);
DO_LIB  ap_dbclc(DNAME daddmntdgi,DCOMMAND ADD,DFILE mnt,DMAP maddmnt3dgi);

SPCALCS(spupdtmptrans)
DO_LIB ap_dbclc(DNAME dupdbtmdgi,DCOMMAND UPDATE,DTARGET btmbukidx almnobuk,DMAP mupdbtmPemdgi);

SPCALCS(spdeltmptrans)
DO_LIB ap_dbclc(DNAME ddelbtmdgi,DCOMMAND UPDATE,DTARGET btmbukidx almnobuk,DMAP mdelbtmPemdgi);

POSTING(tmptrans)
