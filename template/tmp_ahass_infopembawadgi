HOOKS(tmptranst)
BEFORE_INPUT	cur_field=almutama   DO_SKIP_IF cPMK1
BEFORE_INPUT	cur_field=almlat     DO_SKIP_IF cPemilik
BEFORE_INPUT    cur_field=almnama2   DO_SKIP_IF cPemilik
BEFORE_INPUT    cur_field=almjalan   DO_SKIP_IF cPemilik
BEFORE_INPUT    cur_field=almprop    DO_SKIP_IF cPemilik
BEFORE_INPUT    cur_field=almkota    DO_SKIP_IF cPemilik
BEFORE_INPUT    cur_field=almkec     DO_SKIP_IF cPemilik
BEFORE_INPUT    cur_field=almkel     DO_SKIP_IF cPemilik
