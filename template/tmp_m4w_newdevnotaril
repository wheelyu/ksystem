IMAGE(tmptrans)

FIELDS(tmptranst)
        svists          PROTECT                   INPUTRI 1
        svistr5         PROTECT                   INPUTRI 1
        svikode         PROTECT  QPROTECT UNSEEN  INPUTRI 1
        svistr2         NOCHANGE                  INPUTRI 2
        svidf1          ALLCAPS                   INPUTRI 2
        lketisik        TEXTAREA 2 ALLCAPS         INPUTRI 2
        lketisi2k       TEXTAREA 2 ALLCAPS         INPUTRI 2
        svistr1         NOCHANGE                  INPUTRI 3
        svitgl1         PROTECT {DD-MM-YYYY}      INPUTRI 4
        svinobuk        PROTECT UNSEEN            INPUTRI 5
        svitblkode      PROTECT UNSEEN            INPUTRI 5
        lupld11         TOMBOL                    INPUTRI 1
        svistr33        ALLCAPS                   INPUTRI 6
        svistr7         TEXTAREA 2 ALLCAPS        INPUTRI 20
        lketisi2        NOCHANGE                  INPUTRI 21

 
DEFAULTS(tmptranst)
svistr4 DFALT_SCAN BLANKS YA TIDAK
svistr33           DFALT_SCAN_BLANKS Y T

EDITS(tmptranst)
e.stsbukan707     svikode         VALIDATE ftmdatbukidx mftm7 sftm6 {PlMULTI4W}
e.isintf          svidf1          MANDATORY 
e.ket             svitblkode      VALIDATE ketdatbukkod mket11  0     {Psvidata} {Psvinobuk}
e.isiaccrm        svistr33        MANDATORY_IF cinpgd
e.isiket          svistr7         MANDATORY_IF crmT


MAP(mket11)
lketisik         ketisi            REPLACE_IF cadaket1b
cBLANKS         lketisik           DO_CALC
ketisi          lketisik           REPLACE
lketisi2k        ketisi2            REPLACE_IF cadaket1b
cBLANKS         lketisi2k           DO_CALC
ketisi2         lketisi2k          REPLACE


MAP(mftm7)
ftmkode7        svistr2         REPLACE

MAP(maddket11)
svinobuk        ketnobuk          REPLACE
svidata         ketdata           REPLACE
svitype         ketkode           REPLACE
lketisik         ketisi            REPLACE_IF cadaket0
lketisi2k        ketisi2           REPLACE_IF cadaket0

MAP(mupdsvi11)
lketisik        ketisi            REPLACE_IF cadaket1b
cBLANKS         lketisik          DO_CALC
ketisi          lketisik          REPLACE
lketisi2k       ketisi2            REPLACE_IF cadaket1b
cBLANKS         lketisi2k          DO_CALC
ketisi2         lketisi2k          REPLACE



MAP(mupdsviftmandx11)
cIN             svistr1         DO_CALC_IF cksong2
g_tgltrn        svitgl1         REPLACE
gv_INPG         svists          REPLACE_IF cinpg


DBCALCS(dbftupl11)
        DCOMMAND UPDATE
        DTARGET sviprmidx sviprm
        DMAP mupdsviftmandx11

MAP(maprnotaril)
gv_OPEN         svists          REPLACE_IF cksong
cOKRM           svistr34        DO_CALC_IF crmok
ctKRM           svistr34        DO_CALC_IF crmT
gv_TACC         svists          REPLACE_IF crmT

MAP(mupload11)
g_tgltrn        svitgl1         REPLACE_IF cuplok
cOK             svistr1         DO_CALC_IF cuplok

MAP(mmapmap11a)
ldum            ldum              REPLACE
svinourt        lurt              REPLACE
ckuncidev1      lkunci2           DO_CALC

MAP(mkuncirm11)
gv_CLSD         abksts            REPLACE_IF cnipsama

MAP(mkuncirm211)
gv_CLSD         abksts            REPLACE



SPCALCS(saddket11)
DO_LIB                 ap_dbclc(DNAME dmapmap11a,DCOMMAND MAPMAP,DMAP mmapmap11a);
DO_LIB_IF cadaket0     ap_dbclc(DNAME dket11,DCOMMAND ADD,DFILE ket,DMAP maddket11);
DO_LIB_IF cadaket1     ap_dbclc(DNAME dupdsvi11,DCOMMAND UPDATE,DTARGET ketdatbukkod svidata svinobuk svitblkode,DMAP mupdsvi11);

SPCALCS(sdelket11)
DO_LIB_IF cadaket1     ap_dbclc(DNAME ddelket11,DCOMMAND DELETE,DTARGET ketdatbukkod svidata svinobuk svitblkode);                                 
SPCALCS(suploadd11)
DO_LIB                 ap_dbclc(DNAME dmapupl11,DCOMMAND MAPMAP,DMAP mmapmap11a);
DO_LIB_IF crm          ap_dbclc(DNAME ddevb11,DCOMMAND ADD,DFILE abk,DMAP madddevrm);
DO_LIB                 ap_dbclc(DNAME dupload11d,DCOMMAND UPDATE,DTARGET sviprmidx sviprm,DMAP mupload11);

SPCALCS(sbkkunci11)
DO_LIB                 ap_dbclc(DNAME dmapmaprm11,DCOMMAND MAPMAP,DMAP mmapmap1a);
DO_LIB_IF crmok2       ap_dbclc(DNAME dupdrmok11,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lkunci2 l643,DMAP mkuncirm11);
DO_LIB_IF crmT2        ap_dbclc(DNAME dupdrmT11,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lkunci2 l643,DMAP mkuncirm211);
DO_LIB_IF cdvh         ap_dbclc(DNAME ddevd11,DCOMMAND ADD,DFILE abk,DMAP madddevdvh);


HOOKS(tmptranst)
CLICKED         cur_field=lupld11       DO_SPCALCS suploadd11
AFTER_INPUT     cur_keybd=EN            DO_MAP SHOW maprnotaril
AFTER_INPUT     cur_keybd=EN            DO_SPCALCS sbkkunci11
AFTER_INPUT     cur_field=lketisik      DO_MAP SHOW mketcab
AFTER_INPUT     cur_field=lketisik      DO_MAP
                IF ccabisik mdum
                ELSE HKCURSOR STAY
                HKMSG harus 200 karabker
BEFORE_INPUT    cur_field=svistr33      DO_SKIP_IF copend
BEFORE_INPUT    cur_field=svistr7       DO_SKIP_IF copend
BEFORE_INPUT    cur_field=svidf1        DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=svistr2       DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=svistr1       DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=lketisik      DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=lketisi2k     DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=svistr1       DO_SKIP_IF cinpgd


