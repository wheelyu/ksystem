IMAGE(tmptrans)

FIELD(tmptranst)
nhdkode			PROTECT	SCROLL			INPUTRI	1
nhdnobbm		NOCHANGE SCROLL			INPUTRI	1
nhdhrg1			PROTECT	SCROLL			INPUTRI	3
nhdtgl			NOLIMIT {DD-MM-YY}		INPUTRI	3

DEFAULT(tmptranst)
nhdnobbm	DFALT_SCAN 	BLANKS 
				HIDUP 
				MATI

CALCS()
cisiSTNK	nhdkode=="STNK"
cpajakstnk	nhdkode=="PAJAKSTNK"
ctotalsurat	ltotalsurat + ltotalsurat2

EDITS(tmptranst)
e.Validate1 nhdkode	VALIDATE tbtdattypkod  mtbt3 stbt {Pgv_dttabel} {Pgv_dttabel21} {Pgv_estimasi21} {Plsurat}  {Slsegmen}
/*e.validate nhdnobbm     VALIDATE tbddatkodidx mtbd4 stbd {Pgv_dttabel} {Pgv_estimasi21} {PlTARIK}*/
e.Mandatory     nhdnobbm  MANDATORY
e.Mandatory	nhdtgl	MANDATORY_IF cpajakstnk

/*MAP(mtbd4)
tbdkode		nhdnobbm	REPLACE*/

MAP(mtbt3)
tbttbdkode      nhdkode		REPLACE
tbttot  	nhdhrg1		REPLACE_IF cmati  
ckosong		nhdhrg1		DO_CALC_IF chidup  

HOOKS(tmptranst)
BEFORE_INPUT	cur_field=nhdtgl	DO_SKIP_IF cisiSTNK

SUBFILE(tmptrans)
SFL_LINES(5)        
SFL_TITLE(tmptranst)
SFL_SELECT cbagianpart
SFL_SHOW_NEXT
SFL_TARGET
nhdbukidx   tlmnobuk gv_estimasi 


/*--------Update Ke Master Perhitungan-----------*/
MAP(mmapmap4)
nhdkode         lnhdkode        REPLACE
nhdhrg1         ltotalestimasi2 REPLACE
nhdhrg1         ltotalsurat2    REPLACE
ltotalestimasi	ltotalestimasi	REPLACE_IF cscannhd
ltotalsurat	ltotalsurat	REPLACE_IF cscannhd
ctotalsurat     ltotalsurat     DO_CALC
ctotalestimasi  ltotalestimasi  DO_CALC


MAP(mupdtlm4)
ltotalestimasi	tlmjml		REPLACE
ltotalsurat	tlmperdis	REPLACE
cnilaiper       tlmtotal        DO_CALC
cpersenest      tlmperdisd      DO_CALC_IF clbrcdf2ada

SPCALCS(sptmptrans)
DO_LIB ap_dbclc(DNAME dmapmap4,DCOMMAND MAPMAP,DMAP mmapmap4);
DO_LIB ap_dbclc(DNAME dupdtlm4,DCOMMAND UPDATE,DTARGET tlmbukidx nhdnobuk,DMAP mupdtlm4);

POSTING(tmptrans)
PST_UPDCMD sptmptrans
