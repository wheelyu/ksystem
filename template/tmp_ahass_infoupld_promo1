cdf5t		aktdf5 == 2
cya		"YA"
ctdk1		"TIDAK"
cBLANK		BLANKS

cpanjangnip     DO_LIB ap_strln(aktcrtusr,&lpanjangnip);
cpanjangket     DO_LIB ap_strln(aktket,&lpanjangket);
cnippsi         ((aktcrtusr != BLANKS && ldigit1 == "P" && lpanjangnip >= 7 && lpanjangnip <= 8) || (aktcrtusr != BLANKS && lpanjangnip >= 7 && lpanjangnip <= 8) || (aktcrtusr == BLANKS))
