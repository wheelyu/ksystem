cnotwahana	(djointbt_cabtdkref == 0 && (djointbt_cabdptref1 == 1 || djointbt_cabdptref2 == 1))
cnotwahana1	(djointbt_cabtdkref == 0 && (djointbt_cabdptref1 == 1 || djointbt_cabdptref2 == 1) && aktdf5 == 1)
