IMAGE(tmptrans)

FIELDS(tmptranst)
        svists          PROTECT                   INPUTRI 1
        svistr5         PROTECT                   INPUTRI 1
        svikode         PROTECT QPROTECT UNSEEN   INPUTRI 1
        svidf1          PROTECT QPROTECT UNSEEN   INPUTRI 1
        svistr2         ALLCAPS                   INPUTRI 1
        svistr3         ALLCAPS                   INPUTRI 2
        lketisim        TEXTAREA 2 ALLCAPS         INPUTRI 2
        lketisi2m       TEXTAREA 2 ALLCAPS         INPUTRI 2
        svistr1         NOCHANGE                  INPUTRI 3
        svitgl1         PROTECT {DD-MM-YYYY}      INPUTRI 4
        svinobuk        PROTECT UNSEEN            INPUTRI 5
        svitblkode      PROTECT UNSEEN            INPUTRI 5
        lupld13         TOMBOL                    INPUTRI 1
        svistr33        ALLCAPS                   INPUTRI 6
        svistr7         TEXTAREA 2 ALLCAPS        INPUTRI 20
        lketisi2        NOCHANGE                  INPUTRI 21



EDITS(tmptranst)
e.isicabsurveyaju svistr3         MANDATORY
e.ket             svitblkode      VALIDATE ketdatbukkod mket13  0     {Psvidata} {Psvinobuk}
e.isiaccrm        svistr33        MANDATORY_IF cinpgd
e.isiket          svistr7         MANDATORY_IF crmT


DEFAULTS(tmptranst)
svistr33           DFALT_SCAN_BLANKS Y T


MAP(mket13)
lketisim         ketisi            REPLACE_IF cadaket1b
cBLANKS         lketisim           DO_CALC
ketisi          lketisim           REPLACE
lketisi2m        ketisi2           REPLACE_IF cadaket1b
cBLANKS         lketisi2m          DO_CALC
ketisi2         lketisi2m          REPLACE




MAP(mupdsviftmandx13)
cIN             svistr1         DO_CALC_IF cksong2
g_tgltrn        svitgl1         REPLACE
gv_INPG         svists          REPLACE_IF cinpg


MAP(maddket13)
svinobuk        ketnobuk          REPLACE
svidata         ketdata           REPLACE
svitype         ketkode           REPLACE
lketisim        ketisi            REPLACE_IF cadaket0
lketisi2m       ketisi2           REPLACE_IF cadaket0

MAP(mupdsvi13)
lketisim        ketisi            REPLACE_IF cadaket1b
cBLANKS         lketisim          DO_CALC
ketisi          lketisim          REPLACE
lketisi2m       ketisi2            REPLACE_IF cadaket1b
cBLANKS         lketisi2m          DO_CALC
ketisi2         lketisi2m          REPLACE


MAP(mupload13)
g_tgltrn        svitgl1         REPLACE_IF cuplok
cOK             svistr1         DO_CALC_IF cuplok

MAP(mkuncirm13)
gv_CLSD         abksts             REPLACE_IF cnipsama

MAP(mkuncirm213)
gv_CLSD         abksts             REPLACE


DBCALCS(dbftupl13)
        DCOMMAND UPDATE
        DTARGET sviprmidx sviprm
        DMAP mupdsviftmandx13


MAP(mmapmap13a)
ldum            ldum              REPLACE
svinourt        lurt              REPLACE
ckuncidev1      lkunci2           DO_CALC

SPCALCS(saddket13)
DO_LIB                 ap_dbclc(DNAME dmapmap13a,DCOMMAND MAPMAP,DMAP mmapmap13a);
DO_LIB_IF cadaket0     ap_dbclc(DNAME dket13,DCOMMAND ADD,DFILE ket,DMAP maddket13);
DO_LIB_IF cadaket1     ap_dbclc(DNAME dupdsvi13,DCOMMAND UPDATE,DTARGET ketdatbukkod svidata svinobuk svitblkode,DMAP mupdsvi13);

SPCALCS(sdelket13)
DO_LIB_IF cadaket1     ap_dbclc(DNAME ddelket13,DCOMMAND DELETE,DTARGET ketdatbukkod svidata svinobuk svitblkode);

MAP(mapr13)
gv_OPEN         svists          REPLACE_IF cksong
cOKRM           svistr34        DO_CALC_IF crmok
ctKRM           svistr34        DO_CALC_IF crmT
gv_TACC         svists          REPLACE_IF crmT


SPCALCS(suploadd13)
DO_LIB                 ap_dbclc(DNAME dmapupl13,DCOMMAND MAPMAP,DMAP mmapmap13a);
DO_LIB_IF crm          ap_dbclc(DNAME ddevb13,DCOMMAND ADD,DFILE abk,DMAP madddevrm);
DO_LIB                 ap_dbclc(DNAME dupload13d,DCOMMAND UPDATE,DTARGET sviprmidx sviprm,DMAP mupload13);

SPCALCS(sbkkunci13)
DO_LIB                 ap_dbclc(DNAME dmapmaprm13,DCOMMAND MAPMAP,DMAP mmapmap1a);
DO_LIB_IF crmok2       ap_dbclc(DNAME dupdrmok13,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lkunci2 l643,DMAP mkuncirm13);
DO_LIB_IF crmT2        ap_dbclc(DNAME dupdrmT13,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lkunci2 l643,DMAP mkuncirm213);
DO_LIB_IF cdvh         ap_dbclc(DNAME ddevc13,DCOMMAND ADD,DFILE abk,DMAP madddevdvh);
DO_LIB_IF cram         ap_dbclc(DNAME ddevd13,DCOMMAND ADD,DFILE abk,DMAP madddevram);


HOOKS(tmptranst)
CLICKED         cur_field=lupld13       DO_SPCALCS suploadd13
AFTER_INPUT     cur_keybd=EN     DO_MAP SHOW mapr13
AFTER_INPUT     cur_keybd=EN            DO_SPCALCS sbkkunci13
AFTER_INPUT     cur_field=lketisim       DO_MAP SHOW mketcab
AFTER_INPUT     cur_field=lketisim        DO_MAP
                IF ccabisim mdum
                ELSE HKCURSOR STAY
                HKMSG harus 200 karakter
BEFORE_INPUT    cur_field=svistr33      DO_SKIP_IF copend
BEFORE_INPUT    cur_field=svistr7       DO_SKIP_IF copend
BEFORE_INPUT    cur_field=svistr2       DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=svistr3       DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=lketisim      DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=lketisi2m     DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=svistr1       DO_SKIP_IF cinpgd


