e.isiket          sviket         MANDATORY_IF cT
e.stsbukan707     svikode        VALIDATE ftmdatbukidx mftm4b sftm6 {PlMULTI4W}

MAP(mftm4b)
ftmnofak          svikode         REPLACE
ltglcm            ltglcm          REPLACE_IF cjoinaktcm
ljamcm            ljamcm          REPLACE_IF cjoinaktcm


MAP(mmapmap4)
ldum            ldum              REPLACE
svinourt        lurut             REPLACE
cnobukabk       lkunci            DO_CALC

MAP(mkunci4)
gv_CLSD         abksts            REPLACE

MAP(maddakt4)
svidata         aktdata         REPLACE
svitype         akttype        REPLACE
svinobuk        aktkode         REPLACE
svinobuk        aktnobuk        REPLACE
g_usrkode       aktkode2        REPLACE
g_tgltrn        akttgl          REPLACE
cSYSTIME        aktjam          DO_CALC
g_grpnam        aktlok          REPLACE


SPCALCS(supdabk4)
DO_LIB                 ap_dbclc(DNAME dmapmap4,DCOMMAND MAPMAP,DMAP mmapmap4);
DO_LIB                 ap_dbclc(DNAME dakt4,DCOMMAND ADD,DFILE akt,DMAP maddakt4);
DO_LIB_IF cbkunci      ap_dbclc(DNAME daddkunc4,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lkunci l643,DMAP mkunci4);
DO_LIB_IF cbkunci2     ap_dbclc(DNAME dupdkunc4a,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lkunci l643,DMAP mkunci4);


HOOKS(tmptranst)
AFTER_INPUT     cur_keybd=EN            DO_MAP SHOW mapra4
AFTER_INPUT     cur_keybd=EN            DO_SPCALCS supdabk4
BEFORE_INPUT    cur_field=sviyt1        DO_SKIP_IF cbknCR
BEFORE_INPUT    cur_field=sviket        DO_SKIP_IF cbknCR
AFTER_INPUT     cur_field=sviket        DO_MAP SHOW mlenket
AFTER_INPUT     cur_field=sviket        DO_MAP
                IF cisiket mdum
                ELSE HKCURSOR STAY
                HKMSG isi 20 karakter


MAP(mupdsviftmandx4)
cOK             svistr1         DO_CALC
g_tgltrn        svitgl1         REPLACE

DBCALCS(dbftupl4)
        DCOMMAND UPDATE
        DTARGET sviprmidx sviprm
        DMAP mupdsviftmandx4

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
