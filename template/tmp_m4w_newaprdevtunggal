IMAGE(tmptrans)

FIELDS(tmptranst)
        svists          PROTECT                   INPUTRI 1
        svistr5         PROTECT                   INPUTRI 1
        svinobuk        PROTECT QPROTECT UNSEEN   INPUTRI 1
        svikode         PROTECT QPROTECT UNSEEN   INPUTRI 1
        svistr2         PROTECT                   INPUTRI 2
        svistr1         PROTECT                   INPUTRI 3
        svitgl1         PROTECT {DD-MM-YYYY}      INPUTRI 4
        svinobuk        PROTECT UNSEEN            INPUTRI 5
        sviyt1          ALLCAPS                   INPUTRI 5
        sviket          TEXTAREA ALLCAPS          INPUTRI 6
        lok             NOCHANGE                  INPUTRI 7
        ltglcm          PROTECT {DD-MM-YYYY}      INPUTRI 7
        ljamcm          PROTECT                   INPUTRI 7

 
CALCS()
ckodetunggal1      svitype == "DEVTUNGGAL"

DEFAULTS(tmptranst)
