LOCAL
PGM_FIELDS

l719		STRING          5
lh1	      	STRING	     	21
lnamakonsumen 	STRING	     	21
luangmuka	DFLOAT		8
langsuran	DFLOAT		8
ltenor		DFLOAT		8
lstok		INT2		2

/*----------JOIN--------*/

MAP(mpsmkonsumen)
psmnama    lnamakonsumen     REPLACE

DBCALCS(djoinpsmkonsumen)
DBC_COMMAND     JOIN
DBC_TARGET      psmktpidx btmplg
DBC_MAP         mpsmkonsumen

MAP(mnhmrincih1)
nhmumriil    luangmuka     REPLACE
nhmbsrang    langsuran	   REPLACE
nhmtenor     ltenor	   REPLACE

DBCALCS(djoinnhmh1)
DBC_COMMAND     JOIN
DBC_TARGET      nhmdatbukidx	gv_dtbukutamu btmnobuk
DBC_MAP         mnhmrincih1

/*------------------Menghitung Jumlah Stok-----------------------*/
MAP(mbrd)
brdsisa     lstok       REPLACE

DBCALCS(dscanbrd)
    DBC_COMMAND     SCANSCAN
    DBC_TARGET      brdstscabbrg    gv_INPG btmcabjl btmtypmtr
    DBC_SUM_MAP     mbrd


IMAGE(tmptranst)
