curutrekomca		lurut_rekomca + 1
curutrekomca1		1
crekom			svistr1 == "REKOMEN"

MAP(murut_rekomca)
curutrekomca1		svinourt		DO_CALC_IF crekomca0
curutrekomca		svinourt		DO_CALC_IF crekomca1

HOOKS(tmptranst)
AFTER_INPUT		cur_keybd=EN 		DO_MAP SHOW murut_rekomca
BEFORE_INPUT		cur_field=svistr3	DO_SKIP_IF crekom
BEFORE_INPUT		cur_field=sviket	DO_SKIP_IF crekomen

SUBFILE(tmptrans)
SFL_LINES(1)       
SFL_TITLE(tmptranst)
SFL_COND	csdmho
SFL_TARGET
	svidatbuktyp   ldtca btmnobuk gv_rekomca

SFL_MAP
ldtca			svidata			REPLACE
btmnobuk		svinobuk		REPLACE
gv_rekomca		svitype			REPLACE


MAP(mupdbtmrekomen)
svistr1			btmrekomen		REPLACE


SPCALCS(stmptrans)
	DO_LIB		ap_dbclc(DNAME dupdbtmrekomen,DCOMMAND UPDATE,DTARGET btmprmidx btmprm,DMAP mupdbtmrekomen);

POSTING(tmptrans)
	PST_ADDCMD	stmptrans

CALCS()
cupd_rekomca		btmsts == "668" && (g_grpnam == "B.M4WCA" || g_grpnam == "RI" || g_grpnam == "B.M4WCM")
