MAP(mupdsvirmhdpn)
cY              sviyt1          DO_CALC
cSYSTIME	svidf8		DO_CALC
g_tgltrn	svitgl2		REPLACE

DBCALCS(dupdsvirmhdpn)
        DCOMMAND UPDATE
        DTARGET sviprmidx sviprm
        DMAP mupdsvirmhdpn

CALCS()
cok             "OK"
cadalonlat      svidf7!=0 && (g_fotodate1==g_tgltrn || g_grpnam=="RI" || g_grpnam=="IT")
