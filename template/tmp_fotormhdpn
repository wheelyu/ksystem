MAP(mupdsvirmhdpnok)
g_fotolat1      svidf6          REPLACE
g_fotolon1      svidf7          REPLACE
/*g_fotodate1     svitgl2         REPLACE*/
/*g_fototime1     svidf8          REPLACE*/
cok             sviyt2          DO_CALC_IF cadalonlat

DBCALCS(dupdsvirmhdpnok)
        DCOMMAND        UPDATE
        DTARGET         sviprmidx sviprm
        DMAP            mupdsvirmhdpnok

SPCALCS(spcaluplok)
dupdsvirmhdpnok
DO_LIB ap_nxpst(l4461,lm4461det2);

HOOKS(tmptranst)
CLICKED         cur_field=lklikok       DO_SPCALCS IF csdhupload spcaluplok

CALCS()
