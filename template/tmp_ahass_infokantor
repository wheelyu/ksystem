/******************** Trans Info Alamat Kerja ********************/

LOCAL
PGM_FIELDS
lalmbukoto	STRING		61

IMAGE(tmptranst)
/-----------------------------------\
|/-Detail Info Alamat Kerja--------\|
|| t.NamaKntr   : _________________||
|| t.JenisKntr  : ________  _______||
|| i.Alamat     : _________________||
|| i.Propinsi   : ________  _______||
|| i.Kota       : ________  _______||
|| i.Kec        : ________  _______||
||                       _________ ||
|\---------------------------------/|
\-----------------------------------/

IMAGE(tmptrans)

FIELD(tmptranst)
almnama         ALLCAPS         INPUTRI 1
almbukoto       ALLCAPS	SCROLL  INPUTRI 2
lalmbukoto	PROTECT		INPUTRI	2
almjalan        ALLCAPS         INPUTRI 3
almprop         ALLCAPS         INPUTRI 4
almnamprop      PROTECT         INPUTRI 5
almkota         ALLCAPS         INPUTRI 6
almnamkota      PROTECT         INPUTRI 7
almkec          ALLCAPS         INPUTRI 8
almnamkec       PROTECT         INPUTRI 9
lenter          NOCHANGE        INPUTRI 12

EDITS(tmptranst)
e.MandatoryNama	almnama	MANDATORY
e.MandatoryJns	almbukoto MANDATORY
e.MandatoryJln  almjalan MANDATORY
e.MandatoryProp almprop MANDATORY
e.MandatoryKota almkota MANDATORY
e.MandatoryKec  almkec MANDATORY

e.validate      almbukoto VALIDATE tbddatkodidx mtbddt2 stbd {Pgv_dttabel} {Pgv_personal} {Pgv_pekerjaan21}
e.ValidateProp  almprop VALIDATE dtmdtkodidx  mdtmProp2 sdtmProp {Pgv_dtkota}
e.ValidateKota  almkota VALIDATE tbldtdtmkod  mtblKota2 stblKota {Pgv_dtkota} {Palmprop}
e.ValidateKec   almkec VALIDATE tbddatkodidx  mtbdKec2 stbd {Pgv_dtkota} {Palmprop} {Palmkota}

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_TARGET
almdatbukidx    lINFOKNTR btmnobuk

SFL_MAP
lINFOKNTR       almdata         REPLACE
btmnobuk        almnobuk        REPLACE

MAP(mtbddt2)
tbdkode         almbukoto        REPLACE
tbdket          lalmbukoto       REPLACE

MAP(mdtmProp2)
dtmkode         almprop         REPLACE
dtmket          almnamprop      REPLACE

MAP(mtblKota2)
tblkode         almkota         REPLACE
tblket          almnamkota      REPLACE

MAP(mtbdKec2)
tbdkode         almkec          REPLACE
tbdket          almnamkec       REPLACE
