FIELDS(tmptranst)
svinourt	PROTECT			INPUTRI  1
svikode         ALLCAPS                 INPUTRI  2  /*ID Mitra*/
lnamamitra      PROTECT ALLCAPS         INPUTRI  3  /*Nama Mitra*/
svistr5         ALLCAPS                 INPUTRI  4  /*No. Telpon Mitra*/
svistr1         NOCHANGE                INPUTRI  5  /*Ket. Call*/
svinama		TEXTAREA		INPUTRI  6  /*Ket Hasil Call*/
sviket		TEXTAREA         	INPUTRI  7  /*Ket Kendala*/
ljamtlpmtr      PROTECT                 INPUTRI  8  /*Jam mulai spk*/
lenter          ALLCAPS                 INPUTRI  9  /*Tombol enter*/
svistr3         PROTECT                 INPUTRI 10  /*Status Sudah Upload*/
ltombupltlp	TOMBOL			INPUTRI	11  /*Tombol Upload OK*/

svitype2        PROTECT                 INPUTRI 12 /*NIP Rev HO*/
svistr34        NOCHANGE                INPUTRI 13 /*ket Rev SPV*/
lrevhotlp       PROTECT                 INPUTRI 14
sviket2         TEXTAREA                INPUTRI 15 /*isi ket review HO*/
svistr35        NOCHANGE                INPUTRI 16 /*ket Rev DVH*/
lrevdvhtlp      PROTECT                 INPUTRI 17
sviket3         TEXTAREA                INPUTRI 18 /*isi ket review DVH*/

ltompjtlp       TOMBOL          	INPUTRI 19
ltomdvhtlp      TOMBOL          	INPUTRI 21
svistr36        PROTECT         	INPUTRI 20
svistr37        PROTECT         	INPUTRI 22

DEFAULTS(tmptranst)
lvertlp			INIT			2606.18v1
svistr1			DFALT_SCAN_BLANKS	DIANGKAT
						TIDAK
svistr34        	DFALT_SCAN_BLANKS   	1 "ACC"
                	                    	2 "TACC"
svistr35        	DFALT_SCAN_BLANKS   	1 "ACC"
                	                    	2 "TACC"
lenter			INIT			"ENTER"
ltombupltlp		INIT			"UPLOAD OK"
ltompjtlp               INIT                    "SELESAI REV PJ HO"
ltomdvhtlp              INIT                    "SELESAI REV DVH"
IF chnypjho svitype2	INIT_UPDATE			{g_usrkode}

CALCS()
cjawabcall3		svistr1=="DIANGKAT" && (g_curcmd == 1 || g_curcmd == 2)
ctdkcall3		svistr1=="TIDAK" && (g_curcmd == 1 || g_curcmd == 2)
cdtmitra3       	lpsmsts3 == "INPG"
cbtstlpmtr      	svidf1 < 1
ctdtlpmtr       	svidf1 + 1
csdhupltelp		svidf1 == 1
cjointkdtelp		djointkdtelp == 1
ctelpcek		(g_curcmd==1 && (dscantlpmitra==0 || dscantlpmitra!=0) && ljmltlpmitra < 1) || g_curcmd == 2
cangkattlp		tkdnourt == svinourt && djointkdtlpmitra==1 && svidf1 != 0 && svistr3 != "OK" && svistr1=="DIANGKAT"
ctdktlp			tkdnourt == svinourt && djointkdtlpmitra==1 && svidf1 != 0 && svistr3 != "OK" && svistr1=="TIDAK"
curttlpmtr0  		djoinuruttlpmtr==0 && g_curcmd==1
curttlpmtr1     	djoinuruttlpmtr==1 && g_curcmd==1
curttlpmtr      	FLD_TO_STRING(svinourt) + "TLPMITRA"
cjoinnohp		djoinnohp == 1
crev1tlp        	svistr34 == "1" && svitype == "TELPMITRA"
crev1atlp       	svistr35 == "1" && svitype == "TELPMITRA"
crev2tlp        	svistr34 == "2" && svitype == "TELPMITRA"
crev2atlp     		svistr35 == "2" && svitype == "TELPMITRA"
cpjhosdhrevtlp          svistr34 != BLANKS
cdvhsdhrevtlp           svistr35 != BLANKS
ctambahdata2 		(g_curcmd == 1 || g_curcmd == 2) && (g_usrkode == tkmplg || g_grpnam == "IT")

EDITS(tmptranst)
