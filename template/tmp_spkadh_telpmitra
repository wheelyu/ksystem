e.Kode Mitra Harus Diisi		svikode		MANDATORY
e.Keterangan Call Harus Diisi		svistr1		MANDATORY
e.Ket. Hasil Call Harus Diisi		svinama		MANDATORY_IF cjawabcall3
e.Ket. Kendala Harus Diisi		sviket		MANDATORY_IF ctdkcall3

e.Validate Master Call Mitra	 	svikode         VALIDATE_IF ctambahdata2 tbtdattypkod mdtmitra3 stbtcallmit {Pgv_dttabel} {Pgv_dttabel21} {PlMASTERTARGET} {PlM4W21} {PlMASTERTLPMITRA}
/*e.Bukan Mitra Upline 		 	svikode         VALIDATE psddatpsmkod mdtmitra3 spsd {PlKETMITRA11} {Ptkmplg} {Slm4w}*/
