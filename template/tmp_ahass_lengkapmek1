DBCALCS(dupdfoto3)
DBC_COMMAND     UPDATE
DBC_TARGET      aktprmidx   aktprm
DBC_MAP         mupdaktfoto3

HOOKS(tmptranst)
AFTER_INPUT	cur_field=aktlok	DO_MAP SHOW mupdaktmek1
BEFORE_INPUT	cur_field=aktcab	DO_SKIP_IF cTdkAda1

SUBFILE(tmptrans)
