IMAGE(tmptrans)

FIELDS(tmptranst)
aktnobuk        PROTECT          INPUTRI 1
aktdk           PROTECT          INPUTRI 2
akttgl          PROTECT          INPUTRI 3
aktlok		NOCHANGE	 INPUTRI 4
aktcab		NOCHANGE	 INPUTRI 5
lenter          NOCHANGE         INPUTRI 6
luplok          TOMBOL           INPUTRI 8

CALCS()
cAda1		aktlok == "ADA"
cTdkAda1	aktlok == "TIDAK_ADA"
cfotobaru3      akttgl == g_tgltrn

EDITS(tmptranst)
e.MandatoryPilihan	aktlok	MANDATORY
e.MandatoryKondisi	aktcab	MANDATORY_IF cAda1

DEFAULTS(tmptranst)
aktlok		DFALT_SCAN	BLANKS
				ADA
				TIDAK_ADA

aktcab		DFALT_SCAN	BLANKS
				NAIK
				TIDAK_NAIK

MAP(mupdaktfoto3)
g_tgltrn        akttgl  REPLACE
cY1             aktdk   DO_CALC_IF cfotobaru3

MAP(mupdaktmek1)
