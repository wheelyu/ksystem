IMAGE(tmptrans)

FIELD(tmptranst)
mtdnourt    	NOCHANGE      	 	INPUTRI 1
mtdsts      	PROTECT       	 	INPUTRI 2
mtdsat     	ALLCAPS       	 	INPUTRI 3

mtdtglfak	NONE {DD-MM-YYYY} NOLIMIT	INPUTRI	4
mtdtgl2  	PROTECT {DD-MM-YYYY} NOLIMIT	INPUTRI	4
mtdnoll      	ALLCAPS       	 	INPUTRI 5
mtdjml     	NUMERIC       	 	INPUTRI 5
mtdjml2    	NUMERIC       	 	INPUTRI 6
mtdhrg       	NUMERIC       	 	INPUTRI 7


DEFAULTS(tmptranst)
mtdsts		INIT		INPG
mtdsts		INIT_UPDATE		INPG
ltomsubmit	INIT		SUBMIT



EDITS(tmptranst)
e.Validate3106 mtdsat   VALIDATE_IF ctypebeasiswa tbddatkodidx mtbdbea stbd   {Pgv_dttabel} {PlHRD} {PlPROGKRY1} 
e.Validate3106 mtdsat   VALIDATE_IF ctypebiayatbh tbddatkodidx mtbdbea stbd   {Pgv_dttabel} {PlHRD} {PlPROGKRY2} 
e.ValidatePmb  mtdnoll	VALIDATE pmbsupstsbuk mpmb spmb {PlPENSIUN} {Pgv_INPG} {PlBIAYA23} {Ptkmcab}

/*mtdstsbrgukr   mtddata mtdsts mtdbrg mtdukrwrn mtdsat mtdtgl2 	dup
e.Dupkey	mtdsat DUPKEY mtdstsbrgukr  {Ptkmdata} {Pgv_INPG} {Ptkmbuk2} {PlBEASISWA21} 
*/

MAP(mpmb)
pmbnobuk	mtdnoll 	REPLACE

MAP(mtbdbea)
tbdkode		mtdsat  		REPLACE

CALCS()
cisimtd1		1
ctammtd1		lmtdnourt + 1
cdjoinmtd0	djoinmtd2 == 0 && g_curcmd == 1
cdjoinmtd1	djoinmtd2 == 1 && g_curcmd == 1


cmtdhrg		mtdjml * mtdjml2

ctambl1          DO_LIB ap_tambl(mtdtglfak,lmtdjml2,&mtdtgl2);
ctambl3          DO_LIB ap_tambl(lmtdtgl2,l1,&mtdtglfak);

csudahinput	djoinmtd3 == 0 || g_curcmd == 2	
clmtdnourt0 	lmtdnourt == 0

chlkurang	pmbsisprc >= mtdhrg
clmtdjml2	mtdjml2 - 1

MAP(murut)
cisimtd1        mtdnourt        DO_CALC_IF cdjoinmtd0
ctammtd1        mtdnourt        DO_CALC_IF cdjoinmtd1


tkmdata		mtddata		REPLACE
tkmbuk2		mtdbrg		REPLACE
tkmtype		mtdukrwrn	REPLACE

MAP(mtotal)
clmtdjml2		lmtdjml2	DO_CALC
cmtdhrg   	mtdhrg   	DO_CALC
ctambl1		mtdtgl2		DO_CALC

MAP(mcaritgl)
c0		mtdtglfak	DO_CALC_IF clmtdnourt0
lmtdtgl2	lmtdtgl2	REPLACE_IF cdjoinmtd1
ctambl3		mtdtglfak	DO_CALC


MAP(mdum)
ldum		ldum		REPLACE

HOOKS(tmptranst)
BEFORE_INPUT	cur_field=mtdnourt	DO_MAP SHOW murut
AFTER_INPUT	cur_field=mtdnourt	DO_MAP SHOW mcaritgl

AFTER_INPUT	cur_field=mtdjml2  	DO_MAP SHOW mtotal
AFTER_INPUT	cur_field=mtdhrg	DO_MAP SHOW mtotal
AFTER_INPUT	cur_keybd=EN       	DO_MAP SHOW mtotal




AFTER_INPUT	cur_field=mtdsat	DO_MAP SHOW
		IF csudahinput mdum
		ELSE HKCURSOR STAY
		     HKMSG Jenjang Pendidikan ini sudah pernah diinput di No.Id yang sama

AFTER_INPUT	cur_keybd=EN    	DO_MAP SHOW
		IF csudahinput mdum
		ELSE HKCURSOR STAY
		     HKMSG Jenjang Pendidikan ini sudah pernah diinput di No.Id yang sama

AFTER_INPUT	cur_field=mtdhrg    	DO_MAP SHOW
		IF chlkurang mdum
		ELSE HKCURSOR STAY
		     HKMSG Cadangan Pensiun Tidak Cukup

AFTER_INPUT	cur_keybd=EN        	DO_MAP SHOW
		IF chlkurang mdum
		ELSE HKCURSOR STAY
		     HKMSG Cadangan Pensiun Tidak Cukup

SUBFILE(tmptrans)
SFL_LINES(1)      
SFL_TITLE(tmptranst)
SFL_TARGET	
mtdbukurtidx   tkmnobuk

SFL_MAP	
tkmdata		mtddata		REPLACE
tkmnobuk	mtdnobuk 	REPLACE
tkmtype		mtdplg		REPLACE
tkmcab		mtdcab		REPLACE


