LOCAL
PGM_FIELDS
lUBAH		STRING		11
ldtbirojasa	STRING		11

MAP(mnhdub)
nhdkode         lnhdkode        REPLACE
nhdkode2        lnhdkode2       REPLACE


DBCALCS(djoinnhdub)
        DBC_COMMAND     JOIN
        DBC_TARGET      nhdbukidx  tlmnobbm ldtbirojasa
        DBC_MAP         mnhdub
  
DBCALCS(djoinsviprb0)
        DBC_COMMAND     JOIN
        DBC_TARGET      svidatbuktyp   tlmdata tlmnobuk lUBAH  

DBCALCS(djoinast4)
        DBC_COMMAND     JOIN
        DBC_TARGET      astdatkodidx   gv_dtassets svistr8  gv_bpkb svikode
  

