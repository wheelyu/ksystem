svinama                 PROTECT                 INPUTRI         1
sviyt1			NOCHANGE		INPUTRI		2
svitgl2			PROTECT {DD-MM-YYYY}	INPUTRI		3
svidf6			PROTECT NUMERIC		INPUTRI		3
svidf7			PROTECT NUMERIC		INPUTRI		3
svidf8			PROTECT			INPUTRI		4
luploadOK		TOMBOL			INPUTRI		5

