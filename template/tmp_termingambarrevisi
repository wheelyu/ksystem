SFL_DOCUPLFLD_DBCALCS dupdtkmlay
SFL_DOCUPLFLD tkmnobuk tkmdata 
SFL_TARGET
        tkmdtkdstlok lDTREGAMKER mtsnobuk gv_OPEN                        
SFL_MAP
	lDTREGAMKER	tkmdata		REPLACE
	mtsnobuk	tkmkode 	REPLACE 
	gv_OPEN		tkmsts		REPLACE
	mtstgl		tkmtgl		REPLACE
