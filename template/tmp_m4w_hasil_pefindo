tldgrup2	NOCHANGE SCROLL	INPUTRI 4
tldlok2		NOCHANGE SCROLL	INPUTRI 5
tldbrdoto	PROTECT		INPUTRI	6
tldppdoto	ALLCAPS 	INPUTRI	7
tldbisnis	ALLCAPS		INPUTRI	8
tldjml2		ALLCAPS		INPUTRI	9 
tldperdis4	PROTECT		INPUTRI	10
tldperdis1	PROTECT		INPUTRI	11
tldperdis2	PROTECT		INPUTRI	12
tldperdis3	PROTECT		INPUTRI	13
tldjml		PROTECT		INPUTRI	14
tldket		PROTECT		INPUTRI	15
tldtydis	NOCHANGE	INPUTRI	16

DEFAULTS(tmptranst)
tldgrup         DFALT_SCAN      BLANKS
                                ADA TIDAK_ADA ADA_TIDAK_TERHIT
tldtydis	DFALT_SCAN	BLANKS Y T

tldlok2         DFALT_SCAN      BLANKS
                                ADA TIDAK_ADA


lHASILPEFINDO	INIT		HSLPEFINDO
lDTPEFINDO21	INIT		DTPEFINDO
lDEBITUR	INIT		DEBITUR
lPENJAMIN21     INIT		PENJAMIN
lPENJAMIN       INIT		PASANGAN
lPASANGAN21     INIT		PENJAMIN
tlddata		INIT		HSLPEFINDO
tldsts		INIT		INPG
tldukrwrn	DFALT_SCAN	BLANKS
				DEBITUR
				PASANGAN
				PENJAMIN

EDITS(tmptranst)
e.Mandatory	tldukrwrn	MANDATORY
e.Mandatory	tldnoll		MANDATORY
e.Mandatory	tldgrup		MANDATORY
e.Mandatory	tldgrup2	MANDATORY
e.Mandatory	tldlok2		MANDATORY
e.ValidatePsm	tldnoll		VALIDATE psmktpidx mpsmpefhsl 0

MAP(mpsmpefhsl)
psmktp		tldnoll		REPLACE
cBLANKS		lscorepef	DO_CALC
cBLANKS		lgagalbyrpef	DO_CALC
cBLANKS		lgradepef	DO_CALC
cBLANKS		ltrendpef	DO_CALC
cBLANKS		lpoinslikpef	DO_CALC
cBLANKS		lrmdgabkdscr	DO_CALC
cBLANKS		lrmdgabgagalbyr	DO_CALC
cBLANKS		lrmdgabtrend	DO_CALC
cBLANKS		lrmdgabslikpef	DO_CALC
cBLANKS		lrmdgabhasilpef	DO_CALC
lscorepef	lscorepef	REPLACE_IF cjointldpef1
lgradepef	tldppdoto	REPLACE_IF cbknhit
ltrendpef	tldbisnis	REPLACE_IF cbknhit
lgagalbyrpef	tldjml2		REPLACE_IF cbknhit
lpoinslikpef	lpoinslikpef	REPLACE_IF cjoinsvislik2



cmasterrmdgabkdscr	lrmdgabkdscr	DO_CALC
cmasterrmdgabgagalbyr	lrmdgabgagalbyr	DO_CALC
cmasterrmdgabtrend	lrmdgabtrend	DO_CALC
cmasterrmdgabslikpef	lrmdgabslikpef	DO_CALC_IF cjksliklanjut
cmasterrmdgabslikpef2	lrmdgabslikpef	DO_CALC_IF cjksliktdklanjut
cmasterrmdgabhasilpef	lrmdgabhasilpef	DO_CALC

MAP(misihslpef)
btmnobuk	tldbrg		REPLACE
btmnobuk	tldnobuk	REPLACE
cBLANKS		lhasil1		DO_CALC
cBLANKS		lhasil1a	DO_CALC
cBLANKS		lhasil1b	DO_CALC
cBLANKS		lhasil1c	DO_CALC

MAP(misihslpef2)
cBLANKS		tldgrup2	DO_CALC
cBLANKS		lslikpef	DO_CALC
cADA		tldgrup2	DO_CALC_IF cjointldpef1
cTDKADA		tldgrup2	DO_CALC_IF cjointldpef2
lslikpef	lslikpef	REPLACE_IF cjoinsvislik1
lslikpef	tldbrdoto	REPLACE

MAP(mpoinpef)
lhasil1		tldperdis1	REPLACE_IF cjikapefada
lhasil1a	tldperdis3	REPLACE_IF cjikapefada
lhasil1b	tldperdis2	REPLACE_IF cjikapefada
lhasil1c	tldperdis4	REPLACE
ctotpoinpef	tldjml		DO_CALC

MAP(mpoinpef2)
lhasilstr1d	tldket		REPLACE
lhasilstr2d	tldket2		REPLACE


HOOKS(tmptranst)
BEFORE_INPUT	cur_field=tldtydis	DO_SKIP_IF clewatscor
BEFORE_INPUT	cur_field=tldppdoto	DO_SKIP_IF cjikatdkhit
BEFORE_INPUT	cur_field=tldbisnis     DO_SKIP_IF cjikatdkhit
BEFORE_INPUT	cur_field=tldjml2       DO_SKIP_IF cjikatdkhit
BEFORE_INPUT	cur_field=tldnoll	DO_MAP SHOW misihslpef
AFTER_INPUT	cur_field=tldnoll	DO_MAP SHOW misihslpef2
AFTER_INPUT	cur_field=tldlok2	DO_LIB_IF crmdgabkodescr1 ap_ambts(gv_INPG,lrmdgabkdscr,lNol,lNol,lNol,&lhasil1,&lhasil2,&lhasil3,lhasilstr1,lhasilstr2);
AFTER_INPUT	cur_field=tldlok2	DO_LIB_IF crmdgabgagalbyr1 ap_ambts(gv_INPG,lrmdgabgagalbyr,tldjml2,lNol,lNol,&lhasil1a,&lhasil2a,&lhasil3a,lhasilstr1,lhasilstr2);
AFTER_INPUT	cur_field=tldlok2       DO_LIB_IF crmdgabtrend1 ap_ambts(gv_INPG,lrmdgabtrend,lNol,lNol,lNol,&lhasil1b,&lhasil2b,&lhasil3b,lhasilstr1,lhasilstr2);
AFTER_INPUT	cur_field=tldlok2       DO_LIB_IF crmdgabslikpef1 ap_ambts(gv_INPG,lrmdgabslikpef,lNol,lNol,lNol,&lhasil1c,&lhasil2c,&lhasil3c,lhasilstr1,lhasilstr2);
AFTER_INPUT	cur_field=tldlok2       DO_MAP	SHOW mpoinpef

AFTER_INPUT	cur_field=tldlok2       DO_LIB_IF crmdgabhasilpef1 ap_ambts(gv_INPG,lrmdgabhasilpef,tldjml,lNol,lNol,&lhasil1d,&lhasil2d,&lhasil3d,lhasilstr1d,lhasilstr2d);

AFTER_INPUT	cur_field=tldlok2	DO_MAP	SHOW mpoinpef2
AFTER_INPUT	cur_keybd=EN		DO_LIB_IF crmdgabkodescr1 ap_ambts(gv_INPG,lrmdgabkdscr,lNol,lNol,lNol,&lhasil1,&lhasil2,&lhasil3,lhasilstr1,lhasilstr2);
AFTER_INPUT	cur_keybd=EN		DO_LIB_IF crmdgabgagalbyr1 ap_ambts(gv_INPG,lrmdgabgagalbyr,tldjml2,lNol,lNol,&lhasil1a,&lhasil2a,&lhasil3a,lhasilstr1,lhasilstr2);
AFTER_INPUT	cur_keybd=EN		DO_LIB_IF crmdgabtrend1 ap_ambts(gv_INPG,lrmdgabtrend,lNol,lNol,lNol,&lhasil1b,&lhasil2b,&lhasil3b,lhasilstr1,lhasilstr2);
AFTER_INPUT	cur_keybd=EN		DO_LIB_IF crmdgabslikpef1 ap_ambts(gv_INPG,lrmdgabslikpef,lNol,lNol,lNol,&lhasil1c,&lhasil2c,&lhasil3c,lhasilstr1,lhasilstr2);
AFTER_INPUT	cur_keybd=EN		DO_MAP	SHOW mpoinpef
AFTER_INPUT	cur_keybd=EN		DO_LIB_IF crmdgabhasilpef1 ap_ambts(gv_INPG,lrmdgabhasilpef,tldjml,lNol,lNol,&lhasil1d,&lhasil2d,&lhasil3d,lhasilstr1d,lhasilstr2d);
AFTER_INPUT	cur_keybd=EN		DO_MAP	SHOW mpoinpef2


SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_TARGET
tldstsbrgukr lHASILPEFINDO  gv_INPG btmnobuk

SFL_MAP
btmnobuk	tldnobuk	REPLACE
btmnobuk	tldbrg		REPLACE
lHASILPEFINDO	tlddata		REPLACE
gv_INPG		tldsts		REPLACE

CALCS()
chslpefok	(((tldjml <= lpoinslikpef) && (lpoinslikpef==0 || lpoinslikpef>0)) || 
                  (lpoinslikpef==0 && (djointldhslpef==0 || djointldhslpef == 1))  ||
                  (tldjml >= lpoinslikpef && djointldhslpefdeb == 1) ||
                  (tldjml >= lpoinslikpef && djointldhslpefpas == 1) ||
                  (tldjml >= lpoinslikpef && djointldhslpefpen == 1)) && tldtydis=="Y"

MAP(mupdsvihslpefok)
tldket2		svistr3		REPLACE
tldket		svistr4		REPLACE
tldjml		svidf7		REPLACE
DEBUG	lNol	lNol		REPLACE

MAP(mupdscor)
tldket		sviket3		REPLACE
DEBUG		ldum	ldum	REPLACE

SPCALCS(saddtmptranst)
DO_LIB_IF chslpefok	ap_dbclc(DNAME dupdsvihslpefok,DCOMMAND	UPDATE_RANGE,DTARGET svidatbuktyp lSLIK nhmfinco_2 lPOSSLIK,DMAP mupdsvihslpefok);
DO_LIB_IF cjoinscor	ap_dbclc(DNAME dupdscor,DCOMMAND UPDATE_RANGE,DTARGET svidatbuktyp lMULTI4W nhmfinco_2 lSCORING,DMAP mupdscor);

POSTING(tmptrans)
PST_ADDCMD	saddtmptranst
PST_UPDCMD	saddtmptranst

PERMIT(tmptrans)
        PMT_ADD_COND            c642
        PMT_UPDALL_COND         c642     
        PMT_DEL_COND            c642     
