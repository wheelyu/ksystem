DBCALCS(djointldhslpefpen)
        DBC_COMMAND     JOIN
        DBC_TARGET      tldstsbrgukr lHASILPEFINDO  gv_INPG btmnobuk lPENJAMIN21

DBCALCS(djointldhslpefpas)
        DBC_COMMAND     JOIN
        DBC_TARGET      tldstsbrgukr lHASILPEFINDO  gv_INPG btmnobuk lPASANGAN21


MAP(mjoinsvislik)
