	DBC_COMMAND	JOIN
	DBC_TARGET	rmdstsgabidx	gv_INPG lrmdgabkdscr

DBCALCS(djoinrmdgabgagalbyr)
	DBC_COMMAND	JOIN
	DBC_TARGET	rmdstsgabidx	gv_INPG lrmdgabgagalbyr

DBCALCS(djoinrmdgabtrend)
	DBC_COMMAND	JOIN
	DBC_TARGET	rmdstsgabidx	gv_INPG lrmdgabtrend


DBCALCS(djoinrmdgabslikpef)
	DBC_COMMAND	JOIN
	DBC_TARGET	rmdstsgabidx	gv_INPG lrmdgabslikpef

DBCALCS(djoinrmdgabhasilpef)
	DBC_COMMAND	JOIN
	DBC_TARGET	rmdstsgabidx	gv_INPG lrmdgabhasilpef

DBCALCS(djoinscor)
	DBC_COMMAND	JOIN	
	DBC_TARGET	svidatbuktyp  lMULTI4W nhmfinco_2 lSCORING


CALCS()
cADA		"ADA"
cTDKADA		"TIDAK_ADA"
cjointldpef1		djointldscore==1
cjointldpef2		djointldscore==0
cjoinsvislik1		djoinsvislik==1
cjoinsvislik2		djoinsvislik2==1

crmdgabkodescr1		djoinrmdgabkodescr==1
crmdgabgagalbyr1	djoinrmdgabgagalbyr==1
crmdgabtrend1		djoinrmdgabtrend==1
crmdgabslikpef1		djoinrmdgabslikpef==1
crmdgabhasilpef1	djoinrmdgabhasilpef==1
cmasterrmdgabkdscr	"KDSCORE" + "PEFINDO" + STRIP(tldppdoto)
cmasterrmdgabgagalbyr	"GAGALBYR" + "PEFINDO"
cmasterrmdgabtrend	"TREND" + "PEFINDO" + STRIP(tldbisnis)
cmasterrmdgabslikpef	"SLIK" + "PEFINDO" + STRIP(tldbrdoto) + STRIP(tldlok2) 
cmasterrmdgabslikpef2	"SLIK" + "PEFINDO" + STRIP(tldbrdoto)
cmasterrmdgabhasilpef	"SCOORING" + "PEFINDO" 
ctotpoinpef		tldperdis1 + tldperdis2 + tldperdis3 + tldperdis4
cjksliklanjut		tldbrdoto=="LANJUT"
cjksliktdklanjut	tldbrdoto!="LANJUT"
cjikapefada		tldgrup=="ADA" || tldgrup=="ADA_TIDAK_TERHIT" 
cjoinscor		djoinscor==1 && tldtydis=="Y"
clewatscor		g_grpnam!="B.M4WCM" && g_grpnam!="RAS" && g_grpnam!="RASDVH" && 
                        g_grpnam != "B.M4WCRO" && g_grpnam != "B.M4WSPV" && g_grpnam != "RI" && g_grpnam != "IT"
cjikatdkhit             tldgrup != "ADA_TIDAK_TERHIT" 
cbknhit                 tldgrup != "ADA_TIDAK_TERHIT"


