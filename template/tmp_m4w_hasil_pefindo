DBCALCS(djoinsvislik)
	DBC_COMMAND	JOIN
	DBC_TARGET	svidatbuktyp	lSLIK nhmfinco_2 lPOSSLIK
	DBC_MAP		mjoinsvislik

MAP(mjoinsvislik2)
svidf7		lpoinslikpef	REPLACE

DBCALCS(djoinsvislik2)
	DBC_COMMAND	JOIN
	DBC_TARGET	svidatbuktyp	lSLIK nhmfinco_2 lPOSSLIK
	DBC_MAP		mjoinsvislik2

