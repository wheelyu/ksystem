DO_LIB_IF cdjoinconAHS_1 ap_dbclc(DNAME dupdconAHS,DCOMMAND UPDATE,DTARGET conkodstsidx btmnobuk gv_INPG,DMAP mupdconAHS);
DO_LIB_IF cdjoinppmInstansi ap_dbclc(DNAME dupdppmInstansi,DCOMMAND UPDATE,DTARGET ppmbukidx btmkdkms,DMAP mupdppmInstansi);



