IMAGE(tmptranst)
/----------------------------------\
|/--------------------------------\|
||i.JnsDeb   : _________________  ||__
||i.Ktp      : __________________ ||
||i.Nama     : __________________ ||
|\--------------------------------/|
\----------------------------------/

IMAGE(tmptrans)

FIELD(tmptranst)
tkdjenis		NOCHANGE			INPUTRI	1
tkddata			PROTECT				INPUTRI	2
tkdnoll			DIGITS SCROLL	QNONMANDATORY	INPUTRI 3
tkdrek			ALLCAPS	SCROLL			INPUTRI	4

DEFAULT(tmptranst)
tkdsts			INIT		INPG
tkdtgl			INIT		{g_tgltrn}
tkdnourt		INIT		99
tkddata			INIT		PSMKTP
lDTMITRA		INIT		DTMITRA
lKONSUMEN		INIT		KONSUMEN
lNEW			INIT		NEW

tkdjenis	DFALT_SCAN_BLANKS	PERORANGAN
                                       	INSTANSI
                                        EKITAP
                                        NPWP

EDITS(tmptranst)
e.Mandatory		tkdjenis	MANDATORY
e.MandatoryKTP		tkdnoll		MANDATORY
e.MandatoryNama		tkdrek		MANDATORY

CALCS()
/*ctdkKtp		tkdnoll != BLANKS && g_curcmd == 2*/
cdjoinpsmKons0	djoinpsmKons == 0
cdjoinpsmKons1	djoinpsmKons == 1
cdjoinalmPsmKtp1 djoinalmPsmKtp == 1
cdjoinast620_1	djoinast620 == 1
cdjoinppmInstansi	djoinppmInstansi == 1
cdjoinalmPsmAhass_1	djoinalmPsmAhass == 1
cdjoinconPembawa_1	djoinconPembawa == 1
cdjoinconAHS_1		djoinconAHS == 1
cpanjang2	DO_LIB ap_strln(tkdnoll,&lpanjang);
cpjgktp2	((lpanjang == 15 || lpanjang == 16) && tkdjenis == "PERORANGAN") || tkdjenis != "PERORANGAN"
cpjgnpwp2	(lpanjang == 15 && (tkdjenis == "INSTANSI" || tkdjenis == "NPWP" || tkdjenis == "EKITAP")) ||
		(tkdjenis!="INSTANSI" && tkdjenis!="EKITAP")
cHnyaInstansi	btmguna == "INSTANSI" && btmtypdeb == "INSTANSI"

MAP(mpanjangktp2)
cpanjang2	lpanjang	DO_CALC

HOOKS(tmptranst)
AFTER_INPUT	cur_field=tkdnoll	DO_MAP SHOW mpanjangktp2

AFTER_INPUT   	cur_field=tkdnoll       DO_MAP SHOW
              	IF cpjgktp2 mdumstr
              	ELSE HKCURSOR STAY
              	HKMSG t.KtpLimit16Digits

AFTER_INPUT     cur_field=tkdnoll       DO_MAP SHOW
                IF cpjgnpwp2 mdumstr
                ELSE HKCURSOR STAY
                HKMSG t.NpwpLimit15Digits

AFTER_INPUT     cur_keybd=EN		DO_MAP SHOW
                IF cpjgktp2 mdumstr
                ELSE HKCURSOR STAY
                HKMSG t.KtpLimit16Digits

AFTER_INPUT     cur_keybd=EN		DO_MAP SHOW
                IF cpjgnpwp2 mdumstr
                ELSE HKCURSOR STAY
                HKMSG t.NpwpLimit15Digits



SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_TARGET
        tkddatbukll	lPSMKTP	btmnobuk

SFL_MAP
btmnobuk	tkdnobuk	REPLACE


MAP(mupdbtmKtp)
