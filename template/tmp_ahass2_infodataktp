lalmpropKtp	lalmpropKtp             REPLACE_IF cdjoinalmPsmKtp1
lalmnampropKtp	lalmnampropKtp          REPLACE_IF cdjoinalmPsmKtp1
lalmkecKtp	lalmkecKtp              REPLACE_IF cdjoinalmPsmKtp1
lalmnamkecKtp	lalmnamkecKtp           REPLACE_IF cdjoinalmPsmKtp1
lalmkelKtp	lalmkelKtp              REPLACE_IF cdjoinalmPsmKtp1
lalmnamkelKtp	lalmnamkelKtp           REPLACE_IF cdjoinalmPsmKtp1
lalmkotaKtp	lalmkotaKtp             REPLACE_IF cdjoinalmPsmKtp1
lalmnamkotaKtp	lalmnamkotaKtp          REPLACE_IF cdjoinalmPsmKtp1
lalmrtKtp	lalmrtKtp		REPLACE_IF cdjoinalmPsmKtp1
lalmrwKtp	lalmrwKtp		REPLACE_IF cdjoinalmPsmKtp1
lalmkdposKtp	lalmkdposKtp		REPLACE_IF cdjoinalmPsmKtp1
lpsmins2	lpsmins2		REPLACE_IF cdjoinpsmKons1
