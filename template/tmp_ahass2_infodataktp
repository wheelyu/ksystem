DO_LIB_IF cdjoinast620_1 ap_dbclc(DNAME dupdast620,DCOMMAND UPDATE,DTARGET astdatkodidx lasset tkdnobuk gv_bpkb btmkdsam,DMAP mupdast620);

DO_LIB_IF cdjoinalmPsmAhass_1 ap_dbclc(DNAME dupdalmPsmAhass,DCOMMAND UPDATE,DTARGET almdatbukidx lPSMAHASS btmnobuk,DMAP mupdalmPsmAhass);
