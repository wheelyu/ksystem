tkdnoll		psmktp		REPLACE
tkdnoll		psmkode		REPLACE
tkdrek		psmnama		REPLACE
lNEW		psmstsbill	REPLACE
gv_INPG		psmstsplg	REPLACE
lDTMITRA	psmdatasup	REPLACE
lKONSUMEN	psmdataplg	REPLACE
gv_OPEN		psmstssup	REPLACE
g_tgltrn	psmtgl		REPLACE
