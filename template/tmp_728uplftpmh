IMAGE(tmptrans)

FIELD(tmptranst)
svinama                 PROTECT                 INPUTRI         1
sviyt1			NOCHANGE		INPUTRI		2 
sviyt2			NOCHANGE		INPUTRI		3 
svitgl2                 PROTECT {DD-MM-YYYY}    INPUTRI         4
ljamfoto		PROTECT			INPUTRI		5	
g_fotolat1		PROTECT NUMERIC {99,999999999}		INPUTRI		6 
g_fotolon1		PROTECT NUMERIC {99,999999999}		INPUTRI		7 
lklikok5                TOMBOL                  INPUTRI         8
svinobuk		PROTECT	UNSEEN		INPUTRI		9

DEFAULTS(tmptranst)
lklikok5        INIT    "UPLOAD OK"
l1		INIT	1

EDITS(tmptranst)
e.Validate      svinobuk        VALIDATE btmbukidx msviftpmh

MAP(msviftpmh)
cBLANKS         ljamfoto        DO_CALC
svidf8          ljamfoto        REPLACE

CALCS()
cok5             "OK"
cadalonlat5      svidf7!=0 && (g_fotodate1==g_tgltrn || g_grpnam=="RI" || g_grpnam=="IT")
csdhupload5      sviyt1=="Y"
cnamaselfpmh	"FOTO SELFI DENGAN PEMOHON"

MAP(mupdsviftpmh)
cnamaselfpmh	svinama		DO_CALC
cY              sviyt1          DO_CALC
cSYSTIME        svidf8          DO_CALC
g_tgltrn        svitgl2         REPLACE

DBCALCS(dupdsviftpmh)
        DCOMMAND UPDATE
        DTARGET sviprmidx sviprm
        DMAP mupdsviftpmh

MAP(mupdsviftpmhok)
g_fotolat1      svidf6          REPLACE
g_fotolon1      svidf7          REPLACE
cok5            sviyt2          DO_CALC_IF cadalonlat5

DBCALCS(dupdsviftpmhok)
        DCOMMAND        UPDATE
        DTARGET         sviprmidx sviprm
        DMAP            mupdsviftpmhok

SPCALCS(spcaluplftpmhok)
dupdsviftpmhok
DO_LIB ap_nxpst(l4461,lm4461det2);

HOOKS(tmptranst)
CLICKED         cur_field=lklikok5       DO_SPCALCS IF csdhupload5 spcaluplftpmhok

CALCS()
cftspmh		tmpkode == "FTSLFPHM728" &&  
		((/*lkodeotp != BLANKS &&*/ btdsisbrg == BLANKS && (btdbrg == "1" || btdbrg == "2")) || 
		(/*lkodeotp != BLANKS && */btdbrg == "4" && (btdsisbrg=="1" || btdsisbrg=="2")))
cftspmh1	sviyt1 != "Y"

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_COND cftspmh
SFL_UPL_DIRFLD btdtgl1
SFL_UPLFLD_DBCALCS dupdsviftpmh
SFL_UPLFLD btmnobuk     svikode
SFL_UPL_CAMERAONLY
SFL_UPL_DELCOND cftspmh1

SFL_TARGET
	svidatbuktyp   gv_datasurvey btmnobuk lFTPMH728 l1

PERMIT(tmptrans)
  PMT_ADD_COND  c0
  PMT_UPDALL_COND  c0
  PMT_DEL_COND  c0

