MAP(misikrjlap)
ltbtket1        ltbtket1        REPLACE_IF cdjoinpkrjdbformatlap
lmenit1         svidf1          REPLACE_IF cdjoinpkrjdbformatlap
ltbtket2        ltbtket2        REPLACE_IF cdjoinpkrjdbsourcelap
lmenit2         svidf2          REPLACE_IF cdjoinpkrjdbsourcelap
ltbtket3        ltbtket3        REPLACE_IF cdjoinpkrjdbuatlap
lmenit3         svidf3          REPLACE_IF cdjoinpkrjdbuatlap

MAP(msvnilailap)
c0              svidf1          DO_CALC_IF cT1
lmenit1         svidf1          REPLACE_IF cY1
c0              svidf2          DO_CALC_IF cT2
lmenit2         svidf2          REPLACE_IF cY2  
c0              svidf3          DO_CALC_IF cT3
lmenit3         svidf3          REPLACE_IF cY3

MAP(mnisiniplaporan)
lnippm         svistr2          REPLACE_IF cdjoinsct909niplaporan
lnipsop        svistr1          REPLACE_IF cdjoinsct909niplaporan
lblanks1       svistr1          REPLACE_IF cpilihT
lblanks1       lnama2           REPLACE_IF cpilihT

HOOKS(tmptranst)
