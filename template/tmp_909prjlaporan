AFTER_INPUT    cur_field=svistr32      DO_MAP SHOW msvnilailap
AFTER_INPUT    cur_field=svistr33      DO_MAP SHOW msvnilailap
AFTER_INPUT    cur_field=svistr3       DO_MAP SHOW mnisiniplaporan
AFTER_INPUT    cur_field=svistr3       DO_MAP SHOW mnisiniplaporan


