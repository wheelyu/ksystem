i.Mandatory         sviket2          MANDATORY 1
i.Mandatory         svistr31         MANDATORY 1
i.Mandatory         svistr32         MANDATORY 1
i.Mandatory         svistr33         MANDATORY 1
i.Date              svitgl1          MANDATORY 1
i.Date              svitgl2          MANDATORY 1







CALCS()
cSistemLaporan         tlmgrup2 == "PROJECT_SISTEM" && tlmkode == "LAPORAN"
cdjoinpkrjdbformatlap   djoinpkrjdbformatlap == 1 && (svistr31 == "Y" || svistr31 == "")
cdjoinpkrjdbsourcelap   djoinpkrjdbsourcelap == 1 && (svistr32 == "Y" || svistr32 == "")
