lpikstspiubli	lpikstspiubli	REPLACE_IF cjoinpik_1
lpiktglbyrakh	lpiktglbyrakh	REPLACE_IF cjoinpik_1

ltlmjml2	ltlmjml2	REPLACE_IF cjointlm739_1
ltlmtotal	ltlmtotal	REPLACE_IF cjointlm739_1
ltlmjml		ltlmjml		REPLACE_IF cjointlm739_1
chrglelang	lhrglelang	DO_CALC_IF cjointlm739_1
cminlelang	lhrglelang	DO_CALC_IF cminhrglelang
cumrstk		lumrstk		DO_CALC

CALCS()
