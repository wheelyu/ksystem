   ltlmjml2		PROTECT	SCROLL	  INPUTRI		15
   lhrglelang		PROTECT	SCROLL	  INPUTRI		15
   ltlmjml		PROTECT	SCROLL    INPUTRI		15
   ltlmtotal		PROTECT	SCROLL    INPUTRI		15
