ltlmbisnis  	STRING		11
lPENARIKAN	STRING		11
lUPLSRTSTR	STRING		11
lSRTSTR		STRING		11

MAP(mjointlm739)
tlmjml2		ltlmjml2	   REPLACE  /* Harga Pasaran  */
tlmtotal	   ltlmtotal	REPLACE  /* Harga Persediaan */
tlmjml		ltlmjml		REPLACE  /* Harga Estimasi */
tlmbisnis   ltlmbisnis  REPLACE  /* Usia Saat Tarik */


DBCALCS(djointlm739)
	DBC_COMMAND	JOIN
	DBC_TARGET	tlmdatstsasl lESTIMASI lCLSD brdplg  
	DBC_MAP		mjointlm739

DBCALCS(djointlm828)
	DBC_COMMAND	JOIN
	DBC_TARGET	tlmdatstsasl lESTAKTIVA lCLSD brdplg  
	DBC_MAP		mjointlm739


MAP(mjoinpik)
piksispok	lpiksispok		REPLACE
pikstspiubli	lpikstspiubli		REPLACE
piktglbyrakh	lpiktglbyrakh		REPLACE

DBCALCS(djoinpik)
	DBC_COMMAND	JOIN
	DBC_TARGET	pikdatbukidx lDTPIU brdplg
	DBC_MAP		mjoinpik

CALCS()
cjoinpik_1	djoinpik == 1
cjointlm739_1	djointlm739 == 1 || djointlm828 == 1
chrglelang	(ltlmjml2 - ltlmjml) + 250000
cminlelang	2550000
cminhrglelang	lhrglelang <= 2550000
cumrstk		g_tgltrn - brdtgl

