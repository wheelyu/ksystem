LOCAL
PGM_FIELDS
ltime2a		TIME	4
lsvitglfu2a	DATE	4
lnamanip2a	STRING	31
lsystimeR2a	TIME	4
ltglbesok	DATE	4
lnoktp2         STRING  21

MAP(mjoinsvifu2a)
svitgl2         lsvitglfu2	REPLACE
DBCALCS(djoinsvifu2a)
        DBC_COMMAND     JOIN
        DBC_TARGET      svidatbuktyp    tkmdata tkmnobuk lFOLLOWUP
        DBC_MAP         mjoinsvifu2a

DBCALCS(djoinabkkbaa)
        DBC_COMMAND     JOIN
        DBC_TARGET      abkdatbukidx lKUNCIABSEN svinobuk

MAP(mjointldsvi2)
tldplg          lnoktp2          REPLACE

DBCALCS(djointldsvi2)
        DBC_COMMAND     JOIN
        DBC_TARGET      tldbukbrglok svinobuk lINFOALAMATx
        DBC_MAP         mjointldsvi2

CALCS()
cbesok		svitgl1 + 1


IMAGE(tmptranst)
/----------------------------------------------------------------------------------------------------\
|t.NipReview     : __________                t.TlpV    t.TelpValid      t.Notif t.BeriSdmNotif       |
|t.Nama          : _______________________   t.L       t.LonglatSesuai  t.AgenV t.AgenValid          |
|t.jabatan       : __________                t.A       t.AlsnTdkJd      t.SdmJ  t.SdmJwb             |
|t.TglReview     : __________                t.Kes     t.Kesimpulan                                  |
|t.JamReview     : __________                t.SdmJ    t.SdmJwb                                      |
|t.Telp          : __________                                                                        |
|-----t-------t------t---t-------t---------------------t--------------------t---------t--------------|        
|t.No |t.TlpV |t.Foto|t.L|t.AgenV|t.Kor                |t.Kes               |t.Notif  |t.SdmJ        |
\-----.-------.------.---.-------.---------------------.--------------------.---------.--------------/
IMAGE(tmptrans)
|_____|_______|______|___|_______|_____________________|____________________|_________|______________|___|   

FIELD(tmptranst)
svistr1		PROTECT 		INPUTRI	1	/* nip */
lnamanip2a	PROTECT			INPUTRI	2	/* nama */
svistr3		PROTECT			INPUTRI	3	/* jabatan */
svitgl1		PROTECT	{DD-MM-YYYY}	INPUTRI	4	/* tgl */
lsystimeR2a	PROTECT			INPUTRI	5	/* Jam Review */
svistr10	PROTECT			INPUTRI	6	/* No Telp */

FIELD(tmptrans)
svinourt	PROTECT				INPUTRI	10	/* 10. No Urut */
sviyt1   	NOCHANGE			INPUTRI	11	/* 11. Telp Valid */
sviyt2		NOCHANGE			INPUTRI	12	/* 12. Foto Sesuai */
svistr31	NOCHANGE			INPUTRI	13	/* 13. Longlat Sesuai */
svistr9 	NOCHANGE			INPUTRI	14	/* 14. Agen Valid */
sviket          TEXTAREA ALLCAPS                INPUTRI 16      /* 16. Koreksi  */
svistr2		PROTECT				INPUTRI	18	/* 18. Kesimpulan */
svitype2	PROTECT 			INPUTRI 18	/* 18. Notif ke SDM */
svitype3	NOCHANGE			INPUTRI 19	/* 19. SDM Jawab */
svistr1         PROTECT QPROTECT                INPUTRI 20      /* 20. Hasil */

CALCS()
csystimeR2a	SYSTIME

DEFAULTS(tmptrans)
ltglbesok	INIT		{cbesok}

sviyt1   DFALT_SCAN	BLANKS	
				Y1	"DIANGKAT-TERHUBUNG"
				Y2	"TIDAK DIANGKAT" 
				T	"TDK TERHUBUNG-TDK TERDAFTAR"
sviyt2 		DFALT_LIST	BLANKS	Y T
svistr31	DFALT_LIST	BLANKS	Y T
svistr9 	DFALT_LIST	BLANKS	Y T
svitype3	DFALT_LIST	BLANKS	Y T

CALCS()
cdjoinsvifu2a	djoinsvifu2a == 1
cagenvTa        svistr9 == "T"
cbknPic		g_usrkode == svitblkode

EDITS(tmptrans)
t.Mandatory	sviyt1		MANDATORY
t.Mandatory	sviyt2		MANDATORY
t.Mandatory	svistr31	MANDATORY
t.Mandatory	svistr9 	MANDATORY
t.Mandatory	sviket		MANDATORY_IF cagenvTa
t.Mandatory	svitype3	MANDATORY_IF cbknPic

t.Validate	svistr1		VALIDATE psikodidx mpsirev2a 0

MAP(mpsirev2a)
psikode		svistr1		REPLACE
psinama		lnamanip2a	REPLACE
svidf1		ltime2a		REPLACE
lsvitglfu2a	lsvitglfu2a	REPLACE_IF cdjoinsvifu2a

MAP(mjam2a)
csystimeR2a     svidf1          DO_CALC
svidf1		lsystimeR2a	REPLACE

CALCS()
cjkpica		g_usrkode != svistr1 
chasilY2a       (sviyt1 == "Y1" || sviyt1 == "Y2")  && svistr9 == "Y"
chasilT2a       sviyt1 == "T" || svistr9 == "T"
csesuai2a       "VALID"
ctdksesuai2a    "TDK_VALID"
ckesimpulanaT	svistr2 == "TDK_VALID"
ckesimpulanaY	svistr2 == "VALID"
cjkkbaa		g_usrkode != svitblkode 
cinikba		g_usrkode == svitblkode
ctdkV		svistr3 == "PICMKT" && svitype2 == "Y" && svitype3 == BLANKS
cketkbaY	"JWB NOTIF SDM 6D 878"
crevgab2	(sviyt1 == BLANKS && (g_usrkode == svistr1 || g_grpnam == "RI" || g_grpnam == "RAS"))
		||
		(sviyt1 != BLANKS && (g_usrkode == svitblkode || g_grpnam == "IT"))
cdjoinabkkbaa   djoinabkkbaa == 1 && svitype3 == "Y" && svistr3 == "PICMKT" 
/* cdjoinabkkbab   djoinabkkbab == 1 && svitype3 == "Y" */
cnotelpTV2      djointldsvi2 == 1 && sviyt1 == "T"
cblanksa	BLANKS

MAP(mhasilpic2a)
csesuai2a       svistr2         DO_CALC_IF chasilY2a
ctdksesuai2a    svistr2         DO_CALC_IF chasilT2a

MAP(mnotif2)
cY		svitype2	DO_CALC_IF ckesimpulanaT
cblanksa        svitype2        DO_CALC_IF ckesimpulanaY

HOOKS(tmptrans)
AFTER_INPUT     cur_field=svistr9	DO_MAP SHOW mhasilpic2a
AFTER_INPUT     cur_keybd=EN            DO_MAP SHOW mnotif2
BEFORE_INPUT	cur_field=sviket 	DO_SKIP_IF cjkpica
BEFORE_INPUT	cur_field=svitype3	DO_SKIP_IF cjkkbaa
AFTER_INPUT     cur_keybd=EN 		DO_MAP SHOW mjam2a

BEFORE_INPUT	cur_field=sviyt1  	DO_SKIP_IF cinikba
BEFORE_INPUT	cur_field=sviyt2  	DO_SKIP_IF cinikba
BEFORE_INPUT	cur_field=svistr31	DO_SKIP_IF cinikba
BEFORE_INPUT	cur_field=svistr9 	DO_SKIP_IF cinikba
BEFORE_INPUT	cur_field=sviket  	DO_SKIP_IF cinikba
SUBFILE(tmptrans)
SFL_LINES(4)
SFL_SHOW_NEXT
SFL_TITLE(tmptranst)
SFL_SORT_BY_FIELD svinourt
SFL_TARGET	svidatbuktyp    lreviewspk tkmnobuk

MAP(mupdabkmmsls2a)
gv_CLSD         abksts          REPLACE

MAP(mdumc2a)
DEBUG ldum	ldum		REPLACE

MAP(maddabkKBA)
lKUNCIABSEN     abkdata         REPLACE
svitblkode      abkkym          REPLACE
svinobuk        abknobuk        REPLACE
cbesok		abktgl          DO_CALC
cketkbaY        abkkym2         DO_CALC
l878            abkscr          REPLACE
DEBUG gt_RINP   abksts          REPLACE

MAP(mupdpsm2)
gv_CLSD         psmstssup	REPLACE

SPCALCS(sptmprevmm2a)
        DO_LIB                  ap_dbclc(DNAME dupdtkmmm2a,DCOMMAND UPDATE,DTARGET tkmbukidx svinobuk,DMAP mupdtkmrev);
	DO_LIB_IF cnotelpTV2     ap_dbclc(DNAME dupdpsm2,DCOMMAND UPDATE,DTARGET psmktpidx lnoktp2, DMAP mupdpsm2);

        DO_LIB_IF cdjoinabkkbaa	ap_dbclc(DNAME dupdabkkbaa,DCOMMAND UPDATE_RANGE,DTARGET abkdatbukidx lKUNCIABSEN svinobuk,DMAP mupdabkmmsls2a);
/*	DO_LIB_IF cdjoinabkkbab	ap_dbclc(DNAME dupdabkkbab,DCOMMAND UPDATE,DTARGET abkdatstskym lKUNCIABSEN gt_RINP svitblkode l878a ltglbesok svinobuk,DMAP mupdabkmmsls2a); */

        DO_LIB_IF cdjoinabkreva	ap_dbclc(DNAME dupdabka2a,DCOMMAND UPDATE,DTARGET abkdatstskym lKUNCIABSEN gv_INPG svistr1 l878a svitgl1 svinobuk,DMAP mupdabkmmsls2a);
	DO_LIB_IF cdjoinabkrevb	ap_dbclc(DNAME dupdabkb2a,DCOMMAND UPDATE,DTARGET abkdatstskym lKUNCIABSEN gt_RINP svistr1 l878a svitgl1 svinobuk,DMAP mupdabkmmsls2a);
	DO_LIB			ap_dbclc(DNAME dmapmapc2a,DCOMMAND MAPMAP,DMAP mdumc2a);
	DO_LIB_IF ctdkV         ap_dbclc(DNAME daddabkKBA, DCOMMAND ADD, DFILE abk, DMAP maddabkKBA);	

POSTING(tmptrans)
PST_UPDCMD      sptmprevmm2a

PERMIT(tmptrans)
	PMT_ADD_COND	c0
	PMT_UPDALL_COND	crevgab2
	PMT_DEL_COND	c0