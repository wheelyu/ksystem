LOCAL
PGM_FIELDS
lKETTOLAKSURVEY		STRING		21
lcmsmcs		STRING	21
lsgmstr5	STRING	21
lbtmcab1		STRING	21
lbtmcab2		STRING	21
lhasil1a	STRING	21
lhasil1b	STRING	21
lhasil1c	STRING	61
l4688a			INT2            2
lm4688a			STRING          15
lrmdgab         STRING  61
lindukkk	STRING	11

IMAGE(tmptranst) 
/--------------------------------------------------------------------------------------------------\
| /----------------------------------------------------------------------------------------------\ |
   i.Acctacc          : __  _________
   i.Keterangan       : __  ________________________ _ _

| \----------------------------------------------------------------------------------------------/ |
