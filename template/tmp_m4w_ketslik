    svistr3             DFALT_SCAN_BLANKS       ACC     TACC
    svistr4             DFALT_SCAN_BLANKS       ACC     TACC

CALCS()
    cupdtmp             btmsts == "701" && btmflag1 == "SLIK" && svistr1 == "NOT OK" && (g_grpnam == "B.M4WBM" || g_grpnam == "B.M4WRM" || g_grpnam == "B.M4WCM" || g_grpnam == "B.M4WDVH" || g_grpnam == "RI" || g_grpnam == "IT")
    caksestmp           g_grpnam == "B.M4WBM" || g_grpnam == "B.M4WRM" || g_grpnam == "B.M4WDVH" || g_grpnam == "RI" || g_grpnam == "IT" || g_grpnam == "B.M4WMSPV" || g_grpnam == "B.M4WCM" || g_grpnam == "B.M4WCA" || g_grpnam == "RAS"
    
    caccbmisi           svistr3 != BLANKS || svistr4 != BLANKS

    cbknrm              g_grpnam != "B.M4WRM"
    cbknho              g_grpnam != "B.M4WCM"

    cbesok              lsystime2 >= l1630 
    chariesok           g_tgltrn + 1

    /* KALO NOT OK ISI DULU BARU KE SRVY, KALO OK UDH AUTO SRVY DI 2918 PIL 42 */
    ckeSRVY             svistr1 == "NOT OK" && svistr2 == "OK" && svistr4 == "ACC"

    cnobuk3502          "BTLPK" + THBLS(g_tgltrn)
    cketabk             "DETAIL KET SLIK"
    cbadslik            "SLIK NOT OK"

