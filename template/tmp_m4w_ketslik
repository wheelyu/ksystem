    l3502               abkscr                  REPLACE

MAP(mupdketslik)
    lSRVY               btmflag1                REPLACE
                        
SPCALCS(sptmpketslik)
    DO_LIB_IF ckeSRVY                           ap_dbclc(DNAME dupdbtmketslik,DCOMMAND UPDATE,DTARGET btmprmidx btmprm,DMAP mupdketslik);
    DO_LIB                                      ap_dbclc(DNAME daddnobuk3502,DCOMMAND MAPMAP,DMAP mnobuk3502);
    DO_LIB_IF cjoinabkketslikrm                 ap_dbclc(DNAME daddabktmpketslikrm,DCOMMAND ADD,DFILE abk,DMAP maddabkketslik);
    DO_LIB_IF cbukakuncirm                      ap_dbclc(DNAME dupdabkketslikrm,DCOMMAND UPDATE_RANGE,DTARGET abkdatbukidx lkunciabsen btmnobuk,DBC_COND cabkketslikrm,DBC_MAP mupdabkketslik);
    DO_LIB_IF cjoinabkketslikho                 ap_dbclc(DNAME daddabktmpketslikho,DCOMMAND ADD,DFILE abk,DMAP maddabkketslik);
    DO_LIB_IF cbukakunciho                      ap_dbclc(DNAME dupdabkketslikho,DCOMMAND UPDATE_RANGE,DTARGET abkdatbukidx lkunciabsen btmnobuk,DBC_COND cabkketslikho,DBC_MAP mupdabkketslik);
    DO_LIB_IF cbentuk3502                       ap_dbclc(DNAME daddbentuk3502,DCOMMAND ADD,DFILE tlm,DLTARGET tlmbukidx tlmnobuk,DLLEN {stspjbuk},DMAP maddtlmbentuk3502);
    DO_LIB_IF cbentuk3502x                      ap_dbclc(DNAME daddbentuk3502x,DCOMMAND ADD,DFILE abk,DMAP maddabkbentuk3502x);

