IMAGE(tmptranst)
/------------------------------------------------------------------\
 /----------------------------------------------------------------\
 | t.Enter ____        t.NipUser_______                           |
 \----------------------------------------------------------------/
                             t.736HrIni
 t.Dvs    t.Awal        t.CLSD          t.Blm       t.Fraud
 t.Hmc  _____________ _____________ _____________ _____________  
 t.M2W  _____________ _____________ _____________ _____________  

\------------------------------------------------------------------/
IMAGE(tmptrans)

FIELD(tmptranst)
lenter                  NOCHANGE                INPUTRI 1
lvariant                NOCHANGE                INPUTRI 1

lawlhmc			PROTECT			INPUTRI 2
lclsdhmc		PROTECT			INPUTRI 3
lblmhmc			PROTECT			INPUTRI 4
lfraudhmc		PROTECT			INPUTRI 5

lawlm2w                 PROTECT                 INPUTRI 2
lclsdm2w                PROTECT                 INPUTRI 3
lblmm2w                 PROTECT                 INPUTRI 4
lfraudm2w               PROTECT                 INPUTRI 5



DEFAULTS(tmptranst)
lvariant                INIT            {tlmcab}
lenter                  INIT            TAB

ltglawl                 INIT            {cawlbln}
lthbl5			INIT		{cthbl}

lawlhmc                 INIT		BLANKS
lclsdhmc                INIT		BLANKS
lblmhmc                 INIT		BLANKS
lfraudhmc               INIT		BLANKS

lawlm2w                 INIT		BLANKS
lclsdm2w                INIT		BLANKS
lblmm2w                 INIT		BLANKS
lfraudm2w               INIT		BLANKS


CALCS()
cawlhmc		mtscab==tlmcab && mtsdvs=="HMC"
cawlm2w		mtscab==tlmcab && mtsdvs=="M2W"

cclsdhmc	mtscab==tlmcab && mtsdvs=="HMC" && mtssts=="CLSD"
cclsdm2w	mtscab==tlmcab && mtsdvs=="M2W" && mtssts=="CLSD"

cblmhmc		mtscab==tlmcab && mtsdvs=="HMC" && mtssts!="CLSD"
cblmm2w		mtscab==tlmcab && mtsdvs=="M2W" && mtssts!="CLSD"

cfraudhmc	mtscab==tlmcab && mtsdvs=="HMC" && mtsgrup=="FRAUD"
cfraudm2w	mtscab==tlmcab && mtsdvs=="M2W" && mtsgrup=="FRAUD"

MAP(mscanmtsresurvey)
c1		lawlhmc			DO_CALC_IF cawlhmc 
c1		lawlm2w			DO_CALC_IF cawlm2w

c1		lclsdhmc		DO_CALC_IF cclsdhmc
c1		lclsdm2w		DO_CALC_IF cclsdm2w

c1              lblmhmc                 DO_CALC_IF cblmhmc
c1              lblmm2w                 DO_CALC_IF cblmm2w

c1              lfraudhmc               DO_CALC_IF cfraudhmc
c1              lfraudm2w               DO_CALC_IF cfraudm2w

DBCALCS(dbscanmtsresurvey)
        DBC_COMMAND     SCANSCAN
        DBC_TARGET      mtsdattglidx   lresurvey tlmtgl  
        DBC_LAST_TARGET mtsdattglidx   lresurvey tlmtgl  
        DBC_SUM_MAP     mscanmtsresurvey


MAP(mhitungresurvey)
lawlhmc         lawlhmc                 REPLACE
lawlm2w         lawlm2w                 REPLACE

lclsdhmc        lclsdhmc                REPLACE
lclsdm2w	lclsdm2w                REPLACE

lblmhmc		lblmhmc                 REPLACE
lblmm2w		lblmm2w                 REPLACE

lfraudhmc	lfraudhmc               REPLACE
lfraudm2w	lfraudm2w               REPLACE


HOOKS(tmptranst)
AFTER_INPUT     cur_field=lenter        DO_SCAN dbscanmtsresurvey
AFTER_INPUT     cur_field=lenter        DO_MAP SHOW mhitungresurvey

SUBFILE(tmptrans)
SFL_APP_TYPE
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_TARGET
        cabkodidx   tlmcab

