/*cjenismtr		djoinjnsmtr == 1 && ljenismtr == "EKSTERNAL"*/
cjoinnamcrmtr		djoinnamacrmtr == 1
ccektglmitra		lpsmtgl2 == g_tgltrn
			/*
			(ltgmke == 1 && lpsmtgl2 == g_tgltrn) ||
			(ltgmke == 2 && lpsmtgl2 >= (g_tgltrn-1) && lpsmtgl2 <= g_tgltrn) ||
			(ltgmke == 3 && lpsmtgl2 >= (g_tgltrn-2) && lpsmtgl2 <= g_tgltrn) ||
			(ltgmke == 4 && lpsmtgl2 >= (g_tgltrn-3) && lpsmtgl2 <= g_tgltrn) ||
			(ltgmke == 5 && lpsmtgl2 >= (g_tgltrn-4) && lpsmtgl2 <= g_tgltrn) ||
			(ltgmke == 6 && lpsmtgl2 >= (g_tgltrn-5) && lpsmtgl2 <= g_tgltrn)
			*/
cjoinurtcrmtr0  	djoinurutcrmtr==0 && g_curcmd==1
cjoinurtcrmtr1  	djoinurutcrmtr==1 && g_curcmd==1
curtcrmtr1      	FLD_TO_STRING(svinourt) + "FTCRMITRA"
curtcrmtr2		FLD_TO_STRING(svinourt) + "SFCRMITRA"
