e.IsiKeterangan   sviket              MANDATORY_IF cfreetext
e.IsiJawabCMS     sviyt1              MANDATORY_IF cadakirimanCMO

MAP(mvalusr)
cBLANKS         lpembuktian             DO_CALC
cBLANKS         lverifikasi             DO_CALC
cBLANKS         ltbtdf1                 DO_CALC
cBLANKS         ltbtdf2                 DO_CALC
cBLANKS         lsifatbukti             DO_CALC
cBLANKS         lkirimanCMO             DO_CALC
cBLANKS         lsifatPengisian         DO_CALC
cGabFTCMS       lSviKodeCMS             DO_CALC
cAmStrKode      lSviKodeTbt             DO_CALC
cGabStrKode     lSviGabTbt              DO_CALC

MAP(mtbttbdkode)
tbtket          lpembuktian             REPLACE
tbttbdket       lverifikasi             REPLACE
tbtdf1          ltbtdf1                 REPLACE
tbtdf2          ltbtdf2                 REPLACE
cTAMBAHAN       lsifatbukti             DO_CALC
cMANDATORY      lsifatbukti             DO_CALC_IF cmandatory
cBLANKS         lsifatbukti             DO_CALC_IF ctbtdf2BLANKS
cTIDAKADAKRMAN  lkirimanCMO             DO_CALC
cADAKRMAN       lkirimanCMO             DO_CALC_IF cadakirimanCMO
cBLANKS         lkirimanCMO             DO_CALC_IF csvitidakada
cOPSIONVER      lsifatPengisian         DO_CALC
cWAJIBVER       lsifatPengisian         DO_CALC_IF cadakirimanCMO
cBLANKS         lsifatPengisian         DO_CALC_IF csvitidakada

MAP(misitambahanverif)
