DBCALCS(dUpdSviUploadCMS)
        DBC_COMMAND     UPDATE
        DBC_TARGET      sviprmidx sviprm
        DBC_MAP         mUpdSviUploadCMS

SUBFILE(tmptrans)
SFL_LINES(1) /* subfile hanya 1 baris */
SFL_HEADER(transheader)
SFL_TITLE(tmptranst)
SFL_COND cCMSsetujupkjCMO /* jika CMS setuju, maka tampilkan subfile */
SFL_SELECT cOnlyBuktiPekerjaan /* only svitblkode PKJ */
SFL_UPL_DELCOND c0 /* ga bisa hapus gambar */
SFL_UPL_DIRFLD btmtgl /* tanggal upload */
SFL_UPLFLD btmnobuk svikode
SFL_UPLFLD2 btmnobuk lSviKodeCMS
