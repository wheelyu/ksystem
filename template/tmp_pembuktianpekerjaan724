cadakirimanCMO                  svidf8!=BLANKS && svidf6!=BLANKS && svidf7!=BLANKS && svitgl2!=BLANKS
cMandatoryYT1_TidakSetuju       ltbtdf2 == 1 && sviyt1 == "T"
cMandatoryYT1_Setuju            ltbtdf2 == 1 && sviyt1 == "Y"
cMANDATORY                      "MANDATORY"
cTAMBAHAN                       "NON MANDATORY"
cADAKRMAN                       "ADA UPLOAD"
cTIDAKADAKRMAN                  "TIDAK ADA UPLOAD"
cWAJIBVER                       "WAJIB VERIFIKASI"
cOPSIONVER                      "PERLU MINTA TAMBAHAN?"
cisiket                         DO_LIB ap_strln(sviket,&lisiket);
cminisiket	                (lkirimanCMO!="TIDAK ADA UPLOAD" && lisiket >=20 && ltbtdf1 == 2) || (ltbtdf1 == 1) || (ltbtdf1 == 2 && lkirimanCMO=="TIDAK ADA UPLOAD") 
				|| g_grpnam!="TUTUP"
