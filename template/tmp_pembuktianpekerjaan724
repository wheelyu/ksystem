AFTER_INPUT     cur_field=sviket        DO_MAP SHOW misiket
AFTER_INPUT     cur_field=sviket 	DO_MAP SHOW
                IF cminisiket mdum
                ELSE HKCURSOR STAY
                HKMSG t.Min20Karakter
