FIELD(tmptranst)
g_usrkode         PROTECT UNSEEN      INPUTRI   1 /* validasi user kode, trigger kosong lokal */
svikode           PROTECT UNSEEN      INPUTRI   1 /* kode foto bukti pekerjaan */

/* Informasi dari pembuktian yang dikirim */
lsifatbukti       PROTECT             INPUTRI   2 /* sifat bukti dr cmo mandatory / tambahan */
lkirimanCMO       PROTECT             INPUTRI   2 /* ada kiriman cmo apa tidak */
lsifatPengisian   PROTECT             INPUTRI   2 /* sifat pengisian harus diisi apa tidak */

/* Field Konten */
lpembuktian       TEXTAREA 3 PROTECT  INPUTRI   3 /* pembuktian pekerjaan dari masteran */
lverifikasi       TEXTAREA 3 PROTECT  INPUTRI   4 /* verifikasi dari masteran */
sviket            TEXTAREA 3          INPUTRI   5 /* keterangan pembuktian pekerjaan, tergantung cbukanfreetext */
sviyt1            NOCHANGE            INPUTRI   6 /* jawaban CMS, tergantung cmandatory */
sviyt2            NOCHANGE            INPUTRI   7 /* minta tambahan verifikasi */
lenter            NOCHANGE            INPUTRI   8 /* trigger enter */

DEFAULTS(tmptranst)
sviyt1		DFALT_SCAN	BLANKS
                                Y "Y"
                                T "T"
sviyt2		DFALT_SCAN	BLANKS
                                Y "Y"
                                T "T"
lY              INIT            Y
lT              INIT            T

EDITS(tmptranst)
t.Validate        g_usrkode           VALIDATE  usrkodidx mvalusr /* trigger kosong lokal */
