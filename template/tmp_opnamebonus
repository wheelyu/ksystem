LOCAL
PGM_FIELDS
lurtf           INT2            2
lokbonus        STRING          21
ltglbns		STRING		21

MAP(mjointldf)
tldnourt        lurtf           REPLACE
DBCALCS(djointldf)
        DBC_COMMAND     JOIN_LAST_SFL
        DBC_TARGET      tldbukurtidx    tlmnobuk
        DBC_MAP         mjointldf

IMAGE(tmptranst)
/------t-------------------t------------------t---------------t-------------t------------t------------\
|t.No  |t.Brg              |t.Lok             |t.Hrg          |t.Jumlah     |t.Latitude  |t.Longitude |
\------.-------------------.------------------.---------------.-------------.------------.------------/
IMAGE(tmptrans)
|______|___________________|__________________|_______________|_____________|___.________|___.________|

FIELDS(tmptrans)
tldnourt                PROTECT                 INPUTRI         1
tldnobbm                ALLCAPS SCROLL          INPUTRI         1
tlddvs                  ALLCAPS SCROLL          INPUTRI         2
tldhrg                  ALLCAPS                 INPUTRI         3
tldjml                  ALLCAPS SCROLL          INPUTRI         4
tldperdis4      	PROTECT                 INPUTRI         4
tldperdis5      	PROTECT                 INPUTRI         4

DEFAULTS(tmptrans)
tldtglfak		INIT_ADD	{g_tgltrn}
tldplg          	INIT_ADD        {g_usrkode}
tldsts			INIT_ADD	ADD
lokbonus		INIT		LOKBONUS
ltglbns			INIT		20220405

CALCS()
curtf           lurtf + 1
cjointld0f      djointldf == 0 && g_curcmd == 1
cjointld1f      djointldf == 1 && g_curcmd == 1
cubhbnsx	g_curcmd != 2
cubhbns		g_curcmd == 2

EDITS(tmptrans)
e.MandatoryBrg          tldnobbm        MANDATORY
e.MandatoryLok          tlddvs          MANDATORY
/*e.MandatoryJml          tldjml          MANDATORY*/
e.ValidateLok		tlddvs		VALIDATE_IF cubhbnsx	tbddatkodidx mtbd2 stbd {Pgv_dttabel} {Pgv_barang} {Plokbonus}
e.Dupkey                tlddvs          DUPKEY          	tldbukbbmidx {Ptlmnobuk} {Ptldnobbm} {Ptlmcab}

MAP(mtbd2)
tbdkode		tlddvs		REPLACE

MAP(murtf)
gv_int1         tldnourt        REPLACE_IF cjointld0f
curtf           tldnourt        DO_CALC_IF cjointld1f


HOOKS(tmptrans)
BEFORE_INPUT    cur_field=tldnobbm      DO_MAP SHOW murtf
BEFORE_INPUT    cur_field=tldnobbm      DO_SKIP_IF cubhbns
BEFORE_INPUT    cur_field=tlddvs        DO_SKIP_IF cubhbns
BEFORE_INPUT    cur_field=tldhrg        DO_SKIP_IF cubhbns



SUBFILE(tmptrans)
SFL_TITLE(tmptranst)
SFL_LINES(10)
SFL_COND   cbonus
SFL_SELECT      cbknSISTEMa
SFL_TARGET
tldbukurtidx    tlmnobuk   

SFL_MAP
tlmnobuk        tldnobuk        REPLACE
tlmdata         tlddata         REPLACE
tlmcab          tldcab          REPLACE
tlmtype1        tldgrup         REPLACE
g_lat         	tldperdis4      REPLACE
g_lon         	tldperdis5      REPLACE

CALCS()
cplus1f         tlmtotal + 1
cmins1f         tlmtotal - 1

MAP(mupdtlmaddf)
cplus1f         tlmtotal        DO_CALC

MAP(mupdtlmupdf)
cmins1f         tlmtotal        DO_CALC


SPCALCS(sptrans2addf)
DO_LIB          ap_dbclc(DNAME dupdtlmaddf, DCOMMAND UPDATE, DTARGET tlmbukidx tldnobuk, DMAP mupdtlmaddf);

SPCALCS(sptrans2updf)
DO_LIB          ap_dbclc(DNAME dupdtlmupdf, DCOMMAND UPDATE, DTARGET tlmbukidx tldnobuk, DMAP mupdtlmupdf);

POSTING(tmptrans)
        PST_ADDCMD      sptrans2addf
        PST_DELCMD      sptrans2updf

