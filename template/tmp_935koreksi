DO_LIB_IF cabkkordevhead0	ap_dbclc(DNAME daddabkkordevhead,DCOMMAND ADD,DFILE abk,DMAP maddabkkordevhead);
DO_LIB_IF cabkkordcoo0		ap_dbclc(DNAME daddabkkordcoo,DCOMMAND ADD,DFILE abk,DMAP maddabkkordcoo);
