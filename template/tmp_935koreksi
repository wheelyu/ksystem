tkdtype		PROTECT				INPUTRI	5	

DEFAULTS(tmptranst)
tkdtgl		INIT	{g_tgltrn}
tkdsts		INIT	{gv_INPG}

DBCALCS(djoinabkkordev)
	DBC_COMMAND	JOIN
	DBC_TARGET	abkdatbukidx	lKUNCIABSEN lnipdev
	DBC_SELECT	ctipekoreksi

DBCALCS(djoinabkkordevhead)
	DBC_COMMAND	JOIN
	DBC_TARGET	abkdatbukidx	lKUNCIABSEN lnipdevhead
	DBC_SELECT	ctipekoreksi

DBCALCS(djoinabkkordcoo)
	DBC_COMMAND	JOIN
	DBC_TARGET	abkdatbukidx	lKUNCIABSEN lnipdcoo
	DBC_SELECT	ctipekoreksi

MAP(mjoinurutkorbhnmeet)
tkdnourt		ltkdnourt	REPLACE
DBCALCS(djoinurutkorbhnmeet)
	DBC_COMMAND	JOIN_LAST_SFL
	DBC_TARGET	tkddatbukll lKOR935 tlmnobuk
	DBC_MAP		mjoinurutkorbhnmeet

CALCS()
/* cjoinnipdev		djoinnipdev == 1*/
cHplus1			g_tgltrn + 1
cfartglmeet		tlmtgl2 - g_tgltrn > 2
cHmin1			tlmtgl2 - 1
cdkttglmeet		tlmtgl2 - g_tgltrn <= 2
cabkkordev0		djoinabkkordev == 0
cabkkordevhead0		djoinabkkordevhead == 0
cabkkordcoo0		djoinabkkordcoo == 0
cnamafoto		"KOR935" + FLD_TO_STRING(tkdnourt)
cjoinurut0		djoinurutkorbhnmeet == 0
cjoinurut1		djoinurutkorbhnmeet == 1


MAP(murutkoreksi)
c1			tkdnourt	DO_CALC_IF cjoinurut0	
cnourt			tkdnourt	DO_CALC_IF cjoinurut1
tlmtgl2			tkdtgl2		REPLACE
tlmdari			tkdjenis	REPLACE

HOOKS(tmptranst)
BEFORE_INPUT		cur_field=tkdket	DO_MAP SHOW murutkoreksi

MAP(mupdtkd4)
c1			tkdjml2		DO_CALC
lOK			tkdtype		REPLACE
DBCALCS(dupdtkd4)
	DBC_COMMAND	UPDATE
	DBC_TARGET	tkdprmidx tkdprm
	DBC_MAP		mupdtkd4

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_SHOW_NEXT
SFL_SORT_BY_FIELD tkdnourt
SFL_SORT_UPDOWN DOWN
SFL_UPL_DIRFLD tlmtgl
SFL_DOCUPLFLD tkdoto tkdnoll
SFL_DOCUPLFLD_DBCALCS dupdtkd4
SFL_DOCUPL_DELCOND c0
SFL_TARGET	tkddatbukll lKOR935 tlmnobuk
SFL_MAP
tlmnobuk	tkdnobuk	REPLACE
lKOR935		tkddata		REPLACE
cnamafoto	tkdnoll		DO_CALC

MAP(mmap935koreksi)
tkdket		ltkdketkor	REPLACE
tkdtype		ltkdtypekor	REPLACE
tkdnoll		ltkdnollkor	REPLACE
DEBUG ldum	ldum		REPLACE

MAP(maddabkkordev)
