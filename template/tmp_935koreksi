tlmnobuk	abknobuk	REPLACE
l935		abkscr		REPLACE
lnippiccoe	abkkym		REPLACE
lketkormeet	abkkym2		REPLACE
cHplus1		abktgl		DO_CALC_IF cfartglmeet 		/*jika hari ini > H-2 dari tgl meeting*/
lINPH		abksts		REPLACE_IF cfartglmeet 		/*jika hari ini > H-2 dari tgl meeting*/
cHmin1		abktgl		DO_CALC_IF cdkttglmeet		/*jika hari ini H-1 or H-2 dari tgl meeting*/
lINPH		abksts		REPLACE_IF cdkttglmeet		/*jika hari ini H-1 or H-2 dari tgl meeting*/
lKOR935		abktype		REPLACE
DEBUG ldum	ldum		REPLACE

MAP(mupduplulang)
