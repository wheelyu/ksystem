e.Mandatory	ketisi		MANDATORY

MAP(mjoinputuslok)
ketnourt	lurut		REPLACE

DBCALCS(djoinputuslok)
	DBC_COMMAND	JOIN_LAST_SFL
	DBC_TARGET	ketbukurtidx lPUTUSANLOK mtsnobuk
	DBC_MAP		mjoinputuslok

CALCS()
cjoinputuslok1	djoinputuslok==1 && g_curcmd==1
cjoinputuslok0	djoinputuslok==0 && g_curcmd==1
ckode1		"B" + STRIP(mtsnobuk) + STRIP(lurutstr)
cPEMUTUSAN	"PEMUTUSAN"

MAP(mmapsublok1)
c1		ketnourt	DO_CALC_IF cjoinputuslok0
curut		ketnourt	DO_CALC_IF cjoinputuslok1
ketnourt	lurutstr	REPLACE_IF ctambah
ckode1		ketkode		DO_CALC_IF ctambah

HOOKS(tmptranst)
AFTER_INPUT	cur_keybd=EN	DO_MAP SHOW mmapsublok1

MAP(mupdmaster1)
gv_INPG		mtssts		REPLACE
cPEMUTUSAN	mtsdvs		DO_CALC

SPCALCS(saddsublok1)
	DO_LIB ap_dbclc(DNAME dupdmaster1,DCOMMAND UPDATE,DTARGET mtsbukidx mtsnobuk,DMAP mupdmaster1);

POSTING(tmptrans)
	PST_ADDCMD	saddsublok1
	PST_UPDCMD	saddsublok1

SUBFILE(tmptrans)
SFL_TITLE(tmptranst)
SFL_LINES(1)
