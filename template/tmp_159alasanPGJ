BEFORE_INPUT	cur_field=psdket	DO_SKIP_IF cisiket
BEFORE_INPUT	cur_field=psdtype2	DO_SKIP_IF cisiacc
BEFORE_INPUT	cur_field=psdket2	DO_SKIP_IF cisiacc2
BEFORE_INPUT	cur_field=psdstr1	DO_SKIP_IF cisibanking
BEFORE_INPUT	cur_field=psdstr2	DO_SKIP_IF cisicmbn
AFTER_INPUT     cur_keybd=EN            DO_MAP  SHOW misitgl2

MAP(misitgl2)
g_tgltrn        psdtgl1         REPLACE_IF ckondtambah
g_tgltrn        psdtgl2         REPLACE_IF cisidetacc                 

MAP(mupdpsdUPL)
cY          psdstr3     DO_CALC

DBCALCS(dupdpsdUPL)
        DBC_COMMAND     UPDATE
        DBC_TARGET      psdprmidx   psdprm  
        DBC_MAP         mupdpsdUPL


        
