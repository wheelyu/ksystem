IMAGE(tmptrans)

FIELD(tmptranst)
psdtgl1     PROTECT {DD-MM-YYYY}    INPUTRI 1
psdtgl2     PROTECT {DD-MM-YYYY}    INPUTRI 3
psdtype2     NOCHANGE                INPUTRI 4
psdket2     TEXTAREA                INPUTRI 5
psdstr4     NOCHANGE                INPUTRI 2
lalasanPGJ  PROTECT                 INPUTRI 2
psdstr1     NOCHANGE                INPUTRI 6
psdket      TEXTAREA                INPUTRI 3
psdstr2     NOCHANGE                INPUTRI 7     
psdstr3     NOCHANGE                INPUTRI 8

DEFAULTS(tmptranst)
psdtype2     DFALT_SCAN  BLANKS
                        ACC
                        TACC
psdstr1     DFALT_SCAN  BLANKS
                        Y
psdstr2     DFALT_SCAN  BLANKS
                        Y


EDITS(tmptranst)
t.Mandatory     psdket  MANDATORY
t.Mandatory     psdstr4  MANDATORY
