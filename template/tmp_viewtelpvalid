lfaktur		NOCHANGE		INPUTRI		1
lketvalid	NOCHANGE		INPUTRI		1


CALCS()
cjualx		(cabusaha=="FINCO" && djoinbkm==1) || (cabusaha=="DEALER" && djoinppm==1)
ctglawl		ststglprjgl + 1
cadajual	(djoinbkm==1 || djoinppm==1)

ctelpok         (djoinbkm==1 || djoinppm==1) && ((djoinbtm== 1 && ltypejl == "T" && djointlm840==1 && ltlmdari!=BLANKS) || (djoinbtm== 1 && ltypejl=="K" && djointlm840K==1 && ltlmbisnis=="VALID"))
ctelpnot        (djoinbkm==1 || djoinppm==1) && ((djoinbtm== 1 && ltypejl == "T" && djointlm840==1 && ltlmdari==BLANKS) || (djoinbtm== 1 && ltypejl=="K" && djointlm840K==1 && ltlmbisnis==BLANKS))
ctelpblm        (djoinbkm==1 || djoinppm==1) && ((djoinbtm==1 && ltypejl=="T" && djointlm840==0) || (djoinbtm==1 && ltypejl=="K" && djointlm840K==0))

cvalid		"VALID"
ctdkvld		"TDK VALID"
cblmtelp	"BLM TELP"

DEFAULTS(tmptrans)
lmktcab		INIT		MKTCAB
ltglawl		INIT		{ctglawl}
ltglakh		INIT		{g_tgltrn}
