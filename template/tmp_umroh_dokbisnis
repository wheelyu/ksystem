FIELD(tmptranst)
cmdkode	    NUMERIC {9999999999999999}   	INPUTRI 1
cmdnama1	ALLCAPS	SCROLL			INPUTRI	2
cmdstr1     ALLCAPS SCROLL          INPUTRI 3
cmdket1		TEXTAREA 2 SCROLL		INPUTRI	4
cmdarea		NUMERIC	SCROLL	{9999999999999}	INPUTRI	5
cmddvs		NUMERIC	SCROLL			INPUTRI	6
cmddf1		NOCHANGE			INPUTRI 7
cmddf2		NOCHANGE			INPUTRI 8

EDITS(tmptranst)
    e.Mandatory               cmdkode       MANDATORY               
    e.Mandatory               cmdnama1       MANDATORY      
    e.Mandatory               cmdstr1       MANDATORY           
    e.Mandatory               cmdket1     MANDATORY    
    e.Mandatory               cmdarea     MANDATORY     
    e.Mandatory               cmddvs     MANDATORY              

DEFAULTS(tmptranst)
lTRAVELUMR	INIT	TRAVELUMR
cmdstr1             DFALT_SCAN              BLANKS
                                                           OWNER
                                                           DIREKTUR
                                                           KOMISARIS

CALCS()
    cnik         DO_LIB ap_strln(lnik,&lpanjangNik);     /* Hitung panjang NIK menggunakan fungsi pustaka */
    cpanjangnik  lpanjangNik == 16                        /* Validasi apakah panjang NIK sama dengan 16 */
    
    cnomor1         DO_LIB ap_strln(lnomor1,&lpanjangNomor1); /* Hitung panjang Nomor menggunakan fungsi pustaka */
    cpanjangnomor1  lpanjangNomor1 == 13                        /* Validasi apakah panjang Nomor sama dengan 13 */
    
    cnomor2         DO_LIB ap_strln(lnomor2,&lpanjangNomor2);/* Hitung panjang Nomor menggunakan fungsi pustaka */
    cpanjangnomor2  lpanjangNomor2 == 13                        /* Validasi apakah panjang Nomor sama dengan 13 */

MAP(mpanjang)
    cmdkode     lnik             REPLACE      
    cnik        lpanjangNik      DO_CALC       /* Mapping hasil validasi panjang NIK */

MAP(mpanjang1)
    cmddvs     lnomor1             REPLACE       
    cnomor1     lpanjangNomor1      DO_CALC       /* Mapping hasil validasi panjang Nomor */

MAP(mpanjang2)
    cmdarea    lnomor2             REPLACE       
    cnomor2     lpanjangNomor2      DO_CALC       /* Mapping hasil validasi panjang Nomor */

HOOKS(tmptranst)
    AFTER_INPUT cur_field=cmdkode DO_MAP SHOW mpanjang  
    AFTER_INPUT cur_field=cmdkode
        DO_MAP SHOW
        IF cpanjangnik
            /* Jika panjang NIK valid, mapping ke mpanjang */
            mpanjang
        ELSE
            /* Jika panjang NIK tidak valid, tampilkan pesan error */
            HKCURSOR STAY
            HKMSG t.NikHarus16Digit

    AFTER_INPUT cur_field=cmddvs DO_MAP SHOW mpanjang1  
    AFTER_INPUT cur_field=cmddvs
        DO_MAP SHOW
        IF cpanjangnomor1
            /* Jika panjang Nomor valid, mapping ke mpanjang */
            mpanjang1
        ELSE
            /* Jika panjang Nomor tidak valid, tampilkan pesan error */
            HKCURSOR STAY
            HKMSG t.NomorHarus13Digit

    AFTER_INPUT cur_field=cmdarea DO_MAP SHOW mpanjang2  
    AFTER_INPUT cur_field=cmdarea
        DO_MAP SHOW
        IF cpanjangnomor2
            /* Jika panjang Nomor valid, mapping ke mpanjang */
            mpanjang2
        ELSE
            /* Jika panjang Nomor tidak valid, tampilkan pesan error */
            HKCURSOR STAY
            HKMSG t.NomorHarus13Digit


MAP(mupdktpppiu)
