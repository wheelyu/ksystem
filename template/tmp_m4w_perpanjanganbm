DBC_MAP         mjoinabkbmmou

DBCALCS(djoinabkdvhmou)
DBC_COMMAND     JOIN
DBC_TARGET      abkdatbukidx    lkunciabsen tlmnobuk
DBC_SELECT	cabkdvhmou

DBCALCS(djoinabkdvhdok)
DBC_COMMAND     JOIN
DBC_TARGET      abkdatbukidx    lkunciabsen tlmnobuk
DBC_SELECT	cabkdvhdok

MAP(mupdspkmou)
gv_Y		spkfoto		REPLACE
DBCALCS(dupdspkmou)
DBC_COMMAND     UPDATE
DBC_TARGET      spkprmidx       spkprm
DBC_MAP         mupdspkmou

MAP(mjoinspkperpanjang)
spkkat         lspkkat          REPLACE
DBCALCS(djoinspkperpanjang)
DBC_COMMAND     JOIN_LAST_SFL
DBC_TARGET      spkdatbuktyp lEXTERNAL tlmnobuk lBERKASMOU
DBC_MAP         mjoinspkperpanjang

