LOCAL
PGM_FIELDS
ltombolaprx	STRING	100

ltglkuncmou	DATE	4
ltglakhir	DATE	4
ltglreminderx	DATE	4

l11		INT2	2
l12		INT2	2
lspkkat        INT2    2

CALCS()
cabkdvhmou	abktype == "MOUDVH" && (abksts == gt_RINP || abksts == gv_INPG) 
cabkdvhdok	abktype == "ACCMOU" && (abksts == gt_RINP || abksts == gv_INPG) 
cabkbmmou       abktype == "MOUBM" && (abksts == gt_RINP || abksts == gv_INPG)

MAP(mjoinabkbmmou)
abktgl          ltglkuncmou     REPLACE
DBCALCS(djoinabkbmmou)
