	DO_LIB_IF cadajarak 	ap_dsGPS(svidf6,svidf7,svidf4,svidf5,&ljarak);
	dmapmapjarak
	DO_LIB 		ap_dbclc(DNAME dmap6d2,DCOMMAND UPDATE,DTARGET sviotoidx svioto, DMAP mmap6d2);
	DO_LIB_IF ckbaxx	ap_dbclc(DNAME dupdtld, DCOMMAND UPDATE_RANGE, DTARGET tldbukbrgoto svinobuk gv_OPEN lINFOALAMAT, DMAP mupdtldinfo);

SPCALCS(spcalc2)
