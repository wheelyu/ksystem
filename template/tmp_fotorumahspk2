CALCS()
cadagps         g_fotolat1 != "" && g_fotolon1 != "" && g_fotodate1 == g_tgltrn
cadajarak       svidf6!=BLANKS && svidf7!=BLANKS && svidf4!=BLANKS && svidf5!=BLANKS
