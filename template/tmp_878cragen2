spkkode7          ALLCAPS                 INPUTRI 13 /* JML KOMUNITAS */
ljmlkom           ALLCAPS                 INPUTRI 14 /* JML ANGGOTA */
spkkode8          PROTECT                 INPUTRI 15 /* JML ANGGOTA */
ljmlmotor         ALLCAPS                 INPUTRI 16 /* JML MOTOR */
