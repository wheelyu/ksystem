ljmlkry           ALLCAPS                 INPUTRI 9 /* JMLKRY */
spkkode5          PROTECT                 INPUTRI 10 /* JMLKRY */
spkkode6          CHECKBOX                INPUTRI 11 /* KOMUNITAS */
