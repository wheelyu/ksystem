e.ValidateJmlMotor      ljmlmotor        VALIDATE tbddatkodidx mtbdjmlmotorx stbdapk {Pgv_dttabel} {PlSPK21} {PlJMLANGGOTA}

MAP(mtbdjmlx)
tbdkode                 ljmlkry          REPLACE
tbdket                  spkkode5         REPLACE

MAP(mtbdkomx)
