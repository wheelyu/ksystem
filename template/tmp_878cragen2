spkkode3          ALLCAPS SCROLL          INPUTRI 5 /* SUBPEKERJAAN */
spkkode4          ALLCAPS SCROLL          INPUTRI 6 /* INDUSTRI */
lindustri         ALLCAPS SCROLL          INPUTRI 7 /* INDUSTRI */
