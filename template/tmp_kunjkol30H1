cspk32           lket30           DO_CALC_IF ccspk32
cspk33           lket30           DO_CALC_IF ccspk33
cspk34           lket30           DO_CALC_IF ccspk34


MAP(mpiksvi)
mtsnoasal        mtsnoasal        REPLACE

MAP(mpanjangnotelp)
