ccspk33          tkdjwbstr1=="3 "
ccspk34          tkdjwbstr1=="4 "
cspk31           "Konsumen"
cspk32           "Keluarga"
cspk33           "Tetangga"
cspk34           "RT/RW"
cpanjang         DO_LIB  ap_strln(tkdrek,&lpanjang);
ctelp            lpanjang >= 10 && lpanjang <=13


/*
