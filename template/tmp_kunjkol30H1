HOOKS(trans2g29t)
AFTER_INPUT             cur_field=tkdrek        DO_MAP SHOW mpanjangnotelp
AFTER_INPUT             cur_field=tkdrek        DO_MAP SHOW
                        IF ctelp mdum
                        ELSE HKCURSOR STAY
                        HKMSG t.btsnNOHP


SUBFILE(tmptrans)
SFL_LINES(1)
