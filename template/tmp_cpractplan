EDITS(tmptranst)
e.Mandatory spktgl  MANDATORY
e.Mandatory spktgg  MANDATORY
e.Mandatory spkfoto  MANDATORY
e.Mandatory spktgg4  MANDATORY
e.Mandatory spkket MANDATORY
e.Mandatory spknoasal MANDATORY
t.InputNipygBenar  spknoasal  VALIDATE psikodidx mpsi3 0
t.ValidateKatTopik      spktgg        VALIDATE tbddatkodidx mtbd2 stbdon {Pgv_dttabel} {PlPIUTREM} {PlKATTOPIKCOE}
t.Validatedivisi	spkfoto		VALIDATE tbddatkodidx mtbd3 stbdon {Pgv_dttabel} {PlPIUTREM} {PlTIPEKPICOE}
t.ValidateTopikMeet     spktgg4       VALIDATE tbtdattypkod mtbt2 stbtpros {Pgv_dttabel} {Pgv_dttabel21} {PlPIUTREM} {PlTIPEKPICOE} {Pspkfoto}

MAP(mpsi3)
psikode         spknoasal       REPLACE
psinama         lnamapjap       REPLACE

MAP(mkode3)
c1           	spklmtg		DO_CALC_IF cjoinspku0
curut           spklmtg		DO_CALC_IF cjoinspku1
