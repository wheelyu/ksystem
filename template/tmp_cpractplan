MAP(mtbd2)
tbdkode		spktgg		REPLACE
tbdket		lketkat		REPLACE
spktgl		spktglft	REPLACE_IF caddx
g_tgltrn	spktglft2	REPLACE_IF cadd

MAP(mtbd3)
