/*
ccalldecek      	g_curcmd==1 && (dscancalldeb==0 || dscancalldeb!=0) && ljmlcalldeb < 1 
covdcek			svitgl1 <= lovdmin && svitgl1 >= lovdmax
cfktcek         	lcab == tkmcab && lpikdvs == "M4W"
*/
