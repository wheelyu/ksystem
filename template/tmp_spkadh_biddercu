ctkdbidder	tkdnoll == "BIDDERCU"

DBCALCS(djointkdbidder)
	DBC_COMMAND	JOIN
	DBC_TARGET	tkdbukidx svinobuk gv_OPEN svinourt
	DBC_SELECT	ctkdbidder

