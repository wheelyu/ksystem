IMAGE(tmptrans)

FIELD(tmptranst)
lenter          NOCHANGE                INPUTRI         1

DEFAULTS(tmptranst)
lenter          INIT            "Tekan Enter Untuk Proses VOID"

CALCS()
cbolehbtl       tlmsts == "OPEN" || ((tlmsts == "RINP" ||  tlmsts == "INPG") && (g_grpnam == "FINBPKBCO" || g_grpnam == "RI" || g_usrkode == "1000055"))

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_APP_TYPE
SFL_COND cbolehbtl
SFL_SHOW_NEXT
SFL_TARGET tlmbukidx   tlmnobuk

CALCS()
cdjoinabk863    djoinabk863 == 1
cketvoid        "Dari" + " " + STRIP(tlmsts) + " " + "Ke VOID"
cBTL            "BTL"

MAP(mupdtlm863sts)
gv_VOID         tlmsts          REPLACE

MAP(mupdtld863sts)
gv_VOID         tldsts          REPLACE

MAP(mupdabk863)
gv_CLSD         abksts          REPLACE

MAP(maddakt)
tlmnobuk        aktkode         REPLACE
tlmdata         aktdata         REPLACE
gv_VOID         akttype         REPLACE
g_tgltrn        akttgl          REPLACE
lsystime        aktjam          REPLACE
g_usrkode       aktcrtusr       REPLACE
cketvoid        aktket          DO_CALC
cBTL            aktlok          DO_CALC

SPCALCS(spbatal863)
DO_LIB ap_dbclc(DNAME daddakt,DCOMMAND ADD,DFILE akt,DMAP maddakt);
DO_LIB ap_dbclc(DNAME dupdtld863sts,DCOMMAND UPDATE_RANGE,DTARGET tldbukbrgoto tlmnobuk,DMAP mupdtld863sts);
DO_LIB_IF cdjoinabk863 ap_dbclc(DNAME dupdabk863,DCOMMAND UPDATE_RANGE,DBC_TARGET abkdatbukidx lkunciabsen tlmnobuk,DMAP mupdabk863);
DO_LIB ap_dbclc(DNAME dupdtlm863sts,DCOMMAND UPDATE,DTARGET tlmbukidx tlmnobuk,DMAP mupdtlm863sts);

POSTING(tmptrans)
PST_COMMAND     spbatal863
