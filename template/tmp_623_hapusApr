CALCS()
ckondhpsapr     ppmstsapr == "TL" || ((ppmstsapr == "IN" || ppmstsapr == "OK") && (g_grpnam == "ADHSPV" || g_grpnam == "ADHDVH" || g_grpnam == "ADHHEAD" || g_grpnam == "ADHAM" || g_grpnam == "ADHHO" || g_grpnam == "FINBANKCO" || g_grpnam == "RI" || g_grpnam == "IT" || g_grpnam == "AHASSHEAD" || g_grpnam == "AHASSINVSPV"))
