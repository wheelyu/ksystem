IMAGE(tmptranst)
/-------------------t----------------t-------------t-----------------t--------------\ 
|i.Kode             |i.KeteranganCms |t.Potongan   | i.KeteranganCmo |t.Potongan    |
\-------------------.----------------.-------------.-----------------.--------------/ 

IMAGE(tmptrans)
|___________________|________________|_____________|_________________|______________|
FIELD(tmptrans)
nhdkode			PROTECT	SCROLL			INPUTRI	1
nhdnobbm		ALLCAPS SCROLL			INPUTRI	2
nhdhrg1			PROTECT	SCROLL			INPUTRI	3
nhdkode2		PROTECT SCROLL			INPUTRI	5
nhdhrg2			PROTECT	SCROLL			INPUTRI	6

DEFAULTS(tmptrans)
lU                      INIT            "U"

EDITS(tmptrans)
e.Validate nhdkode	VALIDATE tbtdattypkod  mtbt stbt {Pgv_dttabel} {Pgv_dttabel21} {Pgv_estimasi21} {Pgv_body}  {Slsegmen}
e.validate nhdnobbm     VALIDATE tbddatkodidx mtbd1 stbd {Pgv_dttabel} {Pgv_estimasi21} {Pgv_ganti21}
e.Mandatory     nhdnobbm  MANDATORY

CALCS()
cganti1		nhdnobbm=="GANTI"
cganti2		nhdnobbm=="LECET"
cganti3		nhdnobbm=="IMITASI"
cganti4		nhdnobbm=="TIDAKGANTI"
ckosong		0
cbodyok		nhdnobbm!="TIDAKADA" && nhdnobbm!="ADA"

MAP(mtbd1)
tbdkode		nhdnobbm	REPLACE

MAP(mtbt)
tbttbdkode      nhdkode REPLACE
tbttot		nhdhrg1		REPLACE_IF cganti1
tbtdf1		nhdhrg1         REPLACE_IF cganti3
tbtdf2		nhdhrg1         REPLACE_IF cganti2
ckosong		nhdhrg1		DO_CALC_IF cganti4


HOOKS(tmptrans)
AFTER_INPUT     cur_keybd=EN            DO_MAP SHOW
                IF cbodyok mdum
                ELSE HKCURSOR nhdnobbm
                HKMSG t.PilihanTdkBoleh

SUBFILE(tmptrans)
SFL_LINES(10)        
SFL_TITLE(tmptranst)

SFL_TARGET_GTE
nhdbukidx   btmnobuk gv_estimasi l1	{btmnobuk} {gv_estimasi} {l16}


/*----------------------------Perhitungan Ulang-------------------------------*/
CALCS()
cblmada         /*djoinmts==0 && */ lcairbaru!=lnhmcairpinj
chrgtaksir      nhmhrgpasar - ltotalestimasi - nhmbbnhpp
cscannhd1	dbscannhdEst!=0 || dbscannhdEst==0
ccairMtr1       btmtdjadi - nhmpladis - ltotalestimasi

MAP(mmapmap)
nhdkode		lnhdkode		REPLACE
nhdhrg1		ltotalestimasi2		REPLACE
ltotalestimasi	ltotalestimasi		REPLACE_IF cscannhd1
ctotalestimasi	ltotalestimasi		DO_CALC
ckosong         lnhmcairpinj            DO_CALC
ckosong         ltotpokbaru             DO_CALC
ckosong         langsuranbaru           DO_CALC
ckosong         lcairbaru               DO_CALC
nhmcairpinj    lnhmcairpinj    REPLACE
ctotalpokok    ltotpokbaru     DO_CALC


MAP(mupdnhm1)
ckosong         nhmestimasi     DO_CALC
ltotalestimasi  nhmestimasi     REPLACE
ctotalpokok     nhmtotpok       DO_CALC_IF cblmada
ctotalpokok	nhmtotpok       DO_CALC
chrgtaksir      nhmhrgpsr       DO_CALC
ccairMtr1       nhmcairpinj     DO_CALC

MAP(mmapdeb)
btmnobuk		nhdnobuk	REPLACE


SPCALCS(sptmptrans)
DO_LIB ap_dbclc(DNAME dmapmap,DCOMMAND MAPMAP,DMAP mmapmap);
DO_LIB ap_dbclc(DNAME dupdnhm1,DCOMMAND UPDATE,DTARGET nhmdatbukidx gv_dtbukutamu btmnobuk,DMAP mupdnhm1);
DO_LIB  ap_bulat(nhmbsrang,l500,&lhasilbulat,lU);
DO_LIB ap_dbclc(DNAME dmapdeb,DCOMMAND MAPMAP,DMAP mmapdeb);

POSTING(tmptrans)
PST_UPDCMD sptmptrans

