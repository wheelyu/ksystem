IMAGE(tmptrans)

FIELD(tmptranst)
tkmkode 	PROTECT		INPUTRI	2
tkmnobuk	PROTECT		INPUTRI	3
tkmbuk1		NOCHANGE	INPUTRI	4
tkmtype 	NOCHANGE	INPUTRI	4
tkmstsapr	PROTECT 	INPUTRI	5
tkmusrapr	PROTECT		INPUTRI	6
lnamaaprdet1	PROTECT		INPUTRI	7 
ltombolboq	TOMBOL		INPUTRI	8
ltombolapr	TOMBOL		INPUTRI 9

CALCS()
crev		mtsnopsn=="REVISI_GAMBAR"
cnotrev  	mtsnopsn!="REVISI_GAMBAR"

DEFAULTS(tmptranst)
ltombolboq			INIT	"HITUNG BOQ"
IF cnotrev tkmbuk1		DFALT_SCAN	BLANKS
				ARSITEKTUR "ARSITEKTUR"
				MEP "MECHANICAL-ELECTRICAL-PLUMBING"
				STRUKTUR "STRUKTUR"
				INFRASTRUKTUR "INFRASTRUKTUR"
				KOMPOSIT "GAMBAR ALL"
IF crev tkmbuk1			DFALT_SCAN	BLANKS
				REVARSITEKTUR "REVISI ARSITEKTUR"
				REVMEP "REV MECHANICAL-ELECTRICAL-PLUMBING"
				REVSTRUKTUR "REVISI STRUKTUR"
				REVINFRASTRUKTUR "REVISI INFRASTRUKTUR"
				REVKOMPOSIT "REVISI GAMBAR ALL"
ltombolapr      INIT            "HAPUS_APR"

EDITS(tmptranst)
e.Validate      tkmkode         VALIDATE mtsbukidx mmts
e.Validate	tkmusrapr	VALIDATE psikodidx mpsi2 0

CALCS()
cAPR_GBRKERJA	"APR_GBRKERJA"
cRSB		tkmbuk1=="RUNNING_STRUKTUR"
cIMB		tkmbuk1=="IMB"
cMEP		tkmbuk1=="MEP"
caprPM		tkmbuk1=="RUNNING_STRUKTUR" || tkmbuk1=="IMB" || tkmbuk1=="MEP" || tkmbuk1=="ARSITEKTUR" || tkmbuk1=="KOMPOSIT"
caprPMSITE	tkmbuk1=="STRUKTUR" || tkmbuk1=="INFRASTRUKTUR"
cAST		tkmbuk1=="ARSITEKTUR"
cSRT		tkmbuk1=="STRUKTUR"
cIST		tkmbuk1=="INFRASTRUKTUR"
cKOM		tkmbuk1=="KOMPOSIT"

MAP(mnobuktkm2)
cnobukRSB       tkmnobuk        DO_CALC_IF cRSB
cnobukIMB       tkmnobuk        DO_CALC_IF cIMB
cnobukMEP       tkmnobuk        DO_CALC_IF cMEP
cnobukAST       tkmnobuk        DO_CALC_IF cAST
cnobukKOM       tkmnobuk        DO_CALC_IF cKOM
cAPRHMC_PROOFF  tkmlok1         DO_CALC_IF caprPM  
cnobukSRT       tkmnobuk        DO_CALC_IF cSRT
cnobukIST       tkmnobuk        DO_CALC_IF cIST
cAPR_GBRKERJA   tkmlok1         DO_CALC_IF caprPMSITE

MAP(mupdtkmboq)
cOK		tkmlok2		DO_CALC

SPCALCS(spboq)
	DO_LIB	ap_dbclc(DNAME dupdtkmboq,DCOMMAND UPDATE,DTARGET tkmotoidx tkmoto,DMAP mupdtkmboq);
	DO_LIB  ap_nxpst(l4850,lmnext2);

HOOKS(tmptranst)
AFTER_INPUT	cur_field=tkmbuk1	DO_MAP SHOW mnobuktkm2
CLICKED         cur_field=ltombolboq    DO_SPCALCS spboq
CLICKED		cur_field=ltombolapr	DO_SPCALCS spdelapr

