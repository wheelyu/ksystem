FIELD(tmptranst)
svinama                 PROTECT                 INPUTRI         1
sviyt1                  NOCHANGE                INPUTRI         2
sviyt2                  NOCHANGE                INPUTRI         3
svitgl2                 PROTECT {DD-MM-YYYY}    INPUTRI         4
ljamfoto                PROTECT                 INPUTRI         5
g_fotolat1              PROTECT NUMERIC {99,999999999}          INPUTRI         5
g_fotolon1              PROTECT NUMERIC {99,999999999}          INPUTRI         6
lklikok2d                TOMBOL                  INPUTRI         7
svinobuk                PROTECT UNSEEN          INPUTRI         8

DEFAULTS(tmptranst)
lcount                   INIT   7
lklikok2d                INIT    "UPLOAD OK"
ljaminput2d              INIT    SYSTIME

EDITS(tmptranst)
e.Validate      svinobuk        VALIDATE btmbukidx msviselfie

MAP(msviselfie)
cBLANKS         ljamfoto        DO_CALC
svidf8          ljamfoto        REPLACE

CALCS()
cfotoselfie      sviyt1 != "Y"
cok2d            "OK"
cadalonlat2d     svidf7!=0 && (g_fotodate1==g_tgltrn || g_grpnam=="RI" || g_grpnam=="IT")
csdhupload2d     sviyt1=="Y"

MAP(mupdsviselfie)
g_fotolat1      svidf6          REPLACE
g_fotolon1      svidf7          REPLACE
cok2d            sviyt2          DO_CALC_IF cadalonlat2d

DBCALCS(dupdsviselfie)
        DCOMMAND        UPDATE
        DTARGET         sviprmidx sviprm
        DMAP            mupdsviselfie

MAP(mupdsvifotoselfie)
cY              sviyt1          DO_CALC
cSYSTIME        svidf8          DO_CALC
g_tgltrn        svitgl2         REPLACE

DBCALCS(dupdsvifotoselfie)
        DCOMMAND UPDATE
        DTARGET sviprmidx sviprm
        DMAP mupdsvifotoselfie

SPCALCS(spcaluplfotoselfie)
dupdsviselfie

HOOKS(tmptranst)
CLICKED         cur_field=lklikok2d       DO_SPCALCS IF csdhupload2d spcaluplfotoselfie

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
