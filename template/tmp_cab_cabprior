CALCS()
cgrupdlrsama	((cadarea != BLANKS && lcabpst2 == cabpst2) || cadarea == BLANKS)
cjoincadprior04	djoincadprior04 == 1
cpriorv1	"PRIORITAS0" + FLD_TO_STRING(lcadtot1_int2)
cpriorv2	"PRIORITAS" + FLD_TO_STRING(lcadtot1_int2)
curutv1		cadtot1 >= 1 && cadtot1 <= 9
curutv2		cadtot1 >= 10 && cadtot1 <= 99
cpriordup01	(((g_curcmd == 1 || (g_curcmd == 2 && ~cadkode != cadkode)) && djoincadprior01 == 0) || (g_curcmd == 2 && ~cadkode == cadkode))
cpriordup02	(((g_curcmd == 1 || (g_curcmd == 2 && ~cadarea != cadarea)) && djoincadprior02 == 0) || (g_curcmd == 2 && ~cadarea == cadarea))
cpriordup03	((g_curcmd == 1 && djoincadprior03 == 0 && cadtot1 == 1) || (g_curcmd == 1 && djoincadprior03 == 1) || (g_curcmd != 1))
cpriordup04	(((g_curcmd == 1 || (g_curcmd == 2 && ~cadtot1 != cadtot1)) && cadtot1 == lcadtot1_04 + 1) || (g_curcmd == 2 && ~cadtot1 == cadtot1))
ccabstok01	(((g_curcmd == 1 || (g_curcmd == 2 && ~cadarea != cadarea)) && djoincadstok01 == 1) || (g_curcmd == 2 && ~cadarea == cadarea))
ccadtot1	lcadtot1_04 + 1
curutprior01	g_curcmd == 1 && djoincadprior04 == 0
curutprior02	g_curcmd == 1 && djoincadprior04 == 1
cnominal0	0

MAP(misiprior)
cadtot1		lcadtot1_int2	REPLACE
cpriorv1	cadkode		DO_CALC_IF curutv1
cpriorv2	cadkode		DO_CALC_IF curutv2

MAP(murutprior)
