lkota3			almkota			REPLACE_IF coke 
lkec3			almkec			REPLACE_IF coke 
lkel3			almkel			REPLACE_IF coke 
lkdpos3			almkdpos		REPLACE_IF coke
ltbtcab			btmcab			REPLACE_IF ccim2w4w
lPKTG			btmsts			REPLACE_IF cpktgm2w4w


HOOKS(tmptranst)
AFTER_INPUT		cur_field=almnama2	DO_MAP SHOW malm


SUBFILE(tmptrans)
SFL_LINES(1)        
SFL_TITLE(tmptranst)
SFL_TARGET
almdatbukidx   gv_almsurvey btmnobuk

SFL_MAP
btmnobuk	almnobuk	REPLACE
btmplg		almbukoto	REPLACE
gv_almsurvey	almdata		REPLACE

CALCS()
cfincoina             btmtypjl=="K" && btmdvsjl!="M2W4W"

MAP(mupdbtmsurv)
tbtcab         btmcab          REPLACE_IF cfincoina
ltbtcab        btmcab          REPLACE_IF ccim2w4w
lPKTG          btmsts          REPLACE_IF cpktgm2w4w

SPCALCS(sptransaddbtm)
DO_LIB ap_dbclc(DNAME dupdbtmadd,DCOMMAND UPDATE,DTARGET btmbukidx btmnobuk,DMAP mupdbtmsurv);

SPCALCS(sptransupdbtm)
DO_LIB ap_dbclc(DNAME dupdbtmupd,DCOMMAND UPDATE,DTARGET btmbukidx btmnobuk,DMAP mupdbtmsurv);

POSTING(tmptrans)
        PST_ADDCMD sptransaddbtm
        PST_UPDCMD sptransupdbtm

CALCS()
cdel		0
calm0		(btmsts=="OPEN" || btmsts=="RENC" || btmsts=="621" || btmsts=="651") && btmtypjl=="K" && djoinalmsurv==0
calm1		(btmsts=="OPEN" || btmsts=="RENC" || btmsts=="621" || btmsts=="651") && btmtypjl=="K" && djoinalmsurv==1

PERMIT(tmptrans)
