tbtdf2			almlon			REPLACE
lwarnaarea              lwarnaarea              REPLACE_IF cjoin3110warna

MAP(mtbd3)
tbdkode			almkec 			REPLACE
tbdket			almnamkec		REPLACE

MAP(mtbl3)
tblkode			almkota 		REPLACE
tblket			almnamkota		REPLACE

MAP(mdtm3)
