almlon   		PROTECT SCROLL			INPUTRI 16

IMAGE(tmptrans) 

CALCS()
cjoin3110warna       djointbewarna3110 == 1
coke		djoinalmktp==1 || djoinalmtinggal==1
ccim2w4w		btmdvsjl == "M2W4W" && djoinalmm2w4w==1 && djointbtm2w4w==1
cpktgm2w4w		btmdvsjl == "M2W4W" && djoinalmm2w4w==1 && djointbtm2w4w==1 && ltbtusrcrt == "TDK_JUAL"

DEFAULT(tmptranst)
almnama2		DFALT_SCAN PSMTINGGAL
lkelwrnsvy		INIT		KELWRNSVY
lSURVEYM2W41            INIT            SURVEYM2W4
lSURVEYM2W42            INIT            SURVEYM2W4
lPKTG                   INIT            PKTG
lpsmtinggal		INIT		PSMTINGGAL

EDITS(tmptranst)
t.IsiLonLat3110 almlat MANDATORY
t.IsiLonLat3110 almlon MANDATORY
e.validatePropinsi3	almprop VALIDATE dtmdtkodidx  mdtm3 0 {Pgv_dtkota}
e.validateKota3		almkota VALIDATE tbldtdtmkod mtbl3 0 {Pgv_dtkota} {Palmprop}
e.validateKec3		almkec VALIDATE tbddatkodidx mtbd3 0 {Pgv_dtkota} {Palmprop} {Palmkota}
e.validateKel3		almkel VALIDATE tbtdattypkod mtbt3 0 {Pgv_dtkota} {Pgv_dtkota21} {Palmprop} {Palmkota} {Palmkec}

MAP(mtbt3)
tbtkode			almkel 			REPLACE
tbtket			almnamkel		REPLACE
