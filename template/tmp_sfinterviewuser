	psddatpsmkod gv_clnkry11 btmnobuk lINTV_USER 

SFL_MAP
gv_clnkry11   	psddata		REPLACE
btmnobuk  	psdpsmkode	REPLACE
lINTV_USER     	psdkode		REPLACE
