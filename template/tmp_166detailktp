SFL_UPL_COND cbisaupl
SFL_UPL_DIRFLD hrmdvs2
SFL_UPLFLD  tkmoto lUPLKTP166
SFL_UPLFLD_DBCALCS dupdtkmktpsdm21
SFL_UPL_DELCOND caccblanks
SFL_COND        cpengkinianktp
SFL_TARGET
         tkmdtkdstlok   lUPLKTP166_11 hrmnobuk

SFL_MAP
lUPLKTP166_11           tkmdata         REPLACE
