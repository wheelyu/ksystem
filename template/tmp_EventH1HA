CALCS()
cdetailahok              tlmkode == g_usrkode && tkdnourt > 0 && tkdjml3 > 0  &&
                        (tkdsts == gv_OPEN || tkdsts == gv_TACC) 

MAP(mupdinfodetailha)
lUPLOADFOTOKEGIATAN     tkdrek          REPLACE_IF cfoto3kosong
lDALAMPROSESREVIEW      tkdrek          REPLACE_IF cdetaildalamreview

SPCALCS(spdetailokha)
        DO_LIB_IF cdetailahok            ap_dbclc(DNAME dupddetailreqha,DCOMMAND UPDATE,DTARGET tkdprmidx tkdprm, DMAP mupddetailreq);
        DO_LIB_IF cadakawilbelumacc     ap_dbclc(DNAME daddabkreviewkawilha, DCOMMAND ADD, DFILE abk, DMAP maddabkreviewkawil);
        DO_LIB_IF cadaambelumacc        ap_dbclc(DNAME daddabkreviewamha, DCOMMAND ADD, DFILE abk, DMAP maddabkreviewam);
        DO_LIB_IF cdetailbelumacc       ap_dbclc(DNAME dupdinfodetailha,DCOMMAND UPDATE,DTARGET tkdprmidx tkdprm, DMAP mupdinfodetailha);

HOOKS(tmptranst)
BEFORE_INPUT    cur_field=tkdjenisaw        DO_SKIP_IF cpicnso
BEFORE_INPUT    cur_field=tkdket        DO_SKIP_IF cpicnso
BEFORE_INPUT    cur_field=tkdket        DO_SKIP_IF cisitacc

CLICKED         cur_field=ltombolahok    DO_SPCALCS spdetailokha

MAP(mtambahuploadfotokegiatan)
