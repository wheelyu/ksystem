ctambahuploadfoto3      tkdjml3         DO_CALC
g_fotolat1	        tkdnil4		REPLACE
g_fotolon1	        tkdnil5	        REPLACE
gv_int1                 tkdtotjsa       REPLACE
DBCALCS(dtambahuploadfotokegiatan)
	DBC_COMMAND	UPDATE
	DBC_TARGET	tkdprmidx	tkdprm
	DBC_MAP		mtambahuploadfotokegiatan
 
