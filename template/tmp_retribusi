IMAGE(tmptrans)

FIELD(tmptranst)
tbtyt             ALLCAPS                 INPUTRI 1   /*AdaPembayaranRetribusi*/
tbtket	     	  ALLCAPS		  INPUTRI 2   /*PerunBiaya*/
tbttot            NUMERIC                 INPUTRI 3   /*BiayaRetribusi*/

DEFAULT(tmptranst)
tbtyt             DFALT_SCAN_BLANKS       Y "Ya"
					  T "Tidak"
CALCS()
cbyrY             tbtyt=="Y"
cbyrT		  tbtyt=="T"

EDITS(tmptranst)
e.Mandatory     tbtyt   MANDATORY
e.Mandatory	tbtket  MANDATORY_IF cbyrY
e.Mandatory     tbttot  MANDATORY_IF cbyrY

HOOKS(tmptranst)
BEFORE_INPUT     cur_field=tbtket       DO_SKIP_IF cbyrT
BEFORE_INPUT     cur_field=tbttot       DO_SKIP_IF cbyrT

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_UPLFLD tbttbdkode tbtkode
SFL_UPLFLD_DBCALCS dupdtbtfoto
SFL_UPL_DIRFLD tbdtgl1
SFL_TARGET
        tbtdattypkod tbddata tmpkode tbddtmkode tbdtblkode tbdkode
SFL_MAP
        tbddata         tbtdata         REPLACE
        tmpkode         tbttype         REPLACE
        tbddtmkode      tbtdtmkode      REPLACE
        tbdtblkode      tbttblkode      REPLACE
        tbdkode         tbttbdkode      REPLACE
        tbdkode         tbtkode         REPLACE

