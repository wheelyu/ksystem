LOCAL
PGM_FIELDS
lnama		STRING	21
ltottools	DFLOAT	8
ltoolstemu	DFLOAT	8
ltoolscek       DFLOAT  8
lprslengkap	DFLOAT	8
ljmlbaik	DFLOAT	8
lprsbaik	DFLOAT	8
ljmlrusak	DFLOAT	8	
lprsrusak	DFLOAT	8
lkosong		INT2	2
lbaik		INT2	2
lrusak		INT2	2
lsemua		INT2	2
ltombolket	STRING	31
l4633           INT2    2
lm4633          STRING  15



IMAGE(tmptranst)
/----------------------------------------------------------------------------------\
 /-------------------------------------\/-----------------------------------------\
  t.Rekap                                t.Kondisi
    t.NoPIT    : ____                     t.Baik
    t.Nip      : ________                      t.JmlBaik    : _______________
    t.Nama     : ___________________           t.PrsBaik    : _______________ %
    t.TotTool  : ___________________      t.Rusak
    t.ToolCek  : ___________________           t.JmlRusak   : _______________
