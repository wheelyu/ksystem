conkel		NONE SCROLL	INPUTRI		3	/* Instagram	*/
conkota		NONE SCROLL INPUTRI		4   /* Tiktok  */

lsosmed_enter	NOCHANGE	INPUTRI		4	/* ENTER 	*/

DEFAULTS(tmptranst)
