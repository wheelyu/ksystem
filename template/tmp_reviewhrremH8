IMAGE(tmptrans)
|_____________________|____________________|____________________|____________________|____________________|_______|

FIELDS(tmptrans)
        kettype         PROTECT                         INPUTRI         1
        ketstr1         TEXTAREA                        INPUTRI         2
        ketstr2         TEXTAREA                        INPUTRI         3
        ketstr3         TEXTAREA	PROTECT		INPUTRI         4
        ketstr4         TEXTAREA	PROTECT		INPUTRI         5  
        lenter          NOCHANGE                        INPUTRI         6

DEFAULTS(tmptrans)
lenter          INIT            ENTER

EDITS(tmptrans)
e.Mandatory     ketstr1         MANDATORY
e.Mandatory     ketstr2         MANDATORY

HOOKS(tmptrans)
BEFORE_INPUT    cur_field=ketstr3       DO_SKIP_IF cjikabm
BEFORE_INPUT    cur_field=ketstr4       DO_SKIP_IF cjikabm

AFTER_INPUT     cur_field=ketstr1 DO_MAP SHOW
                IF chrsisi1 mdum3
                ELSE HKCURSOR STAY
                     HKMSG t.MandatoryKet

AFTER_INPUT     cur_field=ketstr2 DO_MAP SHOW
                IF chrsisi2 mdum3
                ELSE HKCURSOR STAY
                     HKMSG t.MandatoryKet

CALCS()
ctypeketrem	kettype=="PPTGH" || kettype=="TARIK" || kettype=="PLNS" || kettype=="ZDEN" || kettype=="JUALMOKAS" 

SUBFILE(tmptrans)
SFL_LINES(5)
SFL_TITLE(tmptranst)
