IMAGE(tmptrans)

FIELD(tmptranst)
condata		ALLCAPS	SCROLL		INPUTRI	1
conkode         PROTECT SCROLL          INPUTRI 2
conhp           DIGITS SCROLL          INPUTRI 3
conkota		NOCHANGE		INPUTRI	4
consts		PROTECT SCROLL		INPUTRI 5
congrup		ALLCAPS SCROLL  	INPUTRI 6
conurtstr	PROTECT			INPUTRI	7
lketfungsi	PROTECT			INPUTRI	7
lhp_enter	NOCHANGE		INPUTRI	7

CALCS()
cjointbdfungsihp	djointbdfungsihp == 1
cbkninstasi             psmins != "INSTANSI"
cinstasi                psmins == "INSTANSI"

EDITS(tmptranst)
/*e.Dupkeyhp              conhp   DUPKEY  condathpidx {PlTELP}*/

e.Mandatory		conhp	MANDATORY
e.Mandatory 		congrup MANDATORY
e.Validate              congrup VALIDATE tbddatkodidx mtypehp stbd {Pgv_dttabel} {Pgv_infoumum} {Pltypehp}
e.Validate		conkota VALIDATE tbddatkodidx mjamtelp stbd {Pgv_dttabel} {PlSURVEY} {PlJAMTELPON}
/*e.Dupkeyhp            conhp   DUPKEY condathpidx {PlDTHP}*/

MAP(mtypehp)
tbdkode		congrup		REPLACE
tbdyt		conurtstr	REPLACE
tbdyt		ltype21		REPLACE
lketfungsi	lketfungsi	REPLACE_IF cjointbdfungsihp

MAP(mjamtelp)
tbdkode		conkota		REPLACE

DEFAULTS(tmptranst)
IF cbkninstasi  condata   DFALT_SCAN TELP
IF cinstasi     condata   DFALT_SCAN TELP TELP2 TELP3 TELP4 TELP5 TELP6 TELP7 TELP8 TELP9 TELP10
lhp_enter	INIT	ENTER
ltypehp		INIT	TYPEHP
lSURVEY		INIT	SURVEY
lJAMTELPON	INIT	JAMTELPON
lfungsihp	INIT	FUNGSIHP
lTELPa          INIT    TELP 
lTELP2          INIT    TELP2
lTELP3          INIT    TELP3
lTELP4          INIT    TELP4
lTELP5          INIT    TELP5
lTELP6          INIT    TELP6
lTELP7          INIT    TELP7
lTELP8          INIT    TELP8
lTELP9          INIT    TELP9
lTELP10         INIT    TELP10

CALCS()
cpanjangnom             DO_LIB ap_strln(conhp,&ljumlahnomor);
cHP			(condata==lTELP     || condata == "TELP2" || condata == "TELP3" ||  condata == "TELP4" || condata == "TELP5" ||  
                         condata == "TELP6" || condata == "TELP7" || condata == "TELP8" || condata == "TELP9" || condata == "TELP10" ||
                         condata== "GSM" || condata==BLANKS) && congrup != "CUG"
cbmmmnsohead		g_curcmd==2 && (g_grpnam =="BUM" || g_grpnam=="ARDVH" || g_grpnam=="KAWIL")

cjointelp               (g_curcmd == 1 && 
                        ( condata == "TELP" && djoincon   == 0 ) ||
                        ( condata == "TELP2" && djoincon2 == 0 ) || 
                        ( condata == "TELP3" && djoincon3 == 0 ) || 
                        ( condata == "TELP4" && djoincon4 == 0 ) || 
                        ( condata == "TELP5" && djoincon5 == 0 ) || 
                        ( condata == "TELP6" && djoincon6 == 0 ) || 
                        ( condata == "TELP7" && djoincon7 == 0 ) || 
                        ( condata == "TELP8" && djoincon8 == 0 ) || 
                        ( condata == "TELP9" && djoincon9 == 0 ) || 
                        ( condata == "TELP10" && djoincon10 == 0 ) || g_curcmd == 2) 
                        
cjointelp2             ((g_curcmd == 2  && condata == ~condata && conhp == ~conhp ) ||
                       (g_curcmd == 2  && condata != ~condata && conhp == ~conhp  && djoincon == 0) || 
                       (g_curcmd == 2  && condata == ~condata && conhp != ~conhp  && djoincon == 0) ||
                       (g_curcmd == 2  && condata != ~condata && conhp != ~conhp  && (djoincon == 1 || djoincon == 0)) || 
                        g_curcmd == 1) 
                          


MAP(mpanjangnom)
cpanjangnom             ljumlahnomor            DO_CALC

HOOKS(tmptranst)
AFTER_INPUT             cur_field=conhp       DO_LIB ap_amstr(conhp,ln1i,ln1,&ldigit1);
AFTER_INPUT             cur_field=conhp       DO_LIB ap_amstr(conhp,ln2i,ln1,&ldigit2);
AFTER_INPUT             cur_field=conhp       DO_MAP SHOW mpanjangnom

BEFORE_INPUT		cur_field=conhp		DO_SKIP_IF cbmmmnsohead

AFTER_INPUT             cur_field=conhp DO_MAP SHOW
                        IF cbukan08 mdum
                        ELSE HKCURSOR STAY
                        HKMSG Nomor Telepon 2 Digit Didepan Harus 08 Dan Harus Lebih Dari 10 Dan Kurang Dari 14

AFTER_INPUT             cur_field=conhp DO_MAP SHOW
                        IF cjointelp  mdum
                        ELSE HKCURSOR STAY
                        HKMSG Nomor Telepon   Sudah Pernah Di input 

AFTER_INPUT             cur_keybd=EN    DO_MAP SHOW
                        IF cjointelp2  mdum
                        ELSE HKCURSOR STAY
                        HKMSG Nomor Telepon   Sudah Pernah Di input ya 


