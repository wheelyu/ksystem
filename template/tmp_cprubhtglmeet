IMAGE(tmptrans)

FIELD(tmptranst)
aktcrttgl      	PROTECT  {DD-MM-YYYY}  INPUTRI  1
aktcrtusr    	PROTECT		INPUTRI		2
lnamainp2	PROTECT		INPUTRI		3
akttgl      	PROTECT  {DD-MM-YYYY}  INPUTRI  4
akttgl2      	ALLCAPS  {DD-MM-YYYY}  INPUTRI  5
aktket		TEXTAREA	INPUTRI		6
lenter    	NOCHANGE	INPUTRI		7


DEFAULT(tmptranst)
aktcrtusr	INIT_ADD	{g_usrkode}
aktcrttgl	INIT_ADD	{g_tgltrn}

EDITS(tmptranst)
e.Mandatory akttgl2  MANDATORY
e.Mandatory aktket MANDATORY
t.Validate  aktcrtusr  VALIDATE psikodidx mpsik 0

MAP(mpsik)
psikode         aktcrtusr       REPLACE
psinama         lnamainp2       REPLACE

MAP(mtglawl)
tlmtgl		akttgl		REPLACE

HOOKS(tmptranst)
AFTER_INPUT     cur_field=aktcrtusr      DO_MAP SHOW mtglawl
AFTER_INPUT     cur_field=akttgl2        DO_MAP SHOW
                IF cnolewattgl4 mdum
                ELSE HKCURSOR STAY
                HKMSG t.TglLebihHariIni

AFTER_INPUT     cur_keybd=EN             DO_MAP SHOW
                IF cnolewattgl4 mdum
                ELSE HKCURSOR STAY
                HKMSG t.TglLebihHariIni

AFTER_INPUT     cur_field=akttgl2        DO_MAP SHOW
                IF ctglnosama mdum
                ELSE HKCURSOR STAY
                HKMSG t.TglTdkBolehSama

AFTER_INPUT     cur_keybd=EN             DO_MAP SHOW
                IF ctglnosama mdum
                ELSE HKCURSOR STAY
                HKMSG t.TglTdkBolehSama


SUBFILE(tmptrans)
SFL_TITLE(tmptranst)
SFL_SORT_BY_FIELD akttgl
SFL_LINES(1)
SFL_SHOW_NEXT

SFL_TARGET
aktkodtypidx   tlmnobuk lUBHTGLCPR

SFL_MAP
tlmnobuk        aktkode		REPLACE
tlmnobuk        aktnobuk	REPLACE
lUBHTGLCPR      aktdata		REPLACE

