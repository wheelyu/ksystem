IMAGE(tmptrans)

FIELD(tmptranst)
spknama		PROTECT			INPUTRI 1		/* Nama Agen */
spkkode		PROTECT			INPUTRI	2		/* Nip Agen*/
spknohp         PROTECT                 INPUTRI 2               /* No Hp*/
spktype         PROTECT                 INPUTRI 3		/* Tipe Agen */
spkgaji         PROTECT                 INPUTRI	4               /* Jual 3 Bulan Terakhir */
spkssgaji	PROTECT                 INPUTRI	5               /* Pk 3 Bulan Terakhir */
spknama2        PROTECT                 INPUTRI	6               /* Upline Saat Ini */
spkkat2         PROTECT                 INPUTRI 7               /* Jabatan Upline Saat Ini  */
spkkode2        PROTECT                 INPUTRI 8               /* Status Upline Saat Ini */
spkkat5	        PROTECT                 INPUTRI 9               /* Terhubung atau Tidak */
lalasan		PROTECT			INPUTRI 10
spkket		PROTECT			INPUTRI 11
spkkat6	        PROTECT                 INPUTRI 12              /* Masih Minat Agen */
lmntagen	PROTECT			INPUTRI	13
spkkat4	      	PROTECT                 INPUTRI	14              /* Alasan Tidak Minat Menjadi Agen */
lketclsd2	PROTECT			INPUTRI 15		/* Alasan Tidak Minat Menjadi Agen */
spkkode3        PROTECT                 INPUTRI	16              /* Nip Upline Baru */
lnamakba        PROTECT                 INPUTRI	17              /* Nama Upline Baru*/

CALCS()
crevie		 tkmsts !=  "OPEN"

EDITS(tmptranst)
e.ValidateRes           spkkat4           VALIDATE tbddatkodidx mtbd3 stbd {Pgv_dttabel} {PlKLIKNSC} {PlALSKELUARAGEN}
e.ValidateNoHp          spkkode           VALIDATE_DUP psmkod2stsid mpsm2 0
e.ValidateRes2          spkkat5           VALIDATE tbddatkodidx mtbd8 stbd {Pgv_dttabel} {PlKLIKNSC} {PlTERHUBUNG}
e.ValidateRes3          spkkat6           VALIDATE tbddatkodidx mtbd9 stbd {Pgv_dttabel} {PlKLIKNSC} {PlMINATAGEN}


MAP(mpsm2)
psmkode           spknohp           REPLACE

MAP(mtbd3)
tbdkode         spkkat4                 REPLACE
tbdket          lketclsd2               REPLACE

MAP(mtbd8)
tbdkode         spkkat5                 REPLACE
tbdket          lalasan                 REPLACE

MAP(mtbd9)
tbdkode         spkkat6                 REPLACE
tbdket          lmntagen                REPLACE


SUBFILE(tmptrans)
SFL_LINES(1)
SFL_COND	crevie
SFL_UPLFLD spknobuk
SFL_UPL_DIRFLD tkmcab
SFL_TITLE(tmptranst)
SFL_TARGET
        spkdatbuktyp   lFU_AGEN tkmnobuk

PERMIT(tmptrans)
	PMT_ADD_COND	c0
	PMT_UPDALL_COND	c0
	PMT_DEL_COND    c0