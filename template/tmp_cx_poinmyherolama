IMAGE(tmptrans)

FIELDS(tmptranst)
        tldstr1         PROTECT                                         INPUTRI 1       /* STATUS UPLOAD */
        tldstr2         NOCHANGE                                        INPUTRI 2       /* CEK UPLOAD */
        tldkirim        NOCHANGE                                        INPUTRI 3       /* PILIHAN ALASAN CEK UPLOAD */
        tldket          TEXTAREA 2                                      INPUTRI 4       /* ALASAN CEK UPLOAD */
        tldstr3         PROTECT                                         INPUTRI 5       /* STATUS UPLOAD */

        tldbisnis       NOCHANGE                                        INPUTRI 6       /* CEK UPLOAD BUKTI SKOR */
        tldlok2         NOCHANGE                                        INPUTRI 7       /* PILIHAN ALASAN CEK UPLOAD BUKTI SKOR */
        ltldket3        TEXTAREA 2                                      INPUTRI 8       /* ALASAN CEK UPLOAD BUKTI SKOR */

        tldjml          NUMERIC                                         INPUTRI 9       /* SKOR */
        tldtydis        PROTECT                                         INPUTRI 10      /* STATUS SKOR */
        tldstr4         NOCHANGE                                        INPUTRI 11      /* CEK SKOR */
        tldket2         TEXTAREA 2      PROTECT                         INPUTRI 12      /* ALASAN CEK SKOR */
        tldhrg          NUMERIC                                         INPUTRI 13      /* REVISI SKOR ACT */
        lENTER2         NOCHANGE                                        INPUTRI 14      /* ENTER 2 */

DEFAULTS(tmptranst)
        tldstr2	        DFALT_SCAN              BLANKS	
                                                SESUAI
					        TIDAK
        tldbisnis       DFALT_SCAN              BLANKS	
                                                SESUAI
					        TIDAK
        tldstr4	        DFALT_SCAN              BLANKS	
                                                SESUAI
				                TIDAK
        lENTER2         INIT_LABEL              ENTER

EDITS(tmptranst)
        t.IsiCekUpload          tldstr2         MANDATORY_IF cStsINPG
        t.IsiPilAlasanCekUpl    tldkirim        MANDATORY_IF cCekUploadFrs
        t.IsiAlasanCekUpl       tldket          MANDATORY_IF cCekUploadV3

        t.IsiCekBuktiScore      tldbisnis       MANDATORY_IF cStsINPG
        t.IsiPilAlsCekUplBuk    tldlok2         MANDATORY_IF cCekBukSkorFrs
        t.IsiAlsCekUplBuk       ltldket3        MANDATORY_IF cCekBukSkorV3

        t.IsiSkor               tldjml          MANDATORY_IF cIDADA  
        t.IsiCekSkor            tldstr4         MANDATORY_IF cCekBukSkorV5

        t.IsiRevisiScoreACT     tldhrg          MANDATORY_IF cTTLSkorV2  

        e.ValidateAlsCekUpl	tldkirim	VALIDATE_IF cCekUploadFrs tbddatkodidx mAlasanCekUpload stbd {Pgv_dttabel} {PlCUSTOMEREXPERIENCE} {PlALASANCEKUPLOAD} 
        e.ValidateAlsCekBukSkor	tldlok2	        VALIDATE_IF cCekBukSkorFrs tbddatkodidx mAlasanCekBuktiSkor stbd {Pgv_dttabel} {PlCUSTOMEREXPERIENCE} {PlALASANCEKBUKSKOR} 

MAP(mAlasanCekUpload)
        tbdkode         tldkirim                REPLACE
        tbdket          tldket                  REPLACE_IF cCekUploadV4

MAP(mAlasanCekBuktiSkor)
        tbdkode         tldlok2                 REPLACE
        tbdket          ltldket3                REPLACE_IF cCekBukSkorV4

MAP(mCekUpload)
        cBLANKS	        tldkirim                DO_CALC
        cBLANKS	        tldket	                DO_CALC

MAP(mCekUploadV2)
        tldkirim        ltldkirimV2             REPLACE

MAP(mCekUploadV3)
        cBLANKS	        tldket	                DO_CALC

MAP(mCekBukSkor)
        cBLANKS	        tldlok2                 DO_CALC_IF cCekBukSkorV5
        cBLANKS	        ltldket3                DO_CALC

MAP(mCekBukSkorV1)
        cBLANKS	        tldstr4                 DO_CALC
        cBLANKS         tldtydis                DO_CALC
        cBLANKS         tldket2                 DO_CALC
        cBLANKS         tldhrg                  DO_CALC

MAP(mCekBukSkorV2)
        tldlok2         ltldlok2V2              REPLACE

MAP(mCekBukSkorV3)
        cBLANKS	        ltldket3	        DO_CALC

MAP(mTTLSkor)
        cBLANKS         tldket2                 DO_CALC_IF cTTLSkorV3
        lTTLSKORKET     tldket2                 REPLACE_IF cTTLSkorV2

        lACC            tldtydis                REPLACE_IF cTTLSkorV3
        lTACC           tldtydis                REPLACE_IF cTTLSkorV2

MAP(mRevisi)
        cBLANKS	        tldhrg                  DO_CALC

MAP(mNIPCx)
        g_usrkode       tldstr5                 REPLACE

HOOKS(tmptranst)
        BEFORE_INPUT	cur_field=tldstr2       DO_SKIP_IF cStsOPEN
        BEFORE_INPUT	cur_field=tldkirim      DO_SKIP_IF cCekUpload
        BEFORE_INPUT	cur_field=tldket        DO_SKIP_IF cCekUploadV2

        BEFORE_INPUT	cur_field=tldkirim      DO_MAP SHOW
                        IF      cCekUploadFrs   mCekUploadV2
        BEFORE_INPUT	cur_field=tldket        DO_MAP SHOW
                        IF      cCekUploadV6    mCekUploadV3
        BEFORE_INPUT	cur_field=tldket        DO_MAP SHOW
                        IF      cCekUploadFrs   mCekUploadV2
        AFTER_INPUT	cur_field=tldstr2       DO_MAP SHOW
                        IF      cCekUploadV5    mCekUpload

        BEFORE_INPUT	cur_field=tldbisnis     DO_SKIP_IF cStsOPEN
        BEFORE_INPUT	cur_field=tldlok2       DO_SKIP_IF cCekBukSkor
        BEFORE_INPUT	cur_field=ltldket3      DO_SKIP_IF cCekBukSkorV2
        BEFORE_INPUT	cur_field=tldlok2       DO_MAP SHOW
                        IF      cCekBukSkorFrs  mCekBukSkorV2
        BEFORE_INPUT	cur_field=ltldket3      DO_MAP SHOW
                        IF      cCekBukSkorV6   mCekBukSkorV3
        BEFORE_INPUT	cur_field=ltldket3      DO_MAP SHOW
                        IF      cCekBukSkorFrs  mCekBukSkorV2
        AFTER_INPUT	cur_field=tldbisnis     DO_MAP SHOW
                        IF      cCekBukSkorV5   mCekBukSkor
                        
        AFTER_INPUT	cur_field=tldbisnis     DO_MAP SHOW
                        IF      cCekBukSkorFrs  mCekBukSkorV1

        BEFORE_INPUT	cur_field=tldjml        DO_SKIP_IF cStsINPG

        AFTER_INPUT     cur_field=tldjml        DO_MAP SHOW
                        IF cMAX9999             mdum
                        ELSE HKCURSOR STAY
                        HKMSG Skor MY HERO Atau APPLE Tidak Boleh Lebih Dari 4 Digit

        BEFORE_INPUT	cur_field=tldstr4       DO_SKIP_IF cTTLSkor

        AFTER_INPUT     cur_field=tldstr4       DO_MAP SHOW
                        IF cStsINPG             mTTLSkor

        BEFORE_INPUT	cur_field=tldhrg        DO_SKIP_IF cRevTTLSkor

        AFTER_INPUT     cur_field=tldhrg        DO_MAP SHOW
                        IF cMAX9999V2           mdum
                        ELSE HKCURSOR STAY
                        HKMSG Skor MY HERO Atau APPLE Tidak Boleh Lebih Dari 4 Digit

        AFTER_INPUT     cur_field=tldhrg        DO_MAP SHOW
                        IF cTTLSkorV3           mRevisi

        AFTER_INPUT     cur_field=tldstr2       DO_MAP SHOW
                        IF cStsINPG             mNIPCx

MAP(mUpdStsFoto)
        lOK      	tldstr1	        REPLACE

DBCALCS(dUpdStsFoto)
	DBC_COMMAND	UPDATE
	DBC_TARGET	tldprmidx       tldprm
	DBC_MAP		mUpdStsFoto

MAP(mUpdStsFoto2)
        lOK      	tldstr3	        REPLACE

DBCALCS(dUpdStsFoto2)
	DBC_COMMAND	UPDATE
	DBC_TARGET	tldprmidx       tldprm
	DBC_MAP		mUpdStsFoto2

