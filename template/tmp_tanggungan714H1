ctdkbolehpilih1       	((svistr1!=BLANKS || svistr1=="TDKADA" ) && svistr2 !="TDKADA") || svistr2 == BLANKS
ctdkbolehpilih2       	((svistr2!=BLANKS || svistr2=="TDKADA" ) && svistr3 !="TDKADA") || svistr3 == BLANKS
ctdkbolehpilih3       	((svistr3!=BLANKS || svistr3=="TDKADA" ) && svistr4 !="TDKADA") || svistr4 == BLANKS
