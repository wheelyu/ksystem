			svistr1 !="ISTRI/SUAMI") ||(djoinsvicharacter==1 && lstspmhncrc!="BELUMKAWIN" && lstspmhncrc!="DUDA" && lstspmhncrc!="JANDA"))

cpemsingle2             ((djoinsvicharacter==1 && (lstspmhncrc=="BELUMKAWIN" || lstspmhncrc=="DUDA" || lstspmhncrc=="JANDA") && 
			svistr2 !="ISTRI/SUAMI") ||(djoinsvicharacter==1 && lstspmhncrc!="BELUMKAWIN" && lstspmhncrc!="DUDA" && lstspmhncrc!="JANDA"))

cpemsingle3             ((djoinsvicharacter==1 && (lstspmhncrc=="BELUMKAWIN" || lstspmhncrc=="DUDA" || lstspmhncrc=="JANDA") && 
			svistr3 !="ISTRI/SUAMI") ||(djoinsvicharacter==1 && lstspmhncrc!="BELUMKAWIN" && lstspmhncrc!="DUDA" && lstspmhncrc!="JANDA"))

cpemsingle4             ((djoinsvicharacter==1 && (lstspmhncrc=="BELUMKAWIN" || lstspmhncrc=="DUDA" || lstspmhncrc=="JANDA") && 
			svistr4 !="ISTRI/SUAMI") ||(djoinsvicharacter==1 && lstspmhncrc!="BELUMKAWIN" && lstspmhncrc!="DUDA" && lstspmhncrc!="JANDA"))
/*
cpemsingle5             ((djoinsvicharacter==1 && (lstspmhncrc=="BELUMKAWIN" || lstspmhncrc=="DUDA" || lstspmhncrc=="JANDA") &&
                        (svistr1 =="ANAK" || svistr1 =="KANEK" || svistr1 =="KELUARGADKT" || svistr1 =="ORTUKANDUNG" || svistr1 =="SDRIPAR" || 
			svistr1 =="SDRKANDUNG") || (svistr2 =="ANAK" || svistr2 =="KANEK" || svistr2 =="KELUARGADKT" || svistr2 =="ORTUKANDUNG" || 
			svistr2 =="SDRIPAR" || svistr2 =="SDRKANDUNG") || (svistr3 =="ANAK" || svistr3 =="KANEK" || svistr3 =="KELUARGADKT" || 
			svistr3 =="ORTUKANDUNG" || svistr3 =="SDRIPAR" || svistr3 =="SDRKANDUNG") || (svistr4 =="ANAK" || svistr4 =="KANEK" || 
			svistr4 =="KELUARGADKT" || svistr4 =="ORTUKANDUNG" || svistr4 =="SDRIPAR" || svistr4 =="SDRKANDUNG")) || 
			(djoinsvicharacter==1 && lstspmhncrc!="BELUMKAWIN" && lstspmhncrc!="DUDA" && lstspmhncrc!="JANDA")) 
*/			
cpemsingle5		djoinsvicharacter==1 && (((lstspmhncrc=="BELUMKAWIN" || lstspmhncrc=="DUDA" || lstspmhncrc=="JANDA") && 
			svistr1 !="ISTRI/SUAMI" && svistr2 !="ISTRI/SUAMI" && svistr3 !="ISTRI/SUAMI" && svistr4 !="ISTRI/SUAMI") || 
			(lstspmhncrc!="BELUMKAWIN" && lstspmhncrc!="DUDA" && lstspmhncrc!="JANDA"))

ctanggkosong2           svistr2 == BLANKS
ctanggkosong3           svistr3 == BLANKS
ctanggkosong4           svistr4 == BLANKS
