cmntnnti	svistr4 == "MINAT_NANTI"
cminat   	svistr4 == "MINAT"
cTDK		"TDMN"
cNANTI		"NNTI"
cMNAT 		"MNAT"

MAP(misig1)
	cempty 		svitgl1		DO_CALC
	ctgl		svitgl1		DO_CALC_IF caktftdk

HOOKS(tmptranst)
	AFTER_INPUT 	cur_field=svistr2	DO_MAP SHOW IF 	cNoM2W4W misig1
	BEFORE_INPUT 	cur_field=svitgl1	DO_SKIP_IF 	cM2W4W

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_COND  	ckondg1
SFL_TITLE(tmptranst)
SFL_UPLFLD      tlmnobuk svitype
SFL_TARGET      svidatbuktyp   lDTCRO tlmnobuk lHSLFU          

SFL_MAP    
	tlmnobuk	svinobuk	REPLACE
	lDTCRO   	svidata		REPLACE
	lHSLFU   	svitype		REPLACE

MAP(mupdtlmg1)
	svitgl1         tlmtgljtp       REPLACE                
	cMNAT 		tlmsts2 	DO_CALC_IF cminat
	cTDK		tlmsts2 	DO_CALC_IF ctdkmnt
	cNANTI		tlmsts2 	DO_CALC_IF cmntnnti

MAP(mupdtlmM2W4W)
	svitgl1         tlmtgljtp       REPLACE                
	svistr4 	tlmpst 		REPLACE_IF cminat
	svistr4		tlmpst 		REPLACE_IF ctdkmnt
	svistr4		tlmpst 		REPLACE_IF cmntnnti

SPCALCS(supdtlmg1)
        DO_LIB_IF cNoM2W4W	ap_dbclc(DNAME dupdtlmg1,DCOMMAND UPDATE,DTARGET tlmprmidx tlmprm,DMAP mupdtlmg1);

SPCALCS(supdtlmg2)
        DO_LIB_IF cM2W4W	ap_dbclc(DNAME dupdtlmg2,DCOMMAND UPDATE,DTARGET tlmprmidx tlmprm,DMAP mupdtlmM2W4W);

POSTING(tmptrans)
