								MINAT_NANTI	"MINAT NANTI"
	                                        		TDK_MINAT 	"TIDAK MINAT"

	IF cAktM2W4W	svistr4       	DFALT_SCAN_BLANKS       MINAT  		"MINAT"
								MINAT_NANTI	"MINAT NANTI"
	                                        		TDK_MINAT 	"TIDAK MINAT"

	IF cTdAktM2W4W	svistr4         DFALT_SCAN_BLANKS       TDK_MINAT 	"TIDAK MINAT"


