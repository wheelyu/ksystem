cbukanfintax	g_grpnam!="ACC" && g_grpnam!="RI" && g_grpnam!="ACCMNG"
ckosonga	tkdtmp2==BLANKS
ckosongb	tkdstr2==BLANKS
ctgvendor	tkdkodejsa!="VENDOR"
ctgvendor2	tkdkodejsa=="VENDOR"

MAP(mtotalnilai)
