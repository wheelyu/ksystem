BEFORE_INPUT	cur_field=tkdnil2   	DO_SKIP_IF caprboq
BEFORE_INPUT	cur_field=tkdnil3   	DO_SKIP_IF caprboq
BEFORE_INPUT	cur_field=tkdjml2   	DO_SKIP_IF caprboq
