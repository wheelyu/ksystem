/------t----t----t---------------------------t-------t---------t---------t---------t-------t---------t-----------t----\
|t.THBL|t.wk|Kode|t.IndikatorBDPerformance   | t.TGT | t.ACT   | t.%Ach  |t.%ACHmd |t.POINT|t.%BOBOT | t.Ket     | __ |
\------.----.----.---------------------------.-------.---------.---------.---------.-------.---------.-----------.----/
IMAGE(tmptrans)
|______|____|____|___________________________|_______|_________|_________|_________|_______|_________|___________|____|


FIELDS(tmptranst)
ltomsdhact	TOMBOL				INPUTRI	1

FIELDS(tmptrans)
tldth         	PROTECT NOCHANGE                INPUTRI 1       /* THBL */
tldsatbsr       PROTECT                         INPUTRI 2       /* WEEK */
tldstr4         PROTECT                         INPUTRI 3       /* INDIKATOR */
lket         	PROTECT                         INPUTRI 4       /* INDIKATOR */
tldhrg         PROTECT                         INPUTRI 5       /* TGT */
tldukrwrn       DIGITS                        INPUTRI 6       /* ACT */
tldsubtot       PROTECT NOCHANGE                INPUTRI 7       /* % ACH */
tldhrgnet       PROTECT NOCHANGE                INPUTRI 8       /* % ACH MD */
tldperdis       PROTECT NOCHANGE                INPUTRI 9       /* POINT */
tldtotdis       PROTECT NOCHANGE                INPUTRI 10       /* BOBOT */
tldket		NONE				INPUTRI 11
lenterd1    	NOCHANGE                	INPUTRI 12       /* TOMBOL ENTER */

CALCS()
cselectactperformance  tldcab == tlmcab && tldbrg == lPERFORMANCE && tlddata == tlmdata && tldth == tlmtype2 && tldsatbsr == tlmjml
cachkrg			tldsubtot < tlmperpph

EDITS(tmptrans)
e.ValidateKet           tldstr4  VALIDATE        tbddatkodidx     mketactPerformance                     {PlDTTABEL}        {PlCUSTOMEREXPERIENCE} {PlKODEMATRIKSIBDA}
e.KetWajibDiisi		tldket			 MANDATORY_IF cachkrg

MAP(mketactPerformance)
tbdket                  lket            REPLACE

/* PERHITUNGAN */
CALCS()
c50			50
c75			75
c90			90
c100			100

cach			tldjml3 / tldhrg * 100
cachmd1			tldsubtot >= 0 && tldsubtot < 70 && (tldstr4 == "1A" || tldstr4 == "1B" || tldstr4 == "1C" || tldstr4 == "2A" || tldstr4 == "2B" || tldstr4 == "2C") && tldbrg == "PERFORMANCE"
cachmd2			tldsubtot >= 70 && tldsubtot < 80 && (tldstr4 == "1A" || tldstr4 == "1B" || tldstr4 == "1C" || tldstr4 == "2A" || tldstr4 == "2B" || tldstr4 == "2C") && tldbrg == "PERFORMANCE"	
cachmd3			tldsubtot >= 80 && tldsubtot < 90 && (tldstr4 == "1A" || tldstr4 == "1B" || tldstr4 == "1C" || tldstr4 == "2A" || tldstr4 == "2B" || tldstr4 == "2C") && tldbrg == "PERFORMANCE"	
cachmd4			tldsubtot >= 90 && tldsubtot < 100 && (tldstr4 == "1A" || tldstr4 == "1B" || tldstr4 == "1C" || tldstr4 == "2A" || tldstr4 == "2B" || tldstr4 == "2C") && tldbrg == "PERFORMANCE"	
cachmd5			tldsubtot >= 100 && (tldstr4 == "1A" || tldstr4 == "1B" || tldstr4 == "1C" || tldstr4 == "2A" || tldstr4 == "2B" || tldstr4 == "2C") && tldbrg == "PERFORMANCE"	
cachmd6			((tldstr4 != "1A" && tldstr4 != "1B" && tldstr4 != "1C" && tldstr4 != "2A" && tldstr4 != "2B" && tldstr4 != "2C") || tldbrg == "POTENTIAL") && tldsubtot <= 100
cachmd7			((tldstr4 != "1A" && tldstr4 != "1B" && tldstr4 != "1C" && tldstr4 != "2A" && tldstr4 != "2B" && tldstr4 != "2C") || tldbrg == "POTENTIAL") && tldsubtot > 100
cpoint			tldhrgnet * tldtotdis / 100

MAP(mhitung)
tldukrwrn		tldjml3			REPLACE
cach			tldsubtot		DO_CALC
c0			tldhrgnet		DO_CALC_IF cachmd1
c50			tldhrgnet		DO_CALC_IF cachmd2
c75			tldhrgnet		DO_CALC_IF cachmd3
c90			tldhrgnet		DO_CALC_IF cachmd4
c100			tldhrgnet		DO_CALC_IF cachmd5
tldsubtot		tldhrgnet		REPLACE_IF cachmd6
c100			tldhrgnet		DO_CALC_IF cachmd7
cpoint			tldperdis		DO_CALC

MAP(mceklisact1)
cy			tlmytppn		DO_CALC

SPCALCS(ssdhisiact)
DO_LIB			ap_dbclc(DNAME dceklisact1, DCOMMAND UPDATE, DTARGET tlmprmidx tlmprm, DMAP mceklisact1);


HOOKS(tmptrans)
AFTER_INPUT		cur_field=tldukrwrn		DO_MAP SHOW mhitung
BEFORE_INPUT		cur_field=tldket		DO_SKIP_IF cachkrg

HOOKS(tmptranst)
CLICKED                 cur_field=ltomsdhact    	DO_SPCALCS  ssdhisiact

SUBFILE(tmptrans)
SFL_LINES(18)
SFL_SORT_BY_FIELD tldstr4
SFL_TITLE(tmptranst)
SFL_SELECT 	cselectactperformance
SFL_TARGET
tldstsbrgukr    tlmdata

SFL_MAP
tlmdata		tlddata
tlmnobuk	tldnobuk
lACTPOTENTIAL   tldbrg                  /*PEMBEDA ANTARA PERFORMANCE DENGAN POTENTIAL*/
tlmcab          tldcab                  /*PEMBEDA TGT BONUS DEALER CABANG 1 DENGAN CABANG LAINNYA*/
tlmtype2        tldthbl                 /*PEMBEDA TGT BONUS DEALER CABANG 1 DENGAN CABANG LAINNYA*/
tlmtype2        tldth                 /*PEMBEDA TGT BONUS DEALER CABANG 1 DENGAN CABANG LAINNYA*/
