CALCS()
cpusatho2x	(mtsdari=="BLAKT_NL" || mtsdari=="PBK" || mtsdari=="TPDPN_ADA" || mtsdari=="TT_ADA" || mtsdari=="TPDPN_BARU" || mtsdari=="TT_BARU" || mtsdari=="GG" || mtsdari=="RNV" || mtsdari=="BLAKT_AL") && (g_grpnam=="GA" || g_grpnam=="ESTIMATOR" || g_grpnam == "IT" || g_grpnam=="RI" || g_grpnam=="REMMGR")

MAP(mklaraccx)
cklaracc	bidstr11	DO_CALC_IF cpusatho2x
g_usrkode	bidplg		REPLACE

MAP(mklartaccx)
cklartacc	bidstr11	DO_CALC_IF cpusatho2x
g_usrkode	bidplg		REPLACE

MAP(mformaccx)
cacc		bidsup		DO_CALC_IF cpusatho2x

MAP(mformtaccx)
ctacc		bidsup		DO_CALC_IF cpusatho2x

SPCALCS(spklaraccx)
	DO_LIB	ap_dbclc(DNAME dupdklaraccx,DCOMMAND UPDATE,DTARGET bidotoidx bidoto,DMAP mklaraccx);
	DO_LIB  ap_dbclc(DNAME dupdabkdonezx,DCOMMAND UPDATE_RANGE,DTARGET abkdatbukidx lKUNCIABSEN mtsnobuk,DMAP mupdabkdonex);
	/*DO_LIB  ap_dbclc(DNAME dupdmtsboqx,DCOMMAND UPDATE,DTARGET mtsotoidx mtsoto,DMAP mupdmtsboq);*/
	DO_LIB_IF cngadugedung ap_dbclc(DNAME daddabkboqx,DCOMMAND ADD,DFILE abk,DMAP maddabkboq);
	DO_LIB_IF cngaduaktiva ap_dbclc(DNAME daddabkboq2x,DCOMMAND ADD,DFILE abk,DMAP maddabkboq2);

SPCALCS(spklartaccx)
	DO_LIB	ap_dbclc(DNAME dupdklartaccx,DCOMMAND UPDATE,DTARGET bidotoidx bidoto,DMAP mklartaccx);
	DO_LIB  ap_dbclc(DNAME dupdabkdonexx,DCOMMAND UPDATE_RANGE,DTARGET abkdatbukidx lKUNCIABSEN mtsnobuk,DMAP mupdabkdonex);
	DO_LIB  ap_dbclc(DNAME daddabkvend2x,DCOMMAND ADD,DFILE abk,DMAP maddabkvend2);

SPCALCS(spformaccx)
	DO_LIB	ap_dbclc(DNAME dupdformaccx,DCOMMAND UPDATE,DTARGET bidotoidx bidoto,DMAP mformaccx);

SPCALCS(spformtaccx)
	DO_LIB	ap_dbclc(DNAME dupdformtaccx,DCOMMAND UPDATE,DTARGET bidotoidx bidoto,DMAP mformtaccx);
	DO_LIB  ap_dbclc(DNAME dupdabkdoneax,DCOMMAND UPDATE_RANGE,DTARGET abkdatbukidx lKUNCIABSEN mtsnobuk,DMAP mupdabkdone);
	DO_LIB  ap_dbclc(DNAME daddabkvend3x,DCOMMAND ADD,DFILE abk,DMAP maddabkvend2);

HOOKS(tmptranst)
AFTER_INPUT 	cur_field=bidhrg		DO_MAP SHOW mtotalrab
CLICKED		cur_field=ltomklarifikasi1x	DO_SPCALCS spklaraccx 
CLICKED		cur_field=ltomklarifikasi2x	DO_SPCALCS spklartaccx
CLICKED		cur_field=ltomform1		DO_SPCALCS spformaccx 
CLICKED		cur_field=ltomform2		DO_SPCALCS spformtaccx

CALCS()
ckonesti	g_grpnam=="ESTIMATOR" || g_grpnam=="IT" || g_grpnam=="RI"

