tkdjenis        ALLCAPS                 INPUTRI         5
tkdket          ALLCAPS                 INPUTRI         6
tkdstr1         NOCHANGE                INPUTRI         7
tkdstr2         ALLCAPS                 INPUTRI         8


DEFAULTS(tmptranst)
