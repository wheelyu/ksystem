HOOKS(tmptranst)
BEFORE_INPUT    cur_field=tkdstr1        DO_SKIP_IF copen1
BEFORE_INPUT    cur_field=tkdstr2        DO_SKIP_IF ctdk
BEFORE_INPUT    cur_field=tkdjenis       DO_SKIP_IF cinpg
