DEFAULTS(tmptranst)
psdnourt	INIT              1
psdsts		DFALT_SCAN_BLANKS	1PRO "1PRO" 1PUL "1PUL"  2PUL "2PUL"  3PUL "3PUL"  SEDO "SEDO" 
psdtype2	DFALT_SCAN_BLANKS	D1 D2 D3 D4 S1 S2 S3 SD SMA SMK SMP TDK_SEKOLAH  

CALCS()
csedo  		psdsts  == "SEDO"
c1pul  		psdsts  == "1PUL"
c2pul  		psdsts  == "2PUL"
c2pul1 		psdsts  == "2PUL" || psdsts   == "3PUL"
c3pul  		psdsts  == "3PUL"
c1pro  		psdsts  == "1PRO"
cjns_univ	psdtype2=="S1" || psdtype2=="S2" || psdtype2=="S3" || psdtype2=="D1" || psdtype2=="D2" || psdtype2=="D3" || psdtype2=="D4"
cjns_smk	psdtype2=="SMK"	
cjns_sma	psdtype2=="SMU" || psdtype2=="SMA"
cUNIVERSITAS	"UNIVERSITAS"
cSMK		"SMK"
cSMA		"SMA"
cpulau		psdsts 	== "1PUL" || psdsts  == "2PUL" || psdsts  == "3PUL" || psdsts  == "1PRO"
chanyapulau	psdsts 	== "1PUL" || psdsts  == "2PUL" || psdsts  == "3PUL" 
chanyaprov 	psdsts 	== "1PRO"
csekolah        psdtype2== "SD" || psdtype2== "SMP" || psdtype2== "SMU" || psdtype2== "SMK"|| psdtype2=="SMA" || psdtype2== "TDK_SEKOLAH"       || psdtype2== "BELUM TAMAT SD"
csekolah2       psdtype2== "SD" || psdtype2== "SMP" || psdtype2== "TDK_SEKOLAH" || psdtype2== "BELUM TAMAT SD"
cuniversitas	psdtype2== "D1" || psdtype2== "D2" || psdtype2== "D3" || psdtype2== "D4" || psdtype2== "S1" || psdtype2== "S2" || psdtype2== "S3"
csekolah3	psdtype2== "D1"||psdtype2=="D2"|| psdtype2== "D3" || psdtype2== "D4" || psdtype2== "S1" || psdtype2== "S2" || psdtype2== "S3" || psdtype2== "SD" || psdtype2== "SMP" || psdtype2== "SMU" 
		|| psdtype2== "SMK" || psdtype2=="SMA"
csekolah4       g_scrnumstr!="134" && (psdtype2== "D1"||psdtype2=="D2"|| psdtype2== "D3" || psdtype2== "D4" || psdtype2== "S1" || psdtype2== "S2" || psdtype2== "S3" || psdtype2== "SD" || psdtype2== "SMP"
		|| psdtype2== "SMU" || psdtype2== "SMK" || psdtype2=="SMA")

ctdkskl		psdtype2== "BELUM TAMAT SD" || psdtype2== "TDK_SEKOLAH"      
cipk		psdtot <= 4 || psdtype2=="SD" || psdtype2=="SMP" || psdtype2=="SMU" || psdtype2=="SMK"|| psdtype2=="SMA" 
cipk2		g_scrnumstr=="134" || psdtot > 0 || psdtype2=="SD" || psdtype2=="SMP" || psdtype2=="SMU" || psdtype2=="SMK" || psdtype2=="SMA"
c1PRO		"1 PROVINSI"
c1PUL		"1 PULAU"
c2PUL		"2 PULAU"
c3PUL		"3 PULAU"
cSEDO		"SELURUH INDONESIA"
cnon134		g_scrnumstr!="134"


EDITS(tmptranst)
e.Mandatory psdstr1	MANDATORY_IF cuniversitas
e.Mandatory psdtype2	MANDATORY
e.Mandatory psdket	MANDATORY_IF cnon134
e.Mandatory psdstr3	MANDATORY_IF csekolah3
e.Mandatory psdstr4	MANDATORY_IF csekolah4
e.Mandatory psdstr5	MANDATORY_IF cuniversitas
e.Mandatory psdtot	MANDATORY_IF cnon134                   
e.Mandatory psdsts 	MANDATORY_IF cnon134
e.Mandatory ltempat1	MANDATORY_IF cpulau
e.Mandatory ltempat2  	MANDATORY_IF c2pul1 
e.Mandatory ltempat3  	MANDATORY_IF c3pul 

e.Validate psdstr1 VALIDATE_IF cuniversitas tbddatkodidx mtbd_jns stbd {Pgv_dttabel} {Pgv_personal} {Pledu21}
e.Validate psdstr3 VALIDATE_IF cuniversitas tbtdattypkod  mtbt_ijazah2 stbt {Pgv_dttabel} {Pgv_dttabel21} {Pgv_personal} {Pledu21} {Ppsdstr1} 
e.Validate psdstr4 VALIDATE tbddatkodidx  mtbd_ijazah3 stbd {Pgv_dttabel} {Pgv_infoumum} {Pgv_tahun}
e.Validate psdstr5 VALIDATE tbtdattypkod  mtbt_ijazah4 stbt {Pgv_dttabel} {Pgv_dttabel21} {Pgv_personal} {Pgv_pendidikan} {Pljns_pendidikan}

e.Validate ltempat1 VALIDATE_IF chanyapulau tbddatkodidx  mtbdPulau stbd {Pgv_dttabel} {Pgv_personal} {Pgv_pulau}
e.Validate ltempat2 VALIDATE_IF chanyapulau tbddatkodidx  mtbdPulau1 stbd {Pgv_dttabel} {Pgv_personal} {Pgv_pulau}
e.Validate ltempat3 VALIDATE_IF chanyapulau tbddatkodidx  mtbdPulau2 stbd {Pgv_dttabel} {Pgv_personal} {Pgv_pulau}
e.Validate ltempat1 VALIDATE_IF chanyaprov dtmdtkodidx  mdtmProp1 sdtmProp {Pgv_dtkota}

MAP(mtbd_jns)
tbdkode		psdstr1		REPLACE

MAP(mtempat1)
ltempat1	psdket2		REPLACE


MAP(mtbt_ijazah2)
tbtkode		psdstr3		REPLACE
tbtket		lnama_univ	REPLACE

CALCS()
cbelangk		BLANKS

MAP(mtbd_ijazah3)
tbdkode		psdstr4		REPLACE
cbelangk		ljns_pendidikan	DO_CALC
cUNIVERSITAS    ljns_pendidikan DO_CALC_IF cjns_univ
cSMK            ljns_pendidikan DO_CALC_IF cjns_smk
cSMA            ljns_pendidikan DO_CALC_IF cjns_sma

MAP(mtbt_ijazah4)
tbtkode		psdstr5		REPLACE
tbtket		lnama_studi	REPLACE

MAP(mtbdPulau)
tbdkode		ltempat1		REPLACE

MAP(mtbdPulau1)
tbdkode		ltempat2  	REPLACE

MAP(mtbdPulau2)
tbdkode		ltempat3  	REPLACE

MAP(mdtmProp1)
dtmkode         ltempat1        REPLACE

MAP(mpenempatan)
c1PRO		lpenempatan	DO_CALC_IF c1pro      
c1PUL		lpenempatan	DO_CALC_IF c1pul     
c2PUL		lpenempatan	DO_CALC_IF c2pul     
c3PUL		lpenempatan	DO_CALC_IF c3pul     
cSEDO		lpenempatan	DO_CALC_IF csedo      

CALCS()
ctdksama	(psdtype== "2PUL" && ltempat3 != ltempat2) || psdtype!="2PUL"
ctdksama2	(psdtype == "3PUL" && (ltempat3 != ltempat2 && ltempat3 != psdket2 && ltempat2!=psdket2)) || psdtype !="3PUL"

HOOKS(tmptranst)
BEFORE_INPUT	cur_field=ltempat1	DO_SKIP_IF csedo
BEFORE_INPUT	cur_field=ltempat2  	DO_SKIP_IF csedo
BEFORE_INPUT	cur_field=ltempat3  	DO_SKIP_IF csedo
BEFORE_INPUT	cur_field=ltempat2  	DO_SKIP_IF c1pul
BEFORE_INPUT	cur_field=ltempat3 	DO_SKIP_IF c1pul
BEFORE_INPUT	cur_field=ltempat3  	DO_SKIP_IF c2pul
BEFORE_INPUT	cur_field=ltempat2 	DO_SKIP_IF c1pro
BEFORE_INPUT	cur_field=ltempat3  	DO_SKIP_IF c1pro
BEFORE_INPUT	cur_field=psdstr1	DO_SKIP_IF csekolah
BEFORE_INPUT	cur_field=psdstr3  	DO_SKIP_IF ctdkskl
BEFORE_INPUT	cur_field=psdstr4  	DO_SKIP_IF ctdkskl
BEFORE_INPUT	cur_field=psdstr5  	DO_SKIP_IF csekolah2
/*BEFORE_INPUT	cur_field=psdtot  	DO_SKIP_IF csekolah*/
AFTER_INPUT	cur_field=psdsts  	DO_MAP SHOW mpenempatan

AFTER_INPUT	cur_field=ltempat1	DO_MAP SHOW mtempat1

AFTER_INPUT     cur_field=ltempat2      DO_MAP SHOW
                IF ctdksama mdum
                ELSE HKCURSOR STAY
                HKMSG i.DtTdkBlhSm

AFTER_INPUT     cur_field=ltempat3       DO_MAP SHOW
                IF ctdksama2 mdum
                ELSE HKCURSOR STAY
                HKMSG i.DtTdkBlhSm

AFTER_INPUT     cur_keybd=EN           	DO_MAP SHOW
                IF ctdksama mdum
                ELSE HKCURSOR STAY
                HKMSG i.DtTdkBlhSm

AFTER_INPUT     cur_keybd=EN           	DO_MAP SHOW
                IF ctdksama2 mdum
                ELSE HKCURSOR STAY
                HKMSG i.DtTdkBlhSm

AFTER_INPUT     cur_field=psdtot       DO_MAP SHOW
                IF cipk mdum
                ELSE HKCURSOR STAY
                HKMSG i.TdkBlhLebihDari 4

AFTER_INPUT     cur_field=psdtot      DO_MAP SHOW
                IF cipk2 mdum
                ELSE HKCURSOR STAY
                HKMSG i.TdkBlhMinus


