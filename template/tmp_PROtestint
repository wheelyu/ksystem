IMAGE(tmptrans)

FIELD(tmptranst)
psdpsmkode		PROTECT                	INPUTRI 1
psdstr1  		PROTECT SCROLL          INPUTRI 2
lnamauser		PROTECT 		INPUTRI 3
psdtgl1  		ALLCAPS {DD-MM-YY}    	INPUTRI 4
psdtype			NOCHANGE		INPUTRI	5
psdtgl2   		ALLCAPS {DD-MM-YY}      INPUTRI 6
psdtype2		NOCHANGE		INPUTRI	7
psdtype3		NOCHANGE		INPUTRI 8
psdstr2			NOCHANGE		INPUTRI 9
psdstr3			NOCHANGE		INPUTRI 10
psdstr4			NOCHANGE		INPUTRI 11
psdstr5			NOCHANGE		INPUTRI 12
psdsts			NOCHANGE		INPUTRI 13

psdtot			NOCHANGE		INPUTRI 14
lepps			PROTECT			INPUTRI 15

psdtot2			NOCHANGE		INPUTRI 16
lkete			PROTECT			INPUTRI 17

psdtot3			NOCHANGE		INPUTRI 18
lima			PROTECT			INPUTRI 19

psdtot4			NOCHANGE		INPUTRI 20
lnume			PROTECT			INPUTRI 21

psdtot5			NOCHANGE		INPUTRI 22
lgen			PROTECT			INPUTRI 23

psdket			TEXTAREA ALLCAPS			INPUTRI 24

DEFAULTS(tmptranst)
psdstr1			INIT_ADD	{g_usrkode}
psdtype			DFALT_SCAN_BLANKS YA TIDAK
psdtype2		DFALT_SCAN_BLANKS YA TIDAK
psdtype3		DFALT_SCAN_BLANKS YA TIDAK
psdstr2 		DFALT_SCAN_BLANKS YA TIDAK
psdstr3 		DFALT_SCAN_BLANKS YA TIDAK
psdstr4 		DFALT_SCAN_BLANKS YA TIDAK
psdstr5 		DFALT_SCAN_BLANKS YA TIDAK
psdsts  		DFALT_SCAN_BLANKS YA TDK  
psdtot			DFALT_SCAN_BLANKS 1 "YA" 
					  2 "TIDAK"
psdtot2			DFALT_SCAN_BLANKS 1 "YA"
					  2 "TIDAK"
psdtot3			DFALT_SCAN_BLANKS 1 "YA"
                                          2 "TIDAK"
psdtot4			DFALT_SCAN_BLANKS 1 "YA"
					  2 "TIDAK"
psdtot5			DFALT_SCAN_BLANKS 1 "YA"
					  2 "TIDAK"

CALCS()
cya		psdtype=="YA"
ctidak		psdtype=="TIDAK"
cbknsreq	hrmkep!="SPESIALREQUEST"
csreq		hrmkep=="SPESIALREQUEST"
cYA		"YA"
cTIDAK		"TIDAK"
cketeY		psdtot2 == 1
cketeT		psdtot2 == 2

ceppsY		psdtot == 1
ceppsT		psdtot == 2

cimaY		psdtot3 == 1
cimaT		psdtot3 == 2

cnumeY		psdtot4 == 1
cnumeT		psdtot4 == 2

cgenY		psdtot5 == 1
cgenT		psdtot5 == 2

EDITS(tmptranst)
t.Mandatory psdtgl1  	MANDATORY_IF cbknsreq
t.Mandatory psdtype	MANDATORY
t.Mandatory psdtgl2  	MANDATORY_IF cya
t.Mandatory psdtype2 	MANDATORY_IF cya
t.Mandatory psdtype3 	MANDATORY_IF cya
t.Mandatory psdstr2  	MANDATORY_IF cya
t.Mandatory psdstr3  	MANDATORY_IF cya
t.Mandatory psdstr4  	MANDATORY_IF cya
t.Mandatory psdstr5  	MANDATORY_IF cya
t.Mandatory psdsts   	MANDATORY_IF cya
t.Mandatory psdtot   	MANDATORY_IF cya
t.Mandatory psdtot2  	MANDATORY_IF cya
t.Mandatory psdtot3  	MANDATORY_IF cya
t.Mandatory psdtot4  	MANDATORY_IF cya
t.Mandatory psdtot5  	MANDATORY_IF cya
t.Mandatory psdket   	MANDATORY
t.Validate psdstr1 VALIDATE psikodidx mpsi_test

MAP(mpsi_test)
psikode		psdstr1	REPLACE
psinama		lnamauser	REPLACE
cYA		lkete		DO_CALC_IF cketeY
cTIDAK		lkete		DO_CALC_IF cketeT

cYA		lepps		DO_CALC_IF ceppsY
cTIDAK		lepps		DO_CALC_IF ceppsT

cYA		lima		DO_CALC_IF cimaY
cTIDAK		lima		DO_CALC_IF cimaT

cYA		lnume		DO_CALC_IF cnumeY
cTIDAK		lnume		DO_CALC_IF cnumeT

cYA		lgen		DO_CALC_IF cgenY
cTIDAK		lgen		DO_CALC_IF cgenT

CALCS()
ctgl_benar	psdtgl1>=g_tgltrn
ctgl_benar2	(psdtype=="YA" && psdtgl2>=g_tgltrn) || psdtype=="TIDAK"

HOOKS(tmptranst)
BEFORE_INPUT	cur_field=psdtgl1	DO_SKIP_IF csreq
BEFORE_INPUT	cur_field=psdtgl2	DO_SKIP_IF ctidak
BEFORE_INPUT	cur_field=psdtype2	DO_SKIP_IF ctidak
BEFORE_INPUT	cur_field=psdtype3	DO_SKIP_IF ctidak
BEFORE_INPUT	cur_field=psdstr2 	DO_SKIP_IF ctidak
BEFORE_INPUT	cur_field=psdstr3 	DO_SKIP_IF ctidak
BEFORE_INPUT	cur_field=psdstr4 	DO_SKIP_IF ctidak
BEFORE_INPUT	cur_field=psdstr5 	DO_SKIP_IF ctidak
BEFORE_INPUT	cur_field=psdsts  	DO_SKIP_IF ctidak
BEFORE_INPUT	cur_field=psdtot  	DO_SKIP_IF ctidak
BEFORE_INPUT	cur_field=psdtot2 	DO_SKIP_IF ctidak
BEFORE_INPUT	cur_field=psdtot3 	DO_SKIP_IF ctidak
BEFORE_INPUT	cur_field=psdtot4 	DO_SKIP_IF ctidak
BEFORE_INPUT	cur_field=psdtot5 	DO_SKIP_IF ctidak

AFTER_INPUT	cur_field=psdtgl1	DO_MAP SHOW 
		IF ctgl_benar mdum
		ELSE HKCURSOR STAY
		HKMSG t.TglBenar

AFTER_INPUT     cur_field=psdtgl2       DO_MAP SHOW
                IF ctgl_benar2 mdum
                ELSE HKCURSOR STAY
                HKMSG t.TglBenar

AFTER_INPUT     cur_keybd=EN       	DO_MAP SHOW
                IF ctgl_benar mdum
                ELSE HKCURSOR STAY
                HKMSG t.TglBenar

AFTER_INPUT     cur_keybd=EN       	DO_MAP SHOW
                IF ctgl_benar2 mdum
                ELSE HKCURSOR STAY
                HKMSG t.TglBenar

	
