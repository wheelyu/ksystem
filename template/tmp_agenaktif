LOCAL
PGM_FIELDS
lPROGAGN         STRING 11
lthblmin1	 STRING 11
laktif		 INT2	2

CALCS()
cthblmin1        THBLS(ststglprjgl)
condagen	 psdtot2 > 0 && psdtype == "1BULAN" && psdkode == lthblmin1

MAP(mscanpsdagen)
gv_int1		 laktif		REPLACE_IF condagen

DBCALCS(dscanpsdagen)
	DBC_COMMAND	SCANSCAN
	DBC_TARGET	psddatstr1ur   lPROGAGN lpsmkode
	DBC_SUM_MAP	mscanpsdagen

IMAGE(tmptranst)
/-----------------t---------\
|    t.NIP        | t.Total |    
\-----------------.---------/
IMAGE(tmptrans)
|_________________|_________|

DEFAULT(tmptrans)
lPROGAGN        INIT            PROGAGN
lthblmin1	INIT		{cthblmin1}

FIELD(tmptrans)
lpsmkode	PROTECT SCROLL  INPUTRI 1
laktif	        PROTECT SCROLL  INPUTRI 2

CALCS()
csel            psdtot2 > 0 && psdtype == "1BULAN" && psdkode == lthblmin1 && dscanpsdagen == 1

SUBFILE(tmptrans)
SFL_LINES(10)
SFL_TITLE(tmptranst)
SFL_SELECT csel
SFL_REKAP psddata
SFL_TARGET psddatstr1ur   lPROGAGN lpsmkode
































