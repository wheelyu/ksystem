FIELD(tmptranst)
svitgl2		ALLCAPS NOLIMIT {DD-MM-YY}  	INPUTRI		1
svinobuk	PROTECT				INPUTRI		2
svistr1		ALLCAPS SCROLL			INPUTRI		3
svistr2		ALLCAPS SCROLL			INPUTRI		4
svistr3		ALLCAPS SCROLL			INPUTRI		5
sviket3		ALLCAPS SCROLL			INPUTRI		6
svistr9		NOCHANGE      			INPUTRI		8 
