DEFAULT(tmptranst)
svitgl1         INIT_ADD                {g_tgltrn}
svitgl1         INIT_UPDATE             {g_tgltrn}
svistr9		DFALT_SCAN BLANKS 	Y ""
					T "" 
lenter		INIT			ENTER
svistr6         DFALT_SCAN              BLANKS
                                        NO_GSM
                                        NO_WA
                                        ALL

CALCS()
cy6x		svistr9 == "Y"
ct6x		svistr9 == "T"
csdhY1		sviyt1 == "Y"

cplhgsm_3         svistr6 == "NO_GSM" || svistr6 == "ALL"
cplhgsm2_3        svistr6 == "NO_GSM"
cplhwa_3         svistr6 == "NO_WA" || svistr6 == "ALL"
cplhwa2_3         svistr6 == "NO_WA"
csamanomor_3	svistr6 == "ALL" && svistr7 != BLANKS

cpanjangnom_3     DO_LIB ap_strln(svistr7,&ljumlahnomor_3);

cpanjangnomwa_3     DO_LIB ap_strln(svistr8,&ljumlahnomorwa_3);

cbukan08_3        (ldigit1_3=="0" && ldigit2_3=="8" && ljumlahnomor_3>=11 && ljumlahnomor_3<=13 && (svistr6 == "NO_GSM" || svistr6 == "ALL")) || svistr6 == "NO_WA"
cbukan08wa_3	(ldigit1wa_3=="0" && ldigit2wa_3=="8" && ljumlahnomorwa_3>=11 && ljumlahnomorwa_3<=13 && (svistr6=="NO_WA" || svistr6 == "ALL")) || svistr6 == "NO_GSM"

EDITS(tmptranst)
e.Mandatory	svitgl2		MANDATORY
e.Mandatory	svistr1		MANDATORY
e.Mandatory	svistr2		MANDATORY
e.Mandatory	svistr3		MANDATORY
e.Mandatory	sviket3		MANDATORY
e.Mandatory	svistr9		MANDATORY
e.Mandatory	svistr10	MANDATORY_IF cy6x
e.Mandatory     svistr6         MANDATORY
e.Mandatory     svistr7         MANDATORY_IF cplhgsm_3
e.Mandatory     svistr8         MANDATORY_IF cplhwa_3

MAP(mpanjangnom_ubah_3)
cpanjangnom_3     ljumlahnomor_3            DO_CALC

MAP(mpanjangnom_ubah2_3)
cpanjangnomwa_3     ljumlahnomorwa_3            DO_CALC

MAP(msananomor3)
svistr7		svistr8		REPLACE_IF csamanomor_3

MAP(mblank3)
cBLANKS		svistr7		DO_CALC_IF cplhwa2_3
cBLANKS		svistr8		DO_CALC_IF cplhgsm2_3

HOOKS(tmptranst)
BEFORE_INPUT	cur_field=svistr10	DO_SKIP_IF ct6x

BEFORE_INPUT            cur_field=svistr7       DO_SKIP_IF cplhwa2_3
BEFORE_INPUT            cur_field=svistr8       DO_SKIP_IF cplhgsm2_3

AFTER_INPUT		cur_field=svistr6	DO_MAP SHOW mblank3

AFTER_INPUT cur_field=svistr7       DO_LIB ap_amstr(svistr7,ln1i,ln1,&ldigit1_3);
AFTER_INPUT cur_field=svistr7       DO_LIB ap_amstr(svistr7,ln2i,ln1,&ldigit2_3);

AFTER_INPUT cur_field=svistr8       DO_LIB ap_amstr(svistr8,ln1i,ln1,&ldigit1wa_3);
AFTER_INPUT cur_field=svistr8       DO_LIB ap_amstr(svistr8,ln2i,ln1,&ldigit2wa_3);

AFTER_INPUT             cur_field=svistr7       DO_MAP SHOW mpanjangnom_ubah_3
AFTER_INPUT             cur_field=svistr8       DO_MAP SHOW mpanjangnom_ubah2_3

AFTER_INPUT cur_field=svistr7		DO_MAP SHOW msananomor3

AFTER_INPUT             cur_field=svistr7 DO_MAP SHOW
                        IF cbukan08_3 mdum
                        ELSE HKCURSOR STAY
                        HKMSG Nomor Telepon 2 Digit Didepan Harus 08 Dan Harus Lebih Dari 10 Dan Kurang Dari 14

AFTER_INPUT             cur_field=svistr8 DO_MAP SHOW
                        IF cbukan08wa_3 mdum
                        ELSE HKCURSOR STAY
                        HKMSG Nomor WA 2 Digit Didepan Harus 08 Dan Harus Lebih Dari 10 Dan Kurang Dari 14

