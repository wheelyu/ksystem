DO_LIB_IF cjoinabklistrik1	ap_dbclc(DNAME dupdabklistrik, DCOMMAND UPDATE_RANGE, DTARGET abkdatbukidx lkunciabsen lnobuklistrik, DMAP mupdabklistrik);
DO_LIB_IF cyalis   		ap_dbclc(DNAME dupdabklistrik2, DCOMMAND UPDATE_RANGE, DTARGET abkdatbukidx lkunciabsen tbdkode, DMAP mupdabklistrik,DBC_COND cselabkga);
DO_LIB_IF cyalis   		ap_dbclc(DNAME dupdabklistrik5, DCOMMAND UPDATE_RANGE, DTARGET abkdatbukidx lkunciabsen tbdkode, DMAP mupdabklistrik,DBC_COND cselabklis);
DO_LIB_IF ctdklis               ap_dbclc(DNAME dupdabklistrik3, DCOMMAND UPDATE_RANGE, DTARGET abkdatbukidx lkunciabsen tbdkode, DMAP mupdabklisinpg,DBC_COND cselabklis);
DO_LIB_IF ctdklisga             ap_dbclc(DNAME dupdabklistrik4, DCOMMAND UPDATE_RANGE, DTARGET abkdatbukidx lkunciabsen tbdkode, DMAP mupdabklistrik, DBC_COND cselabkga);
DO_LIB_IF cyalis        	ap_dbclc(DNAME dupdabkdetlis,DCOMMAND UPDATE_RANGE,DTARGET abkdatbukidx lkunciabsen tbdkode,DMAP mupdabk);
*/
DO_LIB_IF cyalis         ap_dbclc(DNAME dupdabkketlrst,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lketlis,DMAP mupdabklis);
DO_LIB_IF cyalis         ap_dbclc(DNAME dupdabkketlrst2,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gt_RINP lketlis,DMAP mupdabklis);


SPCALCS(spupdfotolis)
        DO_LIB_IF cgpsoklis        ap_dbclc(DNAME dupdfotolis,DCOMMAND UPDATE, DTARGET tbtotoidx tbtoto,DMAP mupdfotolis);
        DO_LIB_IF cgpsoklis        ap_dbclc(DNAME dupdabklis,DCOMMAND UPDATE_RANGE,DTARGET abkdatbukidx lkunciabsen tbdkode,DMAP mupdabk,DBC_COND cselabklis);
        DO_LIB_IF cgpsoklis        ap_dbclc(DNAME daddabk106gaofflis,DCOMMAND ADD,DFILE abk,DMAP maddabk106gaofflis);
        DO_LIB_IF cgpsoklis        ap_dbclc(DNAME daddabk106gaheadlis,DCOMMAND ADD,DFILE abk,DMAP maddabk106gaheadlis);

POSTING(tmptrans)
	PST_ADDCMD	spupdabklistrik
	PST_UPDCMD	spupdabklistrik
