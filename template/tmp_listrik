IMAGE(tmptrans)

FIELD(tmptranst)
tbtkolek	    NOCHANGE		    	INPUTRI 1   /*Pembayaran*/
tbtkode             ALLCAPS                 	INPUTRI 2   /*IdPelanggan*/
tbtket              ALLCAPS SCROLL          	INPUTRI 3   /*Nama Pelanggan*/
tbtkat              NOCHANGE                	INPUTRI 4   /*JnsPembayaran*/
tbtjml              NUMERIC                 	INPUTRI 5   /*Watt*/
tbttot              NUMERIC                 	INPUTRI 6   /*HargaPerKwh*/
tbtdf1		    PROTECT			INPUTRI 7   /*Longitude*/
tbtdf2		    PROTECT			INPUTRI 8   /*Latitude*/
tbttglcrt	    NONE {DD-MM-YYY} NOLIMIT	INPUTRI 9   /*Tgl Byr AKhir*/
tbttblket	    PROTECT			INPUTRI 10  /*uploadok*/
luploklis           TOMBOL                      INPUTRI 11  /*uploadfoto*/
lGMAPS3             TOMBOL                      INPUTRI 12  /*gmaps*/
tbtyt		    NOCHANGE			INPUTRI 13  /*Acc GA*/
tbtkode2	    PROTECT 			INPUTRI 14  /*Nip Acc/Tacc*/
lnamasdmlis	    PROTECT 			INPUTRI 15  /*Nama SDM*/	
tbttbdket	    ALLCAPS SCROLL		INPUTRI 16  /*Keterangan TACC*/

DEFAULT(tmptranst)
tbtkolek	    DFALT_SCAN_BLANKS	     CABANG 
					     SEMARANG 
tbtkat              DFALT_SCAN_BLANKS        PRABAYAR 
                                             PASCABAYAR
tbtyt		    DFALT_SCAN_BLANKS        Y " " 
					     T " " 
tbtcab		    INIT		     "1"
luploklis           INIT                     "UPLOAD OK"
lGMAPS3             INIT      	             "GMAPS"
                                             
CALCS()
cbyrcab		   tbtkolek=="CABANG"
cbyrsmg		   tbtkolek=="SEMARANG" || tbtcab == BLANKS
ctacclis	   tbtyt == "T"
cacclis		   tbtyt == "Y" || tbtcab == "1"
ctambah		   tbtcab == "1"
cubhrek		   tbtcab == BLANKS
cadakoordinat3     tbtdf1 != 0 && tbtdf2 != 0

EDITS(tmptranst)
e.Mandatory 		tbtkolek  MANDATORY
e.Mandatory     	tbtkode   MANDATORY
e.Mandatory     	tbtket    MANDATORY
e.Mandatory     	tbtkat    MANDATORY_IF cbyrcab
e.Mandatory     	tbtjml    MANDATORY_IF cbyrcab
e.Mandatory 		tbttot    MANDATORY_IF cbyrcab
e.MandatoryKetTacclis   tbttbdket MANDATORY_IF ctacclis
e.Validate      	tbtkode2  VALIDATE psikodidx mpsinamasdmlis 0

MAP(mpsinamasdmlis)
psinama         lnamasdmlis        REPLACE

MAP(macclis)
g_usrkode	tbtkode2       	  REPLACE	
psinama         lnamasdmlis       REPLACE

MAP(mupdfotolis)
cOK             tbttblket    DO_CALC

SPCALCS(spgmaps3)
DO_LIB_IF cadakoordinat3 ap_shmap(tbtdf2,tbtdf1);

HOOKS(tmptranst)
BEFORE_INPUT     cur_field=tbtkolek      DO_SKIP_IF cubhrek
BEFORE_INPUT     cur_field=tbtkode       DO_SKIP_IF cubhrek
BEFORE_INPUT     cur_field=tbtket        DO_SKIP_IF cubhrek
BEFORE_INPUT     cur_field=tbtkat        DO_SKIP_IF cbyrsmg
BEFORE_INPUT     cur_field=tbtjml        DO_SKIP_IF cbyrsmg
BEFORE_INPUT     cur_field=tbttot        DO_SKIP_IF cbyrsmg
BEFORE_INPUT     cur_field=tbttglcrt     DO_SKIP_IF cubhrek
BEFORE_INPUT     cur_field=tbtyt         DO_SKIP_IF ctambah
BEFORE_INPUT     cur_field=tbttbdket     DO_SKIP_IF cacclis

AFTER_INPUT      cur_field=tbtyt         DO_MAP SHOW macclis

CLICKED         cur_field=luploklis      DO_SPCALCS spupdfotolis
CLICKED         cur_field=lGMAPS3        DO_SPCALCS spgmaps3

MAP(mupdtbtfoto)
g_fotolon1      tbtdf1       	REPLACE
g_fotolat1      tbtdf2      	REPLACE
cblanks		tbtcab		DO_CALC


DBCALCS(dupdtbtfoto)
        DCOMMAND UPDATE
        DTARGET tbtprmidx tbtprm
        DMAP mupdtbtfoto

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_UPLFLD tbttbdkode tbtkode
SFL_UPLFLD_DBCALCS dupdtbtfoto
SFL_UPL_DIRFLD tbdtgl1
SFL_TARGET
        tbtdattypkod tbddata tmpkode tbddtmkode tbdtblkode tbdkode
SFL_MAP
        tbddata         tbtdata         REPLACE
        tmpkode         tbttype         REPLACE
        tbddtmkode      tbtdtmkode      REPLACE
        tbdtblkode      tbttblkode      REPLACE
        tbdkode         tbttbdkode      REPLACE


/*DBCALCS(djoinabklistrik)
	DBC_COMMAND	JOIN
	DBC_TARGET	abkdatbukidx lkunciabsen lnobuklistrik*/

CALCS()
/*cselabkga	abkkym2 == "APROV FOTO LISTRIK1D"*/
cselabklis         abkkym2 == "UPL REK LISTRIK 3231"

CALCS()
cnobuklistrik		STRIP(tbdkode) + "3231LISTRIK"
/*cjoinabklistrik1	djoinabklistrik == 1*/
cyalis			tbtyt == "Y"
/*ctdklis		tbtyt == "T"*/
/*ctdklisga		tbtyt == "T"*/
cabkoklis          	tbdkode == abknobuk

MAP(mapmaplistrik)
cnobuklistrik	lnobuklistrik	DO_CALC
DEBUG		ldum 		ldum		REPLACE

/*(mupdabklistrik)
gv_CLSD		abksts		REPLACE
DEBUG		ldum 		ldum		REPLACE*/

/*MAP(mupdabklisinpg)
gv_INPG		abksts		REPLACE*/

MAP(mupdabklis)
gv_CLSD         abksts          REPLACE_IF cabkoklis

SPCALCS(spupdabklistrik)
DO_LIB				ap_dbclc(DNAME dmapmaplistrik, DCOMMAND MAPMAP, DMAP mapmaplistrik);
