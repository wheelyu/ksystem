lnmapnrma           PROTECT                         INPUTRI 3
lenter     			NOCHANGE SCROLL	               	INPUTRI 4

DEFAULTS(tmptranst)
lenter		INIT		ENTER
psdtgl1     INIT_ADD	{g_tgltrn}

CALCS()
cnoER       g_grpnam!="HRDSPV" && g_usrkode!="2130879" && g_usrkode!="1604848" && g_usrkode!="2492032"
chrdER      g_grpnam=="HRDSPV" || g_usrkode=="2130879" || g_usrkode=="2492032" || g_usrkode=="1604848"

EDITS(tmptranst)
e.Mandatory   psdstr1   MANDATORY
