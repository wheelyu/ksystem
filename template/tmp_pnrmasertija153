t.Validatepsisrtj    psdstr1   VALIDATE_IF cnoER psistsdepkod mpsi153 spsiCab153 {Pgv_INPG} {Pmtsnobbm}

/*SCAN PSI 153*/
MAP(mpsi153)
psikode         psdstr1         REPLACE
psicabskr	    lcabawlsertija	REPLACE
psinama         lnmapnrma       REPLACE
psijabatan      ljabsertija     REPLACE
