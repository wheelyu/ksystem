IMAGE(tmptrans)

FIELD(tmptranst)
svistr1         NOCHANGE        INPUTRI         1  /* ktp lengkap 	 */
svinobuk        PROTECT         INPUTRI         2
svistr2         ALLCAPS         INPUTRI         3  /* kk lengkap  	 */
svistr3         ALLCAPS         INPUTRI         4  /* pekerjaan pemohon  */
svistr4         ALLCAPS         INPUTRI         7  /* status rumah	 */
svistr5         ALLCAPS         INPUTRI         8  /* alamat tinggal	 */
svistr6         ALLCAPS         INPUTRI         9  /* alamat kerja	 */
svistr7         ALLCAPS         INPUTRI         11 /* penawaran    	 */
svistr8         NOCHANGE        INPUTRI         12 /* penawaran    	 */
svidf1          NUMERIC         INPUTRI         13 /* penawaran    	 */
svidf2          NUMERIC         INPUTRI         14 /* penawaran    	 */
svidf3          NUMERIC         INPUTRI         15 /* penawaran    	 */
svistr9         ALLCAPS         INPUTRI         16 /* penawaran    	 */
svistr10        ALLCAPS         INPUTRI         17 /* penawaran    	 */
svistr31        NOCHANGE        INPUTRI         18 /* penawaran    	 */

DEFAULT(tmptranst)
svistr1         DFALT_LIST BLANKS Y T 
svistr8         DFALT_LIST BLANKS Y T 
svistr31	DFALT_LIST BLANKS CO SL MK

HELPS(tmptranst)
t.PilPenawaran svistr31

CALCS()
cm2w_pjmonly	btmstr1 == "Y"

EDITS(tmptranst)
e.Mandatory svistr1 MANDATORY
e.Mandatory svistr2 MANDATORY
e.Mandatory svistr3 MANDATORY
e.Mandatory svistr4 MANDATORY
e.Mandatory svistr5 MANDATORY_IF cm2w_pjmonly
e.Mandatory svistr6 MANDATORY
e.Mandatory svistr7 MANDATORY

e.validate svistr2 VALIDATE cabstskodidx mcabtmp scabF {Pgv_INPG} 
e.validate svistr6 VALIDATE tbddatkodidx mtbd1_6 stbd {Pgv_dttabel} {Pgv_kunjungan} {Pgv_bpkb21}
e.validate svistr9 VALIDATE tbddatkodidx mtbd1_9 stbd {Pgv_dttabel} {Pgv_kunjungan} {Pgv_pemakai}

MAP(mcabtmp)
cabkode		svistr2		REPLACE

MAP(mtbd1_6)
tbdkode         svistr6         REPLACE

MAP(mtbd1_9)
tbdkode         svistr9         REPLACE

CALCS()
ctdkpenjamin		btmstr1=="T" || btmstr1==BLANKS

HOOKS(tmptranst)
BEFORE_INPUT	cur_field=svistr5	DO_SKIP_IF ctdkpenjamin

SUBFILE(tmptrans)
SFL_TITLE(tmptranst)
SFL_LINES(1)
SFL_TARGET
svidatbuktyp   gv_veradh11 btmnobuk gv_veradh11

SFL_MAP
btmnobuk        svinobuk        REPLACE
gv_veradh11     svidata         REPLACE
gv_veradh11     svitype         REPLACE

PERMIT(tmptrans)
PMT_ADD_COND    cboleht
PMT_UPDALL_COND cbolehu
PMT_DEL_COND    c0
