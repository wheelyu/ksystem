IMAGE(tmptranst)
/---------------------t-------------------t-------------------t---------------------t---------------------t-------\
|t.Usia               |t.ProbActHr        |t.Identify         |t.Corection          |t.Action             |t.Enter|
\---------------------.-------------------.-------------------.---------------------.---------------------.-------/

IMAGE(tmptrans)
|_____________________|___________________|___________________|_____________________|_____________________|_______|

FIELDS(tmptrans)
        kettype         PROTECT                        INPUTRI         1
        ketstr1         TEXTAREA	PROTECT        INPUTRI         2
        ketstr2         TEXTAREA 	PROTECT        INPUTRI         3
        ketstr3         TEXTAREA                       INPUTRI         4
        ketstr4         TEXTAREA                       INPUTRI         5
        lenter          NOCHANGE                       INPUTRI         6

EDITS(tmptrans)
e.Mandatory     ketstr3         MANDATORY
e.Mandatory     ketstr4         MANDATORY

DEFAULTS(tmptrans)
lenter          INIT            ENTER

CALCS()
cjikaam		tlmgrup==g_usrkode
chrsisi3	ketstr3!=BLANKS
chrsisi4	ketstr4!=BLANKS


HOOKS(tmptrans)
BEFORE_INPUT    cur_field=ketstr1       DO_SKIP_IF cjikaam
BEFORE_INPUT    cur_field=ketstr2       DO_SKIP_IF cjikaam

AFTER_INPUT     cur_field=ketstr3 DO_MAP SHOW
                IF chrsisi3 mdum3
                ELSE HKCURSOR STAY
                     HKMSG t.MandatoryKet

AFTER_INPUT     cur_field=ketstr4 DO_MAP SHOW
                IF chrsisi4 mdum3
                ELSE HKCURSOR STAY
                     HKMSG t.MandatoryKet

SUBFILE(tmptrans)
SFL_LINES(6)
SFL_TITLE(tmptranst)
SFL_SELECT ctypeketpiut
SFL_TARGET
        ketdatbukkod   tlmdata tlmnobuk


