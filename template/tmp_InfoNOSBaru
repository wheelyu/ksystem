CALCS()
cpjg13          DO_LIB ap_strln (svistr5,&lpanjangno);
cpanjangno      lpanjangno <= 12
cminpjgno	lpanjangno >= 10
cSENIN          "SENIN"
cSELASA         "SELASA"
cRABU           "RABU"
cKAMIS          "KAMIS"
cJUMAT          "JUMAT"
cSABTU          "SABTU"
cMINGGU         "MINGGU"
cjika1          djointgm3d==1 && ltgmke==1
cjika2          djointgm3d==1 && ltgmke==2
cjika3          djointgm3d==1 && ltgmke==3
cjika4          djointgm3d==1 && ltgmke==4
cjika5          djointgm3d==1 && ltgmke==5
cjika6          djointgm3d==1 && ltgmke==6
cjika7          djointgm3d==1 && ltgmke==0
cjika1a         djointgma3d==1 && ltgmke==1
cjika2a         djointgma3d==1 && ltgmke==2
cjika3a         djointgma3d==1 && ltgmke==3
cjika4a         djointgma3d==1 && ltgmke==4
cjika5a         djointgma3d==1 && ltgmke==5
cjika6a         djointgma3d==1 && ltgmke==6
cjika7a         djointgma3d==1 && ltgmke==0

EDITS(tmptranst)
t.ValidateTgl    svitgl1 VALIDATE_DUP tgmdattglidx mtgm3d 0 {Pgv_dttgl}

MAP(mtgm3d)
tgmtgl          psdtgl1         REPLACE
tgmke           ltgmke          REPLACE
cSENIN          lhari           DO_CALC_IF cjika1
cSELASA         lhari           DO_CALC_IF cjika2
cRABU           lhari           DO_CALC_IF cjika3
cKAMIS          lhari           DO_CALC_IF cjika4
cJUMAT          lhari           DO_CALC_IF cjika5
cSABTU          lhari           DO_CALC_IF cjika6
cMINGGU         lhari           DO_CALC_IF cjika7


MAP(mtanggal3d)
cSENIN          lhari_ini               DO_CALC_IF cjika1a
cSELASA         lhari_ini               DO_CALC_IF cjika2a
cRABU           lhari_ini               DO_CALC_IF cjika3a
cKAMIS          lhari_ini               DO_CALC_IF cjika4a
cJUMAT          lhari_ini               DO_CALC_IF cjika5a
cSABTU          lhari_ini               DO_CALC_IF cjika6a
cMINGGU         lhari_ini               DO_CALC_IF cjika7a

MAP(mcek13)
cpjg13         lpanjangno  DO_CALC

MAP(mdumsvino)
lpanjangno     lpanjangno     REPLACE


HOOKS(tmptranst)
AFTER_INPUT     cur_field=svistr5      DO_MAP  SHOW    mcek13
AFTER_INPUT     cur_field=svistr5      DO_MAP  SHOW
                                    IF cpanjangno mdumsvino
                                    ELSE HKCURSOR STAY
                                    HKMSG t.NomorMaks12Digit
AFTER_INPUT     cur_field=svistr5      DO_MAP  SHOW
                                    IF cminpjgno mdumsvino
                                    ELSE HKCURSOR STAY
                                    HKMSG t.NomorMin10Digit
AFTER_INPUT     cur_field=svistr1       DO_MAP SHOW mtanggal3d


