IMAGE(tmptrans)

FIELD(tmptranst)
tbtyt             ALLCAPS                 INPUTRI 1   /*AdaBiaKuliAngkut?*/
tbttot            NUMERIC                 INPUTRI 2   /*BiaPerUnit*/

CALCS()
cbiaangkutY               tbtyt=="Y"
cbiaangkutT               tbtyt=="T"

DEFAULT(tmptranst)
tbtyt               DFALT_SCAN_BLANKS       Y "Ya"
                                            T "Tidak"

EDITS(tmptranst)
e.Mandatory     tbtyt   MANDATORY
e.Mandatory     tbttot  MANDATORY_IF cbiaangkutY

HOOKS(tmptranst)
BEFORE_INPUT     cur_field=tbttot        DO_SKIP_IF cbiaangkutT

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_UPLFLD tbttbdkode tbtkode
SFL_UPLFLD_DBCALCS dupdtbtfoto
SFL_UPL_DIRFLD tbdtgl1
SFL_TARGET
        tbtdattypkod tbddata tmpkode tbddtmkode tbdtblkode tbdkode
SFL_MAP
        tbddata         tbtdata         REPLACE
        tmpkode         tbttype         REPLACE
        tbddtmkode      tbtdtmkode      REPLACE
        tbdtblkode      tbttblkode      REPLACE
        tbdkode         tbttbdkode      REPLACE
        tbdkode         tbtkode         REPLACE

