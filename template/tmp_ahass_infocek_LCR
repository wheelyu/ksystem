    lJI                 ppdjasbrg          REPLACE
    stsmua              ppdkdmua            REPLACE
    btmtgl              ppdtglfak           REPLACE
    gv_OPEN             ppdsts              REPLACE
    btmscr              ppdscr              REPLACE
    btmcab              ppdgrup             REPLACE
