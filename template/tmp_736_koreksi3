cubhf		g_curcmd==2 && (g_grpnam=="RI" || g_grpnam=="KAWIL" ||g_grpnam=="REMDVH" || g_grpnam=="ADHSYOMA" || g_grpnam=="BPI" || g_grpnam == "DCARESURVEY")

