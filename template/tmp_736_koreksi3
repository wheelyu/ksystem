cplus2x         tldnourt        DO_CALC_IF cjointld_1

MAP(misitranse3)
mtsnobuk        tldnobuk        REPLACE
labktglbm	tldtgl2		REPLACE_IF cjoinkunciabk

HOOKS(tmptranst)
BEFORE_INPUT    cur_field=tldnourt      DO_MAP misiuruty3

BEFORE_INPUT    cur_field=tldtgl3      DO_SKIP_IF clogkwl
BEFORE_INPUT    cur_field=tldket       DO_SKIP_IF clogkwl
BEFORE_INPUT    cur_field=tldtydis     DO_SKIP_IF clognotkwl


AFTER_INPUT     cur_field=tldtgl2       DO_MAP SHOW misitranse3

AFTER_INPUT     cur_field=tldtgl3      DO_MAP  SHOW
