psmnama		lnamabm2	REPLACE
cthblk          lthblk          DO_CALC_IF cjointldf

CALCS()
/*
cjointld_0      djointld == 0 && g_curcmd==1
cjointld_1      djointld == 1 && g_curcmd==1
*/

cjoinkunciabk	djointglabkbm==1
cbtstgl3        tldtgl3 > g_tgltrn && tldtgl3 <= (g_tgltrn + 7)
cststgl		(abksts=="RINP" || abksts=="INPG")
cjointglabk736	djointglabk736==1 && tldtydis=="ACC"
clogkwl		g_grpnam!="BM" && g_grpnam!="IT" && g_grpnam!="ADHSYOMA" && g_grpnam!="BPI" && g_grpnam != "DCARESURVEY"
clognotkwl	g_grpnam!="KAWIL" && g_grpnam!="RI" && g_grpnam!="REMDVH" && g_grpnam!="ADHSYOMA" && g_grpnam!="BPI" && g_grpnam != "DCARESURVEY"

MAP(misiuruty3)
