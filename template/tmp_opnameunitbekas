        DBC_COMMAND     UPDATE
        DBC_TARGET      tldprmidx       tldprm
        DBC_MAP         mupdfotospmb


HOOKS(tmptranst)
BEFORE_INPUT    cur_field=tldnobbm      DO_MAP SHOW murtb
AFTER_INPUT     cur_field=tldnobbm      DO_MAP SHOW mampatb
