lssunobuk2      lssunobuk2      REPLACE_IF cjoinssubekas2x
lpiktglbyrakh   ltglretur       REPLACE_IF cjoinpikretur

cBLANKS		lssunobuk2	DO_CALC
cBLANKS		lbtdnobuk	DO_CALC
cBLANKS		ljnspembia2	DO_CALC
ljnspembia      ljnspembia2     REPLACE_IF cdjoinbtdmb
cMB             ljnspembia2     DO_CALC_IF cMBkond
cMBU            ljnspembia2     DO_CALC_IF cMBUkond

