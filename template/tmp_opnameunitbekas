cmampatb        MAMPAT(tldnobbm)
cadakoordinat2  tldperdis4 != BLANKS && tldperdis5 != BLANKS
cjoinssubekas2  djoinssubekas2 == 1
cjoinssubekas2x djoinssubekas2x == 1
cjoinpikretur	djoinpikretur == 1

