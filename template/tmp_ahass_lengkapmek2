DBCALCS(dupdfoto4)
DBC_COMMAND     UPDATE
DBC_TARGET      aktprmidx   aktprm
DBC_MAP         mupdaktfoto4

HOOKS(tmptranst)
AFTER_INPUT     cur_field=aktlok        DO_MAP SHOW mupdaktmek2
BEFORE_INPUT    cur_field=aktcab        DO_SKIP_IF cTdkAda2

SUBFILE(tmptrans)
SFL_LINES(1)
