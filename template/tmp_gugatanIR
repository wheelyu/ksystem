cnourt1y                lnourt1y + 1
ckhusus			tlmsts == "INPG" && (tlmsts2 == "CAB4" || tlmsts2 == "C4+7") && g_usrkode != "1832688" && g_grpnam != "RI" && g_grpnam != "IT"
cskipsviket3		svitype2 != "PHI" || (g_curcmd == 2 && tlmsts == "INPG" && (tlmsts2 == "O4+7" || tlmsts2 == "OFF4") && g_usrkode != "1832688" && g_grpnam != "RI" && g_grpnam != "IT")
cubah4a			g_curcmd == 2 && tlmsts == "INPG" && (tlmsts2 == "O4+7" || tlmsts2 == "OFF4") && g_usrkode != "1832688" && g_grpnam != "RI" && g_grpnam != "IT"

MAP(mnourt1y)
c1c             svinourt        DO_CALC_IF cjoinchdnourt1y
cnourt1y        svinourt        DO_CALC_IF cjoinchdnourt2y

MAP(mupdubh)
