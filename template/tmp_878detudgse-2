        DO_LIB_IF catasan1layer     ap_dbclc(DNAME dupdabkudgse2det, DCOMMAND UPDATE_RANGE, DTARGET abkdatbukidx lKUNCIABSEN tkmnobuk, DMAP mupdabkudgse1);
        DO_LIB_IF catasan1layer     ap_dbclc(DNAME dupdtkm1gse2det,DCOMMAND ADD,DFILE abk, DMAP maddabk878udgseH);

        DO_LIB_IF catasan1layer		ap_dbclc(DNAME dupdmaster2bdet, DCOMMAND UPDATE, DTARGET tkmbukidx tkmnobuk, DMAP mupdmaster);

POSTING(tmptrans)
