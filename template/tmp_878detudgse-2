tldnobbm    PROTECT     INPUTRI 4
lenter      ALLCAPS     INPUTRI 5
MAP(mupdtlda1)
lBLASTWAUDGSE             tldstr4       		REPLACE
gv_int1                 tldjmlren       REPLACE

MAP(mupdtlda2)
