        DBC_TARGET      tldprmidx   tldprm
        DBC_MAP         mupdtlda1

DBCALCS(dupdtlda2)
        DBC_COMMAND     UPDATE
        DBC_TARGET      tldprmidx   tldprm
        DBC_MAP         mupdtlda2

DEFAULTS(tmptranst)
