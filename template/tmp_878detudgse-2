BEFORE_INPUT    cur_field=tldcab        DO_SKIP_IF cudgseT
BEFORE_INPUT    cur_field=tldukrwrn        DO_SKIP_IF cudgseT
BEFORE_INPUT    cur_field=tldnobbm        DO_SKIP_IF cudgseT
 
