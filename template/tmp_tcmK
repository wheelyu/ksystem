cVL  			tcmtype == "VL"
cfile_bkm	g_scrfile == "bkm"
cfile_bkm2      g_scrfile == "bkm" && ((bkmjns == "ASS" && tcmnobbm != "411.00.2102" && tcmnobbm != "321.00.1101") || bkmjns != "ASS")
