cfile_pmb	g_scrfile == "pmb"
cjoinppsUM1	(djoinppsUM == 1 && lppssisaUM == 0) || (djoinpmbUM == 1 && lpmbsisaUM != 0 )
cjoinppsUM0	(djoinppsUM == 0 || lppssisaUM == 0) && (djoinpmbUM == 0 || lpmbsisaUM == 0)


DEFAULTS(tmptrans)
tcmdk         	INIT              K
tcmsts		INIT		  OPEN
IF cjoinppsUM1 tcmtype  	DFALT_SCAN   	UM "Potong Uang Muka"
IF cjoinppsUM0 tcmtype  	DFALT_SCAN   	TN "Tunai"
			        		TB "Transfer Bank"
			        		CS "Cek Sendiri"
			        		CO "Cek Orang Lain"
			        		CC "Credit Card"
		      				VL "Terima Valas-Uang Asing"
						PK "Piutang Karyawan"

