cnilai_bkm   	tcmtotal 	DO_CALC_IF ctcmtotal0_bkm   
cnilai_bkm2   	tcmtotal 	DO_CALC_IF ctcmtotal0_bkmPBS2   
cnilai_bkm3   	tcmtotal 	DO_CALC_IF ctcmtotal0_bkmPBS3   
cnilai_ppm   	tcmtotal 	DO_CALC_IF ctcmtotal0_ppm   
cnilai_pmb   	tcmtotal 	DO_CALC_IF ctcmtotal0_pmb   
