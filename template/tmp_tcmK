CALCS()
ctot0		tcmtotbuk == 0
cUMHD_bkm	g_scrfile == "bkm" && (bkmjns == "HDN" || bkmjns == "HLN") && tcmtype == "UM"
clUMHD_bkm	g_scrfile == "bkm" && (bkmjns == "HDN" || bkmjns == "HLN") && ~tcmtype == "UM"
cUMHD_pmb	g_scrfile == "pmb" && (bkmjns == "HDN" || bkmjns == "HLN") && tcmtype == "UM"
clUMHD_pmb	g_scrfile == "pmb" && (bkmjns == "HDN" || bkmjns == "HLN") && ~tcmtype == "UM"

cUMok_pps  	(djoinppsUMF == 1 && lppssisaUMF + ~tcmtotbuk >= tcmtotbuk)  || djoinppsUMF == 0
cUMok_pmb       (djoinpmbUMF == 1 && lpmbsisaUMF + ~tcmtotbuk >= tcmtotbuk) || djoinpmbUMF == 0

