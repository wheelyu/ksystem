IF cfile_ppm lkode	INIT	{ppmplg}
IF cfile_pmb lkode	INIT	{pmbsup}
IF cfile_bkm lcab 	INIT	{bkmcab}
IF cfile_ppm lcab 	INIT	{ppmcab}
IF cfile_pmb lcab 	INIT	{pmbcab}

CALCS(master)
cjointcmu0       djointcmu == 0 && g_curcmd == 1 && tcmnourt == 0
cjointcmu1       djointcmu  == 1 && g_curcmd == 1 && tcmnourt == 0
curuttcm       	 luruttcm + 1
cdvs_rekhutgr	 DO_LIB ap_amdvs(gv_dtdivisi21,gv_hutgiro,tcmbbmpiugr); 

cbknCC_ppm     	 tcmtype != "CC" && g_scrfile == "ppm"

ctgljtp_ksg	 tcmtgljtp == BLANKS && tcmtype != "CS" && tcmtype != "CO"
ctgljtp_ksg_ppm	 tcmtgljtp == BLANKS && g_scrfile == "ppm" && tcmtype != "CS" && tcmtype != "CO"

cnocek_ksg_bkm	 g_scrfile == "bkm" && tcmnocek == BLANKS && tcmtype != "CS" && tcmtype != "CO"
cnocek_ksg_ppm	 g_scrfile == "ppm" && tcmnocek == BLANKS && tcmtype != "CS" && tcmtype != "CO"
cnocek_ksg_pmb	 g_scrfile == "pmb" && tcmnocek == BLANKS && tcmtype != "CS" && tcmtype != "CO"
cnomer_tcm_bkm 	 FLD_TO_STRING(tcmnourt) + STRIP(bkmnobuk) 
cnomer_tcm_ppm 	 FLD_TO_STRING(tcmnourt) + STRIP(ppmnobuk) 
cnomer_tcm_pmb 	 FLD_TO_STRING(tcmnourt) + STRIP(pmbnobuk) 

ctcmtotal0_bkm	 g_scrfile == "bkm" && tcmtotal == 0 && tcmtype != "UM" && bkmjns != "PBS"
ctcmtotal0_bkmPBS2	 g_scrfile == "bkm" && tcmtotal == 0 && tcmtype != "UM" && bkmjns == "PBS" && bkmjmld >= bkmjmlk
ctcmtotal0_bkmPBS3	 g_scrfile == "bkm" && tcmtotal == 0 && tcmtype != "UM" && bkmjns == "PBS" && bkmjmld < bkmjmlk
ctcmtotal0_ppm	 g_scrfile == "ppm" && tcmtotal == 0 && tcmtype != "UM"
ctcmtotal0_pmb	 g_scrfile == "pmb" && tcmtotal == 0 && tcmtype != "UM"
ctcmtot0_bkm	 g_scrfile == "bkm" && tcmtotbuk == 0 && tcmtype != "UM" && bkmjns != "PBS"
ctcmtot0_bkmPBS2 g_scrfile == "bkm" && tcmtotbuk == 0 && tcmtype != "UM" && bkmjns == "PBS" && bkmjmld >= bkmjmlk
ctcmtot0_bkmPBS3 g_scrfile == "bkm" && tcmtotbuk == 0 && tcmtype != "UM" && bkmjns == "PBS" && bkmjmld < bkmjmlk
ctcmtot0_ppm	 g_scrfile == "ppm" && tcmtotbuk == 0 && tcmtype != "UM"
ctcmtot0_pmb	 g_scrfile == "pmb" && tcmtotbuk == 0 && tcmtype != "UM"

cnilai_bkm	 bkmjmld - bkmtotal
cnilai_bkm2	 bkmjmld - bkmjmlk 
cnilai_bkm3	 bkmjmlk - bkmjmld 
cnilai_ppm	 ppmtotfak - ppmtotbyr
cnilai_pmb	 pmbtotfak - pmbtotbyr

cpercard0	 tcmpercard == 0.0

