cCekHrsIsi  	 tcmnocek != BLANKS


ctypeCO1       	        tcmtype == "CO" 
cltypeCO1 		~tcmtype == "CO"
cbknCC       		tcmtype != "CC" 

cCSCC_K_UM   		tcmtype == "CS" || tcmtype == "CC" || tcmtype == "UM"
clUMnotHD 		bkmjns != "HDN" && bkmjns != "HLN" && ~tcmtype == "UM"
cUMnotHD  		((bkmjns != "HDN" && bkmjns != "HLN" && tcmtype == "UM") || tcmtype == "PK")
