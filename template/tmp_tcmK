cnomer_tcm_bkm 	tcmnocek       	DO_CALC_IF cnocek_ksg_bkm
cnomer_tcm_ppm 	tcmnocek       	DO_CALC_IF cnocek_ksg_ppm
cnomer_tcm_pmb 	tcmnocek       	DO_CALC_IF cnocek_ksg_pmb
bkmtgl          tcmtgljtp       REPLACE_IF ctgljtp_ksg
ppmtglfak       tcmtgljtp       REPLACE_IF ctgljtp_ksg_ppm
