cnilai_bkm2   	tcmtotbuk	DO_CALC_IF ctcmtot0_bkmPBS2   
cnilai_bkm3   	tcmtotbuk	DO_CALC_IF ctcmtot0_bkmPBS3   
cnilai_ppm   	tcmtotbuk	DO_CALC_IF ctcmtot0_ppm   
cnilai_pmb   	tcmtotbuk	DO_CALC_IF ctcmtot0_pmb   
