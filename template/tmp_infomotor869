lhargaotr	DFLOAT		8

/*-------------JOIN----------------*/

MAP(mjoinssu)
ssubpkb		lnobpkb		REPLACE
ssurangka	lrangka		REPLACE
ssumesin	lmesin		REPLACE

DBCALCS(djoinssu)
        DBC_COMMAND     JOIN
        DBC_TARGET      ssubuk2idx tlmplg
        DBC_MAP         mjoinssu


MAP(mjoinnhm)
nhmhrgpasar	lnhmhrgpasar	REPLACE
nhmjns		lnhmjns		REPLACE
nhmhrgotr	lnhmhrgotr	REPLACE
nhmtotdis	lnhmtotdis	REPLACE
nhmperbg	lnhmperbg	REPLACE
nhmtenor	lnhmtenor	REPLACE
nhmtotpok	lnhmtotpok	REPLACE
nhmumasal	lnhmumasal	REPLACE

DBCALCS(djoinnhm)
        DBC_COMMAND     JOIN
        DBC_TARGET      nhmdatbukidx    gv_bukutamu tlmbisnis
        DBC_MAP         mjoinnhm

MAP(mjoinbtm)
btmtypmtr	ltipemotor	REPLACE
btmplg		lbtmplg		REPLACE
btmdf1		lbtmdf1		REPLACE

DBCALCS(djoinbtm)
        DBC_COMMAND     JOIN
        DBC_TARGET      btmbukidx tlmbisnis
        DBC_MAP         mjoinbtm

MAP(mjoinbrg)
brgkat2		lmerkm2w	REPLACE

DBCALCS(djoinbrg)
        DBC_COMMAND     JOIN
        DBC_TARGET      brgdatkodidx gt_dtmodel ltipemotor
        DBC_MAP         mjoinbrg

MAP(mjoinast)
astmerk         lmerkm4w        REPLACE

DBCALCS(djoinast)
        DBC_COMMAND     JOIN
        DBC_TARGET      astdatkodidx    lasset lbtmplg gv_bpkb lnhmjns
        DBC_MAP         mjoinast



