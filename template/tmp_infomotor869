lmesin		STRING		21
lnhmhrgpasar	DFLOAT		8
lnhmperbg	DFLOAT		8
lnhmtenor	DFLOAT		8
lnhmtotpok	DFLOAT		8
lnhmumasal	DFLOAT		8
lmerk		STRING		21
lmerkm2w	STRING		21
lmerkm4w	STRING		21
lnhmjns		STRING		21
