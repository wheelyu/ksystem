IMAGE(tmptrans)

FIELD(tmptranst)
psdnourt		PROTECT			INPUTRI 1
psdket			PROTECT			INPUTRI 2
psdtgl1  		PROTECT {DD-MM-YY}	INPUTRI 3
psdstr1			PROTECT			INPUTRI	4
psdstr2			PROTECT			INPUTRI 5
psdtype			PROTECT			INPUTRI	6
psdtype2		PROTECT			INPUTRI 7
luploadtacc		TOMBOL			INPUTRI 8
luploadacc		TOMBOL			INPUTRI 9
psdket2  		ALLCAPS SCROLL		INPUTRI 10 

DEFAULTS(tmptranst)
luploadtacc	INIT		TACC
luploadacc	INIT		ACC
l_count3	INIT		1

CALCS()
cadafoto3x	(UPLEXIST(l_count3) == 1  || UPLEXIST(l_count3) == 0) && mtsbisnis=="ACC_FOTO" && (g_grpnam=="HRDER" || g_grpnam=="HRDSPV" || g_grpnam=="HRDDVH" || g_grpnam=="SUPPORT" || g_grpnam=="CMBNHEAD" || g_usrkode=="1802178"|| g_grpnam=="B.IVAROHRD" || g_grpnam=="B.PARTHRD " || g_usrkode=="2130879")

cOK		"OK"
ctacc1		"TACC"
cacc1		"ACC"
cbkn_accfoto	psdtype!="TACC"
caccblanks	psdtype==BLANKS

MAP(mupdmtssdm21)
cOK		psdtype		DO_CALC
g_usrkode	psdstr1		REPLACE
g_tgltrn	psdtgl1		REPLACE

DBCALCS(dupdmtssdm21)
DBC_COMMAND	UPDATE
DBC_TARGET	psdprmidx	psdprm
DBC_MAP		mupdmtssdm21

MAP(mupdmtssdm2)
ctacc1		psdtype2 	DO_CALC
cBLANKS		psdtype		DO_CALC
g_usrkode	psdstr2		REPLACE
g_tgltrn	psdtgl1		REPLACE

MAP(mupdmtssdm3)
cacc1		psdtype2 	DO_CALC
cacc1		psdtype		DO_CALC
g_usrkode	psdstr2		REPLACE
g_tgltrn	psdtgl1		REPLACE

SPCALCS(supdpsd2mts)
	DO_LIB_IF cadafoto3x ap_dbclc(DNAME dupdmtssdm2,DCOMMAND UPDATE,DTARGET psdprmidx psdprm,DMAP mupdmtssdm2);

SPCALCS(supdpsd3mts)
	DO_LIB_IF cadafoto3x ap_dbclc(DNAME dupdmtssdm3,DCOMMAND UPDATE,DTARGET psdprmidx psdprm,DMAP mupdmtssdm3);

HOOKS(tmptranst)
CLICKED		cur_field=luploadtacc	DO_SPCALCS supdpsd2mts
CLICKED		cur_field=luploadacc	DO_SPCALCS supdpsd3mts
BEFORE_INPUT    cur_field=psdket        DO_SKIP_IF cbkn_accfoto

