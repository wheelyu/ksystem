AFTER_INPUT     cur_keybd=EN            DO_MAP SHOW
		IF csdmmasihopen mdum
                ELSE HKCURSOR STAY
                HKMSG t.StsSdmTdkInpg

AFTER_INPUT     cur_keybd=EN            DO_MAP SHOW
		IF csdmsdhinput mdum
                ELSE HKCURSOR STAY
                HKMSG t.SdmSudahDiInput

