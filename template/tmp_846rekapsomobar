ctotadbcd       ltotaladbcd
ctottadbcd      ltotaltadbcd
ctotaltmlain    ltottmlain
ctotalrusak     ltotrusak 
cselkrg         tldjml - tldtotdis
ctothlg         ltotalhilang
ctotjmn         ltotalpmanual   
ctotkrkon       ltotalkrkon     
ctotev          ltotalEv
/*ctothppselkrg   tldsatbsr * tkdjml 
ctothppursk     tldjmlpos * tkdjml 
ctothppselev    (tldsatbsr - tldperdis6) * tkdjml
ctothppuhlg     tldperdism * tkdjml 
ctothppjmn      tldperdis2 * tkdjml
ctothppkrkons   tldperdis4 * tkdjml
ctothppev       tldperdis6 * tkdjml*/
ctotalmutasi    ltotalmutasi
ctotaldoblminp  ltotaldoblminp        
cscantkd        dbscantkdso == 0 || dbscantkdso == 1
cscanakt        dbscanaktso == 0 || dbscanaktso == 1
cscantkm        dbscantkmso == 0 || dbscantkmso == 1


