ctottadbcd              tldperdis               DO_CALC_IF cscansvi
ctotalklop              tldtotdis               DO_CALC_IF cscansvi
ctotaltmlain            tldjml2                 DO_CALC_IF cscansvi
cselkrg                 tldsatbsr               DO_CALC   
lhppselkrg              tldjmlren               REPLACE
ctotalrusak             tldjmlpos               DO_CALC_IF cscansvi
lhppursk                tldhrgnet               REPLACE
lhpppartrsk             tldtmp1                 REPLACE_IF cscantkm
ctothlg                 tldperdism              DO_CALC_IF cscantkd
lhpphlg                 tldperdis1              REPLACE
ctotjmn                 tldperdis2              DO_CALC_IF cscantkd
lhpppenjmanual          tldperdis3              REPLACE
ctotkrkon               tldperdis4              DO_CALC_IF cscantkd
lhppkrkon               tldperdis5              REPLACE
ctotev                  tldperdis6              DO_CALC_IF cscantkd
lhppev                  tldperdis7              REPLACE
lhppselev               tldtotdism              REPLACE
ctotalmutasi            tldjml3                 DO_CALC_IF cscanakt
ctotaldoblminp          tldtmp2                 DO_CALC_IF cscanakt
