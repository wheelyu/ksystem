cscanTadbcd             svistr31 == "MN"
cklop                   svistr9 != "TEMUAN_LAIN"
cscantmlain             svistr9 == "TEMUAN_LAIN"
cscanrusak              svistr9 == "RUSAK"
cscantothlg             tkdtmp1 == "HILANG_ADA_STPL"
cscantothlgtstpl        tkdtmp1 == "HILANG_T_ADA_STPL"
cscantotpmn             tkdtmp1 == "PENJUALAN_MANUAL"
cscantotkrkon           tkdtmp1 == "KIRIM_KE_KONSUMEN"
cscantotEv              tkdtmp1 == "EVENT/PAMERAN"
cscanselev              tkdtmp1 != "EVENT/PAMERAN"
ctotmutasi              aktlok  == "MUTASI_BLM_PROSES"
ctotdoblminp            aktlok  == "DO_BLM_INPUT"
ctotjualblmkr           aktlok  == "MTR_JUAL_BLM_KR"
ctotmotorrretur         aktlok  == "MOTOR_RETUR"
/*cadaharga       tkdjml!= BLANKS*/

MAP(mscanstokbrd)
c1   ltotal1490        DO_CALC_IF cmotor

DBCALCS(dbscanstok1490)
        DBC_COMMAND     SCANSCAN
        DBC_TARGET      brdstscabbrg	gv_INPG tlmcab
        DBC_SUM_MAP     mscanstokbrd

MAP(mscanstokppm)
c1   ltotal614         DO_CALC_IF cscanppm

DBCALCS(dbscanstok614)
        DBC_COMMAND     SCANSCAN
        DBC_TARGET      ppmstscabslm   lDATAPIU gv_INPG tlmcab
        DBC_SUM_MAP     mscanstokppm

MAP(mscansviso)
c1      ltotalsvi         DO_CALC
c1      ltotalklop        DO_CALC_IF cklop
c1      ltotaladbcd       DO_CALC_IF cscanadbcd
c1      ltotaltadbcd      DO_CALC_IF cscanTadbcd
c1      ltottmlain        DO_CALC_IF cscantmlain
c1      ltotrusak         DO_CALC_IF cscanrusak
svidf1  lhppursk          REPLACE_IF cscanrusak

DBCALCS(dbscansviso)
        DBC_COMMAND     SCANSCAN
        DBC_TARGET      svidatbuktyp   lRINCISO tlmnobuk
        DBC_SUM_MAP     mscansviso

/*DBCALCS(djointkdso)
        DBC_COMMAND     JOIN
        DBC_TARGET      tkddatllidx   lTDKKTEMU tlmnobuk
        DBC_SELECT      cadaharga */

MAP(mscantkdso)
c1      ltotalhilang      DO_CALC_IF cscantothlg
c1      ltothlgtstpl      DO_CALC_IF cscantothlgtstpl
c1      ltotalpmanual     DO_CALC_IF cscantotpmn
c1      ltotalkrkon       DO_CALC_IF cscantotkrkon
c1      ltotalEv          DO_CALC_IF cscantotEv
tkdjml  lhppselkrg        REPLACE
tkdjml  lhpphlg           REPLACE_IF cscantothlg
tkdjml  lhpphlgtstpl      REPLACE_IF cscantothlgtstpl
tkdjml  lhppselev         REPLACE_IF cscanselev
tkdjml  lhpppenjmanual    REPLACE_IF cscantotpmn
tkdjml  lhppkrkon         REPLACE_IF cscantotkrkon
tkdjml  lhppev            REPLACE_IF cscantotEv

DBCALCS(dbscantkdso)
        DBC_COMMAND     SCANSCAN
        DBC_TARGET      tkddatllidx   lTDKKTEMU tlmnobuk
        DBC_SUM_MAP     mscantkdso

MAP(mscantkmso)
tkmdf3  lhpppartrsk     REPLACE

DBCALCS(dbscantkmso)
        DBC_COMMAND     SCANSCAN
        DBC_TARGET      tkmdtkdstlok   lUNITRUSAK tlmnobuk gv_OPEN  
        DBC_SUM_MAP     mscantkmso

MAP(mscanaktso)
c1     ltotalmutasi      DO_CALC_IF ctotmutasi
c1     ltotaldoblminp    DO_CALC_IF ctotdoblminp
c1     ltotaljualblmkr   DO_CALC_IF ctotjualblmkr  
c1     ltotalmotorretur  DO_CALC_IF ctotmotorrretur

DBCALCS(dbscanaktso)
        DBC_COMMAND     SCANSCAN
        DBC_TARGET      aktbrgtglidx   tlmnobuk lTEMULAIN lMOBAR
        DBC_SUM_MAP     mscanaktso

CALCS()
ctotalrkp       ltotal1490 + ltotal614
cdbscan         (dbscanstok1490 == 0 || dbscanstok1490 == 1) && (dbscanstok614 == 0 || dbscanstok614 == 1)
ctotalso        ltotalsvi
ctotalklop      ltotalklop
/*cjointkdso      djointkdso == 1 */
