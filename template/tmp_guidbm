CALCS()
cupd1		g_curcmd==2
cpnjg1          DO_LIB ap_strln(sviket,&lpnjg1);
cpnjg2          DO_LIB ap_strln(sviket2,&lpnjg2);
cpnjg3          DO_LIB ap_strln(sviket3,&lpnjg3);
cpjng1          lpnjg1 >= 60 
cpjng2          lpnjg2 >= 60 
cpjng3          lpnjg3 >= 60 

MAP(mpnjng1)
cpnjg1          lpnjg1          DO_CALC

MAP(mpnjng2)
