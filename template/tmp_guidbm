MAP(mpnjng3)
cpnjg3          lpnjg3          DO_CALC

MAP(mdumb)
ldumb		ldumb		REPLACE

HOOKS(tmptranst)
BEFORE_INPUT	cur_field=lguidance	DO_SKIP_IF cupd1
BEFORE_INPUT    cur_field=svistr4       DO_MAP SHOW minput   
AFTER_INPUT     cur_field=sviket        DO_MAP SHOW mpnjng1
AFTER_INPUT     cur_field=sviket        DO_MAP SHOW
                IF cpjng1 mdumb
                ELSE HKCURSOR STAY
                HKMSG t.Progressmin60
AFTER_INPUT     cur_field=sviket2       DO_MAP SHOW mpnjng2
AFTER_INPUT     cur_field=sviket2       DO_MAP SHOW
                IF cpjng2 mdumb
                ELSE HKCURSOR STAY
                HKMSG t.Hambatanmin60
AFTER_INPUT     cur_field=sviket3       DO_MAP SHOW mpnjng3
AFTER_INPUT     cur_field=sviket3       DO_MAP SHOW
                IF cpjng3 mdumb
                ELSE HKCURSOR STAY
                HKMSG t.Usulanmin60

