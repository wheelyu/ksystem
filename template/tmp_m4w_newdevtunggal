IMAGE(tmptrans)

FIELDS(tmptranst)
        svists          PROTECT                   INPUTRI 1
        svistr5         PROTECT                   INPUTRI 1
        svikode         PROTECT QPROTECT UNSEEN   INPUTRI 1
        svistr2         ALLCAPS                   INPUTRI 2
        lketisid        TEXTAREA 2 ALLCAPS         INPUTRI 2
        lketisi2d       TEXTAREA 2 ALLCAPS         INPUTRI 2
        svistr1         NOCHANGE                  INPUTRI 3
        svitgl1         PROTECT {DD-MM-YYYY}      INPUTRI 4
        svinobuk        PROTECT UNSEEN            INPUTRI 5
        svitblkode      PROTECT UNSEEN            INPUTRI 5
        lupld4          TOMBOL                    INPUTRI 1
        svistr33        ALLCAPS                   INPUTRI 6 
        svistr7         TEXTAREA 2 ALLCAPS        INPUTRI 20
        lketisi2        NOCHANGE                  INPUTRI 21



CALCS()
ckodetunggal       svitype == "DEVTUNGGAL"


DEFAULTS(tmptranst)
sviyt1             DFALT_SCAN_BLANKS Y T
svistr2            DFALT_SCAN_BLANKS CERAI CERAI_MATI BELUM_MENIKAH
svistr33           DFALT_SCAN_BLANKS Y T

EDITS(tmptranst)
e.isijenis        svistr2         MANDATORY
e.stsbukan707     svikode         VALIDATE ftmdatbukidx mftm4d sftm6 {PlMULTI4W}
e.isiket          lketisid        MANDATORY
e.ket             svitblkode      VALIDATE ketdatbukkod mket4  0     {Psvidata} {Psvinobuk}
e.isiaccrm        svistr33        MANDATORY_IF cinpgd
e.isiket          svistr7         MANDATORY_IF crmT



MAP(mket4)
ketisi            lketisid        REPLACE_IF cadaket1
ketisi2           lketisi2d       REPLACE_IF cadaket1


MAP(mftm4d)
ftmnofak          svikode         REPLACE

MAP(maddket4)
svinobuk        ketnobuk          REPLACE
svidata         ketdata           REPLACE
svitype         ketkode           REPLACE
lketisid         ketisi            REPLACE_IF cadaket0
lketisi2d        ketisi2           REPLACE_IF cadaket0

MAP(mupdsvi4)
lketisid        ketisi            REPLACE_IF cadaket1b
cBLANKS         lketisid          DO_CALC
ketisi          lketisid          REPLACE
lketisi2d       ketisi2            REPLACE_IF cadaket1b
cBLANKS         lketisi2d          DO_CALC
ketisi2         lketisi2d          REPLACE

MAP(mupload4)
g_tgltrn        svitgl1         REPLACE_IF cuplok
cOK             svistr1         DO_CALC_IF cuplok


MAP(mupdsviftmandx4a)
cIN             svistr1         DO_CALC_IF cksong2
g_tgltrn        svitgl1         REPLACE
gv_INPG         svists          REPLACE_IF cinpg

DBCALCS(dbftupl4a)
        DCOMMAND UPDATE
        DTARGET sviprmidx sviprm
        DMAP mupdsviftmandx4a

MAP(mapr4)
gv_OPEN         svists          REPLACE_IF cksong
cOKRM           svistr34        DO_CALC_IF crmok
ctKRM           svistr34        DO_CALC_IF crmT
gv_TACC         svists          REPLACE_IF crmT


MAP(mmapmap4a)
ldum            ldum              REPLACE
svinourt        lurt              REPLACE
ckuncidev1      lkunci2           DO_CALC

MAP(mkuncirm4)
gv_CLSD         abksts           REPLACE_IF cnipsama

MAP(mkuncirm24)
gv_CLSD         abksts           REPLACE


SPCALCS(saddket4)
DO_LIB                 ap_dbclc(DNAME dmapmap4a,DCOMMAND MAPMAP,DMAP mmapmap4a);
DO_LIB_IF cadaket0     ap_dbclc(DNAME dket4,DCOMMAND ADD,DFILE ket,DMAP maddket4);
DO_LIB_IF cadaket1     ap_dbclc(DNAME dupdsvi4,DCOMMAND UPDATE,DTARGET ketdatbukkod svidata svinobuk svitblkode,DMAP mupdsvi4);


SPCALCS(sdelket4)
DO_LIB_IF cadaket1     ap_dbclc(DNAME ddelket4,DCOMMAND DELETE,DTARGET ketdatbukkod svidata svinobuk svitblkode);                              

SPCALCS(suploadd4)
DO_LIB                 ap_dbclc(DNAME dmapupl4,DCOMMAND MAPMAP,DMAP mmapmap4a);
DO_LIB_IF crm          ap_dbclc(DNAME ddevb4,DCOMMAND ADD,DFILE abk,DMAP madddevrm);
DO_LIB                 ap_dbclc(DNAME dupload4d,DCOMMAND UPDATE,DTARGET sviprmidx sviprm,DMAP mupload4);

SPCALCS(sbkkunci4)
DO_LIB                 ap_dbclc(DNAME dmapmaprm4,DCOMMAND MAPMAP,DMAP mmapmap1a);
DO_LIB_IF crmok2       ap_dbclc(DNAME dupdrmok4,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lkunci2 l643,DMAP mkuncirm4);
DO_LIB_IF crmT2        ap_dbclc(DNAME dupdrmT4,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lkunci2 l643,DMAP mkuncirm24);
DO_LIB_IF cdvh         ap_dbclc(DNAME ddevf4,DCOMMAND ADD,DFILE abk,DMAP madddevdvh);


HOOKS(tmptranst)
CLICKED         cur_field=lupld4        DO_SPCALCS suploadd4
AFTER_INPUT    cur_keybd=EN     DO_MAP SHOW mapr4
AFTER_INPUT     cur_keybd=EN            DO_SPCALCS sbkkunci4
AFTER_INPUT     cur_field=lketisid       DO_MAP SHOW mketcab
AFTER_INPUT     cur_field=lketisid        DO_MAP
                IF ccabisid mdum
                ELSE HKCURSOR STAY
                HKMSG harus 200 karabker
BEFORE_INPUT    cur_field=svistr33      DO_SKIP_IF copend
BEFORE_INPUT    cur_field=svistr7       DO_SKIP_IF copend
BEFORE_INPUT    cur_field=svistr2       DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=svistr1       DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=lketisid      DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=lketisi2d     DO_SKIP_IF cinpgd



SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_UPLFLD_DBCALCS dbftupl4a
SFL_UPLFLD tlmnobuk     svitype
SFL_UPL_DIRFLD tlmtgl
SFL_UPL_DELCOND c0
SFL_SELECT   ckodetunggal
SFL_TARGET
        svidatbuktyp   tlmdata   tlmnobuk     
SFL_MAP
tlmnobuk        svinobuk        REPLACE
tlmuntuk        svidtmkode      REPLACE
tlmnoasal       svikode         REPLACE
tlmdata         svidata         REPLACE
tmpkode         svitype         REPLACE
tmpnourt        svinourt        REPLACE
tmpkode         svitblkode      REPLACE

POSTING(tmptrans)
        PST_ADDCMD saddket4
        PST_UPDCMD saddket4
        PST_DELCMD sdelket4

PERMIT(tmptrans)
  PMT_ADD_COND  cdjoindevslik
  PMT_UPDALL_COND  cdevopen
  PMT_DEL_COND  cdevopen 




