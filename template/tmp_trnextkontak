MAP(mjoinpsmtmplhr)
psmtmplahir	ltmplhr		REPLACE

DBCALCS(djoinpsmtmplhr)
	DBC_COMMAND	JOIN
	DBC_TARGET	psmkodidx tlmdari
	DBC_MAP		mjoinpsmtmplhr

CALCS()
cbukan08                ldigit1=="0" && ldigit2=="8" && ljumlahnomor>=10 && ljumlahnomor<=13
cpanjangnom             DO_LIB ap_strln(tldnobbm,&ljumlahnomor);
cjoinpsmtmplhr		djoinpsmtmplhr == 1

MAP(mpanjangnom)
cpanjangnom             ljumlahnomor            DO_CALC

HOOKS(tmptranst)
BEFORE_INPUT		cur_field=tldket	 DO_MAP SHOW mtmplhr
AFTER_INPUT             cur_field=tldnobbm       DO_LIB ap_amstr(tldnobbm,ln1i,ln1,&ldigit1);
AFTER_INPUT             cur_field=tldnobbm       DO_LIB ap_amstr(tldnobbm,ln2i,ln1,&ldigit2);
AFTER_INPUT             cur_field=tldnobbm    	 DO_MAP SHOW mpanjangnom

AFTER_INPUT             cur_field=tldnobbm DO_MAP SHOW
                        IF cbukan08 mdum
                        ELSE HKCURSOR STAY
                        HKMSG Nomor Telepon 2 Digit Didepan Harus 08 Dan Harus Lebih Dari 10 Dan Kurang Dari 14

MAP(mtmplhr)
ltmplhr		tldstr2		REPLACE_IF cjoinpsmtmplhr

SUBFILE(tmptrans)
