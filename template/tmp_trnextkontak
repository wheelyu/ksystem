tldplg		INIT_ADD	{g_usrkode}
ln1             INIT            1
ln1i            INIT            1
ln2i            INIT            2

EDITS(tmptranst)
e.Mandatory     tldket          MANDATORY
e.Mandatory     tldnobbm        MANDATORY
e.Mandatory	tldstr2		MANDATORY
e.Mandatory	tldstr1		MANDATORY
