		((/* lkodeotp != BLANKS &&*/ btdsisbrg == BLANKS  && btdbrg=="1") ||
		(/*lkodeotp != BLANKS && */(btdbrg == "1" || (btdbrg == "4" && (btdsisbrg=="1" || btdsisbrg=="3") ))))
cftspjmesgn1	sviyt1 != "Y"

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_COND cftspjmesgn
SFL_UPL_DIRFLD btdtgl1
SFL_UPLFLD_DBCALCS dupdsviftpjmesgn
SFL_UPLFLD btmnobuk     svikode
SFL_UPL_CAMERAONLY
SFL_UPL_DELCOND cftspjmesgn1

SFL_TARGET
	svidatbuktyp   gv_datasurvey btmnobuk lPJMESGN728 l4

