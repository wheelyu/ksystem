EDITS(tmptranst)
e.Validate      svinobuk        VALIDATE btmbukidx msviftpjmesgn

MAP(msviftpjmesgn)
cBLANKS         ljamfoto        DO_CALC
svidf8          ljamfoto        REPLACE

CALCS()
cok8             "OK"
cadalonlat8      svidf7!=0 && (g_fotodate1==g_tgltrn || g_grpnam=="RI" || g_grpnam=="IT")
csdhupload8      sviyt1=="Y"
cnamapjmesgn	"FOTO PENJAMIN SAAT ESIGNING"

MAP(mupdsviftpjmesgn)
cnamapjmesgn	svinama		DO_CALC
cY              sviyt1          DO_CALC
cSYSTIME         svidf8          DO_CALC
g_tgltrn        svitgl2         REPLACE

DBCALCS(dupdsviftpjmesgn)
        DCOMMAND UPDATE
        DTARGET sviprmidx sviprm
        DMAP mupdsviftpjmesgn

MAP(mupdsviftpjmesgnok)
g_fotolat1      svidf6          REPLACE
g_fotolon1      svidf7          REPLACE
cok8            sviyt2          DO_CALC_IF cadalonlat8

DBCALCS(dupdsviftpjmesgnok)
        DCOMMAND        UPDATE
        DTARGET         sviprmidx sviprm
        DMAP            mupdsviftpjmesgnok

SPCALCS(spcalftpjmesgnok)
dupdsviftpjmesgnok

HOOKS(tmptranst)
CLICKED         cur_field=lklikok8       DO_SPCALCS IF csdhupload8 spcalftpjmesgnok


CALCS()
