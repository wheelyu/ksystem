CALCS()
ctlmstripxx	STRIP(logscr)+STRIP(logtype)+"XX"
cdjointbdbobotxx	djointbdbobotxx == 1
c420dtk		420
c180dtk		180
c1800dtk	1800
ctotal858	(ltotal858 * 45)
c840		logscr == "840" 
c858		logscr == "858" 
c850		logscr == "850" 
cVALID		logscr == "840" && lVALID840 == "VALID"
cUNVALID	logscr == "840" && lVALID840 == "TDK_VALID"
cket850		"INVESTIGASI LANJUTAN"

MAP(mfiletlmxx)
tlmjml2		ltotal858	REPLACE
tlmbisnis	lVALID840	REPLACE_IF c840
c420dtk		lnilai   	DO_CALC_IF cVALID
c180dtk		lnilai   	DO_CALC_IF cUNVALID
ctotal858	lnilai		DO_CALC_IF c858
c1800dtk	lnilai   	DO_CALC_IF c850
cBLANKS		lket		DO_CALC
lVALID840	lket		REPLACE_IF c840
ltotal858	lket		REPLACE_IF c858
cket850   	lket		DO_CALC_IF c850




MAP(mfiletkmxx)
