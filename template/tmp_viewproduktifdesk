MAP(mfiletldxx)
ctldstrip       ltbdkode        DO_CALC
csatu1          lnilai          DO_CALC
ltbddf1         lnilai          REPLACE_IF cdjointbdbobot



CALCS()
cadabobotdesk  	lognobuk != BLANKS && 
		(logtype=="P" && (logfile == "tlm" || logfile == "tkm" || logfile == "tld")
		&& logscr == "840" || logscr == "858" || logscr == "850")

SUBFILE(tmptrans)
