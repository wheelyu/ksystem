IMAGE(tmptrans)

FIELD(tmptranst)
  lend              NOCHANGE             INPUTRI            1
  tlmytppn          PROTECT              INPUTRI            2

EDITS(tmptranst)
e.Mandatory tlmytppn MANDATORY

DEFAULTS(tmptranst)
lend            INIT    Y

CALCS()
cclsd           tlmsts != "CLS1"
cbolehacc       lend != ""
cjam            SYSTIME
ctest2          tlmdata=="DTLAYOUT" && g_usrkode!="1805349"
cmasuk		tlmdata=="DTLAYOUT"

MAP(misi)
cjam            tlmtgljtp       DO_CALC
g_tgltrn        tlmtgl2         REPLACE
lend            tlmytppn        REPLACE

HOOKS(tmptranst)
AFTER_INPUT     cur_keybd=EN            DO_LIB_IF ctest2 ap_ceksj(tlmplg);
AFTER_INPUT     cur_keybd=EN            DO_MAP SHOW
                IF cbolehacc mdum
                ELSE HKCURSOR STAY
                HKMSG Harap ACC dahulu, Tekan Spasi
AFTER_INPUT     cur_field=tlmytppn       DO_MAP SHOW misi
AFTER_INPUT     cur_field=tlmytppn       DO_MAP SHOW
                IF cclsd mdum
                ELSE HKCURSOR STAY
                HKMSG Status Sudah CLS1 Tidak Bisa Posting

