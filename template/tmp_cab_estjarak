DBCALCS(djoincadestjarak)
	DBC_COMMAND	JOIN
	DBC_TARGET	cadcabdtidx cabkode lESTJARAK lESTJARAK21 cadkode

CALCS()
cestjarak0	(djoincadestjarak==0 && g_curcmd==1) || (g_curcmd==2 && ~cadkode==cadkode) || (g_curcmd==2 && ~cadkode!=cadkode && djoincadestjarak==0)


IMAGE(tmptranst)
/---------t------------t---------------t----------------\
|i.Cab    |t.Kode      |t.JarakM       |t.Menit         |
\---------.------------.---------------.----------------/

IMAGE(tmptrans)
|_________|____________|____________.__|________________|

FIELD(tmptrans)
cadkdcab		PROTECT		INPUTRI		1
cadkode			NOCHANGE	INPUTRI		2
cadtot1			NUMERIC		INPUTRI		3
cadtot2			PROTECT		INPUTRI		4

DEFAULTS(tmptrans)
