MAP(madaSkck)
cYa			psdtype2	DO_CALC_IF cadaSKCK
cTdk			psdtype2	DO_CALC_IF ctdkSKCK
 
HOOKS(tmptranst)
AFTER_INPUT		cur_field=psdtype	DO_MAP SHOW madaSkck

SUBFILE(tmptrans)
SFL_TITLE(tmptranst)  
SFL_LINES(1)

