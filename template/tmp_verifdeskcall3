DBCALCS(djoinabk)
	DBC_COMMAND     JOIN
	DBC_TARGET      abkdatbukidx	lKUNCIABSEN btmnobuk

CALCS()
cverifsudahlengkap      svistr2 != BLANKS && svistr3 != BLANKS && svistr4 != BLANKS && svistr5 != BLANKS && sviket != BLANKS && sviket3 != BLANKS && svistr9 != BLANKS && svistr10 != BLANKS
cverifmasihblmlengkap   svistr2 == BLANKS || svistr3 == BLANKS || svistr4 == BLANKS || svistr5 == BLANKS || sviket == BLANKS || sviket3 == BLANKS || svistr9 == BLANKS || svistr10 == BLANKS
cdjoinabk               djoinabk == 1
cabk727		        abkscr == "727" && abkkym2 == "VER_HO_PGN_UNITDANA"

MAP(mdum)
        lKUNCIABSEN     lKUNCIABSEN     REPLACE

HOOKS(tmptranst)
CLICKED                 cur_field=ltblCekVerif3 DO_MAP SHOW
                                                IF cverifsudahlengkap mdum
                                                ELSE HKCURSOR STAY     
                                                HKMSG t.verifBelumLengkap

CLICKED                 cur_field=ltblCekVerif3 DO_MAP SHOW
                                                IF cverifmasihblmlengkap mdum
                                                ELSE HKCURSOR STAY     
                                                HKMSG t.verifLengkap

CLICKED			cur_field=ltblCekVerif3	DO_SPCALCS IF cverifsudahlengkap spverif3cek

CLICKED			cur_field=ltblCekVerif3	DO_SPCALCS IF cverifmasihblmlengkap spverif3blmcek

