SFL_TARGET
        svidatbuktyp   gv_datasurvey btmnobuk lverifdesk l3
SFL_MAP
        gv_datasurvey 		svidata         REPLACE
        btmnobuk       		svinobuk        REPLACE
        lverifdesk       	svitype         REPLACE
        lverifdesk        	svikode         REPLACE
        l3			svinourt	REPLACE
        g_usrkode       	svistr1         REPLACE
        btmtgl                  svitgl1         REPLACE

PERMIT(tmptrans)
        PMT_ADD_COND    cjoinsviverifdesk3
        PMT_UPDALL_COND cjoinsviverifdesk3U
        PMT_DEL_COND    c0

MAP(mmapmap1)
        l3              l3              REPLACE

MAP(mmapmap2)
        l3              l3              REPLACE

MAP(mupdabk727)
        gv_CLSD         abksts          REPLACE_IF cabk727

SPCALCS(spverif3cek)
DO_LIB                          ap_dbclc(DNAME dmapmap1,DCOMMAND MAPMAP,DMAP mmapmap1);
DO_LIB_IF cdjoinabk             ap_dbclc(DNAME dupdabk,DCOMMAND UPDATE_RANGE,DBC_TARGET abkdatbukidx lKUNCIABSEN btmnobuk,DMAP mupdabk727);

SPCALCS(spverif3blmcek)
