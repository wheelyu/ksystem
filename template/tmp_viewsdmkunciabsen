LOCAL
PGM_FIELDS
lbtmplat		STRING	21
lbtmdvs			STRING	21
lbtmcab			STRING	21
lbtmtgl 		DATE     4

MAP(mjoinbtmabk)
btmplat			lbtmplat	REPLACE
btmdvs			lbtmdvs		REPLACE
btmcab			lbtmcab		REPLACE
btmtgl			lbtmtgl		REPLACE

DBCALCS(djoinbtmabk)
        DBC_COMMAND     JOIN
        DBC_TARGET      btmbukidx abknobuk
	DBC_MAP		mjoinbtmabk

MAP(mjoinsvifr)
svistr5		lsvifr		REPLACE

DBCALCS(djoinsvifr)	
	DBC_COMMAND	JOIN_LAST_SFL
	DBC_TARGET	svidatbuktyp   lHSLAUDIT abknobuk
	DBC_MAP		mjoinsvifr

MAP(mjoinhrm)
hrmdata		lspst		REPLACE

DBCALCS(djoinhrm)	
	DBC_COMMAND	JOIN
	DBC_TARGET	hrmbukidx  abknobuk
	DBC_MAP		mjoinhrm


IMAGE(tmptranst)
/-----t-----t-------------------t----------------------------------\
|t.Scr|t.Sts|     t.NoBuk       | t.Ket                            |
\-----.-----.-------------------.----------------------------------/
IMAGE(tmptrans)
|_____|_____|___________________|__________________________________|_

FIELD(tmptrans)
abkscr 		FLDBUTTON SCROLL	MEDIUM  1
abksts 		PROTECT SCROLL  MEDIUM  2
abknobuk	PROTECT SCROLL  MEDIUM  3
labkkym2 	PROTECT SCROLL  MEDIUM  4
abkkym	 	UNSEEN	INPUTRI	5

CALCS()
ckon1		abkscr == "801" || abkscr == "808" || abkscr == "919" || abkscr == "1428"
cpunyanip	abkkym==psmkode
ckuncpk		FLD_TO_STRING(lbtmtgl) + " " + STRIP(lbtmcab) + " " + STRIP(abkkym2) + " " + STRIP(lbtmplat) 
cdrkuncpk	abkscr=="727" && djoinbtmabk==1 && (lbtmdvs=="HMC" || lbtmdvs=="M2W") && lbtmplat!=BLANKS
ckunci850	STRIP(abkkym2) + " " + STRIP(lsvifr)
cdr850		abkscr=="850" && djoinsvifr==1 && lsvifr!=BLANKS
cdr147		abkscr=="147" && djoinhrm==1 && lspst!=BLANKS

EDIT(tmptrans)
e.Validate      abkkym		VALIDATE        psikodidx       mpsiabk

MAP(mpsiabk)
cblanks		labkkym2	DO_CALC
abkkym2		labkkym2	REPLACE
ckuncpk		labkkym2	DO_CALC_IF cdrkuncpk
ckunci850	labkkym2	DO_CALC_IF cdr850


HOOKS(tmptrans)
CLICKED	        cur_field=abkscr 	DO_FLY {abkscr} mmapabk  
  
MAP(mmapabk)
abknobuk     r_string1   REPLACE
abknoll	     r_string1	 REPLACE_IF ckon1
abkscr       r_string2   REPLACE
g_scrnumstr  r_string3	 REPLACE
abkkym	     r_string4	 REPLACE
lspst		 r_string5   REPLACE_IF cdr147

SUBFILE(tmptrans)
SFL_LINES(20)      
SFL_TITLE(tmptranst)
SFL_SELECT cpunyanip
SFL_TARGET    	
abkdatstskym  lkunciabsen gv_INPG psmkode
