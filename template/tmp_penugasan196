e.Mandatory     tkdstr1 MANDATORY
e.Mandatory     tkdstr2 MANDATORY
e.Mandatory     tkdjml2  MANDATORY
e.ValidatePsi tkdjwbstr1 VALIDATE_IF cnip1_ada psmdtkodidx mpsm2 spsm  {Pgv_dtkaryawan} {Pgv_INPG}
t.ValidateProg  tkdjwbstr1 VALIDATE  tbddatkodidx mtbdIT  stbd {Pgv_dttabel} {PlIT} {PlSOIT}
e.ValidatePsi tkdjwbstr2 VALIDATE_IF cnip2_ada psmdtkodidx mpsm3 spsm  {Pgv_dtkaryawan} {Pgv_INPG}
e.ValidateJenis tkdjenis VALIDATE tbddatkodidx mjns stbd  {Pgv_dttabel} {PlIT} {PlDETAILPR}
t.ValidateJenis2 tkdstr1 VALIDATE_IF ctambahuatx tbddatkodidx mtbd3 stbd {Pgv_dttabel} {PlIT} {PlKAT1962D}
t.ValidateGrade tkdstr2 VALIDATE tbtdattypkod mtbt2 stbt {Pgv_dttabel} {Pgv_dttabel21} {PlIT} {PlDETAILGRADE} {Ptkdstr1}

