BEFORE_INPUT    cur_field=tkdjml4               DO_SKIP_IF cbknlap
BEFORE_INPUT    cur_field=tkdtgl                DO_SKIP_IF csdhCLSD2
BEFORE_INPUT    cur_field=tkdtgl2               DO_SKIP_IF csdhCLSD2
