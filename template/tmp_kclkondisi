IMAGE(tmptrans)

FIELD(tmptranst)
tmpket			PROTECT			INPUTRI 1
psdtgl1                 PROTECT {DD-MM-YY}     INPUTRI 1
psdtype                 PROTECT                 INPUTRI 4
psdstr1                 NOCHANGE		INPUTRI 2
psdstr2			ALLCAPS                 INPUTRI 5
psdket                  TEXTAREA ALLCAPS SCROLL INPUTRI 8

DEFAULTS(tmptranst)
psdtgl1		INIT			{g_tgltrn}
psdstr1		INIT			{g_usrkode}
psdstr2		DFALT_SCAN_BLANKS	SEMBUH 
					BELUM_SEMBUH
CALCS()
cblmsmbh 	psdstr2 == "BELUM_SEMBUH"
csdhsmbh	psdstr2 == "SEMBUH"

EDITS(tmptranst)
e.Mandatory	psdstr2		MANDATORY
e.Mandatory	psdket		MANDATORY_IF cblmsmbh

MAP(mupdpsdkond)
cBLANKS		psdtype		DO_CALC
g_tgltrn	psdtgl1		REPLACE

HOOKS(tmptranst)
BEFORE_INPUT	cur_field=psdket	DO_SKIP_IF csdhsmbh
AFTER_INPUT	cur_field=psdstr2	DO_MAP SHOW mupdpsdkond

SUBFILE(tmptrans)
SFL_TITLE(tmptranst)
SFL_LINES(1)
SFL_UPLFLD  psdpsmkode psdkode
SFL_UPLFLD_DBCALCS dupdpsdupl
SFL_UPL_DELCOND c0
SFL_TARGET
        psddatpsmkod tlmdata tlmnobuk tmpkode
SFL_MAP
tlmdata    	psddata		REPLACE
tmpkode		psdkode		REPLACE
tlmnobuk	psdpsmkode	REPLACE
