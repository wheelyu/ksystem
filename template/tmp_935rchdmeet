CALCS()
ckunciguidmeet			abktype == "GUIDMEET" && (abksts == "RINP" || abksts == "INPG") 
ckuncirmdrmeet			abktype == "RMDRMEET" && (abksts == "RINP" || abksts == "INPG")
ckunciupldmeet			abktype == "UPLDMEET" && (abksts == "RINP" || abksts == "INPG")
ckuncimeetsendev		abktype == "JDWLMEET" && abkkym == lnipsendev
ckuncimeetpicdev		abktype == "JDWLMEET" && abkkym == lnippicdev
ckuncimeetpiccoe		abktype == "JDWLMEET" && abkkym == lnippiccoe

DBCALCS(djoinabkguidmeet)
	DBC_COMMAND		JOIN
	DBC_TARGET		abkdatbukidx lKUNCIABSEN tlmnobuk
	DBC_SELECT		ckunciguidmeet

DBCALCS(djoinabkrmdrmeet)
	DBC_COMMAND		JOIN
	DBC_TARGET		abkdatbukidx lKUNCIABSEN tlmnobuk
	DBC_SELECT		ckuncirmdrmeet

DBCALCS(djoinabkupldmeet)
	DBC_COMMAND		JOIN
	DBC_TARGET		abkdatbukidx lKUNCIABSEN tlmnobuk
	DBC_SELECT		ckunciupldmeet

DBCALCS(djoinabkmeetsendev)
	DBC_COMMAND		JOIN
	DBC_TARGET		abkdatbukidx lKUNCIABSEN tlmnobuk
	DBC_SELECT		ckuncimeetsendev

DBCALCS(djoinabkmeetpicdev)
	DBC_COMMAND		JOIN
	DBC_TARGET		abkdatbukidx lKUNCIABSEN tlmnobuk
	DBC_SELECT		ckuncimeetpicdev

DBCALCS(djoinabkmeetpiccoe)
	DBC_COMMAND		JOIN
	DBC_TARGET		abkdatbukidx lKUNCIABSEN tlmnobuk
	DBC_SELECT		ckuncimeetpiccoe

