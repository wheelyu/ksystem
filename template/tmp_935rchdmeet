				ONLINE
				OFFLINE

CALCS()
cbtlmeet		tkdjenis == "BATAL"
crchdmeet		tkdjenis == "GANTITGL"
cupdtglmeet		(tkdjenis == "GANTITGL" && (tkdtgl - g_tgltrn) >= 0) ||
			(tkdjenis == "BATAL")

chmin7guidmeet		(tlmtgl2 - tkdtgl) == 7 && djoinabkguidmeet == 1
chmin7rmdrmeet		(tlmtgl2 - tkdtgl) == 7 && djoinabkrmdrmeet == 1
chmin7upldmeet		(tlmtgl2 - tkdtgl) == 7 && djoinabkupldmeet == 1

chmin3meetsendev	(tlmtgl2 - tkdtgl) == 3 && djoinabkmeetsendev == 0
chmin3meetpicdev	(tlmtgl2 - tkdtgl) == 3 && djoinabkmeetpicdev == 0
chmin3meetpiccoe	(tlmtgl2 - tkdtgl) == 3 && djoinabkmeetpiccoe == 0

cnipguidance		abktype == "GUIDMEET" && abkkym == lnippdcadir	
cniprmdrmeet		abktype == "RMDRMEET" && 
			(abkkym == lnippiccoe || abkkym == lnippdcadir || abkkym == lnippicpdca || abkkym == lnippdcadiv ||
			 abkkym == lnipsendev || abkkym == lnipdev1    || abkkym == lnipdev2    /* || abkkym == lnipdev3 */ || abkkym == lnippicdev)
cnipupldmeet		abktype == "UPLDMEET" &&
			(abkkym == lnipsendev || abkkym == lnipdev1    || abkkym == lnipdev2    /* || abkkym == lnipdev3 */ )

crchdmin6		tkdtgl - 6
crchdmin5		tkdtgl - 5
crchdmin4		tkdtgl - 4
crchdmin2		tkdtgl - 2

