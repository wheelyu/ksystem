SPCALCS(sprechedule)
DO_LIB_IF cbtlmeet		ap_dbclc(DNAME dbatalmeeting,DCOMMAND UPDATE,DTARGET tlmprmidx tlmprm,DMAP mbatalmeeting);
DO_LIB_IF cbtlmeet		ap_dbclc(DNAME dbukaabkbtlmeet,DCOMMAND UPDATE_RANGE,DTARGET abkdatbukidx lKUNCIABSEN tlmnobuk,DMAP mbukaabkbtlmeet);/*buka kunci semua meeting*/

/*update kuncian jika H-7 dari tgl meeting terbaru*/
DO_LIB_IF chmin7guidmeet	ap_dbclc(DNAME drchdmeetguid,DCOMMAND UPDATE_RANGE,DTARGET abkdatbukidx lKUNCIABSEN tlmnobuk,DMAP mupdmeetguidance);	/*update kunci Guidance Bersama Direksi*/
DO_LIB_IF chmin7rmdrmeet	ap_dbclc(DNAME drchdrmdrmeet,DCOMMAND UPDATE_RANGE,DTARGET abkdatbukidx lKUNCIABSEN tlmnobuk,DMAP mupdmeetreminder);	/*update kunci Reminder Meeting*/
DO_LIB_IF chmin7upldmeet	ap_dbclc(DNAME drchdupldmeet,DCOMMAND UPDATE_RANGE,DTARGET abkdatbukidx lKUNCIABSEN tlmnobuk,DMAP mupdmeetupldmeet);	/*update kunci Upload Bahan Meeting*/

/*update kuncian jika H-3 dari tgl meeting terbaru*/
DO_LIB_IF chmin3meetsendev	ap_dbclc(DNAME daddmeeting,DCOMMAND ADD,DFILE abk,DMAP maddmeeting);		/*reminder jadwal meeting H-2 Senior Dev*/
DO_LIB_IF chmin3meetpicdev	ap_dbclc(DNAME daddmeeting2,DCOMMAND ADD,DFILE abk,DMAP maddmeeting2);		/*reminder jadwal meeting H-2 Pic Dev*/
DO_LIB_IF chmin3meetpiccoe	ap_dbclc(DNAME daddmeeting3,DCOMMAND ADD,DFILE abk,DMAP maddmeeting3);		/*reminder jadwal meeting H-2 Pic Coe*/

/*update master meeting*/
