        DCOMMAND        UPDATE
        DTARGET         sviprmidx sviprm
        DMAP            mupdsviftpjmok

SPCALCS(spcaluplftpjmok)
dupdsviftpjmok
DO_LIB ap_nxpst(l4461,lm4461det2);

