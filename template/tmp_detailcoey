LOCAL
PGM_FIELDS
lnourty			INT2	3


MAP(mambilnourtY)
ketnourt	lnourty		REPLACE
DBCALCS(dnourtY)
	DBC_COMMAND             JOIN_LAST_SFL
	DBC_TARGET              ketbukurtidx tlmdata tlmnobuk
        DBC_SELECT              cselectY
	DBC_MAP	                mambilnourtY

IMAGE(tmptranst)
/------------------------------------------------\
|/----------------------------------------------\|
||  spasi                                       ||_
||  t.NoUrut    : ___                           ||
||  t.DetailCOE : _____________________________ ||
||  t.TipeAct   : ___  ________________________ ||
||  t.Buk909    : _____________________________ ||
||				       ________ ||
|| spasi                                        ||
|\----------------------------------------------/|
\------------------------------------------------/
 /----------------------------------------------\
