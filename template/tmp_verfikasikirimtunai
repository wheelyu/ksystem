IMAGE(tmptrans)

FIELD(tmptranst)
svistr1         NOCHANGE                        INPUTRI         1
svinobuk        PROTECT                         INPUTRI         2
svinama         ALLCAPS SCROLL                  INPUTRI         3
svistr2         NOCHANGE                        INPUTRI         4
svistr3         NOCHANGE                        INPUTRI         5
svistr5         ALLCAPS                         INPUTRI         6
svistr6         NOCHANGE                        INPUTRI         7
svistr7         DIGITS                          INPUTRI         8
svistr8         DIGITS                          INPUTRI         9
svidf1 	        NUMERIC                         INPUTRI         10


DEFAULTS(tmptranst)
svitgl1         INIT_ADD                {g_tgltrn}
svitgl1         INIT_UPDATE             {g_tgltrn}
svistr1         DFALT_SCAN_BLANKS       Y ""
                                        T ""
svistr2         DFALT_SCAN_BLANKS       Y ""
                                        T ""
svistr3         DFALT_SCAN_BLANKS       Y ""
                                        T ""

svistr6         DFALT_SCAN              BLANKS
                                        NO_GSM
                                        NO_WA
                                        ALL

CALCS()
ctipY		svistr3 == "Y"
ctipT		svistr3 == "T"
cplhgsm         svistr6 == "NO_GSM" || svistr6 == "ALL"
cplhgsm2        svistr6 == "NO_GSM"
cplhwa          svistr6 == "NO_WA" || svistr6 == "ALL"
cplhwa2         svistr6 == "NO_WA"
csamanomor	svistr6 == "ALL" && svistr7 != BLANKS

cpanjangnom     DO_LIB ap_strln(svistr7,&ljumlahnomor);

cpanjangnomwa     DO_LIB ap_strln(svistr8,&ljumlahnomorwa);

EDITS(tmptranst)
e.Mandatory             svistr1         MANDATORY
e.Mandatory             svinama         MANDATORY
e.Mandatory             svistr2         MANDATORY
e.Mandatory             svistr3         MANDATORY
e.Mandatory             svistr5         MANDATORY_IF ctipY
e.Mandatory             svidf1          MANDATORY
e.Mandatory             svistr6         MANDATORY
e.Mandatory             svistr7         MANDATORY_IF cplhgsm
e.Mandatory             svistr8         MANDATORY_IF cplhwa

CALCS()
cblmkrmx        lstskrm == "KR"
csdhY3          sviyt1 == "Y"

cbukan08        (ldigit1=="0" && ldigit2=="8" && ljumlahnomor>=11 && ljumlahnomor<=13 && (svistr6 == "NO_GSM" || svistr6 == "ALL")) || svistr6 == "NO_WA"
cbukan08wa	(ldigit1wa=="0" && ldigit2wa=="8" && ljumlahnomorwa>=11 && ljumlahnomorwa<=13 && (svistr6=="NO_WA" || svistr6 == "ALL")) || svistr6 == "NO_GSM"

MAP(mpanjangnom_ubah)
cpanjangnom     ljumlahnomor            DO_CALC

MAP(mpanjangnom_ubah2)
cpanjangnomwa     ljumlahnomorwa            DO_CALC

MAP(msananomor)
svistr7		svistr8		REPLACE_IF csamanomor

MAP(mblank2)
cBLANKS		svistr7		DO_CALC_IF cplhwa2
cBLANKS		svistr8		DO_CALC_IF cplhgsm2

HOOKS(tmptranst)
BEFORE_INPUT            cur_field=svistr7       DO_SKIP_IF cplhwa2
BEFORE_INPUT            cur_field=svistr8       DO_SKIP_IF cplhgsm2

AFTER_INPUT		cur_field=svistr6	DO_MAP SHOW mblank2

AFTER_INPUT cur_field=svistr7       DO_LIB ap_amstr(svistr7,ln1i,ln1,&ldigit1);
AFTER_INPUT cur_field=svistr7       DO_LIB ap_amstr(svistr7,ln2i,ln1,&ldigit2);

AFTER_INPUT cur_field=svistr8       DO_LIB ap_amstr(svistr8,ln1i,ln1,&ldigit1wa);
AFTER_INPUT cur_field=svistr8       DO_LIB ap_amstr(svistr8,ln2i,ln1,&ldigit2wa);

AFTER_INPUT             cur_field=svistr7       DO_MAP SHOW mpanjangnom_ubah
AFTER_INPUT             cur_field=svistr8       DO_MAP SHOW mpanjangnom_ubah2

AFTER_INPUT cur_field=svistr7		DO_MAP SHOW msananomor

AFTER_INPUT             cur_field=svistr7 DO_MAP SHOW
                        IF cbukan08 mdum
                        ELSE HKCURSOR STAY
                        HKMSG Nomor Telepon 2 Digit Didepan Harus 08 Dan Harus Lebih Dari 10 Dan Kurang Dari 14

AFTER_INPUT             cur_field=svistr8 DO_MAP SHOW
                        IF cbukan08wa mdum
                        ELSE HKCURSOR STAY
                        HKMSG Nomor WA 2 Digit Didepan Harus 08 Dan Harus Lebih Dari 10 Dan Kurang Dari 14

BEFORE_INPUT	cur_field=svistr5	DO_SKIP_IF ctipT
BEFORE_INPUT	cur_field=svistr1	DO_MAP SHOW
                IF cblmkrmx  mdum    
                ELSE HKCURSOR STAY
                HKMSG t.MtrBlmKirimKirimDahulu
BEFORE_INPUT	cur_keybd=EN     	DO_MAP SHOW
                IF cblmkrmx  mdum    
                ELSE HKCURSOR STAY
                HKMSG t.MtrBlmKirimKirimDahulu

MAP(mupdsviupl3)
gv_Y            sviyt1          REPLACE
g_tgltrn        svitgl2         REPLACE
DBCALCS(dupdsviupl3)
        DBC_COMMAND     UPDATE
        DBC_TARGET      sviprmidx       sviprm
        DBC_MAP         mupdsviupl3

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_UPL_DELCOND csdhY3
SFL_UPLFLD_DBCALCS dupdsviupl3
SFL_UPL_DIRFLD btmtgl  
SFL_UPLFLD      svinobuk
/*SFL_UPL_DIRFLD  g_tgltrn*/
SFL_TARGET
svidatbuktyp   	gv_veradh11 lnofak   

SFL_MAP
lnofak          svinobuk        REPLACE
gv_veradh11     svidata         REPLACE
lVERKIRIMCAIR	svikode		REPLACE

PERMIT(tmptrans)
PMT_ADD_COND    cadd  
PMT_UPDALL_COND cboleh
PMT_DEL_COND    c0    

