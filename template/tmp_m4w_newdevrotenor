IMAGE(tmptrans)

FIELDS(tmptranst)
        svists          PROTECT                   INPUTRI 1
        svistr5         PROTECT                   INPUTRI 1
        svikode         PROTECT  QPROTECT UNSEEN  INPUTRI 1
        svidf1          ALLCAPS                   INPUTRI 2
        lketisii        TEXTAREA 2 ALLCAPS         INPUTRI 2
        lketisi2i       TEXTAREA 2 ALLCAPS         INPUTRI 2
        svistr1         NOCHANGE                  INPUTRI 3
        svitgl1         PROTECT {DD-MM-YYYY}      INPUTRI 4
        svinobuk        PROTECT UNSEEN            INPUTRI 5
        svitblkode      PROTECT UNSEEN            INPUTRI 5
        lupld9          TOMBOL                    INPUTRI 1
        svistr33        ALLCAPS                   INPUTRI 6
        svistr7         TEXTAREA 2 ALLCAPS        INPUTRI 20
        lketisi2        NOCHANGE                  INPUTRI 21


EDITS(tmptranst)
e.isinominal      svidf1          MANDATORY
e.stsbukan707     svikode         VALIDATE ftmdatbukidx mftm9 sftm6 {PlMULTI4W}
e.isiket          lketisii        MANDATORY
e.ket             svitblkode      VALIDATE ketdatbukkod mket9  0     {Psvidata} {Psvinobuk}
e.isiaccrm        svistr33        MANDATORY_IF cinpgd
e.isiket          svistr7         MANDATORY_IF crmT


DEFAULTS(tmptranst)
svistr33           DFALT_SCAN_BLANKS Y T

MAP(mket9)
lketisii         ketisi            REPLACE_IF cadaket1b
cBLANKS         lketisii           DO_CALC
ketisi          lketisii           REPLACE
lketisi2i        ketisi2            REPLACE_IF cadaket1b
cBLANKS         lketisi2i           DO_CALC
ketisi2         lketisi2i          REPLACE

MAP(mftm9)
ftmnofak        svikode         REPLACE

MAP(maddket9)
svinobuk        ketnobuk          REPLACE
svidata         ketdata           REPLACE
svitype         ketkode           REPLACE
lketisii         ketisi            REPLACE_IF cadaket0
lketisi2i        ketisi2           REPLACE_IF cadaket0

MAP(mupdsvi9)
lketisii        ketisi            REPLACE_IF cadaket1b
cBLANKS         lketisii          DO_CALC
ketisi          lketisii          REPLACE
lketisi2i       ketisi2            REPLACE_IF cadaket1b
cBLANKS         lketisi2i          DO_CALC
ketisi2         lketisi2i          REPLACE

MAP(mupload9)
g_tgltrn        svitgl1         REPLACE_IF cuplok
cOK             svistr1         DO_CALC_IF cuplok


MAP(mupdsviftmandx9)
cIN             svistr1         DO_CALC_IF cksong2
g_tgltrn        svitgl1         REPLACE
gv_INPG         svists          REPLACE_IF cinpg

DBCALCS(dbftupl9)
        DCOMMAND UPDATE
        DTARGET sviprmidx sviprm
        DMAP mupdsviftmandx9

MAP(mapr10)
gv_OPEN         svists          REPLACE_IF cksong
cOKRM           svistr34        DO_CALC_IF crmok
ctKRM           svistr34        DO_CALC_IF crmT
gv_TACC         svists          REPLACE_IF crmT


MAP(mmapmap9a)
ldum            ldum              REPLACE
svinourt        lurt              REPLACE
ckuncidev1      lkunci2           DO_CALC

MAP(mkuncirm9)
gv_CLSD         abksts            REPLACE_IF cnipsama

MAP(mkuncirm29)
gv_CLSD         abksts            REPLACE


SPCALCS(saddket9)
DO_LIB                 ap_dbclc(DNAME dmapmap9a,DCOMMAND MAPMAP,DMAP mmapmap9a);
DO_LIB_IF cadaket0     ap_dbclc(DNAME dket9,DCOMMAND ADD,DFILE ket,DMAP maddket9);
DO_LIB_IF cadaket1     ap_dbclc(DNAME dupdsvi9,DCOMMAND UPDATE,DTARGET ketdatbukkod svidata svinobuk svitblkode,DMAP mupdsvi9);

SPCALCS(sdelket9)
DO_LIB_IF cadaket1     ap_dbclc(DNAME ddelket9,DCOMMAND DELETE,DTARGET ketdatbukkod svidata svinobuk svitblkode);                                 
SPCALCS(suploadd9)
DO_LIB                 ap_dbclc(DNAME dmapupl9,DCOMMAND MAPMAP,DMAP mmapmap9a);
DO_LIB_IF crm          ap_dbclc(DNAME ddevb9,DCOMMAND ADD,DFILE abk,DMAP madddevrm);
DO_LIB                 ap_dbclc(DNAME dupload9d,DCOMMAND UPDATE,DTARGET sviprmidx sviprm,DMAP mupload9);

SPCALCS(sbkkunci9)
DO_LIB                 ap_dbclc(DNAME dmapmaprm9,DCOMMAND MAPMAP,DMAP mmapmap1a);
DO_LIB_IF crmok2       ap_dbclc(DNAME dupdrmok9,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lkunci2 l643,DMAP mkuncirm9);
DO_LIB_IF crmT2        ap_dbclc(DNAME dupdrmT9,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lkunci2 l643,DMAP mkuncirm29);
DO_LIB_IF cdvh         ap_dbclc(DNAME ddevd9,DCOMMAND ADD,DFILE abk,DMAP madddevdvh);
DO_LIB_IF cram         ap_dbclc(DNAME ddevf9,DCOMMAND ADD,DFILE abk,DMAP madddevram);


HOOKS(tmptranst)
CLICKED         cur_field=lupld9         DO_SPCALCS suploadd9
AFTER_INPUT     cur_keybd=EN             DO_MAP SHOW mapr10
AFTER_INPUT     cur_keybd=EN             DO_SPCALCS sbkkunci9
AFTER_INPUT     cur_field=lketisii       DO_MAP SHOW mketcab
AFTER_INPUT     cur_field=lketisii       DO_MAP
                IF ccabisii mdum
                ELSE HKCURSOR STAY
                HKMSG harus 200 karabker
BEFORE_INPUT    cur_field=svistr33      DO_SKIP_IF copend
BEFORE_INPUT    cur_field=svistr7       DO_SKIP_IF copend
BEFORE_INPUT    cur_field=svidf1        DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=lketisii      DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=lketisi2i     DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=svistr1       DO_SKIP_IF cinpgd



SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_UPLFLD_DBCALCS dbftupl9
SFL_UPLFLD tlmnobuk     svitype
SFL_UPL_DIRFLD tlmtgl
SFL_UPL_DELCOND c0
SFL_SELECT   ckodedev
SFL_TARGET
        svidatbuktyp   tlmdata   tlmnobuk     
SFL_MAP
tlmnobuk        svinobuk        REPLACE
tlmuntuk        svidtmkode      REPLACE
tlmnoasal       svikode         REPLACE
tlmdata         svidata         REPLACE
tmpkode         svitype         REPLACE
tmpnourt        svinourt        REPLACE
tmpkode         svitblkode      REPLACE

POSTING(tmptrans)
        PST_ADDCMD saddket9
        PST_UPDCMD saddket9
        PST_DELCMD sdelket9

PERMIT(tmptrans)
  PMT_ADD_COND  cdjoindevslik
  PMT_UPDALL_COND  cdevopen
