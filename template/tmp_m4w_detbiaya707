IMAGE(tmptranst) 
/-------------------------t-----------t--------------------------\
|   i.Keterangan          | i.Persen  |  i.Nominal               |
\-------------------------.-----------.--------------------------/


IMAGE(tmptrans) 
|_________________________|________.__|_______________________.__|
    
FIELD(tmptrans)
nhdkode			PROTECT SCROLL		INPUTRI 1
nhdhrg2			PROTECT 		INPUTRI 3
nhdhrg1			NOCHANGE		INPUTRI 4


CALCS()
cbiayaada		nhmdebpok_3 > 0 || nhmbiamklr_3 > 0

SUBFILE(tmptrans)
SFL_TITLE(tmptranst)
SFL_LINES(10)        
SFL_COND cbiayaada

SFL_TARGET
	nhdbukidx   btmnobuk gv_biaya 



CALCS()
ckurangbi		nhmdebpok - nhdhrg1
ckurangbiltv		nhmtotpok - nhdhrg1
ckurangkomisi		nhmbiamklr - nhdhrg1

cltvada_bi2		nhmtotpok > 0
cpersenltv_bi2		(ltotalpokok / nhmhrgpasar) * 100
cbukanKomisi		nhdkode != "KOMISI"
cjikakomisi		nhdkode == "KOMISI"
cefektifperbl           nhmbgstd / 12


MAP(mupdnhm_delbi)
langsuran		nhmbsrang		REPLACE
ckurangbi		nhmdebpok		DO_CALC_IF cbukanKomisi
ckurangbiltv		nhmtotpok		DO_CALC_IF cbukanKomisi
cpersenltv_bi2		nhmperpok		DO_CALC_IF cltvada_bi2
ckurangkomisi		nhmbiamklr		DO_CALC_IF cjikakomisi
cefektifperbl		lbgefektifbl		DO_CALC


MAP(mmapbiayadel)
ckurangbiltv		ltotalpokok		DO_CALC_IF cbukanKomisi
nhmtenor		ltenor			REPLACE
nhmbsrang		lbesarang		REPLACE


SPCALCS(spdeltrans_biaya)
	DO_LIB		ap_dbclc(DNAME dmapdelbiaya,DCOMMAND MAPMAP,DMAP mmapbiayadel);
	DO_LIB 		ap_angbe(nhmbgstd,ltenor,ltotalpokok,lR,&langsuran);
	DO_LIB          ap_bgflt(lbgefektifbl,ltenor,&lbgflatbl,&ltotbgflat);
	DO_LIB		ap_dbclc(DNAME dupdnhmbiaya2,DCOMMAND UPDATE,DTARGET nhmprmidx nhmprm,DMAP mupdnhm_delbi);




POSTING(tmptrans)
   	PST_DELCMD  spdeltrans_biaya

