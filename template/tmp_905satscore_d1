IMAGE(tmptrans)

FIELD(tmptranst)
ltmpkode	PROTECT				INPUTRI 1
ltmpket		PROTECT				INPUTRI 2
ketisi		TEXTAREA ALLCAPS		INPUTRI 3
ketstr1		ALLCAPS				INPUTRI 4
ketisi2		PROTECT				INPUTRI 4
ldum		ALLCAPS				INPUTRI 5

DEFAULT(tmptranst)
ltmpkode	INIT		{tmpisistr2}
ltmpket		INIT		{tmpket}
ketstr1		DFALT_SCAN	A B C

EDITS(tmptranst)
e.Mandatory 	ketisi 	MANDATORY
e.Mandatory	ketstr1	MANDATORY

CALCS()
csatscore_d1	tlmsts2 == "SAT" && tmpkode == "BAGIAN_D1"
csat_d1a	ketstr1 == "C"
csat_d1b	ketstr1 == "B"
csat_d1c	ketstr1 == "A"
cd1_ket1	"PERLU PENDAMPINGAN INTENSIF"
cd1_ket2	"SUDAH BAIK TAPI BUTUH PENGUATAN MINOR"
cd1_ket3	"SANGAT BAIK DAN DAPAT DIJADIKAN ROLE MODEL"

HOOKS(tmptranst)
BEFORE_INPUT	cur_field=ketstr1	DO_MAP SHOW msat_d1
AFTER_INPUT	cur_field=ketstr1	DO_MAP SHOW msat_d1

MAP(msat_d1)
cd1_ket1	ketisi2	DO_CALC_IF csat_d1a
cd1_ket2	ketisi2	DO_CALC_IF csat_d1b
cd1_ket3	ketisi2	DO_CALC_IF csat_d1c

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_COND        csatscore_d1
SFL_UPLFLD tlmnobuk tmpkode
SFL_TARGET
	ketdatbukkod   ltestsop11 tlmnobuk tmpkode
SFL_MAP
tlmdata		ketdata		REPLACE
tlmnobuk	ketnobuk	REPLACE
tmpkode		ketkode		REPLACE
tlmsts2		kettype		REPLACE
