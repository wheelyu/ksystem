	|| g_grpnam=="RI" || g_grpnam=="IT" || g_grpnam=="IT2" ) && 
	tkdjwbstr1==BLANKS && tkdjwbstr2==BLANKS && tlmstsapr!="OK" && tlmstsapr!="IN" && tlmsts=="OPEN"

