IMAGE(tmptrans)

FIELD(tmptranst)
psdtgl1         PROTECT NOLIMIT {DD-MM-YY} INPUTRI 1
psdstr1         PROTECT                 INPUTRI 2
psdstr2         NOCHANGE                INPUTRI 3
psdket          ALLCAPS                 INPUTRI 4
psdket2         ALLCAPS SCROLL          INPUTRI 4
psdstr3         DIGITS                 INPUTRI 4
psdtype3        NOCHANGE                 INPUTRI 5
psdstr5         ALLCAPS SCROLL          INPUTRI 6

DEFAULTS(tmptranst)
psdtgl1         INIT_ADD                {g_tgltrn}
psdstr1         INIT_ADD                {g_usrkode}
psdstr2         DFALT_SCAN_BLANKS       PIC
                                        JABATAN
                                        TLP_PIC
psdtype3        DFALT_SCAN_BLANKS       ACC TACC

CALCS()
cpic            psdstr2=="PIC"
cjabp           psdstr2=="JABATAN"
ctlppic         psdstr2=="TLP_PIC"
cbknpic         psdstr2!="PIC"
cbknjabp        psdstr2!="JABATAN"
cbkntlppic      psdstr2!="TLP_PIC"

EDITS(tmptranst)
t.Mandatory  psdtgl1   MANDATORY
t.Mandatory  psdstr1   MANDATORY
t.Mandatory  psdstr2   MANDATORY
t.Mandatory  psdket    MANDATORY_IF cpic
t.Mandatory  psdket2   MANDATORY_IF cjabp
t.Mandatory  psdstr3   MANDATORY_IF ctlppic
t.Mandatory  psdtype3   MANDATORY
t.Mandatory  psdstr5   MANDATORY

MAP(mpic)
psdket                  psdkode         REPLACE_IF cpic
psdket2                 psdkode         REPLACE_IF cjabp
psdstr3                 psdkode         REPLACE_IF ctlppic

HOOKS(tmptranst)
AFTER_INPUT     cur_field=psdtype3      DO_MAP SHOW     mpic
BEFORE_INPUT    cur_field=psdket       DO_SKIP_IF cbknpic
BEFORE_INPUT    cur_field=psdket2      DO_SKIP_IF cbknjabp
BEFORE_INPUT    cur_field=psdstr3      DO_SKIP_IF cbkntlppic

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_TARGET
        psddatpsmkod lUBHPIC127 hrmnobuk

SFL_MAP
lUBHPIC127              psddata         REPLACE
hrmnobuk                psdpsmkode      REPLACE
