IMAGE(tmptrans)

FIELD(tmptranst)
psdnourt		PROTECT			INPUTRI 1
psdket			PROTECT			INPUTRI 2
psdtgl1  		PROTECT {DD-MM-YY}	INPUTRI 3
psdstr1			PROTECT			INPUTRI	4
psdstr2			PROTECT			INPUTRI 5
psdtype			PROTECT			INPUTRI	6
psdtype2		PROTECT			INPUTRI 7
luploadtacc		TOMBOL			INPUTRI 8
luploadacc		TOMBOL			INPUTRI 9
psdket2  		ALLCAPS SCROLL		INPUTRI 10 

DEFAULTS(tmptranst)
luploadtacc	INIT		TACC
luploadacc	INIT		ACC
l_count3	INIT		1

CALCS()
cadafoto4x	(UPLEXIST(l_count3) == 1  || UPLEXIST(l_count3) == 0) && djoinpsi_user==1 && (
		(hrmdvs2=="ACC_FOTO" && (g_grpnam=="HRDER" || g_usrkode=="1733536" || g_grpnam=="B.IVAROHRD" || g_grpnam=="HRDSPV"|| g_grpnam=="B.PARTHRD" || ljabuserz=="VNT_DIVHEAD")) || (hrmdvs2=="ACC_DIR" && g_grpnam=="CMBNHEAD"))
cbkn_accfotop	psdtype!="TACC"
caccblanksp	psdtype==BLANKS

MAP(mupdpsdsdm31)
cOK		psdtype		DO_CALC
g_usrkode	psdstr1		REPLACE
g_tgltrn	psdtgl1		REPLACE
cBLANKS		psdtype2	DO_CALC

DBCALCS(dupdpsdsdm31)
DBC_COMMAND	UPDATE
DBC_TARGET	psdprmidx	psdprm
DBC_MAP		mupdpsdsdm31

MAP(mupdpsdsdm2p)
gv_TACC		psdtype2 	REPLACE
cBLANKS		psdtype		DO_CALC
g_usrkode	psdstr2		REPLACE
g_tgltrn	psdtgl1		REPLACE

MAP(mupdpsdsdm3p)
cacc1		psdtype2 	DO_CALC
cacc1		psdtype		DO_CALC
g_usrkode	psdstr2		REPLACE
g_tgltrn	psdtgl1		REPLACE

SPCALCS(supdpsd2part)
	DO_LIB_IF cadafoto4x ap_dbclc(DNAME dupdpsd2part,DCOMMAND UPDATE,DTARGET psdprmidx psdprm,DMAP mupdpsdsdm2p);

SPCALCS(supdpsd3part)
	DO_LIB_IF cadafoto4x ap_dbclc(DNAME dupdpsd3part,DCOMMAND UPDATE,DTARGET psdprmidx psdprm,DMAP mupdpsdsdm3p);

HOOKS(tmptranst)
CLICKED		cur_field=luploadtacc	DO_SPCALCS supdpsd2part
CLICKED		cur_field=luploadacc	DO_SPCALCS supdpsd3part
BEFORE_INPUT    cur_field=psdket        DO_SKIP_IF cbkn_accfotop

