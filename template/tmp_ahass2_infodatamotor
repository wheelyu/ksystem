cmotornotnull	astbrg != BLANKS && g_grpnam != "RI" && g_grpnam != "IT" && g_grpnam != "ANSYSUAT" && g_grpnam != "AHASSHEAD" && g_grpnam!="AHASSSPV"  && g_grpnam != "SPVAREA" && g_grpnam != "CRHMCSPV" && g_grpnam != "HMCSPV" && g_grpnam !="BUM" && g_grpnam!="BUMM2W" && g_grpnam!="ARDVH" && g_grpnam !="BMM" && g_grpnam !="BMMM2W" && g_grpnam != "KAWIL"
cmesinnotnull	astmesin != BLANKS && g_grpnam != "RI" && g_grpnam != "IT" && g_grpnam != "ANSYSUAT" && g_grpnam != "AHASSHEAD" && g_grpnam!="AHASSSPV"  && g_grpnam != "SPVAREA" && g_grpnam != "CRHMCSPV" && g_grpnam != "HMCSPV" && g_grpnam !="BUM" && g_grpnam!="BUMM2W" && g_grpnam!="ARDVH" && g_grpnam !="BMM" && g_grpnam !="BMMM2W" && g_grpnam != "KAWIL"
crangkanotnull	astrangka != BLANKS && g_grpnam != "RI" && g_grpnam != "IT" && g_grpnam != "ANSYSUAT" && g_grpnam != "AHASSHEAD" && g_grpnam!="AHASSSPV"  && g_grpnam != "SPVAREA" && g_grpnam != "CRHMCSPV" && g_grpnam != "HMCSPV" && g_grpnam !="BUM" && g_grpnam!="BUMM2W" && g_grpnam!="ARDVH" && g_grpnam !="BMM" && g_grpnam !="BMMM2W" && g_grpnam != "KAWIL"
cthnnotnull	astth != BLANKS && g_grpnam != "RI" && g_grpnam != "IT" && g_grpnam != "ANSYSUAT" && g_grpnam != "AHASSHEAD" && g_grpnam!="AHASSSPV"  && g_grpnam != "SPVAREA" && g_grpnam != "CRHMCSPV" && g_grpnam != "HMCSPV" && g_grpnam !="BUM" && g_grpnam!="BUMM2W" && g_grpnam!="ARDVH" && g_grpnam !="BMM" && g_grpnam !="BMMM2W" && g_grpnam != "KAWIL"

