		ELSE HKCURSOR STAY
		HKMSG t.NopolBeda

AFTER_INPUT	cur_keybd=EN		DO_MAP SHOW
		IF cnopolbeda	mdum1
		ELSE HKCURSOR STAY
		HKMSG t.NopolBeda

