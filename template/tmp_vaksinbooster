tldtydis	DFALT_SCAN		BLANKS
					ACC "ACC"
					TACC "TACC"
					FRAU "FRAU"

DBCALCS(djoinvaksin2)
	DBC_COMMAND	JOIN
	DBC_TARGET	tldbukbrglok		hrmnobuk    lvsn2  

CALCS()
cdet4OPEN		tldsts =="OPEN"
csdhv2			djoinvaksin2 ==1
cBLMCEK4		"BLMCEK_HRD"

MAP(mupdhrm_u4)
cBLMCEK4         hrmket2                 DO_CALC

MAP(mupdtld_u4)
cY              tldsisbrg       DO_CALC

SPCALCS(supdupl4)
        DO_LIB   ap_dbclc(DNAME dupdhrm_u4,DCOMMAND UPDATE,DTARGET hrmprmidx hrmprm,DMAP mupdhrm_u4);
        DO_LIB   ap_dbclc(DNAME dupdtlg_u4,DCOMMAND UPDATE,DTARGET tldprmidx tldprm,DMAP mupdtld_u4);


HOOKS(tmptranst)
/* BEFORE_INPUT      cur_field=tldtglfak      DO_SKIP_IF cdet2INPG */
BEFORE_INPUT      cur_field=tldtydis       DO_SKIP_IF cdet4OPEN
BEFORE_INPUT      cur_field=tldket         DO_SKIP_IF cdet4OPEN
AFTER_INPUT      cur_field=tldtydis       DO_MAP SHOW mnipacc
AFTER_INPUT     cur_field=tldtglfak     DO_MAP SHOW
                IF csdhv2   mdum
                ELSE HKCURSOR STAY
                HKMSG t.BlmVaksin2

AFTER_INPUT     cur_field=tldtglfak     DO_MAP SHOW
                IF csdhtacc2  mdum
                ELSE HKCURSOR STAY
                HKMSG t.SdhLbh2xTACCHubAtasan


CLICKED      cur_field=lupload_ok2   DO_SPCALCS supdupl4

CALCS()
ccondsdhboost		tmpkode =="BOOSTER"


SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
