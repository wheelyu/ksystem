IMAGE(tmptranst)
/---------------------t--------------------t-------------------t--------------------t---------------------.-------\
|t.Usia               |t.ProbActHr         |t.Identify         |t.Corection         |t.Action             |t.Enter|
\---------------------.--------------------.-------------------.--------------------.---------------------.-------/

IMAGE(tmptrans)
|_____________________|____________________|___________________|____________________|_____________________|_______|

FIELDS(tmptrans)
        kettype         PROTECT                         INPUTRI         1
        ketstr1         TEXTAREA                        INPUTRI         2
        ketstr2         TEXTAREA			INPUTRI         3
        ketstr3         TEXTAREA	PROTECT		INPUTRI         4
        ketstr4         TEXTAREA	PROTECT         INPUTRI         5
	lenter		NOCHANGE			INPUTRI		6

DEFAULTS(tmptrans)
lenter          INIT            ENTER

EDITS(tmptrans)
e.Mandatory     ketstr1         MANDATORY
e.Mandatory     ketstr2         MANDATORY

CALCS()
cjikabm		tlmplg==g_usrkode
chrsisi1	ketstr1!=BLANKS
chrsisi2	ketstr2!=BLANKS

HOOKS(tmptrans)
BEFORE_INPUT    cur_field=ketstr3       DO_SKIP_IF cjikabm
BEFORE_INPUT    cur_field=ketstr4       DO_SKIP_IF cjikabm

AFTER_INPUT     cur_field=ketstr1 DO_MAP SHOW
                IF chrsisi1 mdum3
                ELSE HKCURSOR STAY
                     HKMSG t.MandatoryKet

AFTER_INPUT     cur_field=ketstr2 DO_MAP SHOW
                IF chrsisi2 mdum3
                ELSE HKCURSOR STAY
                     HKMSG t.MandatoryKet

CALCS()
ctypeketpiut	kettype=="USIAZ1" || kettype=="USIAZ1R" || kettype=="USIAZ2" || kettype=="USIAZ4" || kettype=="USIAZ6" || kettype=="RESURVEY"

SUBFILE(tmptrans)
SFL_LINES(6)
SFL_TITLE(tmptranst)
SFL_SELECT ctypeketpiut
SFL_TARGET
        ketdatbukkod   tlmdata tlmnobuk


