MAP(mdum_tmp)
DEBUG	ldumstr	ldumstr		REPLACE

HOOKS(tmptranst)
BEFORE_INPUT	cur_field=almlat     DO_SKIP_IF cPemilik
BEFORE_INPUT    cur_field=almnama2   DO_SKIP_IF cPemilik
BEFORE_INPUT    cur_field=almjalan   DO_SKIP_IF cPemilik
BEFORE_INPUT    cur_field=almprop    DO_SKIP_IF cPemilik
BEFORE_INPUT    cur_field=almkota    DO_SKIP_IF cPemilik
BEFORE_INPUT    cur_field=almkec     DO_SKIP_IF cPemilik
BEFORE_INPUT    cur_field=almkel     DO_SKIP_IF cPemilik
AFTER_INPUT	cur_field=almutama   DO_MAP SHOW malamat
AFTER_INPUT	cur_field=almutama   DO_MAP SHOW mbarcode
AFTER_INPUT	cur_field=almlat     DO_MAP SHOW malamat
AFTER_INPUT	cur_field=almlat     DO_MAP SHOW mtinggal

AFTER_INPUT     cur_field=almbukoto   DO_LIB ap_amstr(almbukoto,ln1i,ln1,&ldigit1);
AFTER_INPUT     cur_field=almbukoto   DO_LIB ap_amstr(almbukoto,ln2i,ln1,&ldigit2);
AFTER_INPUT     cur_field=almbukoto   DO_MAP SHOW mpanjangnom_tmp


AFTER_INPUT	cur_field=almbukoto DO_MAP SHOW
                IF cbukan08 mdum_tmp
                ELSE HKCURSOR STAY
                HKMSG Nomor Telepon 2 Digit Didepan Harus 08 Dan Harus Lebih Dari 10 Dan Kurang Dari 14


SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_TARGET
almdatbukidx    lINFOPEMBW btmnobuk

SFL_MAP
lINFOPEMBW      almdata         REPLACE
btmnobuk        almnobuk        REPLACE

MAP(mdtmProp1)
dtmkode         almprop         REPLACE
dtmket          almnamprop      REPLACE
cSamaTgl	lKetTinggal	DO_CALC_IF cTinggal1
cTdkSamaTgl	lKetTinggal	DO_CALC_IF cTinggal2

MAP(mtblKota1)
tblkode         almkota         REPLACE
tblket          almnamkota      REPLACE

MAP(mtbdKec1)
tbdkode         almkec          REPLACE
tbdket          almnamkec       REPLACE

MAP(mtbtKel1)
tbtkode         almkel          REPLACE
tbtket          almnamkel       REPLACE

MAP(mupdbtmPem)
almutama	btmstsbrg	REPLACE
almnama2	btmbisnisjl	REPLACE

MAP(mdelbtmPem)
cBLANKS		btmstsbrg	DO_CALC
cBLANKS		btmbisnisjl	DO_CALC

SPCALCS(spaddtmptrans)
DO_LIB ap_dbclc(DNAME daddbtm,DCOMMAND UPDATE,DTARGET btmbukidx almnobuk,DMAP mupdbtmPem);

SPCALCS(spupdtmptrans)
DO_LIB ap_dbclc(DNAME dupdbtm,DCOMMAND UPDATE,DTARGET btmbukidx almnobuk,DMAP mupdbtmPem);

SPCALCS(spdeltmptrans)
DO_LIB ap_dbclc(DNAME ddelbtm,DCOMMAND UPDATE,DTARGET btmbukidx almnobuk,DMAP mdelbtmPem);

POSTING(tmptrans)
PST_ADDCMD      spaddtmptrans
PST_UPDCMD      spupdtmptrans
PST_DELCMD      spdeltmptrans
