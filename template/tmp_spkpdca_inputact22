IMAGE(tmptrans)

FIELDS(tmptranst)
spknobuk                PROTECT                         INPUTRI 1               /*Nobuk*/
spktgl                  PROTECT                         INPUTRI 2               /*Tanggal Input*/
spktgg                  PROTECT                         INPUTRI 3               /*Activity*/
lketacttmp              PROTECT                         INPUTRI 4               /*Ket Activity*/
spknoasal               PROTECT                         INPUTRI 5               /*VarKpi*/
spktgg2                 PROTECT                         INPUTRI 6               /*NIP PDCA*/
lpdcatmp                PROTECT                         INPUTRI 7               /*Nama PDCA*/
spktgg3                 PROTECT                         INPUTRI 8               /*NIP PIC*/
lpictmp                 PROTECT                         INPUTRI 9               /*Nama PIC*/
spktgg4                 PROTECT                         INPUTRI 10              /*NIP Head*/
lheadpdcatmp            PROTECT                         INPUTRI 11              /*Nama Head*/
spkkat                  NOCHANGE                        INPUTRI 12               /*Sesuai? YA-TIDAK*/
spkket                  TEXTAREA                        INPUTRI 13              /*Keterangan*/
spktglft                NOLIMIT {DD-MM-YYYY}            INPUTRI 14              /*Tanggal Meeting*/
spktglft2               NOLIMIT {DD-MM-YYYY}            INPUTRI 15              /*Tanggal Koordinasi*/
spkjrk2                 PROTECT                         INPUTRI 16              /*Leadtime*/
spkhasil                PROTECT                         INPUTRI 17              /*Penilaian Hasil*/
lenter                  NOCHANGE                        INPUTRI 18              /*Enter*/
spkhasil2               NOCHANGE                        INPUTRI 19              /*Approval Head PDCA*/

CALCS()
cleadtime22             DO_LIB ap_slshr(&lDD,g_tgltrn,spktglft,lplus,lminus,&lslsbulan,&lslshari);

DEFAULT(tmptranst)
spktgl                  INIT_ADD                        {g_tgltrn}

spkkat                  DFALT_SCAN_BLANKS               YA
                                                        TIDAK

spkhasil2               DFALT_SCAN_BLANKS               ACC
                                                        TACC                    

EDITS(tmptranst)
e.Mandatory                     spkket          MANDATORY

e.Validate Activity             spktgg          VALIDATE tbddatkodidx mactivitytmp22 {Pgv_dttabel} {PlSPKPDCA21} {PlACTIVITY}
e.Validate PDCA                 spktgg2         VALIDATE psikodidx    mpsipdcatmp22  0
e.Validate PIC                  spktgg3         VALIDATE psikodidx    mpsipictmp22   0
e.Validate HEAD PDCA            spktgg4         VALIDATE psikodidx    mpsiheadtmp22  0


MAP(mactivitytmp22)
tbdkode                 spktgg          REPLACE
tbdket                  lketacttmp      REPLACE
tbtkettype              spknoasal       REPLACE

MAP(mpsipdcatmp22)
psikode                 spktgg2         REPLACE
psinama                 lpdcatmp        REPLACE
c0                      spkhasil        DO_CALC_IF cpoint0
c1                      spkhasil        DO_CALC_IF cpoint1
c2                      spkhasil        DO_CALC_IF cpoint2
c3                      spkhasil        DO_CALC_IF cpoint3
c4                      spkhasil        DO_CALC_IF cpoint4
c5                      spkhasil        DO_CALC_IF cpoint5

MAP(mpsipictmp22)
psikode                 spktgg3         REPLACE
psinama                 lpictmp         REPLACE

MAP(mpsiheadtmp22)
psikode                 spktgg4         REPLACE
psinama                 lheadpdcatmp    REPLACE


MAP(mdataact22)
lSPKPDCA                spkdata         REPLACE
lINPACT22	        spktype         REPLACE
tlmnobuk                spknobuk        REPLACE
tlmnobbm                spktgg          REPLACE
tlmuntuk                spktgg2         REPLACE
tlmplg                  spktgg3         REPLACE
tlmbisnis               spktgg4         REPLACE

MAP(mmapkodefoto22)
ckode3                  lspkkode        DO_CALC
lspkkode3               spkkode3        REPLACE

MAP(mleadtime22)
cleadtime22             lslshari        DO_CALC
lslshari                spkjrk2         REPLACE

HOOKS(tmptranst)
BEFORE_INPUT            cur_field=spkkat                DO_MAP SHOW mdataact22
AFTER_INPUT             cur_field=spkkat                DO_MAP SHOW mmapkodefoto22
AFTER_INPUT             cur_field=spktglft2             DO_MAP SHOW mleadtime22

BEFORE_INPUT            cur_field=spkkat                DO_SKIP_IF clogusrinput
BEFORE_INPUT            cur_field=spkket                DO_SKIP_IF clogusrinput
BEFORE_INPUT            cur_field=spktglft              DO_SKIP_IF clogusrinput
BEFORE_INPUT            cur_field=spktglft2             DO_SKIP_IF clogusrinput
BEFORE_INPUT            cur_field=lenter                DO_SKIP_IF clogusrinput

BEFORE_INPUT            cur_field=spkhasil2             DO_SKIP_IF cloghead

MAP(mupdact22b)
cY                      spkfoto3         DO_CALC
DBCALCS(dupdact22b)
        DBC_COMMAND     UPDATE
        DBC_TARGET      spkprmidx spkprm
        DBC_MAP         mupdact22b

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
