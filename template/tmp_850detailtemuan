			|| g_grpnam == "AUDITHEAD"
                	|| g_grpnam == "AUDDVH" || g_grpnam == "IT" || g_grpnam == "RI" || g_grpnam == "RAS") && (tlmsts == "OPEN" ||
 			tlmsts == "INPG"))
                	/*&& g_usrkode == tlmkode */ && tlmplg != BLANKS && (tlmpst == "AUDJR" || tlmpst == "FINJR")
/*cdet1           	(((tlmsts == "OPEN" && svitype2 == BLANKS &&  (g_grpnam == "AUDIT" || g_grpnam == "IT" || g_grpnam == "RI" 
			|| g_grpnam == "RAS")) ||
                	(tlmsts == "INPG" && (((tlmytppn == BLANKS || tlmytppn == "T") && g_grpnam == "AUDIT") || (g_grpnam == "AUDITHEAD" ||
	 		g_grpnam == "AUDDVH" || g_grpnam == "AUDITSPV" ||g_grpnam == "AUDITTL" || g_grpnam == "DESK" || g_grpnam == "DOC" || 
			g_grpnam == "RI" || g_grpnam == "IT" || g_grpnam == "RAS")))) || g_usrkode != tlmkode) && tlmpst == "AUDJR"*/
cdet1 
  (
    (tlmsts == "OPEN" && (tlmpst == "AUDJR" || tlmpst == "FINJR") && svitype2 == BLANKS && (g_grpnam == "AUDIT" || g_grpnam == "AUDITSPV" || g_grpnam == "AUDITTL" ||
	g_grpnam == "DOC" || g_grpnam == "DESK"))
    ||
    (tlmsts == "INPG" && (g_grpnam == "AUDITSPV" || g_grpnam == "AUDITTL" || g_grpnam == "RI" || g_grpnam == "IT" || g_grpnam == "RAS" || 
	g_grpnam == "DOC" || g_grpnam == "DESK"))
  )




