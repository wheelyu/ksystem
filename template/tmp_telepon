IMAGE(tmptrans)

FIELD(tmptranst)
tbtkolek            NOCHANGE		    	INPUTRI 1   /*IdPembayaran*/
tbtkode             ALLCAPS                 	INPUTRI 2   /*IdTelepon*/
tbtket              ALLCAPS SCROLL          	INPUTRI 3   /*Nama Pelanggan*/
tbtkat              ALLCAPS                 	INPUTRI 4   /*JenisPaket*/
tbtkode2            NOCHANGE                	INPUTRI 5   /*Tipe Bayar*/
tbttot              NUMERIC                 	INPUTRI 6   /*Harga*/
tbtdf1              PROTECT                     INPUTRI 7   /*Longitude*/
tbtdf2              PROTECT                     INPUTRI 8   /*Latitude*/
tbttglcrt           NONE {DD-MM-YYY} NOLIMIT    INPUTRI 9   /*Tgl Byr AKhir*/
tbttblket           PROTECT                     INPUTRI 10  /*uploadok*/
luploktel           TOMBOL                      INPUTRI 11  /*uploadfoto*/
lGMAPS4             TOMBOL                      INPUTRI 12  /*gmaps*/
tbtyt               NOCHANGE                    INPUTRI 13  /*Acc GA*/
tbtusrcrt           PROTECT                     INPUTRI 14  /*Nip Acc/Tacc*/
lnamasdmtel         PROTECT                     INPUTRI 15  /*Nama SDM*/
tbttbdket           ALLCAPS SCROLL              INPUTRI 16  /*Keterangan TACC*/

DEFAULT(tmptranst)
tbtkolek            DFALT_SCAN_BLANKS        CABANG
                                             SEMARANG
tbtkode2    	    DFALT_SCAN_BLANK	     INTERNET
					     TELEPON
					     INTERNET_DAN_TELEPON
tbtyt               DFALT_SCAN_BLANKS        Y " "
                                             T " "
tbtcab              INIT                     "1"
luploktel           INIT                     "UPLOAD OK"
lGMAPS4             INIT                     "GMAPS"


CALCS()
cbyrcab2            tbtkolek=="CABANG"
cbyrsmg2            tbtkolek=="SEMARANG"
ctacctel            tbtyt == "T"
cacctel		    tbtyt == "Y" || tbtcab == "1"
ctambahtel	    tbtcab == "1"
cupltel		    tbtcab == BLANKS
cadakoordinat4      tbtdf1 != 0 && tbtdf2 != 0

EDITS(tmptranst)
e.Mandatory     	tbtkolek 	MANDATORY
e.Mandatory     	tbtkode  	MANDATORY
e.Mandatory     	tbtket   	MANDATORY
e.Mandatory     	tbtkode2 	MANDATORY
e.Mandatory     	tbtkat   	MANDATORY_IF cbyrcab2 
e.Mandatory     	tbttot   	MANDATORY_IF cbyrcab2
e.MandatoryKetTacctel   tbttbdket 	MANDATORY_IF ctacctel
e.Validate      	tbtusrcrt  	VALIDATE psikodidx mpsinamasdmtel 0

MAP(mpsinamasdmtel)
psinama         lnamasdmtel        REPLACE

MAP(macctel)
g_usrkode       tbtusrcrt         REPLACE
psinama         lnamasdmtel       REPLACE

MAP(mupdfototel)
cOK             tbttblket    DO_CALC

SPCALCS(spgmaps4)
DO_LIB_IF cadakoordinat4 ap_shmap(tbtdf2,tbtdf1);

HOOKS(tmptranst)
BEFORE_INPUT     cur_field=tbtkat        DO_SKIP_IF cbyrsmg2
BEFORE_INPUT     cur_field=tbttot        DO_SKIP_IF cbyrsmg2
BEFORE_INPUT     cur_field=tbtkolek      DO_SKIP_IF cupltel
BEFORE_INPUT     cur_field=tbtkode       DO_SKIP_IF cupltel
BEFORE_INPUT     cur_field=tbtket        DO_SKIP_IF cupltel
BEFORE_INPUT     cur_field=tbtkat        DO_SKIP_IF cupltel
BEFORE_INPUT     cur_field=tbtkode2      DO_SKIP_IF cupltel
BEFORE_INPUT     cur_field=tbttot        DO_SKIP_IF cupltel
BEFORE_INPUT     cur_field=tbttglcrt     DO_SKIP_IF cupltel
BEFORE_INPUT     cur_field=tbttbdket     DO_SKIP_IF cacctel
BEFORE_INPUT     cur_field=tbtyt         DO_SKIP_IF ctambahtel

AFTER_INPUT      cur_field=tbtyt         DO_MAP SHOW macctel

CLICKED         cur_field=luploktel      DO_SPCALCS spupdfototel
CLICKED         cur_field=lGMAPS4        DO_SPCALCS spgmaps4


MAP(mupdtbtfototel)
g_fotolon1      tbtdf1          REPLACE
g_fotolat1      tbtdf2          REPLACE
cblanks         tbtcab          DO_CALC

DBCALCS(dupdtbtfototel)
        DCOMMAND UPDATE
        DTARGET tbtprmidx tbtprm
        DMAP mupdtbtfototel

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_UPLFLD tbttbdkode tbtkode
SFL_UPLFLD_DBCALCS dupdtbtfototel
SFL_UPL_DIRFLD tbdtgl1
SFL_TARGET
        tbtdattypkod tbddata tmpkode tbddtmkode tbdtblkode tbdkode
SFL_MAP
        tbddata         tbtdata         REPLACE
        tmpkode         tbttype         REPLACE
        tbddtmkode      tbtdtmkode      REPLACE
        tbdtblkode      tbttblkode      REPLACE
        tbdkode         tbttbdkode      REPLACE

