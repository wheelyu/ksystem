SPCALCS(spupdfototel)
        DO_LIB_IF cgpsoklis        ap_dbclc(DNAME dupdfototel,DCOMMAND UPDATE, DTARGET tbtotoidx tbtoto,DMAP mupdfototel);
        DO_LIB_IF cgpsoklis        ap_dbclc(DNAME dupdabktel,DCOMMAND UPDATE_RANGE,DTARGET abkdatbukidx lkunciabsen tbdkode,DMAP mupdabk,DBC_COND cselabktlp);
