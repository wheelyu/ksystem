        DBC_TARGET      abkdatbukidx lkunciabsen lnobuktlp*/

CALCS()
/*cselabktelga       abkkym2 == "APROV FOTO TELEPON1D"*/
cselabktlp	   abkkym2 == "UPL REK TELEPON 3231"

CALCS()
cnobuktlp       STRIP(tbdkode) + "3231TELEPON"
/*cjoinabktlp1  djoinabktlp == 1*/
cyatel          tbtyt == "Y"
/*ctdktel       tbtyt == "T"*/
cabkoktel       tbdkode == abknobuk


MAP(mapmaptlp)
cnobuktlp   	lnobuktlp   	DO_CALC

