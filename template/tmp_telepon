DO_LIB_IF cyatel                ap_dbclc(DNAME dupdabktlp5, DCOMMAND UPDATE_RANGE, DTARGET abkdatbukidx lkunciabsen tbdkode, DMAP mupdabktlp,DBC_COND cselabktlp);
