SFL_UPL_DIRFLD2	tlmtgl
SFL_UPLFLD tldplg tldoto 
SFL_UPLFLD2 tldoto  
SFL_UPLFLD_DBCALCS dupdfotosdm
/*SFL_UPL_CAMERAONLY*/
SFL_SORT_BY_FIELD tldgrup2
SFL_TARGET
	tldbukbbmidx 	tlmnobuk  lsensus

SFL_MAP
tlmnobuk        tldnobuk
lsensus		tldnobbm

PERMIT(tmptrans)
PMT_DEL_COND    c0
PMT_UPDALL_COND cOPEN
PMT_ADD_COND    c0


