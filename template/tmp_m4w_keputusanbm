DBC_TARGET	abkdatbukidx lkunciabsen tlmnobuk
DBC_SELECT	creminder1

DBCALCS(djoinabkdvh)
DBC_COMMAND	JOIN
DBC_TARGET	abkdatbukidx lkunciabsen tlmnobuk
DBC_SELECT      creminder2

DBCALCS(djoinabkmoubm)
DBC_COMMAND     JOIN
DBC_TARGET      abkdatbukidx lkunciabsen tlmnobuk
DBC_SELECT      cmoubm

