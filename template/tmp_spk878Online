LOCAL
PGM_FIELDS
ltkdjwbstr1tmp	STRING	61
lenter_ol	STRING	21

IMAGE(tmptranst)
/-------------------------------------\
|/-----------------------------------\|
|| t.NoBuk   : ______________        ||
|| t.Tanggal : ______________	     ||
|| t.Telp    : ______________	     ||
|| t.Nama    : ______________	     ||
|| t.Hasil   : ___  		     ||
||	       _____________________ ||
||               	       _____ ||
