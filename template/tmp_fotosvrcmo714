LOCAL
PGM_FIELDS
lsesuaiT	     STRING		21
ljarakfoto		     DFLOAT		21

lket			STRING		21			
lcekrmh			STRING		21
lcektg1			STRING		21
lcektg2			STRING		21
lcekkerja		STRING		21


IMAGE(tmptranst) {NO_CLS} {LSTFLD_ADVANCE} {FRSFLD_BACKUP} {BASE_ROW=7}
