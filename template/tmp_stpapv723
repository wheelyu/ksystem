CALCS()
chanyamnt       (djoinpikmnt==1 && lpiktglfak>=ltglfid30b && lpiktglfak<=ltglfid30c && lpiktgljtp!=0 && lpiklama>0 && (lpikdvs=="HMC" || lpikdvs=="H1" || lpikdvs=="M2W") && ( lpiksts=="TRK1"  || (lpiksts=="INPG" && tkmtgl-lpiktgljtp>30 && (100-((lpikke/lpiklama)*100)) > 0)) && lpikstspiubli!="ZASS" && lpikstspiubli!="ZDEN" && lpikstspiubli!="ZFIN") 

