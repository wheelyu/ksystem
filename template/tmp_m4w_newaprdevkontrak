MAP(mmapmap13)
ldum            ldum              REPLACE
svinourt        lurut             REPLACE
cnobukabk       lkunci            DO_CALC


SPCALCS(supdabk13)
DO_LIB                 ap_dbclc(DNAME dmapmap13,DCOMMAND MAPMAP,DMAP mmapmap13);
DO_LIB                 ap_dbclc(DNAME dakt13,DCOMMAND ADD,DFILE akt,DMAP maddakt);
