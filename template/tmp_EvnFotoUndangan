SPCALCS(sptmptrans)
        DO_LIB  ap_dbclc(DNAME dmapmapacara2, DCOMMAND MAPMAP, DMAP mmapmapacara2);
        DO_LIB_IF caprmso2  ap_dbclc(DNAME dupdabkmso2, DCOMMAND UPDATE_RANGE, DTARGET abkdatbukidx lKUNCIABSEN lnobukmso,DMAP mupdabk);
                                                                            
SPCALCS(supdtkd6)
        DO_LIB  ap_dbclc(DNAME dmapmapacara2x, DCOMMAND MAPMAP, DMAP mmapmapacara2);
        DO_LIB  ap_dbclc(DNAME dupdtkd6, DCOMMAND UPDATE, DTARGET tkdotoidx tkdoto, DMAP mupdtkd6);
        DO_LIB  ap_dbclc(DNAME dupdtlm6, DCOMMAND UPDATE, DTARGET tlmbukidx tkdnobuk, DMAP mupdtlm6);
        DO_LIB_IF cm2wbtlxabk ap_dbclc(DNAME daddabkmso2, DCOMMAND ADD, DFILE abk, DMAP maddabkmso2);

HOOKS(tmptranst)
BEFORE_INPUT    cur_field=tkdrek     DO_SKIP_IF cacc
CLICKED         cur_field=luploadok6    DO_SPCALCS supdtkd6

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
