IMAGE(tmptrans)

FIELD(tmptranst)
tldplg		PROTECT		INPUTRI	1
lnama1		PROTECT		INPUTRI	2
tldkat		NOCHANGE	INPUTRI	3
tldnoll		NOCHANGE	INPUTRI	4
tldsat		NOCHANGE	INPUTRI	5
tldket		ALLCAPS		INPUTRI	6

DEFAULTS(tmptranst)
tldplg		INIT_ADD	{g_usrkode}
lreviewsop	INIT		REVIEWSOP
lmastersop	INIT		MASTERSOP
tldkat		DFALT_SCAN	BLANKS
				REVISI
				TIDAK_BERLAKU
				TIDAK_REVISI
				PENGAJUAN_BARU

tldsat		DFALT_SCAN	BLANKS
				LENGKAP
				TIDAK_LENGKAP

CALCS()
cRVS		tldkat == "REVISI"
cblm1		(tldsat == "LENGKAP" && (dscantldview != 0 || dscantldview == 0) && ltdklengkap == 0) ||
		(tldsat == "TIDAK_LENGKAP" && (dscantldview != 0 || dscantldview == 0) && ltdklengkap >= 1)

EDITS(tmptranst)
e.Mandatory	tldkat		MANDATORY
e.Mandatory	tldsat		MANDATORY
e.Mandatory	tldket		MANDATORY
e.Validate	tldnoll		VALIDATE_BUF3_IF cRVS tlmdatstsbuk mtlm stlm {Plmastersop} {Pgv_INPG}

MAP(mtlm)
#tlmnobuk	tldnoll		REPLACE

MAP(mdum)
ldum		ldum		REPLACE

CALCS()
crevisi		tldkat!="REVISI"

HOOKS(tmptranst)
BEFORE_INPUT 	cur_field=tldnoll	DO_SKIP_IF crevisi
AFTER_INPUT	cur_field=tldsat	DO_MAP SHOW 
		IF cblm1 mdum
		ELSE HKCURSOR STAY
		HKMSG t.KelBerkasSesuaiDetBerkas

SUBFILE(tmptrans)
SFL_TITLE(tmptranst)
SFL_LINES(1)
