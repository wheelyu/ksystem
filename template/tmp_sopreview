tldplg		tlmdari		REPLACE
g_tgltrn	tlmtgljtp	REPLACE
tldnoll		tlmgrup		REPLACE

SPCALCS(supdd)
	DO_LIB ap_dbclc(DNAME dupdanalist,DCOMMAND UPDATE,DTARGET tlmbukidx tlmnobuk,DMAP mupdanalist);

POSTING(tmptrans)
PST_ADDCMD 	supdd

CALCS()
c0x		0
cOPENx		tlmsts == "OPEN"
cblmada		djointldrev == 0 && tlmsts == "OPEN"

PERMIT(tmptrans)
