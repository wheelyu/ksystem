EDITS(tmptranst)
e.Mandatory     ketnama     MANDATORY
e.Mandatory     ketstr1     MANDATORY

CALCS()
csakitdll	((ketnama=="SAKIT" || ketnama=="IZIN" || ketnama=="JALAN_DINAS") && ketdf1==1) || (ketnama!="SAKIT" && ketnama!="IZIN" && ketnama!="JALAN_DINAS")

HOOKS(tmptranst)
BEFORE_INPUT    cur_field=kettgl1      DO_SKIP_IF c1
AFTER_INPUT     cur_field=ketisi       DO_MAP SHOW    misiket
AFTER_INPUT	    cur_keybd=EN		DO_MAP SHOW mupdkettgl
AFTER_INPUT     cur_field=ketnama      DO_MAP SHOW
                                IF csakitdll mdum
                                ELSE HKCURSOR NOSTAY
                                HKMSG t.SegeraProsesKoreksi

AFTER_INPUT     cur_field=ketnama      DO_MAP SHOW      misiket2    

AFTER_INPUT     cur_field=ketisi2       DO_MAP SHOW    misiket3



AFTER_INPUT	cur_field=ketisi	DO_MAP SHOW 
				IF cpanjangket mdum
				ELSE HKCURSOR STAY
				HKMSG t.Minimal30Karakter

AFTER_INPUT	cur_field=ketisi2	DO_MAP SHOW 
				IF cpanjangket2 mdum
				ELSE HKCURSOR STAY
				HKMSG t.Minimal30Karakter

CALCS()
cY      "Y"

MAP(mupdketUPL)
