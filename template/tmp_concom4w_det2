cdf7		svistr7		DO_CALC
cdf8		svistr8		DO_CALC
DEBUG		ldum		ldum		REPLACE

HOOKS(tmptranst)
AFTER_INPUT     cur_field=svidf1       DO_MAP SHOW
                IF ckecilagen      mdum2
                ELSE HKCURSOR STAY
                HKMSG TIDAK BOLEH LEBIH BESAR DARI ANGKA SEBELAH KIRI

AFTER_INPUT     cur_field=svidf2       DO_MAP SHOW
                IF ckecilfree      mdum2
                ELSE HKCURSOR STAY
                HKMSG TIDAK BOLEH LEBIH BESAR DARI ANGKA SEBELAH KIRI

AFTER_INPUT     cur_field=svidf3       DO_MAP SHOW
                IF ckecilkagen     mdum2
                ELSE HKCURSOR STAY
                HKMSG TIDAK BOLEH LEBIH BESAR DARI ANGKA SEBELAH KIRI

AFTER_INPUT     cur_field=svidf4       DO_MAP SHOW
                IF ckecilkfree     mdum2
                ELSE HKCURSOR STAY
                HKMSG TIDAK BOLEH LEBIH BESAR DARI ANGKA SEBELAH KIRI

AFTER_INPUT     cur_field=svidf4       DO_MAP SHOW
                IF ckecilkfree     mdum2
                ELSE HKCURSOR STAY
                HKMSG TIDAK BOLEH LEBIH BESAR DARI ANGKA SEBELAH KIRI

AFTER_INPUT     cur_field=svidf5       DO_MAP SHOW
                IF ckecilagenya    mdum2
                ELSE HKCURSOR STAY
                HKMSG TIDAK BOLEH LEBIH BESAR DARI ANGKA SEBELAH KIRI

AFTER_INPUT     cur_field=svidf8       DO_MAP SHOW
                IF ckecilagentdk    mdum2
                ELSE HKCURSOR STAY
                HKMSG TIDAK BOLEH LEBIH BESAR DARI ANGKA SEBELAH KIRI

AFTER_INPUT     cur_field=svidf6       DO_MAP SHOW
                IF ckecilpkagen    mdum2
                ELSE HKCURSOR STAY
                HKMSG TIDAK BOLEH LEBIH BESAR DARI ANGKA SEBELAH KIRI

AFTER_INPUT     cur_field=svidf7       DO_MAP SHOW
                IF ckecilpkfree    mdum2
                ELSE HKCURSOR STAY
                HKMSG TIDAK BOLEH LEBIH BESAR DARI ANGKA SEBELAH KIRI

BEFORE_INPUT     cur_field=sviket       DO_MAP SHOW mdetil2

BEFORE_INPUT	cur_field=ldum2	DO_SCAN dscansvikba
