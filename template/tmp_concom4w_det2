MAP(mdetil2)
lCONCOMKT       svidata         REPLACE
lKBA            svitype         REPLACE
tlmnobuk        svinobuk        REPLACE

CALCS()
cdf1		FLD_TO_STRING(lsvidf1)
cdf2		FLD_TO_STRING(lsvidf2)
cdf3		FLD_TO_STRING(lsvidf3)
cdf4		FLD_TO_STRING(lsvidf4)
cdf5		FLD_TO_STRING(lsvidf5)
cdf6		FLD_TO_STRING(lsvidf6)
cdf7		FLD_TO_STRING(lsvidf7)
cdf8		FLD_TO_STRING(lsvidf8)
ckecilagen	svidf1 <= lsvidf1	
ckecilfree	svidf2 <= lsvidf2
ckecilkagen	svidf3 <= lsvidf3
ckecilkfree	svidf4 <= lsvidf4
ckecilagenya	svidf5 <= lsvidf5
ckecilagentdk	svidf8 <= lsvidf8
ckecilpkagen	svidf6 <= lsvidf6
ckecilpkfree	svidf7 <= lsvidf7
