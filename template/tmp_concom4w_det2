cfree0		lsvidf2 == 0
ckagen		lsvidf3 == 0
ckfree		lsvidf4 == 0
cagenya		lsvidf5 == 0
cagentdk	lsvidf8 == 0
cpkagen		lsvidf6 == 0
cpkfree		lsvidf7 == 0

MAP(mdum2)
