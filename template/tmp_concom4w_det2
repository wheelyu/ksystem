BEFORE_INPUT	cur_field=svidf4	DO_SKIP_IF ckfree
BEFORE_INPUT	cur_field=svidf5	DO_SKIP_IF cagenya
BEFORE_INPUT	cur_field=svidf8	DO_SKIP_IF cagentdk
BEFORE_INPUT	cur_field=svidf6	DO_SKIP_IF cpkagen
BEFORE_INPUT	cur_field=svidf7	DO_SKIP_IF cpkfree

