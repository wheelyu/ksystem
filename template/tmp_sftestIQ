FIELD(tmptranst)
sgmurt       PROTECT                 INPUTRI          1
   sgmstr4      ALLCAPS                 BIG              2

CALCS()
ctambahjamIQ	lsgmjam + l0045
cjoinsgmIQ	djoinsgmtime==1
csyr1           (sgmstr3 == "BS" && (sgmstr4 == "B" || sgmstr4 == "S")) || sgmstr3 != "BS"
csyr2           (sgmstr3 == "AD" && (sgmstr4 == "A" || sgmstr4 == "B" || sgmstr4 == "C" || sgmstr4 == "D")) || sgmstr3 != "AD" 
csyr3           (sgmstr3 == "AE" && (sgmstr4 == "A" || sgmstr4 == "B" || sgmstr4 == "C" || sgmstr4 == "D" || sgmstr4 == "E")) || sgmstr3 != "AE"
csyr4           (sgmstr3 == "ANGKA" && (sgmstr4 == "1" || sgmstr4 == "2" || sgmstr4 == "3" || sgmstr4 == "4" || sgmstr4 == "5")) || sgmstr3 != "ANGKA"
csyr5           (sgmstr3 == "POLA2" && (sgmstr4 == "A,B" || sgmstr4 == "A,C" || sgmstr4 == "A,D" || sgmstr4 == "A,E" || sgmstr4 == "B,C" || sgmstr4 == "B,D" || sgmstr4 == "B,E" || sgmstr4 == "C,D" || sgmstr4 == "C,E" || sgmstr4 == "D,E")) || sgmstr3 != "POLA2"
clewat_jam      (djoinsgmtime == 1 && ljam_skrg <= lsgmjamiqA) || djoinpsd9iq==1|| djoinsgmtime == 0 || g_usrkode=="1029131" || g_tgltrn==20210421

MAP(mtambahjam)
ctambahjamIQ	lsgmjamiqA	DO_CALC_IF cjoinsgmIQ

HOOKS(tmptranst)
AFTER_INPUT	cur_field=sgmstr4	DO_MAP SHOW mtambahjam
AFTER_INPUT	cur_keybd=EN     	DO_MAP SHOW maddtgltes
AFTER_INPUT     cur_field=sgmstr4       DO_MAP SHOW
                IF csyr1        mdum
                ELSE HKCURSOR STAY
                HKMSG t.HrsIsiBS

AFTER_INPUT     cur_field=sgmstr4       DO_MAP SHOW
                IF csyr2        mdum
                ELSE HKCURSOR STAY
                HKMSG t.HrsIsiABCD

AFTER_INPUT     cur_field=sgmstr4       DO_MAP SHOW
                IF csyr3        mdum
                ELSE HKCURSOR STAY
                HKMSG t.HrsIsiABCDE
AFTER_INPUT     cur_field=sgmstr4       DO_MAP SHOW
                IF csyr4        mdum
                ELSE HKCURSOR STAY
                HKMSG t.HrsIsi12345

AFTER_INPUT     cur_field=sgmstr4       DO_MAP SHOW
                IF csyr5        mdum
                ELSE HKCURSOR STAY
                HKMSG t.HrsIsiAB


AFTER_INPUT     cur_field=sgmstr4       DO_MAP SHOW
                IF clewat_jam   mdum
                ELSE HKCURSOR STAY
                HKMSG t.WaktuTesSudahBerahkir



