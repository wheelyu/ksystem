FIELD(tmptrans)
akturt          PROTECT         		INPUTRI 1  
aktbukoto	PROTECT	SCROLL			INPUTRI 1
aktcab		PROTECT SCROLL			INPUTRI 2 /*bisnis*/
aktkode		PROTECT SCROLL			INPUTRI 3 /*no gsm*/
aktkode2	PROTECT	SCROLL			INPUTRI 4 /*no wa*/
akttype		PROTECT	SCROLL			INPUTRI 5 /*status*/
aktbrg		PROTECT	SCROLL			INPUTRI 6 /*keterangan*/
akttgl		PROTECT SCROLL {DD-MM-YY}	INPUTRI 7 /*tgl ubh*/
aktcrtusr	PROTECT SCROLL			INPUTRI 8 /*nip ubh */
aktlok		PROTECT	SCROLL			INPUTRI 9 /*group login*/
aktscr		PROTECT SCROLL			INPUTRI 10 /*nipdesk*/
aktket		PROTECT	SCROLL			INPUTRI 11 /*penyelesaian*/
ltergsm		PROTECT SCROLL			INPUTRI 12
lterwa		PROTECT	SCROLL			INPUTRI 13

DEFAULTS(tmptrans)
ldeskcall	INIT	DESKCALL
lDTLP		INIT	DTLP

CALCS()
cselectdata	aktdata == "HSTRNOHP"
cdjointldtelpx	djointldtelpx == 1 && (ltldkatx != BLANKS || ltldlok2x != BLANKS)
cdjointldtelp	djointldtelp == 1 && (ltldkat_1 != BLANKS || ltldlok2_1 != BLANKS)
cdjointldtelp2	djointldtelp2 == 1 && (ltldkat_2 != BLANKS || ltldlok2_2 != BLANKS)
cdjointldtelp3	djointldtelp3 == 1 && (ltldkat_3 != BLANKS || ltldlok2_3 != BLANKS)
cdjointldtelp4	djointldtelp4 == 1 && (ltldkat_4 != BLANKS || ltldlok2_4 != BLANKS)

EDIT(tmptrans)
e.validate      aktcrtusr		VALIDATE psikodidx mtld 

MAP(mtld)
ltldkatx	ltergsm		REPLACE_IF cdjointldtelpx
ltldlok2x	lterwa		REPLACE_IF cdjointldtelpx
ltldkat_1	ltergsm		REPLACE_IF cdjointldtelp
ltldlok2_1	lterwa		REPLACE_IF cdjointldtelp
ltldkat_2	ltergsm		REPLACE_IF cdjointldtelp2
ltldlok2_2	lterwa		REPLACE_IF cdjointldtelp2
ltldkat_3	ltergsm		REPLACE_IF cdjointldtelp3
ltldlok2_3	lterwa		REPLACE_IF cdjointldtelp3
ltldkat_4	ltergsm		REPLACE_IF cdjointldtelp4
ltldlok2_4	lterwa		REPLACE_IF cdjointldtelp4

SUBFILE(tmptrans)
SFL_TITLE(tmptranst)
