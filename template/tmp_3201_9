tldkat		ltldkat_1	REPLACE
tldlok2		ltldlok2_1	REPLACE

DBCALCS(djointldtelp)
	DBC_COMMAND	JOIN
	DBC_TARGET	tldstsbrgukr    ldeskcall gv_OPEN aktbukoto lDTLP
