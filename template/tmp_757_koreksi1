tldlok2         PROTECT         INPUTRI 3
tldnobuk        PROTECT         INPUTRI 4
tldstr1         NOCHANGE        INPUTRI 5
tldket          TEXTAREA        INPUTRI 6
lenter          NOCHANGE        INPUTRI 7


DEFAULTS(tmptranst)
lenter          INIT            ENTER
tlddata         INIT            VERRESRV
tldlok2         INIT            {g_grpnam}
tldsts          INIT            INPG
tldplg          INIT            {g_usrkode}
lKOREKSIFRAUD	INIT		KOREKSIFRAUD
tldstr1         DFALT_SCAN      BLANKS
                                UBAHSTATUS

EDITS(tmptranst)
