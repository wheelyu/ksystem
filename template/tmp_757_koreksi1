MAP(mpsinip2)
psmkode         tldplg          REPLACE

CALCS()
cjointld_0      djointld2 == 0 && g_curcmd==1
cjointld_1      djointld2 == 1 && g_curcmd==1
c01             "01"
c02             "02"
csatu2x         1
cplus2x         ltldnourt + 1
cTIDAKFRAUD	"TIDAKFRAUD"
cjoinhslresv	djoinhslresv==1
/* 
cbtssts         djointldsts==0 || tldstr1=="UBAHKUNCI" || g_grpnam == "IT"
cbtstgl         djointldkunci==0 || tldstr1=="UBAHSTATUS"
*/

MAP(misiuruty)
csatu2x         tldnourt        DO_CALC_IF cjointld_0
cplus2x         tldnourt        DO_CALC_IF cjointld_1

MAP(misitransc2)
tkmnobuk        tldnobuk        REPLACE

HOOKS(tmptranst)
BEFORE_INPUT    cur_field=tldnourt      DO_MAP misiuruty
AFTER_INPUT     cur_field=tldstr1       DO_MAP SHOW misitransc2

/*
AFTER_INPUT     cur_field=tldstr1     DO_MAP  SHOW
                IF cbtssts mdum3
                ELSE HKCURSOR STAY
                HKMSG Max 1 kali input ubah status

AFTER_INPUT     cur_field=tldstr1     DO_MAP  SHOW
                IF cbtstgl mdum3
                ELSE HKCURSOR STAY
                HKMSG Max 1 kali input mundur tanggal
*/

SUBFILE(tmptrans)
