/*g_fototime1     svidf8          REPLACE*/
cok2            sviyt2          DO_CALC_IF cadalonlat2

DBCALCS(dupdsvirmhkananok)
        DCOMMAND        UPDATE
        DTARGET         sviprmidx sviprm
        DMAP            mupdsvirmhkananok

SPCALCS(spcaluplkananok)
dupdsvirmhkananok
DO_LIB ap_nxpst(l4461,lm4461det2);

HOOKS(tmptranst)
