DBCALCS(dbftverif)
        DCOMMAND UPDATE
        DTARGET sviprmidx sviprm
        DMAP mupdsviftverif

CALCS()
cfotoverif	        svikode=="FCR001" || svikode=="FCR002" || svikode=="FCR003" || svikode=="FCR004" || svikode=="FCR005"
csudahokver             sviyt1 == "Y"
caktupl669sctk          djoinaktupl669sctk == 0 && btmsts == "669" && btmflag1 == "SCTK"

