IMAGE(tmptrans)

FIELDS(tmptranst)
        svists          PROTECT                   INPUTRI 1
        svistr5         PROTECT                   INPUTRI 1
        svikode         PROTECT QPROTECT UNSEEN   INPUTRI 1
        svistr2         ALLCAPS                   INPUTRI 2
        svistr3         PROTECT                   INPUTRI 2
        svistr4         ALLCAPS                   INPUTRI 2
        lketisij        TEXTAREA 2 ALLCAPS         INPUTRI 2
        lketisi2j       TEXTAREA 2 ALLCAPS         INPUTRI 2
        svistr1         NOCHANGE                  INPUTRI 3
        svitgl1         PROTECT {DD-MM-YYYY}      INPUTRI 4
        svinobuk        PROTECT UNSEEN            INPUTRI 5
        svitblkode      PROTECT UNSEEN            INPUTRI 5
        lupld10         TOMBOL                    INPUTRI 1
        svistr33        ALLCAPS                   INPUTRI 6
        svistr7         TEXTAREA 2 ALLCAPS        INPUTRI 20
        lketisi2        NOCHANGE                  INPUTRI 21

 
EDITS(tmptranst)
e.stsbukan707     svikode         VALIDATE ftmdatbukidx mftm6 sftm6 {PlMULTI4W}
e.isiatasnama     svistr2         MANDATORY
e.isirmhdinas     svistr4         MANDATORY
e.isiket          lketisij        MANDATORY
e.ket             svitblkode      VALIDATE ketdatbukkod mketj  0     {Psvidata} {Psvinobuk}
e.isiaccrm        svistr33        MANDATORY_IF cinpgd
e.isiket          svistr7         MANDATORY_IF crmT


MAP(mketj)
lketisij         ketisi            REPLACE_IF cadaket1b
cBLANKS         lketisij           DO_CALC
ketisi          lketisij           REPLACE
lketisi2j        ketisi2            REPLACE_IF cadaket1b
cBLANKS         lketisi2j           DO_CALC
ketisi2         lketisi2j          REPLACE

MAP(mftm6)
ftmkode1        svistr3         REPLACE

MAP(maddket10)
svinobuk        ketnobuk          REPLACE
svidata         ketdata           REPLACE
svitype         ketkode           REPLACE
lketisij         ketisi            REPLACE_IF cadaket0
lketisi2j        ketisi2           REPLACE_IF cadaket0

MAP(mupdsvi10)
lketisij        ketisi            REPLACE_IF cadaket1b
cBLANKS         lketisij          DO_CALC
ketisi          lketisij          REPLACE
lketisi2j       ketisi2            REPLACE_IF cadaket1b
cBLANKS         lketisi2j          DO_CALC
ketisi2         lketisi2j          REPLACE



DEFAULTS(tmptranst)
svistr4 DFALT_SCAN BLANKS YA TIDAK
svistr33           DFALT_SCAN_BLANKS Y T



MAP(mupdsviftmandx10)
cIN             svistr1         DO_CALC_IF cksong2
g_tgltrn        svitgl1         REPLACE
gv_INPG         svists          REPLACE_IF cinpg

DBCALCS(dbftupl10)
        DCOMMAND UPDATE
        DTARGET sviprmidx sviprm
        DMAP mupdsviftmandx10

MAP(mapr11)
gv_OPEN         svists          REPLACE_IF cksong
cOKRM           svistr34        DO_CALC_IF crmok
ctKRM           svistr34        DO_CALC_IF crmT
gv_TACC         svists          REPLACE_IF crmT


MAP(mupload10)
g_tgltrn        svitgl1         REPLACE_IF cuplok
cOK             svistr1         DO_CALC_IF cuplok

MAP(mmapmap10a)
ldum            ldum              REPLACE
svinourt        lurt              REPLACE
ckuncidev1      lkunci2           DO_CALC

MAP(mkuncirm10)
gv_CLSD         abksts            REPLACE_IF cnipsama

MAP(mkuncirm210)
gv_CLSD         abksts            REPLACE


SPCALCS(saddket10)
DO_LIB                 ap_dbclc(DNAME dmapmap10a,DCOMMAND MAPMAP,DMAP mmapmap10a);
DO_LIB_IF cadaket0     ap_dbclc(DNAME dket10,DCOMMAND ADD,DFILE ket,DMAP maddket10);
DO_LIB_IF cadaket1     ap_dbclc(DNAME dupdsvi10,DCOMMAND UPDATE,DTARGET ketdatbukkod svidata svinobuk svitblkode,DMAP mupdsvi10);

SPCALCS(sdelket10)
DO_LIB_IF cadaket1     ap_dbclc(DNAME ddelket10,DCOMMAND DELETE,DTARGET ketdatbukkod svidata svinobuk svitblkode);

SPCALCS(suploadd10)
DO_LIB                 ap_dbclc(DNAME dmapupl10,DCOMMAND MAPMAP,DMAP mmapmap10a);
DO_LIB_IF crm          ap_dbclc(DNAME ddevb10,DCOMMAND ADD,DFILE abk,DMAP madddevrm);
DO_LIB                 ap_dbclc(DNAME dupload10d,DCOMMAND UPDATE,DTARGET sviprmidx sviprm,DMAP mupload10);

SPCALCS(sbkkunci10)
DO_LIB                 ap_dbclc(DNAME dmapmaprm10,DCOMMAND MAPMAP,DMAP mmapmap1a);
DO_LIB_IF crmok2       ap_dbclc(DNAME dupdrmok10,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lkunci2 l643,DMAP mkuncirm10);
DO_LIB_IF crmT2        ap_dbclc(DNAME dupdrmT10,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lkunci2 l643,DMAP mkuncirm210);
DO_LIB_IF cdvh         ap_dbclc(DNAME ddevd10,DCOMMAND ADD,DFILE abk,DMAP madddevdvh);
DO_LIB_IF cram         ap_dbclc(DNAME ddevf10,DCOMMAND ADD,DFILE abk,DMAP madddevram);



HOOKS(tmptranst)
CLICKED         cur_field=lupld10       DO_SPCALCS suploadd10
AFTER_INPUT    cur_keybd=EN     DO_MAP SHOW mapr11
AFTER_INPUT     cur_keybd=EN            DO_SPCALCS sbkkunci10
AFTER_INPUT     cur_field=lketisij       DO_MAP SHOW mketcab
AFTER_INPUT     cur_field=lketisij        DO_MAP
                IF ccabisij mdum
                ELSE HKCURSOR STAY
                HKMSG harus 200 karabker
BEFORE_INPUT    cur_field=svistr33      DO_SKIP_IF copend
BEFORE_INPUT    cur_field=svistr7       DO_SKIP_IF copend
BEFORE_INPUT    cur_field=svistr2       DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=svistr4       DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=lketisij      DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=lketisi2j     DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=svistr1       DO_SKIP_IF cinpgd




