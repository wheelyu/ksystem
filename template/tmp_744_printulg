MAP(mjointldurut)
tldnourt        lnourt      REPLACE

DBCALCS(djointldurut)
        DBC_COMMAND     JOIN_LAST_SFL
        DBC_TARGET      tldbukbrgoto psikode gv_INPG  lprtulg
