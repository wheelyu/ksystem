IMAGE(tmptranst)
/--------------------------------------------\
|i.Tgl       : _____________________________ |
|i.Ket       : _____________________________ |
|i.Status    : _____			     |
\--------------------------------------------/

IMAGE(tmptrans)

FIELD(tmptranst)
tkdtgl    	PROTECT {DD-MM-YY}    INPUTRI     1
tkdket	        TEXTAREA              INPUTRI     2
tkdsts	        NOCHANGE              INPUTRI     3

EDITS(tmptranst)
t.MandatoryTgl	tkdtgl		MANDATORY
t.MandatoryKet	tkdket		MANDATORY

DEFAULT(tmptranst)
tkddata		INIT_ADD		"JADWALUAT"
tkdsts		INIT_ADD		"OPEN"
tkdtgl		INIT_ADD		{ctglp1}

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst) 
SFL_SELECT    ctkdopen
SFL_SHOW_NEXT
SFL_TARGET      
tkddatbukll   ljadwalUAT tlmnobuk

SFL_MAP
tlmnobuk	tkdnobuk		REPLACE
tkddata		tkddata			REPLACE

HOOKS(tmptranst)
AFTER_INPUT     cur_field=tkdtgl                DO_MAP SHOW
        IF      ctglawal        mdumstr
        ELSE
        HKCURSOR STAY tkdtgl
        HKMSG   t.Tanggal tidak boleh tanggal sudah terlewat




