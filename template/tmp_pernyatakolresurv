BOXUNCHECKED    cur_field=lceklisspv3       DO_SPCALCS spcal_delceklisspv3
BOXCHECKED      cur_field=lceklisbm3       DO_SPCALCS spcal_ceklisbm3
BOXUNCHECKED    cur_field=lceklisbm3       DO_SPCALCS spcal_delceklisbm3


SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_TARGET
        svidatbuktyp   mtsdata mtsnobuk lresurvey3
SFL_MAP
mtsnobuk        svinobuk        REPLACE
mtsdata         svidata         REPLACE
mtsnoasal       svidtmkode      REPLACE
g_usrkode	svikode         REPLACE 


CALCS()
ckondisikol	    abktype=="KOL" && abkkym2=="736"

cabkbesok	    g_tgltrn+1
charus3		    (
		    (((lttotalkolINPG + lttotalkolCLSD) >=6) && lttotalkolCLSD >=6) ||  
		    (((lttotalkolINPG + lttotalkolCLSD) < 6) && 
		    (lttotalkolCLSD == (lttotalkolINPG + lttotalkolCLSD)))
		    )
			&& psijabatan != "A/RRESURVSTAFF" && mtsdvs != "M4W"
cblmupltmptkerja    mtsdvs != "M4W" && djoinsvitmptkerja == 1 && lsdhuplft == "" && djoinabkkolfoto==0
cupltmptkerja       "Upload Foto Tmpt Kerja"
cUplTmpKrj          "UPLKRJA736"

MAP(mupdabkkol)
gv_CLSD		abksts		REPLACE_IF cabkkol
DEBUG		ldumx		ldumx		REPLACE

MAP(mscanabkCLSD)
c1              lttotalkolCLSD          DO_CALC_IF ckondisikol
DEBUG           ldumx           ldumx           REPLACE

MAP(mscanabkINPG)
c1              lttotalkolINPG          DO_CALC_IF ckondisikol
DEBUG           ldumx           ldumx           REPLACE

MAP(mscanabkRINP)
c1              lttotalkolRINP          DO_CALC_IF ckondisikol
DEBUG           ldumx           ldumx           REPLACE

MAP(mupdabkkolbesok)
gt_RINP		abksts		REPLACE_IF ckondisikol
cabkbesok	abktgl		DO_CALC_IF ckondisikol
DEBUG		ldumx		ldumx		REPLACE

MAP(maddabkkolupltmptkerja)
gt_RINP         abksts          REPLACE
g_tgltrn /* cabkbesok */      abktgl          REPLACE
lkunciabsen     abkdata         REPLACE
cupltmptkerja   abkkym2         DO_CALC
mtsplg          abkkym          REPLACE
mtsnobuk        abknobuk        REPLACE
l736x           abkscr          REPLACE
cUplTmpKrj      abktype         DO_CALC

SPCALCS(spaddtmptrans)
DO_LIB_IF cjoinabkkol ap_dbclc(DNAME dupdabkkol,DCOMMAND UPDATE_RANGE,DTARGET abkdatbukidx lkunciabsen mtsnobuk,DMAP mupdabkkol);
DO_LIB  ap_dbclc(DNAME dbscanabkCLSD,DCOMMAND SCANSCAN,DTARGET abkdatstskym lkunciabsen gv_CLSD mtsplg l736x g_tgltrn,DBC_SUM_MAP mscanabkCLSD);
DO_LIB  ap_dbclc(DNAME dbscanabkINPG,DCOMMAND SCANSCAN,DTARGET abkdatstskym lkunciabsen gv_INPG mtsplg l736x g_tgltrn,DBC_SUM_MAP mscanabkINPG);
DO_LIB  ap_dbclc(DNAME dbscanabkRINP,DCOMMAND SCANSCAN,DTARGET abkdatstskym lkunciabsen gt_RINP mtsplg l736x g_tgltrn,DBC_SUM_MAP mscanabkRINP);

DO_LIB_IF charus3 ap_dbclc(DNAME dupdabkkolbesok,DCOMMAND UPDATE_RANGE,DTARGET abkdatstskym lkunciabsen gv_INPG mtsplg l736x,DMAP mupdabkkolbesok);
DO_LIB_IF cblmupltmptkerja ap_dbclc(DNAME daddabkkoltmpkerja,DCOMMAND ADD,DFILE abk,DMAP maddabkkolupltmptkerja);

SPCALCS(spcal_ceklisspv3)
DO_LIB ap_dbclc(DNAME dmapcoba2,DCOMMAND MAPMAP, DMAP mcoba);
DO_LIB_IF cjoinceklisspv3_0 ap_dbclc(DNAME daddceklisspv3,DCOMMAND ADD,DFILE psd,DMAP maddceklisspv3);

SPCALCS(spcal_delceklisspv3)
DO_LIB ap_dbclc(DNAME dmapcoba3,DCOMMAND MAPMAP, DMAP mcoba);
DO_LIB_IF cjoinceklisspv3_1 ap_dbclc(DNAME ddelceklisspv3,DCOMMAND DELETE,DTARGET psddattypidx mtsdata lcekprytkol mtsnobuk lCHECKBOX1);

SPCALCS(spcal_ceklisbm3)
DO_LIB_IF cjoinceklisbm3_0 ap_dbclc(DNAME daddceklisbm3,DCOMMAND ADD,DFILE psd,DMAP maddceklisbm3);

SPCALCS(spcal_delceklisbm3)
DO_LIB_IF cjoinceklisbm3_1 ap_dbclc(DNAME ddelceklisbm3,DCOMMAND DELETE,DTARGET psddattypidx mtsdata lcekprytkol mtsnobuk lCHECKBOX2);


