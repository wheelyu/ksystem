CALCS()
chitrt		DO_LIB ap_strln(svistr3,&llongrt);
chitrw		DO_LIB ap_strln(svistr4,&llongrw);
chitktp		DO_LIB ap_strln(svistr9,&llongktp);
clongrt		llongrt==3
clongrw		llongrw==3
clongktp	llongktp==16

MAP(mhitrt)
chitrt		llongrt		DO_CALC

MAP(mhitrw)
chitrw		llongrw		DO_CALC

MAP(mhitktp)
chitktp		llongktp	DO_CALC

HOOKS(tmptranst)
AFTER_INPUT	cur_field=svistr3	DO_MAP SHOW mhitrt
AFTER_INPUT	cur_field=svistr3	DO_MAP SHOW
		 IF clongrt mdum
                ELSE HKCURSOR STAY
                HKMSG  Panjang Nomor RT Harus 3 Karakter

AFTER_INPUT	cur_field=svistr4	DO_MAP SHOW mhitrw
AFTER_INPUT     cur_field=svistr4       DO_MAP SHOW
                 IF clongrw mdum
                ELSE HKCURSOR STAY
                HKMSG  Panjang Nomor RW Harus 3 Karakter

AFTER_INPUT     cur_field=svistr9       DO_MAP SHOW mhitktp
AFTER_INPUT     cur_field=svistr9       DO_MAP SHOW
                 IF clongktp mdum
                ELSE HKCURSOR STAY
                HKMSG  Panjang Nomor KTP Harus 16 Karakter


