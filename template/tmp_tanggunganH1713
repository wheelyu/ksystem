        DO_LIB ap_dbclc(DNAME dupdftmtanggungan, DCOMMAND UPDATE_BUF3, DTARGET ftmdatbukidx gv_capacityH1 btmnobuk, DMAP mupdftmtanggungan713);

        DO_LIB_IF cdjoinsvitanggungany ap_dbclc (DNAME daddsvitanggungan,DCOMMAND ADD,DFILE svi,DMAP maddsvitanggungan);
        DO_LIB_IF cdjoinsvitanggungant ap_dbclc (DNAME ddelsvitanggungan,DCOMMAND DELETE,DTARGET sviotoidx lsviototanggungan714);


