SPCALCS(sptmptrans)
DO_LIB ap_dbclc(DNAME dmapmap1,DCOMMAND MAPMAP,DMAP mmapmap1);
DO_LIB ap_dbclc(DNAME dupdnhm11,DCOMMAND UPDATE,DTARGET nhmdatbukidx gv_dtbukutamu btmnobuk,DMAP mupdnhm11);
DO_LIB  ap_bulat(nhmbsrang,l500,&lhasilbulat,lU);
