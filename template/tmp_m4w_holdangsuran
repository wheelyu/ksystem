nhmbsrang_3	svidf2		REPLACE
chithold	svidf3		DO_CALC
cBLANKS		svidf1		DO_CALC_IF chold0
cBLANKS		svidf3		DO_CALC_IF chold0

HOOKS(tmptranst)
BEFORE_INPUT	cur_field=svidf1	DO_SKIP_IF chold0
AFTER_INPUT	cur_field=svidf1	DO_MAP SHOW mhithold
AFTER_INPUT	cur_keybd=EN    	DO_MAP SHOW mhithold
AFTER_INPUT     cur_field=svidf1        DO_MAP SHOW
                IF ctenorlebih mdum
                ELSE HKCURSOR STAY
                HKMSG MELEBIHI TENOR

MAP(mupdholdang)
