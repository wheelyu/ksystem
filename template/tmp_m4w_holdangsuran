SPCALCS(spholdang)
DO_LIB ap_dbclc(DNAME dupdholdang,DCOMMAND UPDATE,DTARGET nhmdatbukidx btmdata btmnobuk,DMAP mupdholdang);

POSTING(tmptrans)
	PST_ADDCMD spholdang
	PST_UPDCMD spholdang

