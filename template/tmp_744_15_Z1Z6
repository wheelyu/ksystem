cdjoinpcpkolz1		djoinpcpkol==1 && lawlttlunitZ1 > 0
cdjoinpcpkolz2		djoinpcpkol==1 && lawlttlunitZ2 > 0
cdjoinpcpkolz4		djoinpcpkol==1 && lawlttlunitZ4 > 0
cdjoinpcpkolz6		djoinpcpkol==1 && lawlttlunitZ6 > 0

cdjoinkontribusiz1      djoinkontribusi==1 && lawlttlunitZ1 > 0
cdjoinkontribusiz2      djoinkontribusi==1 && lawlttlunitZ2 > 0
cdjoinkontribusiz4      djoinkontribusi==1 && lawlttlunitZ4 > 0
cdjoinkontribusiz6      djoinkontribusi==1 && lawlttlunitZ6 > 0

