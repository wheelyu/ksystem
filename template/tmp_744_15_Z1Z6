cawlttlsispokr		lawlbyr1sispok + lawlbyr2sispok + lawlplnssispok + lawltariksispok

ctgt1blnttlunit		((ltgtpcpkolz1 * lawlttlunitZ1)/100) + ((ltgtpcpkolz2 * lawlttlunitZ2)/100) + ((ltgtpcpkolz4 * lawlttlunitZ4)/100) +
			((ltgtpcpkolz6 * lawlttlunitZ6)/100)
ctgt1blnttlsispok	((ltgtpcpkolz1 * lawlttlsispokZ1)/100) + ((ltgtpcpkolz2 * lawlttlsispokZ2)/100) + 
			((ltgtpcpkolz4 * lawlttlsispokZ4)/100) + ((ltgtpcpkolz6 * lawlttlsispokZ6)/100)

ctgthettlunit		((((ltgtpcpkolz1 * ltgtkonstz1)/100) * lawlttlunitZ1)/100) + ((((ltgtpcpkolz2 * ltgtkonstz2)/100) * lawlttlunitZ2)/100) + ((((ltgtpcpkolz4 * ltgtkonstz4)/100) * lawlttlunitZ4)/100) + ((((ltgtpcpkolz6 * ltgtkonstz6)/100) * lawlttlunitZ6)/100)
ctgthettlsispok         ((((ltgtpcpkolz1 * ltgtkonstz1)/100) * lawlttlsispokZ1)/100) + ((((ltgtpcpkolz2 * ltgtkonstz2)/100) * lawlttlsispokZ2)/100) + ((((ltgtpcpkolz4 * ltgtkonstz4)/100) * lawlttlsispokZ4)/100) + ((((ltgtpcpkolz6 * ltgtkonstz6)/100) * lawlttlsispokZ6)/100)

cactslsttlunitr		lactslsbyr1unit + lactslsbyr2unit + lactslsplnsunit + lactslstarikunit
cactslsttlsispokr	lactslsbyr1sispok + lactslsbyr2sispok + lactslsplnssispok + lactslstariksispok

cactslsSttlunitr	lactslsSbyr1unit + lactslsSbyr2unit + lactslsSplnsunit + lactslsStarikunit
clactslsSttlsispokr	lactslsSbyr1sispok + lactslsSbyr2sispok + lactslsSplnssispok + lactslsStariksispok

cpcp1blnttlunit		(lactslsttlunit / ltgt1blnttlunit) * 100
cpcp1blnttlsispok	(lactslsttlsispok / ltgt1blnttlsispok) * 100

ctgt1blnttlunit0	ltgt1blnttlunit !=0
ctgt1blnttlsispok0	ltgt1blnttlsispok !=0

cpcphettlunit		(lactslsttlunit / ltgthettlunit) * 100
cpcphettlsispok		(lactslsttlsispok/ ltgthettlsispok) * 100

ctgthettlunit0		ltgthettlunit!=0
