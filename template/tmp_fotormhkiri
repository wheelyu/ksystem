DBCALCS(dupdsvirmhkiriok)
        DCOMMAND UPDATE
        DTARGET sviprmidx sviprm
        DMAP mupdsvirmhkiriok

SPCALCS(spcaluplkiriok)
dupdsvirmhkiriok
DO_LIB ap_nxpst(l4461,lm4461det2);

HOOKS(tmptranst)
CLICKED         cur_field=lklikok1       DO_SPCALCS IF csdhupload1 spcaluplkiriok

CALCS()
crmhkiri	tmpkode == "RMHKIRI"
crmhkiri1	sviyt1 != "Y"

