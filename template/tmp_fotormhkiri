MAP(mupdsvirmhkiri)
cY              sviyt1          DO_CALC
cSYSTIME         svidf8          DO_CALC
g_tgltrn        svitgl2         REPLACE

DBCALCS(dupdsvirmhkiri)
        DCOMMAND UPDATE
        DTARGET sviprmidx sviprm
        DMAP mupdsvirmhkiri

MAP(mupdsvirmhkiriok)
g_fotolat1      svidf6          REPLACE
g_fotolon1      svidf7          REPLACE
/*g_fotodate1     svitgl2         REPLACE*/
/*g_fototime1     svidf8          REPLACE*/
