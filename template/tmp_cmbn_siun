cpsg02		mtdtmp1		 DO_CALC_IF cusiakerja02
cpsg03		mtdtmp1		 DO_CALC_IF cusiakerja03
cpsg04		mtdtmp1		 DO_CALC_IF cusiakerja04
cpsg05		mtdtmp1		 DO_CALC_IF cusiakerja05
cpsg06		mtdtmp1		 DO_CALC_IF cusiakerja06
cpsg07		mtdtmp1		 DO_CALC_IF cusiakerja07
cpsg08		mtdtmp1		 DO_CALC_IF cusiakerja08
cpsg09		mtdtmp1		 DO_CALC_IF cusiakerja09
	
