cpmk03           mtdsubtot * 3
cpmk04           mtdsubtot * 4
cpmk05           mtdsubtot * 5
cpmk06           mtdsubtot * 6
cpmk07           mtdsubtot * 7
cpmk08           mtdsubtot * 8
cpmk09           mtdsubtot * 10


cusiakerja01      mtdjml3 < 1
