MAP(mkunci3)
gv_CLSD         abksts            REPLACE

SPCALCS(supdabk3)
DO_LIB                 ap_dbclc(DNAME dmapmap3,DCOMMAND MAPMAP,DMAP mmapmap3);
DO_LIB                 ap_dbclc(DNAME dakt3,DCOMMAND ADD,DFILE akt,DMAP maddakt);
DO_LIB_IF cbkunci      ap_dbclc(DNAME daddkunc3,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lkunci l643,DMAP mkunci3a);
DO_LIB_IF cbkunci2     ap_dbclc(DNAME dupdkunc3b,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lkunci l643,DMAP mkunci3);

HOOKS(tmptranst)
AFTER_INPUT     cur_keybd=EN            DO_MAP SHOW mapra3
AFTER_INPUT     cur_keybd=EN            DO_SPCALCS supdabk3
BEFORE_INPUT    cur_field=sviyt1        DO_SKIP_IF cbknCA   
BEFORE_INPUT    cur_field=sviket        DO_SKIP_IF cbknCA   
BEFORE_INPUT    cur_field=sviyt2        DO_SKIP_IF cbknCR   
BEFORE_INPUT    cur_field=sviket2       DO_SKIP_IF cbknCR   
BEFORE_INPUT    cur_field=svistr31      DO_SKIP_IF cbknDCOO 
BEFORE_INPUT    cur_field=sviket3       DO_SKIP_IF cbknDCOO 
AFTER_INPUT     cur_field=sviket        DO_MAP SHOW mlenket
AFTER_INPUT     cur_field=sviket        DO_MAP
                IF cisiket mdum
                ELSE HKCURSOR STAY
                HKMSG isi 20 karakter

AFTER_INPUT     cur_field=sviket2       DO_MAP SHOW mlenket
AFTER_INPUT     cur_field=sviket2       DO_MAP
                IF cisiket2 mdum
                ELSE HKCURSOR STAY
                HKMSG isi 20 karakter

AFTER_INPUT     cur_field=sviket3       DO_MAP SHOW mlenket
AFTER_INPUT     cur_field=sviket3       DO_MAP
                IF cisiket3 mdum
                ELSE HKCURSOR STAY
                HKMSG isi 20 karakter


