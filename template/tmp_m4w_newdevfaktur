IMAGE(tmptrans)

FIELDS(tmptranst)
        svists          PROTECT                   INPUTRI 1
        svistr5         PROTECT                   INPUTRI 1
        svikode         NOCHANGE QPROTECT UNSEEN  INPUTRI 1
        lketisil        TEXTAREA 2 ALLCAPS         INPUTRI 2
        lketisi2l       TEXTAREA 2 ALLCAPS         INPUTRI 2
        svistr1         NOCHANGE                  INPUTRI 3
        svitgl1         PROTECT {DD-MM-YYYY}      INPUTRI 4
        svinobuk        PROTECT UNSEEN            INPUTRI 5
        svitblkode      PROTECT UNSEEN            INPUTRI 5
        lupld12         TOMBOL                    INPUTRI 1
        svistr33        ALLCAPS                   INPUTRI 6
        svistr7         TEXTAREA 2 ALLCAPS        INPUTRI 20
        lketisi2        NOCHANGE                  INPUTRI 21

EDITS(tmptranst)
e.stsbukan707     svikode         VALIDATE ftmdatbukidx mftm12b sftm6 {PlMULTI4W}
e.isiket          lketisil        MANDATORY
e.ket             svitblkode      VALIDATE ketdatbukkod mket12  0     {Psvidata} {Psvinobuk}
e.isiaccrm        svistr33        MANDATORY_IF cinpgd
e.isiket          svistr7         MANDATORY_IF crmT


DEFAULTS(tmptranst)
svistr33           DFALT_SCAN_BLANKS Y T


MAP(mket12)
lketisil         ketisi            REPLACE_IF cadaket1b
cBLANKS         lketisil           DO_CALC
ketisi          lketisil           REPLACE
lketisi2l        ketisi2            REPLACE_IF cadaket1b
cBLANKS         lketisi2l           DO_CALC
ketisi2         lketisi2l          REPLACE

MAP(mftm12b)
ftmnofak        svikode         REPLACE

MAP(maddket12)
svinobuk        ketnobuk          REPLACE
svidata         ketdata           REPLACE
svitype         ketkode           REPLACE
lketisil         ketisi            REPLACE_IF cadaket0
lketisi2l        ketisi2           REPLACE_IF cadaket0

MAP(mupdsvi12)
lketisil        ketisi            REPLACE_IF cadaket1b
cBLANKS         lketisil          DO_CALC
ketisi          lketisil          REPLACE
lketisi2l       ketisi2            REPLACE_IF cadaket1b
cBLANKS         lketisi2l          DO_CALC
ketisi2         lketisi2l          REPLACE

MAP(mupload12)
g_tgltrn        svitgl1         REPLACE_IF cuplok
cOK             svistr1         DO_CALC_IF cuplok



MAP(mupdsviftmandx12)
cIN             svistr1         DO_CALC_IF cksong2
g_tgltrn        svitgl1         REPLACE
gv_INPG         svists          REPLACE_IF cinpg

DBCALCS(dbftupl12)
        DCOMMAND UPDATE
        DTARGET sviprmidx sviprm
        DMAP mupdsviftmandx12

MAP(mapr12)
gv_OPEN         svists          REPLACE_IF cksong
cOKRM           svistr34        DO_CALC_IF crmok
ctKRM           svistr34        DO_CALC_IF crmT
gv_TACC         svists          REPLACE_IF crmT


MAP(mmapmap12a)
ldum            ldum              REPLACE
svinourt        lurt              REPLACE
ckuncidev1      lkunci2           DO_CALC

MAP(mkuncirm12)
gv_CLSD         abksts            REPLACE_IF cnipsama

MAP(mkuncirm212)
gv_CLSD         abksts            REPLACE




SPCALCS(saddket12)
DO_LIB                 ap_dbclc(DNAME dmapmap12a,DCOMMAND MAPMAP,DMAP mmapmap12a);
DO_LIB_IF cadaket0     ap_dbclc(DNAME dket12,DCOMMAND ADD,DFILE ket,DMAP maddket12);
DO_LIB_IF cadaket1     ap_dbclc(DNAME dupdsvi12,DCOMMAND UPDATE,DTARGET ketdatbukkod svidata svinobuk svitblkode,DMAP mupdsvi12);

SPCALCS(sdelket12)
DO_LIB_IF cadaket1     ap_dbclc(DNAME ddelket12,DCOMMAND DELETE,DTARGET ketdatbukkod svidata svinobuk svitblkode);

SPCALCS(suploadd12)
DO_LIB                 ap_dbclc(DNAME dmapupl12,DCOMMAND MAPMAP,DMAP mmapmap12a);
DO_LIB_IF crm          ap_dbclc(DNAME ddevb12,DCOMMAND ADD,DFILE abk,DMAP madddevrm);
DO_LIB                 ap_dbclc(DNAME dupload12d,DCOMMAND UPDATE,DTARGET sviprmidx sviprm,DMAP mupload12);

SPCALCS(sbkkunci12)
DO_LIB                 ap_dbclc(DNAME dmapmaprm12,DCOMMAND MAPMAP,DMAP mmapmap1a);
DO_LIB_IF crmok2       ap_dbclc(DNAME dupdrmok12,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lkunci2 l643,DMAP mkuncirm12);
DO_LIB_IF crmT2        ap_dbclc(DNAME dupdrmT12,DCOMMAND UPDATE_RANGE,DTARGET abkdatstsky2 lkunciabsen gv_INPG lkunci2 l643,DMAP mkuncirm212);
DO_LIB_IF cdvh         ap_dbclc(DNAME ddevd12,DCOMMAND ADD,DFILE abk,DMAP madddevdvh);



HOOKS(tmptranst)
CLICKED         cur_field=lupld12       DO_SPCALCS suploadd12
AFTER_INPUT     cur_keybd=EN     DO_MAP SHOW mapr12
AFTER_INPUT     cur_keybd=EN            DO_SPCALCS sbkkunci12
AFTER_INPUT     cur_field=lketisil       DO_MAP SHOW mketcab
AFTER_INPUT     cur_field=lketisil        DO_MAP
                IF ccabisil mdum
                ELSE HKCURSOR STAY
                HKMSG harus 200 karabker
BEFORE_INPUT    cur_field=svistr33      DO_SKIP_IF copend
BEFORE_INPUT    cur_field=svistr7       DO_SKIP_IF copend
BEFORE_INPUT    cur_field=lketisil      DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=lketisi2l     DO_SKIP_IF cinpgd
BEFORE_INPUT    cur_field=svistr1       DO_SKIP_IF cinpgd



