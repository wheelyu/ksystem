IMAGE(tmptrans)

FIELDS(tmptranst)
tldnourt	PROTECT			INPUTRI		1
tldnobbm     	QRCODE        		INPUTRI		2
lketfotobpkb    PROTECT SCROLL  INPUTRI         3
luploadok2       TOMBOL          INPUTRI        4 
tldsisbrg      PROTECT         INPUTRI         5
tldtgl2         PROTECT {DD-MM-YYYY}    INPUTRI 6
tldjml          PROTECT         INPUTRI         7
tldhrg          PROTECT         INPUTRI         8

DEFAULTS(tmptranst)
tldtglfak	INIT_ADD	{g_tgltrn}
tldplg          INIT_ADD        {g_usrkode}

EDITS(tmptranst)
e.Mandatory 	tldnobbm	MANDATORY
e.Dupkey        tldnobbm        DUPKEY          tldbukbbmidx {Ptlmnobuk} {Stlmcab} {Stlddvs}

CALCS()
cfotook2         tldsisbrg=="IN" && tldtgl2==g_tgltrn && tldjml!=BLANKS && tldhrg!=BLANKS
cfotoin2         tldsisbrg=="IN"


MAP(mupdfoto3xx)
g_fotodate1     tldtgl2          REPLACE
g_fotolat1      tldjml          REPLACE
g_fotolon1      tldhrg          REPLACE
cOK             tldsisbrg      DO_CALC_IF cfotook2

MAP(mupdfoto3x)
cIN             tldsisbrg      DO_CALC

DBCALCS(dupdfoto3x)
DBC_COMMAND     UPDATE
DBC_TARGET      tldotoidx tldoto
DBC_MAP         mupdfoto3x

SPCALCS(suploadok3)
DO_LIB_IF cfotoin2 ap_dbclc(DNAME dupdfoto3xx,DCOMMAND UPDATE,DTARGET tldotoidx tldoto,DMAP mupdfoto3xx);

HOOKS(tmptranst)
BEFORE_INPUT	cur_field=tldnobbm	DO_MAP SHOW murtd
CLICKED         cur_field=luploadok2     DO_SPCALCS suploadok3

SUBFILE(tmptrans)
SFL_TITLE(tmptranst)
SFL_LINES(1)
SFL_COND	cbpkbm4w
SFL_SELECT      cbknSISTEMd
SFL_UPL_DIRFLD tlmtgl
SFL_UPLFLD tldnobuk tldnobbm
SFL_UPLFLD_DBCALCS dupdfoto3x
SFL_UPL_DELCOND cnodel
SFL_TARGET
tldbukurtidx    tlmnobuk   

SFL_MAP
tlmnobuk        tldnobuk        REPLACE
tlmdata         tlddata         REPLACE
tlmcab          tldcab          REPLACE
tlmtype1        tldgrup         REPLACE
g_lat         	tldperdis4      REPLACE
g_lon         	tldperdis5      REPLACE

SPCALCS(sptrans2addcx)
DO_LIB		ap_dbclc(DNAME dupdtlmaddcx, DCOMMAND UPDATE, DTARGET tlmbukidx tldnobuk, DMAP mupdtlmaddc);

SPCALCS(sptrans2updcx)
DO_LIB		ap_dbclc(DNAME dupdtlmupdcx, DCOMMAND UPDATE, DTARGET tlmbukidx tldnobuk, DMAP mupdtlmupdc);

POSTING(tmptrans)
	PST_ADDCMD	sptrans2addcx
	PST_DELCMD	sptrans2updcx

