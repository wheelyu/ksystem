cppn_net        ((nhmhrgoff - (lhpp_ready * (1 + (stsperppn/100))) - nhmtotdis) / (1 + (stsperppn/100)) * (stsperppn/100))
cppn_net2       ((nhmhrgoff - (lhpp_indent * (1 + (stsperppn/100))) - nhmtotdis) / (1 + (stsperppn/100)) * (stsperppn/100))
cuntungT        (nhmhrgoff + nhmbbnjl) - nhmtotdis - nhmbiamklr - nhmextup - nhmbbnhpp - lhpp_ready - ((lhpp_ready * stsperppn)/100) - nhmestimasi - lppn_net
