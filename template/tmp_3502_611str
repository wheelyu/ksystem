cuntungK        (nhmhrgoff + nhmbbnjl) - nhmtotdis - nhmbbnhpp - lhpp_ready - ((lhpp_ready * stsperppn)/100) - ljmlppsvcrsubs - lppn_net
cuntungK2       (nhmhrgoff + nhmbbnjl) - nhmtotdis - nhmbbnhpp - lhpp_indent - ((lhpp_indent * stsperppn)/100) - ljmlppsvcrsubs - lppn_net
