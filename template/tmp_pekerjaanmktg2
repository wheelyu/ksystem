	btpdatbuktgl gv_historisdm btmnobuk lkerjamktg

SFL_MAP
btmnobuk		btpnobuk	REPLACE
g_tgltrn		btptgltrn	REPLACE
btmscr			btpscr		REPLACE
lkerjamktg    		btptype		REPLACE
gv_historisdm		btpdata		REPLACE

MAP(mupdnhmgarap)
btpnobuk2		nhmgrup		REPLACE

MAP(mupdnhmgarapD)
cgarapksg		nhmgrup		DO_CALC

MAP(mupdbtmMGA)
lSubKerja		btmtypdeb	REPLACE

SPCALCS(spgarap_add)
DO_LIB_IF cselainmga ap_dbclc (DNAME dupdnhmgarapA,DCOMMAND UPDATE,DTARGET nhmdatbukidx gv_bukutamu btpnobuk,DMAP mupdnhmgarap);
DO_LIB_IF cjikamga ap_dbclc (DNAME dupdbtmMGA,DCOMMAND UPDATE,DTARGET btmbukidx btpnobuk,DMAP mupdbtmMGA);

SPCALCS(spgarap_upd)
DO_LIB_IF cselainmga ap_dbclc (DNAME dupdnhmgarapU,DCOMMAND UPDATE,DTARGET nhmdatbukidx gv_bukutamu btpnobuk,DMAP mupdnhmgarap);
DO_LIB_IF cjikamga ap_dbclc (DNAME dupdbtmMGAU,DCOMMAND UPDATE,DTARGET btmbukidx btpnobuk,DMAP mupdbtmMGA);

SPCALCS(spgarap_del)
DO_LIB ap_dbclc(DNAME dupdnhmgarapD,DCOMMAND UPDATE,DTARGET nhmdatbukidx gv_bukutamu btpnobuk,DMAP mupdnhmgarapD);

POSTING(tmptrans)
	PST_ADDCMD spgarap_add
	PST_UPDCMD spgarap_upd
	PST_DELCMD spgarap_del


