BEFORE_INPUT    cur_field=svinama       DO_SKIP_IF cskipsvinama
BEFORE_INPUT	cur_field=svistr31	DO_SKIP_IF cskipsvistr31
BEFORE_INPUT    cur_field=sviyt1        DO_SKIP_IF cskipsviyt1
BEFORE_INPUT	cur_field=svistr1	DO_SKIP_IF cskipsvistr1
AFTER_INPUT	cur_field=svistr31	DO_MAP SHOW mnipIR

