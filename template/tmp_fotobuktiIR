CALCS()
cjoinchdnourt1a         g_curcmd == 1 && djoinsvinourt1a == 0
cjoinchdnourt2a         g_curcmd == 1 && djoinsvinourt1a == 1
c1e			1
cnourta			lnourt1a + 1
ctmbh			g_curcmd == 1
cskipsviyt1		(g_curcmd == 1 || g_curcmd == 2 || sviyt2 == "OK") && tlmgrup2 != g_usrkode && g_usrkode != "1832688" && g_grpnam != "RI" && g_grpnam != "IT"
cskipsvistr31		g_curcmd == 1 || sviyt2 == "" || (tlmgrup2 != g_usrkode && g_usrkode != "1832688" && g_grpnam != "RI" && g_grpnam != "IT")
cskipsvistr1		g_curcmd == 1 || (g_curcmd == 2 && (g_grpnam != "RI" && g_grpnam != "IT")) || (g_grpnam != "RI" && g_grpnam != "IT")
cskipsvinama	 	(tlmgrup2 != g_usrkode && g_usrkode != "1832688" && g_grpnam != "RI" && g_grpnam != "IT")
