	ftm.ftmprm,
    ftm.ftmnobuk1,
    ftm.ftmnama1,
    ftm.ftmnama3,
    ftm.ftmno2,
    ftm.ftmtgl1,
    ftm.ftmtgl2,
    ftm.ftmtgl3,
    ftm.ftmsts1,
    ftm.ftmkode1,
    ftm.ftmkode2,
    ftm.ftmnama2,
    ftm.ftmnama4,
    ftm.ftmalamat1,
    ftm.ftmsup,
    ftm.ftmkode3,
    ftm.ftmkode4,
    ftm.ftmkode5,
    ftm.ftmkode6,
    ftm.ftmtype,
    ftm.ftmkode7,
    ftm.ftmkode8,
    ftm.ftmnobuk2,
    ftm.ftmyt1,
    ftm.ftmnobuk3,
    ftm.ftmyt2,
    ftm.ftmnobuk4,
    ftm.ftmket1,
    ftm.ftmket2,
    ftm.ftmket3,
    ftm.ftmket4,
    ftm.ftmlok,
   	ftm.ftmplg,
    psi.psinama,
    psi.psikode,
    psi.psijabatan,
    psi2.psinama AS psinama2,

	CASE
		WHEN (ftm.ftmsts1 LIKE "Out" AND ftm.ftmtype = "T") THEN "1"
		ELSE "0"
	END AS FU,
    
    CASE
		WHEN (ftm.ftmlok = "BLAST") THEN "1"
		ELSE "0"
	END AS BLAST,

    CASE
        WHEN (ftm.ftmsts1 LIKE "Out" AND ftm.ftmtype = "T")
        OR (ftm.ftmlok = "BLAST") THEN "1"
        ELSE "0"
    END AS FUBLAST,

	CASE
        WHEN (ftm.ftmsts1 = "In" AND ftm.ftmalamat1 NOT LIKE "%Minat%" AND ftm.ftmtype = "T") OR
        (ftm.ftmsts1 = "In" AND ftm.ftmalamat1 LIKE "%Minat%" AND ftm.ftmtype = "Y")
        THEN "1"
        ELSE "0"
    END AS RSPNall,
    
	CASE
        WHEN ((ftm.ftmsts1 = "In" AND ftm.ftmalamat1 NOT LIKE "%Minat%" AND ftm.ftmtype = "T") OR
        (ftm.ftmsts1 = "In" AND ftm.ftmalamat1 LIKE "%Minat%" AND ftm.ftmtype = "Y"))
            AND (ftm.ftmalamat1 LIKE '%akan membalas%'
            OR ftm.ftmalamat1 LIKE '%chat otomatis%'
            OR ftm.ftmalamat1 LIKE '%Hai, Follow yah%'
            OR ftm.ftmalamat1 LIKE '%Jam Operasional%'
            OR ftm.ftmalamat1 LIKE '%Jawab Otomatis%'
            OR ftm.ftmalamat1 LIKE '%kami akan melayani%'
            OR ftm.ftmalamat1 LIKE '%pesan otomatis%'
            OR ftm.ftmalamat1 LIKE '%Selamat datang%'
            OR ftm.ftmalamat1 LIKE '%Silakan beri tahu apa yang dapat kami bantu%'
            OR ftm.ftmalamat1 LIKE '%Terima kasih atas pesan%'
            OR ftm.ftmalamat1 LIKE '%Terima kasih sudah menghubungi%'
            OR ftm.ftmalamat1 LIKE '%Terima kasih telah menghubungi%'
            OR ftm.ftmalamat1 LIKE '%Terima kasih telah mengubungi%'
            OR ftm.ftmalamat1 LIKE '%terima kasih udah chat%'
            OR ftm.ftmalamat1 LIKE '%Terimakasih sudah menghubungi%'
            OR ftm.ftmalamat1 LIKE '%Terimakasih telah menghubungi%'
            OR ftm.ftmalamat1 LIKE '%Untuk pelanggan%')
		THEN "1"
        ELSE "0"
    END AS RSPNar,

	CASE
        WHEN ((ftm.ftmsts1 = "In" AND ftm.ftmalamat1 NOT LIKE "%Minat%" AND ftm.ftmtype = "T") OR
        (ftm.ftmsts1 = "In" AND ftm.ftmalamat1 LIKE "%Minat%" AND ftm.ftmtype = "Y"))
            AND (ftm.ftmalamat1 NOT LIKE '%akan membalas%'
            OR ftm.ftmalamat1 NOT LIKE '%chat otomatis%'
            OR ftm.ftmalamat1 NOT LIKE '%Hai, Follow yah%'
            OR ftm.ftmalamat1 NOT LIKE '%Jam Operasional%'
            OR ftm.ftmalamat1 NOT LIKE '%Jawab Otomatis%'
            OR ftm.ftmalamat1 NOT LIKE '%kami akan melayani%'
            OR ftm.ftmalamat1 NOT LIKE '%pesan otomatis%'
            OR ftm.ftmalamat1 NOT LIKE '%Selamat datang%'
            OR ftm.ftmalamat1 NOT LIKE '%Silakan beri tahu apa yang dapat kami bantu%'
            OR ftm.ftmalamat1 NOT LIKE '%Terima kasih atas pesan%'
            OR ftm.ftmalamat1 NOT LIKE '%Terima kasih sudah menghubungi%'
            OR ftm.ftmalamat1 NOT LIKE '%Terima kasih telah menghubungi%'
            OR ftm.ftmalamat1 NOT LIKE '%Terima kasih telah mengubungi%'
            OR ftm.ftmalamat1 NOT LIKE '%terima kasih udah chat%'
            OR ftm.ftmalamat1 NOT LIKE '%Terimakasih sudah menghubungi%'
            OR ftm.ftmalamat1 NOT LIKE '%Terimakasih telah menghubungi%'
            OR ftm.ftmalamat1 NOT LIKE '%Untuk pelanggan%')
		THEN "1"
        ELSE "0"
    END AS RSPNnar,
    
	CASE
	WHEN (ftm.ftmsts1 LIKE "Out" AND ftm.ftmtype = "T" AND ftm.ftmkode1 = "Terkirim") OR
	(ftm.ftmlok = "BLAST" AND ftm.ftmkode1 = "Terkirim")
        THEN "1"
        ELSE "0"
	END AS RSPNterkirim,
	
	CASE
	WHEN (ftm.ftmsts1 LIKE "Out" AND ftm.ftmtype = "T" AND ftm.ftmkode1 = "Diterima") OR
	(ftm.ftmlok = "BLAST" AND ftm.ftmkode1 = "Diterima")
        THEN "1"
        ELSE "0"
	END AS RSPNditerima,

	CASE
	WHEN (ftm.ftmsts1 LIKE "Out" AND ftm.ftmtype = "T" AND ftm.ftmkode1 = "Dibaca") OR
	(ftm.ftmlok = "BLAST" AND ftm.ftmkode1 = "Dibaca")
        THEN "1"
        ELSE "0"
	END AS RSPNdibaca,

	CASE
	WHEN (ftm.ftmsts1 LIKE "Out" AND ftm.ftmtype = "T" AND ftm.ftmkode1 = "Error") OR
	(ftm.ftmlok = "BLAST" AND ftm.ftmkode1 = "Error")
        THEN "1"
        ELSE "0"
	END AS RSPNerror,
	
	CASE
    	WHEN (ftm.ftmsts1 = "In" AND ftm.ftmalamat1 NOT LIKE "%Minat%" AND ftm.ftmtype = "T") THEN "1"
    	ELSE "0"
	END AS RSPNfu,

	CASE
        WHEN (ftm.ftmsts1 = "In" AND ftm.ftmalamat1 NOT LIKE "%Minat%" AND ftm.ftmtype = "T")
            AND (ftm.ftmalamat1 LIKE '%akan membalas%'
            OR ftm.ftmalamat1 LIKE '%chat otomatis%'
            OR ftm.ftmalamat1 LIKE '%Hai, Follow yah%'
            OR ftm.ftmalamat1 LIKE '%Jam Operasional%'
            OR ftm.ftmalamat1 LIKE '%Jawab Otomatis%'
            OR ftm.ftmalamat1 LIKE '%kami akan melayani%'
            OR ftm.ftmalamat1 LIKE '%pesan otomatis%'
            OR ftm.ftmalamat1 LIKE '%Selamat datang%'
            OR ftm.ftmalamat1 LIKE '%Silakan beri tahu apa yang dapat kami bantu%'
            OR ftm.ftmalamat1 LIKE '%Terima kasih atas pesan%'
            OR ftm.ftmalamat1 LIKE '%Terima kasih sudah menghubungi%'
            OR ftm.ftmalamat1 LIKE '%Terima kasih telah menghubungi%'
            OR ftm.ftmalamat1 LIKE '%Terima kasih telah mengubungi%'
            OR ftm.ftmalamat1 LIKE '%terima kasih udah chat%'
            OR ftm.ftmalamat1 LIKE '%Terimakasih sudah menghubungi%'
            OR ftm.ftmalamat1 LIKE '%Terimakasih telah menghubungi%'
            OR ftm.ftmalamat1 LIKE '%Untuk pelanggan%')
		THEN "1"
        ELSE "0"
    END AS RSPNarfu,

    CASE
        WHEN (ftm.ftmsts1 = "In" AND ftm.ftmalamat1 NOT LIKE "%Minat%" AND ftm.ftmtype = "T")
            AND (ftm.ftmalamat1 NOT LIKE '%akan membalas%'
            OR ftm.ftmalamat1 NOT LIKE '%chat otomatis%'
            OR ftm.ftmalamat1 NOT LIKE '%Hai, Follow yah%'
            OR ftm.ftmalamat1 NOT LIKE '%Jam Operasional%'
            OR ftm.ftmalamat1 NOT LIKE '%Jawab Otomatis%'
            OR ftm.ftmalamat1 NOT LIKE '%kami akan melayani%'
            OR ftm.ftmalamat1 NOT LIKE '%pesan otomatis%'
            OR ftm.ftmalamat1 NOT LIKE '%Selamat datang%'
            OR ftm.ftmalamat1 NOT LIKE '%Silakan beri tahu apa yang dapat kami bantu%'
            OR ftm.ftmalamat1 NOT LIKE '%Terima kasih atas pesan%'
            OR ftm.ftmalamat1 NOT LIKE '%Terima kasih sudah menghubungi%'
            OR ftm.ftmalamat1 NOT LIKE '%Terima kasih telah menghubungi%'
            OR ftm.ftmalamat1 NOT LIKE '%Terima kasih telah mengubungi%'
            OR ftm.ftmalamat1 NOT LIKE '%terima kasih udah chat%'
            OR ftm.ftmalamat1 NOT LIKE '%Terimakasih sudah menghubungi%'
            OR ftm.ftmalamat1 NOT LIKE '%Terimakasih telah menghubungi%'
            OR ftm.ftmalamat1 NOT LIKE '%Untuk pelanggan%')
        THEN '1'
        ELSE '0'
    END AS RSPNnarfu,
    
	CASE
		WHEN ftm.ftmsts1 = "Out" AND ftm.ftmtype = "T" AND ftm.ftmkode1 = "Terkirim" 
        THEN "1"
        ELSE "0"
	END AS RSPNfuterkirim,
	
	CASE
        WHEN ftm.ftmsts1 = "Out" AND ftm.ftmtype = "T" AND ftm.ftmkode1 = "Diterima" 
        THEN "1"
        ELSE "0"
	END AS RSPNfuditerima,

	CASE
        WHEN ftm.ftmsts1 = "Out" AND ftm.ftmtype = "T" AND ftm.ftmkode1 = "Dibaca"  
        THEN "1"
        ELSE "0"
	END AS RSPNfudibaca,

	CASE
        WHEN ftm.ftmsts1 = "Out" AND ftm.ftmtype = "T" AND ftm.ftmkode1 = "Error" 
        THEN "1"
        ELSE "0"
	END AS RSPNfuerror,
	
	CASE
    	WHEN (ftm.ftmsts1 = "In" AND ftm.ftmalamat1 LIKE "%Minat%" AND ftm.ftmtype = "Y")
        THEN "1"
    	ELSE "0"
	END AS RSPNblast,

	CASE
        WHEN (ftm.ftmsts1 = "In" AND ftm.ftmalamat1 LIKE "%Minat%" AND ftm.ftmtype = "Y")
            AND (ftm.ftmalamat1 LIKE '%akan membalas%'
            OR ftm.ftmalamat1 LIKE '%chat otomatis%'
            OR ftm.ftmalamat1 LIKE '%Hai, Follow yah%'
            OR ftm.ftmalamat1 LIKE '%Jam Operasional%'
            OR ftm.ftmalamat1 LIKE '%Jawab Otomatis%'
            OR ftm.ftmalamat1 LIKE '%kami akan melayani%'
            OR ftm.ftmalamat1 LIKE '%pesan otomatis%'
            OR ftm.ftmalamat1 LIKE '%Selamat datang%'
            OR ftm.ftmalamat1 LIKE '%Silakan beri tahu apa yang dapat kami bantu%'
            OR ftm.ftmalamat1 LIKE '%Terima kasih atas pesan%'
            OR ftm.ftmalamat1 LIKE '%Terima kasih sudah menghubungi%'
            OR ftm.ftmalamat1 LIKE '%Terima kasih telah menghubungi%'
            OR ftm.ftmalamat1 LIKE '%Terima kasih telah mengubungi%'
            OR ftm.ftmalamat1 LIKE '%terima kasih udah chat%'
            OR ftm.ftmalamat1 LIKE '%Terimakasih sudah menghubungi%'
            OR ftm.ftmalamat1 LIKE '%Terimakasih telah menghubungi%'
            OR ftm.ftmalamat1 LIKE '%Untuk pelanggan%')
		THEN "1"
        ELSE "0"
    END AS RSPNarblast,

    CASE
        WHEN (ftm.ftmsts1 = "In" AND ftm.ftmalamat1 LIKE "%Minat%" AND ftm.ftmtype = "Y")
            AND (ftm.ftmalamat1 NOT LIKE '%akan membalas%'
            OR ftm.ftmalamat1 NOT LIKE '%chat otomatis%'
            OR ftm.ftmalamat1 NOT LIKE '%Hai, Follow yah%'
            OR ftm.ftmalamat1 NOT LIKE '%Jam Operasional%'
            OR ftm.ftmalamat1 NOT LIKE '%Jawab Otomatis%'
            OR ftm.ftmalamat1 NOT LIKE '%kami akan melayani%'
            OR ftm.ftmalamat1 NOT LIKE '%pesan otomatis%'
            OR ftm.ftmalamat1 NOT LIKE '%Selamat datang%'
            OR ftm.ftmalamat1 NOT LIKE '%Silakan beri tahu apa yang dapat kami bantu%'
            OR ftm.ftmalamat1 NOT LIKE '%Terima kasih atas pesan%'
            OR ftm.ftmalamat1 NOT LIKE '%Terima kasih sudah menghubungi%'
            OR ftm.ftmalamat1 NOT LIKE '%Terima kasih telah menghubungi%'
            OR ftm.ftmalamat1 NOT LIKE '%Terima kasih telah mengubungi%'
            OR ftm.ftmalamat1 NOT LIKE '%terima kasih udah chat%'
            OR ftm.ftmalamat1 NOT LIKE '%Terimakasih sudah menghubungi%'
            OR ftm.ftmalamat1 NOT LIKE '%Terimakasih telah menghubungi%'
            OR ftm.ftmalamat1 NOT LIKE '%Untuk pelanggan%')
        THEN '1'
        ELSE '0'
    END AS RSPNnarblast,
    
	CASE
		WHEN ftm.ftmlok = "BLAST" AND ftm.ftmkode1 = "Terkirim"
        THEN "1"
        ELSE "0"
	END AS RSPNblastterkirim,
	
	CASE
		WHEN ftm.ftmlok = "BLAST" AND ftm.ftmkode1 = "Diterima"
        THEN "1"
        ELSE "0"
	END AS RSPNblastditerima,

	CASE
		WHEN ftm.ftmlok = "BLAST" AND ftm.ftmkode1 = "Dibaca"
        THEN "1"
        ELSE "0"
	END AS RSPNblastdibaca,

	CASE
		WHEN ftm.ftmlok = "BLAST" AND ftm.ftmkode1 = "Error"
        THEN "1"
        ELSE "0"
	END AS RSPNblasterror,
	
    CASE
        WHEN 
        	(ftm.ftmnama3 = alm.almnama2 AND ftm.ftmno1 = ppm.ppmthbl)
        THEN '1'
        ELSE '0'
    END AS DataJL,

    CASE
        WHEN ppm.ppmsts IN ('OPEN', 'INPG', 'CLSD')
             AND ppm.ppmthbl = ftm.ftmno1
        THEN ppm.ppmtotfak
        ELSE 0
    END AS DataJLRP   
    
FROM ftm
LEFT JOIN tkd FORCE INDEX (tkddatbukll) ON tkd.tkddata = "CHATIKLAN" AND tkd.tkdnobuk = ftm.ftmnofak AND tkd.tkdnoll = ftm.ftmnama3
LEFT JOIN psi ON psi.psikode = tkd.tkdtype
LEFT JOIN psi AS psi2 ON psi2.psikode = ftm.ftmkode8
LEFT JOIN tld ON tld.tldnoll = ftm.ftmnama3
LEFT JOIN alm ON alm.almdata = 'ALAMATKIRI' AND alm.almnama2 = ftm.ftmnama3
LEFT JOIN ppm ON ppm.ppmdata = 'DTPIU' AND alm.almnobuk = ppm.ppmnobuk

WHERE ftm.ftmdata = 'CHATIKLAN' AND (ftm.ftmtgl1 >= ? AND ftm.ftmtgl1 <= ?) AND ftm.ftmplg = ?
AND ftm.ftmnama3 NOT LIKE "tokopedia:%" AND ftm.ftmnama3 NOT LIKE "+status@%"
AND ftm.ftmnama3 IN (
    SELECT pengirim.ftmnama3
    FROM ftm AS pengirim
    WHERE pengirim.ftmdata = 'CHATIKLAN' AND ftm.ftmnama3 NOT LIKE "%@g.us%"
    GROUP BY pengirim.ftmnama3
    HAVING COUNT(DISTINCT pengirim.ftmkode8) = 1)

]]></xml-property>
