                    <property name="nativeName">TotalSdJdUETdkAktifRing2</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">28</property>
                    <property name="name">TotalBlmJdUETdkAktif</property>
                    <property name="nativeName">TotalBlmJdUETdkAktif</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">29</property>
                    <property name="name">TotalBlmJdUETdkAktifRing1</property>
                    <property name="nativeName">TotalBlmJdUETdkAktifRing1</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">30</property>
                    <property name="name">TotalBlmJdUETdkAktifRing2</property>
                    <property name="nativeName">TotalBlmJdUETdkAktifRing2</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">31</property>
                    <property name="name">TotalSdJdUEBdk</property>
                    <property name="nativeName">TotalSdJdUEBdk</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">32</property>
                    <property name="name">TotalSdJdUEBdkRing1</property>
                    <property name="nativeName">TotalSdJdUEBdkRing1</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">33</property>
                    <property name="name">TotalSdJdUEBdkRing2</property>
                    <property name="nativeName">TotalSdJdUEBdkRing2</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">34</property>
                    <property name="name">TotalBlmJdUEBdk</property>
                    <property name="nativeName">TotalBlmJdUEBdk</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">35</property>
                    <property name="name">TotalBlmJdUEBdkRing1</property>
                    <property name="nativeName">TotalBlmJdUEBdkRing1</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">36</property>
                    <property name="name">TotalBlmJdUEBdkRing2</property>
                    <property name="nativeName">TotalBlmJdUEBdkRing2</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select 	cab.cabkode as sct16482p2s6rptdesign,
		cab.cabkode as Cabang,
		cab.cabnama as NamaCabang,
		sgmspv.sgmstr5 as NipSPV,
		psispv.psinama as NamaSPV,
	
	count(distinct(tlm.tlmnobuk)) as UEDrBhn,

	count(distinct CASE WHEN tlm.tlmperdisd = 1 then tlm.tlmnobuk
	ELSE null
	end ) as Total,

	count(distinct CASE WHEN tlm.tlmperdisd = 1 and tlm.tlmtotppn = 1 THEN tlm.tlmnobuk
 	ELSE null 
 	END ) as Ring1,

	count(distinct CASE WHEN tlm.tlmperdisd = 1 and tlm.tlmtotppn = 2 THEN tlm.tlmnobuk
 	ELSE null
 	END ) as Ring2,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1
	and (tlm.tlmsts2 = '620' or tlm.tlmsts2 = '623')
	and tlm.tlmsts = 'CLSD' THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalJdUE,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1
	and (tlm.tlmsts2 = '620' or tlm.tlmsts2 = '623')
	and tlm.tlmsts = 'CLSD' and tlm.tlmtotppn = 1 THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalJdUERing1,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1
	and (tlm.tlmsts2 = '620' or tlm.tlmsts2 = '623')
	and tlm.tlmsts = 'CLSD' and tlm.tlmtotppn = 2 THEN tlm.tlmnobuk
 	ELSE null
	END ) as TotalJdUERing2,

	count(distinct CASE WHEN tlm.tlmperdisd = 1
	and (tlm.tlmsts2 = '620' or tlm.tlmsts2 = '623') and tlm.tlmsts = 'CLSD'
	and (tld.tldjasbrg = "1" or tld.tldjasbrg = "2") THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalSdJdUE,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1
	and (tlm.tlmsts2 = '620' or tlm.tlmsts2 = '623') and tlm.tlmsts = 'CLSD'
	and tlm.tlmtotppn = 1 and (tld.tldjasbrg = "1" or tld.tldjasbrg = "2") THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalSdJdUERing1,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1
	and (tlm.tlmsts2 = '620' or tlm.tlmsts2 = '623') and tlm.tlmsts = 'CLSD'
	and tlm.tlmtotppn = 2 and (tld.tldjasbrg = "1" or tld.tldjasbrg = "2") THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalSdJdUERing2,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1 and tlm.tlmsts2 != '620'
	and tlm.tlmsts2 != '623' and tlm.tlmsts = 'CLSD' and tld.tldjasbrg = "1"
	and tld.tldnoll = "MAU_SERVIS" THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalInginService,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1 and tlm.tlmsts2 != '620'
	and tlm.tlmsts2 != '623' and tlm.tlmsts = 'CLSD' and tld.tldjasbrg = "1"
	and tld.tldnoll = "MAU_SERVIS" and tlm.tlmtotppn = 1 THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalInginServiceRing1,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1 and tlm.tlmsts2 != '620'
	and tlm.tlmsts2 != '623' and tlm.tlmsts = 'CLSD' and tld.tldjasbrg = "1"
	and tld.tldnoll = "MAU_SERVIS" and tlm.tlmtotppn = 2 THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalInginServiceRing2,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1 and tlm.tlmsts2 != '620'
	and tlm.tlmsts2 != '623' and tlm.tlmsts = 'CLSD' and tld.tldjasbrg = "1"
	and tld.tldnoll = "TIDAK_MAU_SERVIS" THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalTaboo,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1 and tlm.tlmsts2 != '620'
	and tlm.tlmsts2 != '623' and tlm.tlmsts = 'CLSD' and tld.tldjasbrg = "1"
	and tld.tldnoll = "TIDAK_MAU_SERVIS" and tlm.tlmtotppn = 1 THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalTabooRing1,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1 and tlm.tlmsts2 != '620'
	and tlm.tlmsts2 != '623' and tlm.tlmsts = 'CLSD' and tld.tldjasbrg = "1"
	and tld.tldnoll = "TIDAK_MAU_SERVIS" and tlm.tlmtotppn = 2 THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalTabooRing2,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1 and tlm.tlmsts2 != '620'
	and tlm.tlmsts2 != '623' and tld.tldjasbrg = "2"
	THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalTdkRespon,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1 and tlm.tlmsts2 != '620'
	and tlm.tlmsts2 != '623' and tld.tldjasbrg = "2" and tlm.tlmtotppn = 1
	THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalTdkResponRing1,

	count(distinct CASE WHEN tlm.tlmperdisd = 1 and tlm.tlmsts2 != '620'
	and tlm.tlmsts2 != '623' and tld.tldjasbrg = "2" and tlm.tlmtotppn = 2
	THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalTdkResponRing2,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1
	and (tlm.tlmsts2 = '620' or tlm.tlmsts2 = '623') and tlm.tlmsts = 'CLSD'
	and (tld.tldjasbrg = "3" or tld.tldjasbrg = "4")
	THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalSdJdUETdkAktif,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1
	and (tlm.tlmsts2 = '620' or tlm.tlmsts2 = '623') and tlm.tlmsts = 'CLSD'
	and (tld.tldjasbrg = "3" or tld.tldjasbrg = "4") and tlm.tlmtotppn = 1
	THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalSdJdUETdkAktifRing1,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1
	and (tlm.tlmsts2 = '620' or tlm.tlmsts2 = '623') and tlm.tlmsts = 'CLSD'
	and (tld.tldjasbrg = "3" or tld.tldjasbrg = "4") and tlm.tlmtotppn = 2
	THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalSdJdUETdkAktifRing2,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1
	and (tlm.tlmsts2 = '620' or tlm.tlmsts2 = '623') and tlm.tlmsts = 'INPG'
	and (tld.tldjasbrg = "3" or tld.tldjasbrg = "4")
	THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalBlmJdUETdkAktif,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1
	and (tlm.tlmsts2 = '620' or tlm.tlmsts2 = '623') and tlm.tlmsts = 'INPG'
	and (tld.tldjasbrg = "3" or tld.tldjasbrg = "4") and tlm.tlmtotppn = 1
	THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalBlmJdUETdkAktifRing1,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1
	and (tlm.tlmsts2 = '620' or tlm.tlmsts2 = '623') and tlm.tlmsts = 'INPG'
	and (tld.tldjasbrg = "3" or tld.tldjasbrg = "4") and tlm.tlmtotppn = 2
	THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalBlmJdUETdkAktifRing2,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1 and tlm.tlmsts = 'OPEN'
	and tlm.tlmsts2 = '623'
	THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalSdJdUEBdk,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1 and tlm.tlmsts = 'OPEN'
	and tlm.tlmsts2 = '623' and tlm.tlmtotppn = 1
	THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalSdJdUEBdkRing1,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1 and tlm.tlmsts = 'OPEN'
	and tlm.tlmsts2 = '623' and tlm.tlmtotppn = 2
	THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalSdJdUEBdkRing2,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1 and tlm.tlmsts = 'OPEN'
	and tlm.tlmsts2 = ''
	THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalBlmJdUEBdk,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1 and tlm.tlmsts = 'OPEN'
	and tlm.tlmsts2 = '' and tlm.tlmtotppn = 1
	THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalBlmJdUEBdkRing1,
 
	count(distinct CASE WHEN tlm.tlmperdisd = 1 and tlm.tlmsts = 'OPEN'
	and tlm.tlmsts2 = '' and tlm.tlmtotppn = 2
	THEN tlm.tlmnobuk
 	ELSE null
 	END ) as TotalBlmJdUEBdkRing2

from cab as cab

left join cad as cad force index (caddatkodcab) on
		cad.caddata = "CABBIS" and cad.cadtype = cab.cabkode and cad.cadkode = "H2"
		and cad.cadkdcab = cab.cabkode

left join tlm as tlm force index (tlmdattglidx) on
	tlm.tlmdata = 'DCAHASS' and tlm.tlmtgl >= ? and tlm.tlmtgl <= ?
	and tlm.tlmcab = cab.cabkode

left join tld as tld force index (tldbukurtidx) on
	tld.tldnobuk = tlm.tlmnobuk
	
left join sgm as sgmspv force index (sgmdatplgth) on
	sgmspv.sgmdata = 'DTPICCAB' and sgmspv.sgmplg = 'H2'
	and sgmspv.sgmbrg = cab.cabkode and sgmspv.sgmthbl = ? 
	and sgmspv.sgmtype = 'AHASSSPV'
	
left join psi as psispv force index (psikodidx) on
	psispv.psikode = sgmspv.sgmstr5
	
where cab.cabsts = "INPG"  and cad.cadkode = "H2"

group by sgmspv.sgmstr5]]></xml-property>
        </oda-data-set>
    </data-sets>
