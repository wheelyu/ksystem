            <xml-property name="queryText"><![CDATA[select 	cab.cabkode as sct16482p2s6rptdesign,
		sgmbuh.sgmstr5 as NipBUH, 
		cab.cabkode as Cabang,
		cab.cabnama as NamaCabang,
		psibuh.psinama as NamaBUH,
		sgmhead.sgmstr5 as NipHead,
		psihead.psinama as NamaHead,
		sgmbm.sgmstr5 as NipBM,
		psibm.psinama as NamaBM,
		sgmspv.sgmstr5 as NipSPV,
		psispv.psinama as NamaSPV,
		sgmkabeng.sgmtype as kabengtype,
		sgmsa.sgmtype as satype,
		sgmfd.sgmtype as fdtype,
		
		(CASE WHEN sgmmm.sgmtype = 'MM' then sgmmm.sgmstr5
		WHEN sgmnso.sgmtype = 'NSOHEAD' then sgmnso.sgmstr5
		ELSE null
		end ) as NipMM,
		
		(CASE WHEN sgmmm.sgmtype = 'MM' then psimm.psinama
		WHEN sgmnso.sgmtype = 'NSOHEAD' then psinso.psinama
		ELSE null
		end ) as NamaMM,
		
		(CASE WHEN sgmkabeng.sgmtype = 'AHASSKABENG' then sgmkabeng.sgmstr5
		WHEN sgmsa.sgmtype = "AHASSSA" then sgmsa.sgmstr5
		WHEN sgmfd.sgmtype = "AHASSFD" then sgmfd.sgmstr5
		ELSE null
		end ) as NipPIC,
		
		(CASE WHEN sgmkabeng.sgmtype = 'AHASSKABENG' then psikabeng.psinama
		WHEN sgmsa.sgmtype = "AHASSSA" then psisa.psinama
		WHEN sgmfd.sgmtype = "AHASSFD" then psifd.psinama
		ELSE null
		end ) as NamaPIC,

	count(distinct CASE WHEN (ppm.ppmsts = 'INPG' or ppm.ppmsts = 'CLSD') then ppm.ppmnobuk
	ELSE null
	end ) as UE

from cab as cab

left join cad as cad force index (caddatkodcab) on
		cad.caddata = "CABBIS" and cad.cadtype = cab.cabkode and cad.cadkode = "H2"
		and cad.cadkdcab = cab.cabkode

left join ppm as ppm force index (ppmdtcpostgl) on
	ppm.ppmdata = 'DTPIU' and ppm.ppmcabpos = cab.cabkode
	and ppm.ppmtglkrm >= ? and ppm.ppmtglkrm <= ?
	and ppm.ppmsup = "PKTSERVICEKPB1" and ppm.ppmscr = '623'

left join sgm as sgmhead force index (sgmdatplgth) on
	sgmhead.sgmdata = 'DTPICCAB' and sgmhead.sgmplg = 'H2'
	and sgmhead.sgmbrg = cab.cabkode and sgmhead.sgmthbl = ? 
	and sgmhead.sgmtype = 'AHASSHEAD'

left join sgm as sgmbuh force index (sgmdatplgth) on
	sgmbuh.sgmdata = 'DTPICCAB' and sgmbuh.sgmplg = 'H2'
	and sgmbuh.sgmbrg = cab.cabkode and sgmbuh.sgmthbl = ? 
	and sgmbuh.sgmtype = 'BUH'
	
left join sgm as sgmbm force index (sgmdatplgth) on
	sgmbm.sgmdata = 'DTPICCAB' and sgmbm.sgmplg = 'H2'
	and sgmbm.sgmbrg = cab.cabkode and sgmbm.sgmthbl = ? 
	and sgmbm.sgmtype = 'BM'
	
left join sgm as sgmmm force index (sgmdatplgth) on
	sgmmm.sgmdata = 'DTPICCAB' and sgmmm.sgmplg = 'H2'
	and sgmmm.sgmbrg = cab.cabkode and sgmmm.sgmthbl = ? 
	and sgmmm.sgmtype = 'MM'
	
left join sgm as sgmspv force index (sgmdatplgth) on
	sgmspv.sgmdata = 'DTPICCAB' and sgmspv.sgmplg = 'H2'
	and sgmspv.sgmbrg = cab.cabkode and sgmspv.sgmthbl = ? 
	and sgmspv.sgmtype = 'AHASSSPV'
	
left join sgm as sgmkabeng force index (sgmdatplgth) on
	sgmkabeng.sgmdata = 'DTPICCAB' and sgmkabeng.sgmplg = 'H2'
	and sgmkabeng.sgmbrg = cab.cabkode and sgmkabeng.sgmthbl = ? 
	and sgmkabeng.sgmtype = "AHASSKABENG"
	
left join sgm as sgmsa force index (sgmdatplgth) on
	sgmsa.sgmdata = 'DTPICCAB' and sgmsa.sgmplg = 'H2'
	and sgmsa.sgmbrg = cab.cabkode and sgmsa.sgmthbl = ? 
	and sgmsa.sgmtype = "AHASSSA"

left join sgm as sgmfd force index (sgmdatplgth) on
	sgmfd.sgmdata = 'DTPICCAB' and sgmfd.sgmplg = 'H2'
	and sgmfd.sgmbrg = cab.cabkode and sgmfd.sgmthbl = ? 
	and sgmfd.sgmtype = "AHASSFD"
	
left join sgm as sgmnso force index (sgmdatplgth) on
	sgmnso.sgmdata = 'DTPICCAB' and sgmnso.sgmplg = 'H2'
	and sgmnso.sgmbrg = cab.cabkode and sgmnso.sgmthbl = ? 
	and sgmnso.sgmtype = "NSOHEAD"

left join psi as psibuh force index (psikodidx) on
	psibuh.psikode = sgmbuh.sgmstr5

left join psi as psihead force index (psikodidx) on
	psihead.psikode = sgmhead.sgmstr5

left join psi as psibm force index (psikodidx) on
	psibm.psikode = sgmbm.sgmstr5
	
left join psi as psimm force index (psikodidx) on
	psimm.psikode = sgmmm.sgmstr5
	
left join psi as psispv force index (psikodidx) on
	psispv.psikode = sgmspv.sgmstr5

left join psi as psikabeng force index (psikodidx) on
	psikabeng.psikode = sgmkabeng.sgmstr5
	
left join psi as psisa force index (psikodidx) on
	psisa.psikode = sgmsa.sgmstr5
	
left join psi as psifd force index (psikodidx) on
	psifd.psikode = sgmfd.sgmstr5
	
left join psi as psinso force index (psikodidx) on
	psinso.psikode = sgmnso.sgmstr5
	
where cab.cabsts = "INPG" and cad.cadkode = "H2"

group by sgmbm.sgmstr5]]></xml-property>
        </oda-data-set>
