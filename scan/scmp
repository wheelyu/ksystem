/****************************************************************************/
IMAGE(cmphead) 
/------------------Daftar Company-------------------------\
|  Kode                     Keterangan                    |
|---------------------------------------------------------|









|---------------------------------------------------------|
|                Tekan ESC untuk keluar                   |
\---------------------------------------------------------/

IMAGE(cmproll) 
  _______________________  _______________________________ 

FIELD(cmproll)
   cmpkode              NOCHANGE SCROLL          NONE              1  
   cmpnama              PROTECT SCROLL           NONE              2  

CALCS()
cfin_ok		cmpsts == "INPG" && (cmpcab == btmcab || cmpcab == ppmcab) && cmpcab != BLANKS
cBu_DLR		cmpbu == "MD" || cmpbusup == "MD" || cmpbuhl == "MD" || cmpbupl == "MD"
cBu_PP		cmpbupl == "PP"
casuransi	cmptype2 == "ASS"
ccmpok		((cmpcab == bkmcab) || (g_grpnam =="FINBANK") || (g_grpnam=="FINBANKCO") || (g_grpnam =="RI") || (tlmtype1 == "HLF" && (cmpkode == "FINCO-160"||cmpkode == "FINCO-161"||cmpkode == "FINCO-167"||cmpkode == "FINCO-168"))) && cmptype2 == "HL"
cppscab		ppscab == cmpcab
cGA             (cmptype2==tldsat || cmptype2==bkmcab2) && (cmpkode2=="BELI_INVENTARIS" || cmpkode2=="TG1") && cmptgl>=g_tgltrn
cGA2            (cmpkode2=="MAINTENANCE_INVENTAR" || cmpkode2=="TE3" || cmpkode2=="TE2" || cmpkode2=="TE1" || cmpkode2=="TD2" || cmpkode2=="TA1" || cmpkode2=="TB3" || cmpkode2=="TB2" || cmpkode2=="TB1" || cmpkode2=="TC1" || cmpkode2=="GA2" || cmpkode2=="GA1" || cmpkode2=="TF4")  && cmptgl>=g_tgltrn
c728ok          cmpdataplg == "BPKBKONS" && cmpsts == "INP1" && cmpcab == btmcab
cumr		cmpkode2=="UMROH"

SCAN(scmp) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(scmpass) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=casuransi}
SCAN(scmp2) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(scmp3) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(scmp4) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(scmpFIN) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cfin_ok} 
SCAN(scmpFIN2) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(scmpHC) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(scmpHL) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(scmpPL) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SCR_ADD=3123} 
SCAN(scmpHD) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SCR_ADD=3120} 
SCAN(scmpDvsF) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SCR_ADD=3214} {SCAN_SCR_QRYFLD=cmpkode} {SCAN_SCR_EQLFLD=btmcab}
SCAN(scmpcab) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cppscab}
SCAN(scmpHDGA) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cGA}
SCAN(scmpMTGA) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cGA2}

SCAN(scmpDTPLG) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SCR_ADD=3121} 
SCAN(scmp201) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=ccmpok} {SCAN_SCR_ADD=3122} 
SCAN(scmpDTHL) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SCR_ADD=3122} 
SCAN(scmpDTPL) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SCR_ADD=3123} 
SCAN(scmp_DLR) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cBu_DLR} 
SCAN(scmp_PP) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cBu_PP} 
SCAN(scmp728ok) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=c728ok}
SCAN(scmpumr) {IMAGE_OUT=cmphead} {IMAGE_ROL=cmproll} {IMAGE_INP=cmproll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cumr}

/****************************************************************************/
IMAGE(cmphead2)
/------------------Daftar Company--------------------------------\
|  Kode       Nama                 Nilai Jaminan  Tarif          |
|----------------------------------------------------------------|









|----------------------------------------------------------------|
|                Tekan ESC untuk keluar                          |
\----------------------------------------------------------------/

IMAGE(cmproll2)
  ___________ ____________________ ______________ _______________

FIELD(cmproll2)
   cmpkode              NOCHANGE SCROLL          NONE              1
   cmpnama              PROTECT SCROLL           NONE              2
   cmpdf1               PROTECT SCROLL           NONE              3
   cmpdf2               PROTECT SCROLL           NONE              4

CALCS()
cNT	cmpdf1 >= tlmjml2

SCAN(scmpNT) {IMAGE_OUT=cmphead2} {IMAGE_ROL=cmproll2} {IMAGE_INP=cmproll2} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cNT}
