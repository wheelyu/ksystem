FIELD(mtdpitroll)
mtdnourt		NOCHANGE SCROLL		INPUTRI		1

CALCS()
cmekanik0  mtdplg == BLANKS
SCAN(smtdpit) {IMAGE_OUT=mtdpithead} {IMAGE_ROL=mtdpitroll} {IMAGE_INP=mtdpitroll} {SELECT_BAR} {ROLL_LINES=8}
SCAN(smtdpitmk) {IMAGE_OUT=mtdpithead} {IMAGE_ROL=mtdpitroll} {IMAGE_INP=mtdpitroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cmekanik0}
