|---------------------------------------|





      ESC ESC untuk keluar
\---------------------------------------/

IMAGE(dtmroll) 
  __________   _________________________ 

FIELD(dtmroll)
   dtmkode           NOCHANGE          NONE              1  
   dtmket            PROTECT           NONE              2  

CALCS()
csama2    	dtmnobbm == btmbisnis
cpaketahass	dtmimgbuk == "Y"

SCAN(sdtm) {IMAGE_OUT=dtmhead} {IMAGE_ROL=dtmroll} {IMAGE_INP=dtmroll} {SELECT_BAR} {ROLL_LINES=8}  
SCAN(sdtmB) {IMAGE_OUT=dtmhead} {IMAGE_ROL=dtmroll} {IMAGE_INP=dtmroll} {SELECT_BAR} {ROLL_LINES=8}  
SCAN(sdtmA) {IMAGE_OUT=dtmhead} {IMAGE_ROL=dtmroll} {IMAGE_INP=dtmroll} {SELECT_BAR} {ROLL_LINES=8}  {SCAN_SELECT=csama2}
SCAN(sdtmProp) {IMAGE_OUT=dtmhead} {IMAGE_ROL=dtmroll} {IMAGE_INP=dtmroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SCR_ADD=3107}
SCAN(sdtmLK) {IMAGE_OUT=dtmhead} {IMAGE_ROL=dtmroll} {IMAGE_INP=dtmroll} {SELECT_BAR} {ROLL_LINES=8}  
SCAN(sdtmDVS) {IMAGE_OUT=dtmhead} {IMAGE_ROL=dtmroll} {IMAGE_INP=dtmroll} {SELECT_BAR} {ROLL_LINES=8}  
SCAN(sdtmFBR) {IMAGE_OUT=dtmhead} {IMAGE_ROL=dtmroll} {IMAGE_INP=dtmroll} {SELECT_BAR} {ROLL_LINES=8}  
SCAN(sdtmAHS) {IMAGE_OUT=dtmhead} {IMAGE_ROL=dtmroll} {IMAGE_INP=dtmroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cpaketahass}

