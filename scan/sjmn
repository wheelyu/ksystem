/****************************************************************************/
IMAGE(jmnhead) 
/------------------------------------------Daftar Jaminan-----------------------------------\
   Kode       Keterangan                 Nama                Alamat                   Sts
|-------------------------------------------------------------------------------------------|











\-------------------------------------------------------------------------------------------/

IMAGE(jmnroll) 
  _____________________ _________ _______________________ ____________________________ ____

FIELD(jmnroll)
   jmnno             NOCHANGE SCROLL          NONE              1  
   jmnbentuk         PROTECT SCROLL           NONE              2  
   jmnnama           PROTECT SCROLL           NONE              2  
   jmnalamat         PROTECT SCROLL           NONE              2  
   jmnsts            PROTECT SCROLL           NONE              2  


CALCS()
cINPG	(jmnsts == "INPG" || jmnsts == "CLSD") && jmnbentuk == "GADAI"
cINPGlm	(jmnsts == "INPG" || jmnsts == "CLSD") && jmnbentuk == "EMAS"

SCAN(sjmn) {IMAGE_OUT=jmnhead} {IMAGE_ROL=jmnroll} {IMAGE_INP=jmnroll} {SELECT_BAR} {ROLL_LINES=8} 
{SCAN_SCR_ADD=8211}
SCAN(sjmnGad) {IMAGE_OUT=jmnhead} {IMAGE_ROL=jmnroll} {IMAGE_INP=jmnroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cINPG}
SCAN(sjmnLM) {IMAGE_OUT=jmnhead} {IMAGE_ROL=jmnroll} {IMAGE_INP=jmnroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cINPGlm}
