IMAGE(cabroll) 
  _______ _______________ _______________________  ___ ___

FIELD(cabroll)
   cabkode               NOCHANGE SCROLL          NONE              1  
   cabnama               PROTECT SCROLL           NONE              2  
   cabalamat             PROTECT SCROLL           NONE              3  
   cablevel1             PROTECT SCROLL           NONE              4  
   cablevel2             PROTECT SCROLL           NONE              5  

CALCS()
ccab_beda	cabkode != bkmcab
ccabPst 	(stssetnrc == "PST" && cabpos == "PST ")  || stssetnrc == BLANKS || stssetnrc != "PST"
cPosBknScab	cabpos != "SCAB"
cdealer1         cabusaha == "DEALER"
cfinco1         cabusaha == "FINCO"
cLS             cabtwr == biacab
/*cjual610	(cabusaha == "DEALER" || cabkode == "LBT31")*/
cjual610	cabusaha == "DEALER" 
/*cbolehlbt31	(#cabusaha == "DEALER" || #cabkode == "LBT31")*/
cbolehlbt31	(#cabusaha == "DEALER")
/*ccab503          (pmbgrup == "SPM" || pmbgrup =="PARTSPM") && (cabusaha =="DEALER" || cabkode =="LBT31")*/
ccab503          (pmbgrup == "SPM" || pmbgrup =="PARTSPM") && (cabusaha =="DEALER")
chanya4w        (cablevel1 != BLANKS && cabbrgjln != "TUTUP")
ccab812		cabusaha == "DEALER" || (cabusaha == "FINCO" && (cabkode == "LBT31" || cabkode == "ALR31"))
ccabged         cabtwr == tlmdari
ccabged2 	cabtwr == tbdkode

SCAN(scab) {IMAGE_OUT=cabhead} {IMAGE_ROL=cabroll} {IMAGE_INP=cabroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_IGNORE_CABDVS}
SCAN(scab503) {IMAGE_OUT=cabhead} {IMAGE_ROL=cabroll} {IMAGE_INP=cabroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_IGNORE_CABDVS} {SCAN_SELECT=ccab503}
