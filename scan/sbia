/****************************************************************************/
IMAGE(biahead) 
/---Daftar Master Biaya ------------------------------\
   Kode          Nominal                      Nip     
|-----------------------------------------------------|











      ESC ESC untuk keluar
\-----------------------------------------------------/

IMAGE(biaroll) 
  _____________________   ____________.__ ___________ |

FIELD(biaroll)
   biakode            NOCHANGE          NONE              1  
   biaplafon          PROTECT           NONE              2  
   bianip             PROTECT           NONE              3

CALCS()
cbiayaok		bkmcab == biacab || g_grpnam == "FINSUB" || g_grpnam == "FINSUBCO" || g_grpnam == "FINBANK" || g_grpnam == "FINASS" 
			|| g_grpnam == "FINARSIP" || g_grpnam == "IT " || g_grpnam == "FINANCE" || g_grpnam == "FINBANKCO"

SCAN(sbia) {IMAGE_OUT=biahead} {IMAGE_ROL=biaroll} {IMAGE_INP=biaroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cbiayaok} 
SCAN(sbia1) {IMAGE_OUT=biahead} {IMAGE_ROL=biaroll} {IMAGE_INP=biaroll} {SELECT_BAR} {ROLL_LINES=8}
SCAN(sbia2) {IMAGE_OUT=biahead} {IMAGE_ROL=biaroll} {IMAGE_INP=biaroll} {SELECT_BAR} {ROLL_LINES=8}



/****************************************************************************/
IMAGE(biaheadrtn)
/---Daftar Master Biaya ----------------------------------------\
   Kode                    Cabang       Nomor ATM
|---------------------------------------------------------------|











      ESC ESC untuk keluar
\---------------------------------------------------------------/

IMAGE(biarollrtn)
  _______________________  ___________ ________________________ |

FIELD(biarollrtn)
   biakode            NOCHANGE          NONE              1
   biacab             PROTECT           NONE              2
   bianiplm             PROTECT           NONE              3

CALCS()
catm		biatype == bkdtype || biatype == tldgrup
cdepo		biatype == "DEPOBCA"

SCAN(sbials) {IMAGE_OUT=biaheadrtn} {IMAGE_ROL=biarollrtn} {IMAGE_INP=biarollrtn} {SELECT_BAR} {ROLL_LINES=8}
SCAN(sbiaatm) {IMAGE_OUT=biaheadrtn} {IMAGE_ROL=biarollrtn} {IMAGE_INP=biarollrtn} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=catm}
SCAN(sbiadepo) {IMAGE_OUT=biaheadrtn} {IMAGE_ROL=biarollrtn} {IMAGE_INP=biarollrtn} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cdepo}


