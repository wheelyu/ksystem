{SCAN_SCR_QRYFLD=psmkode} {SCAN_SCR_EQLFLD=btmplg}
SCAN(sastserti) {IMAGE_OUT=asthead} {IMAGE_ROL=astroll} {IMAGE_INP=astroll} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(sastAH) {IMAGE_OUT=astheadAH} {IMAGE_ROL=astrollAH} {IMAGE_INP=astrollAH} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SCR_ADD=622}
SCAN(sastbpkbm2w) {IMAGE_OUT=astheadAH} {IMAGE_ROL=astrollAH} {IMAGE_INP=astrollAH} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SCR_ADD=3213} 
