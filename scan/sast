ckode           astdata == "ASSET" && astjns == "BPKB"

SCAN(sast) {IMAGE_OUT=asthead} {IMAGE_ROL=astroll} {IMAGE_INP=astroll} {SELECT_BAR} {ROLL_LINES=8}
