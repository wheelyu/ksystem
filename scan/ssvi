FIELD(sviroll6)
svikode		NOCHANGE SCROLL 	NONE 1
svinobuk	NOCHANGE SCROLL		NONE 2


CALCS()
calamattgh		svitype =="ALAMAT"
ctahapan		svinourt>=mtstotpph
csviktp			svitype == "KTP" && svinobuk == btmplg && svidata == "DUKCAPIL"
csvisit			svidata == "JKHPJCMO" && (svistr1 == "VISIT" || svitype == "VISIT")
