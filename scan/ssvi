csvimak			svikode == mtstype1 /*&& svistr1!=BLANKS && svistr2!=BLANKS*/ 
csvibider		svinobuk == tlmnobuk && svitype=="BIDDER"
csama			svinobuk == mtsplg
carea			#svinobuk == mtsplg/* && #svistr2 == mtsthbl*/
/*creq			svidata == "SLIK792" && svitype == "REQUEST"*/
cspkrem			#svinobuk == tkmnobuk

SCAN(ssvi) {IMAGE_OUT=svihead} {IMAGE_ROL=sviroll} {IMAGE_INP=sviroll} {SELECT_BAR} {ROLL_LINES=8}
SCAN(ssviarea) {IMAGE_OUT=svihead} {IMAGE_ROL=sviroll} {IMAGE_INP=sviroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=carea}
SCAN(ssvi2) {IMAGE_OUT=svihead2} {IMAGE_ROL=sviroll2} {IMAGE_INP=sviroll2} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=ctahapan}
