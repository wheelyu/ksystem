SCAN(ssvireq) {IMAGE_OUT=sviheadreq} {IMAGE_ROL=svirollreq} {IMAGE_INP=svirollreq} {SELECT_BAR} {ROLL_LINES=8} /*{SCAN_SELECT=creq}*/
SCAN(ssvisit) {IMAGE_OUT=svihead2} {IMAGE_ROL=sviroll2} {IMAGE_INP=sviroll2} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=csvisit}
SCAN(ssvix) {IMAGE_OUT=svihead} {IMAGE_ROL=sviroll} {IMAGE_INP=sviroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=calamattgh}
SCAN(ssviktp) {IMAGE_OUT=svihead2} {IMAGE_ROL=sviroll2} {IMAGE_INP=sviroll2} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=csviktp}
