/****************************************************************************/
IMAGE(cadhead) 
/------------------------------------------------------------------\			
|  Divisi                Bisnis          Keterangan                |
|------------------------------------------------------------------|









|------------------------------------------------------------------|
|      Tekan ESC untuk keluar                                      |
\------------------------------------------------------------------/

IMAGE(cadroll) 
  ____________________  _____________ _____________________________

FIELD(cadroll)
   cadkode               NOCHANGE SCROLL          NONE              1  
   cadgrpush             PROTECT  SCROLL          NONE              1  
   cadket                PROTECT SCROLL           NONE              2  

/****************************************************************************/
IMAGE(cadhead1) 
/------------------------------------------------------------------\			
|  Kode                  Jml Faktur                                |
|------------------------------------------------------------------|









|------------------------------------------------------------------|
|      Tekan ESC untuk keluar                                      |
\------------------------------------------------------------------/

IMAGE(cadroll1) 
  ____________________  _____________ 

FIELD(cadroll1)
   cadkode               NOCHANGE SCROLL          NONE              1  
   cadtot1               PROTECT  SCROLL          NONE              1  

/****************************************************************************/


/****************************************************************************/
IMAGE(cadheadsv)
/------------------------------------------------------------------\
|  Kode Cabang           Divisi          Bisnis                    |
|------------------------------------------------------------------|









|------------------------------------------------------------------|
|      Tekan ESC untuk keluar                                      |
\------------------------------------------------------------------/

IMAGE(cadrollsv)
  ____________________  _____________ _____________________________

FIELD(cadrollsv)
   cadkdcab              NOCHANGE SCROLL          NONE              1
   cadkode               NOCHANGE SCROLL          NONE              2
   cadgrpush             PROTECT  SCROLL          NONE              3

IMAGE(cadheadnew)
/------------------------------------------------------------------\
|  Kode Cabang           Divisi          Bisnis                    |
|------------------------------------------------------------------|









|------------------------------------------------------------------|
|      Tekan ESC untuk keluar                                      |
\------------------------------------------------------------------/

IMAGE(cadrollnew)
  ____________________  ___________________________________________

FIELD(cadrollnew)
   cadkdcab              NOCHANGE SCROLL          NONE              1
   cadkode               NOCHANGE SCROLL          NONE              2

IMAGE(cadheadstok)
/------------------------------------------------------------------\
|  Kode Cabang           Cabang Stok                               |
|------------------------------------------------------------------|









|------------------------------------------------------------------|
|      Tekan ESC untuk keluar                                      |
\------------------------------------------------------------------/

IMAGE(cadrollstok)
  ____________________  ___________________________________________

FIELD(cadrollstok)
   cadkdcab              NOCHANGE SCROLL          NONE              1
   cadarea               NOCHANGE SCROLL          NONE              2


CALCS()
cbknKEND	cadthbl != "KEND" && cadthbl != "SERVIS"
cLoksv          cadkode == "H2"
cLokgd		cadkode == "MGA"
cLoklm		cadkode == "LM"  
ckrmsama	cadkdcab == cadarea && caddata == "CABKRM"
cbbnsama	cadkdcab == cadarea && caddata == "CABBBN"
cstoksama	cadkdcab == cadarea && caddata == "CABSTOK"
chrgsama	cadkdcab == cadarea && caddata == "CABHRG"
cbisnis         caddata == "CABBIS"
cstokprior	caddata == "CABSTOK" && cadarea == btdcab
careapiuok      cadstr1 == tkdjenis && cadkode != tkdnoll
careapiuawl     cadstr1 == tkdjenis  

SCAN(scad) {IMAGE_OUT=cadhead} {IMAGE_ROL=cadroll} {IMAGE_INP=cadroll} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(scadLoksv) {IMAGE_OUT=cadheadsv} {IMAGE_ROL=cadrollsv} {IMAGE_INP=cadrollsv} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cLoksv} 
SCAN(scadLokgd) {IMAGE_OUT=cadheadsv} {IMAGE_ROL=cadrollsv} {IMAGE_INP=cadrollsv} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cLokgd} 
SCAN(scadLoklm) {IMAGE_OUT=cadheadsv} {IMAGE_ROL=cadrollsv} {IMAGE_INP=cadrollsv} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cLoklm} 
SCAN(scadDIV) {IMAGE_OUT=cadhead} {IMAGE_ROL=cadroll} {IMAGE_INP=cadroll} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(scadUM) {IMAGE_OUT=cadhead} {IMAGE_ROL=cadroll} {IMAGE_INP=cadroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cbknKEND}
SCAN(scadKRM) {IMAGE_OUT=cadheadnew} {IMAGE_ROL=cadrollnew} {IMAGE_INP=cadrollnew} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=ckrmsama}
SCAN(scadBBN) {IMAGE_OUT=cadheadnew} {IMAGE_ROL=cadrollnew} {IMAGE_INP=cadrollnew} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cbbnsama}
SCAN(scadSTOK) {IMAGE_OUT=cadheadnew} {IMAGE_ROL=cadrollnew} {IMAGE_INP=cadrollnew} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cstoksama}
SCAN(scadHRG) {IMAGE_OUT=cadheadnew} {IMAGE_ROL=cadrollnew} {IMAGE_INP=cadrollnew} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=chrgsama}
SCAN(scadbl) {IMAGE_OUT=cadheadsv} {IMAGE_ROL=cadrollsv} {IMAGE_INP=cadrollsv} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cbisnis}
SCAN(scadprior) {IMAGE_OUT=cadheadstok} {IMAGE_ROL=cadrollstok} {IMAGE_INP=cadrollstok} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cstokprior}
SCAN(scadareapiuok) {IMAGE_OUT=cadhead1} {IMAGE_ROL=cadroll1} {IMAGE_INP=cadroll1} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=careapiuok}
SCAN(scadareapiuawl) {IMAGE_OUT=cadhead1} {IMAGE_ROL=cadroll1} {IMAGE_INP=cadroll1} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=careapiuawl}
