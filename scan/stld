/****************************************************************************/
IMAGE(tldhead) 
/------------------------------------------------------\			
  Kode Barang        Jml   Jml Ren           Faktur
|------------------------------------------------------|









|------------------------------------------------------|
|      Tekan ESC untuk keluar                          |
\------------------------------------------------------/

IMAGE(tldroll) 
  _________________  ______ ______ ____________________

FIELD(tldroll)
   tldbrg               NOCHANGE SCROLL          NONE              1  
   tldjml               PROTECT                  NONE              2  
   tldjmlren            PROTECT                  NONE              2 
   tldnoll		PROTECT			 NONE		   3 

CALCS()
cgc_helm	tldcab == ppmcab && tldkat == ppmsup && (tldlok2 == BLANKS || tldlok2 == ppmgrup) && ((tldjml - tldjmlren - tldjmlpos) > 0)
cgc_mtr		tldlok == btdcab && tldkat == "SPM"
cgc_mtr2	tldlok == tkdnoll && tldkat == "SPM"
ctldijin	tldkat == tkdjenis
cgc_mtr3	tldkat == "SPM"

SCAN(stld) {IMAGE_OUT=tldhead} {IMAGE_ROL=tldroll} {IMAGE_INP=tldroll} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(stldijin) {IMAGE_OUT=tldhead} {IMAGE_ROL=tldroll} {IMAGE_INP=tldroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=ctldijin}
SCAN(stldgc) {IMAGE_OUT=tldhead} {IMAGE_ROL=tldroll} {IMAGE_INP=tldroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cgc_helm}
SCAN(stldgc2) {IMAGE_OUT=tldhead} {IMAGE_ROL=tldroll} {IMAGE_INP=tldroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cgc_mtr}
SCAN(stldgc3) {IMAGE_OUT=tldhead} {IMAGE_ROL=tldroll} {IMAGE_INP=tldroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cgc_mtr2}
SCAN(stldgc4) {IMAGE_OUT=tldhead} {IMAGE_ROL=tldroll} {IMAGE_INP=tldroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cgc_mtr3}

