/****************************************************************************/
CALCS()   
ctldevent  tldtgl3 <= g_tgltrn && (
              ((tldgrup == "PAP" || tldgrup ==  "PLP" || tldgrup ==  "PMR" ||tldgrup ==  "PTH") && (tldtgl3 + 7) >= g_tgltrn) 
            || ((tldgrup == "GPR" || tldgrup == "JUMBA" ||tldgrup ==  "KBR" || tldgrup ==  "KVS_INS" || tldgrup ==  "SKM" || tldgrup == "SPR" || tldgrup == "PPR" || tldgrup == "RSM" || tldgrup == "SRE" ) && (tldtgl3 + 3) >= g_tgltrn)
            )           
IMAGE(tldhead7)
/---------Daftar Event-------------------------------\
|  NOBUK       Jenis       TglMulai     TglSelesai     |
|----------------------------------------------------|









|----------------------------------------------------|
|          Tekan ESC untuk keluar                     |
\----------------------------------------------------/

IMAGE(tldroll7)
 ________  _________  ___________  _____________

FIELD(tldroll7)
   tldnobuk             NOCHANGE SCROLL          NONE          1
   tldgrup              PROTECT  SCROLL          NONE          2
   tldtgl2              NOCHANGE SCROLL          NONE          3   
   tldtgl3              NOCHANGE SCROLL          NONE          4

SCAN(stldevent) {IMAGE_OUT=tldhead7} {IMAGE_ROL=tldroll7} {IMAGE_INP=tldroll7} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=ctldevent}

