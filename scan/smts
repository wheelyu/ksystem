/****************************************************************************/
IMAGE(mtshead) 
/----------------------------------------------------------------\			
|  Kode       Keterangan                                         |
\----------------------------------------------------------------/



IMAGE(mtsroll) 
  ______________  ______________ _______________________________ 

FIELD(mtsroll)
   mtsnobuk          NOCHANGE SCROLL          NONE              1  
   mtsplg            PROTECT SCROLL           NONE              2  
   cmpnama           PROTECT SCROLL           NONE              2  

CALCS()
cplg1		0

EDITS(mtsroll)
. mtsplg VALIDATE_IF cplg1 cmpkodidx mcmpS 0

MAP(mcmpS)
cmpnama		cmpnama		REPLACE

/****************************************************************************/
IMAGE(mtshead2)
/----------------------------------------------------------------\
|  Kode       Keterangan                                         |
\----------------------------------------------------------------/



IMAGE(mtsroll2)
  ______________  ______________________________________________

FIELD(mtsroll2)
   mtsnobuk          NOCHANGE SCROLL          NONE              1
   mtsket            PROTECT SCROLL           NONE              2

CALCS()
ccmpsama		mtsplg == ppmplg
cslmsama		mtsuntuk == ppmsales
c825sama		(tlmgrup2=="REMMGR" && mtspst!=BLANKS) ||
			(tlmgrup2=="PROPERTY" && (mtspst=="INPUT_PEKERJA_PROYEK" || mtspst=="UPLOAD_SPK" || mtspst=="PROGRESS_TERMIN" || mtspst=="UPLOAD_ANWIJING" || mtspst=="NEGOSIASIFINAL")) ||
			(tlmgrup2=="DRAFTER" && (mtspst=="UPLOAD_GAMBARLAYOUT" || mtspst=="UPLOAD_GAMBARKERJA")) ||
			(tlmgrup2=="SITEENGINER" && (mtspst=="UPL_RUNNINGSTRUKTUR" || mtspst=="UPLOAD_GAMBARLAYOUT")) ||
			(tlmgrup2=="ESTIMATOR" && (mtspst=="UPLOAD_BOQFINAL" || mtspst=="UPLOAD_BOQAWAL" || mtspst=="PROGRESS_TERMIN" || mtspst=="UPLOAD_REKAPBOQ" || mtspst=="NEGOSIASIFINAL")) ||
			(tlmgrup2=="QS" && (mtspst=="UPLOAD_BOQFINAL" || mtspst=="PROGRESS_TERMIN" || mtspst=="UPLOAD_BOQAWAL" || mtspst=="UPLOAD_REKAPBOQ" || mtspst=="NEGOSIASIFINAL"))

SCAN(smts) {IMAGE_OUT=mtshead} {IMAGE_ROL=mtsroll} {IMAGE_INP=mtsroll} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(smts1) {IMAGE_OUT=mtshead} {IMAGE_ROL=mtsroll} {IMAGE_INP=mtsroll} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(smts2) {IMAGE_OUT=mtshead} {IMAGE_ROL=mtsroll} {IMAGE_INP=mtsroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=ccmpsama}
SCAN(smtsSLM) {IMAGE_OUT=mtshead} {IMAGE_ROL=mtsroll} {IMAGE_INP=mtsroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cslmsama}
SCAN(smts825) {IMAGE_OUT=mtshead2} {IMAGE_ROL=mtsroll2} {IMAGE_INP=mtsroll2} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=c825sama}
