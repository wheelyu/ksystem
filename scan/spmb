/****************************************************************************/
IMAGE(pmbhead) 
/-------------Daftar Sisa Hutang---------------------------------------------------------\
|  i.NoBuk         i.SisPrc      i.SisPrcAs     i.TotalCek       i.Keterangan            |
|----------------------------------------------------------------------------------------|









|----------------------------------------------------------------------------------------|
|      Tekan ESC untuk keluar                                                            |
\----------------------------------------------------------------------------------------/

IMAGE(pmbroll) 
  ______________ ______ __________ __________ ________________ _________________________

FIELD(pmbroll)
   pmbnobuk             NOCHANGE SCROLL          NONE              1  
   pmbcab               PROTECT                  NONE              2  
   pmbsisprc            PROTECT                  NONE              2  
   pmbsisprcas1         PROTECT                  NONE              3  
   pmbcek               PROTECT                  NONE              4  
   pmbket               PROTECT SCROLL           NONE              5  

CALCS()
cpmbcab		(pmbsisprc != 0) && pmbdvs == bkmdvs
cmasihpiub	pmbsisa == 0 && pmbdvs == bkmdvs && pmbgrup == bkmgrup2 && (pmbstsbrg == "PIUB" || (pmbstsbrg == "225" && pmbnobuk == ~bkdbukll))
cretur		pmbsisa < 0 && pmbdvs == bkmdvs && pmbgrup == bkmgrup2 && pmbcab == bkmcab2

SCAN(spmb) {IMAGE_OUT=pmbhead} {IMAGE_ROL=pmbroll} {IMAGE_INP=pmbroll} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(spmbFR) {IMAGE_OUT=pmbhead} {IMAGE_ROL=pmbroll} {IMAGE_INP=pmbroll} {SELECT_BAR} {ROLL_LINES=8} 

SCAN(spmbcab) {IMAGE_OUT=pmbhead} {IMAGE_ROL=pmbroll} {IMAGE_INP=pmbroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cpmbcab}


IMAGE(pmbheadCEK) 
/-------------------------Daftar Sisa Hutang -----------------\			
|  i.NoBuk         i.Totfak        i.TotalCek                 |
|-------------------------------------------------------------|









|-------------------------------------------------------------|
|      Tekan ESC untuk keluar                                 |
\-------------------------------------------------------------/

IMAGE(pmbrollCEK) 
  ______________ _______________ _____________ 

FIELD(pmbrollCEK)
   pmbnobuk             NOCHANGE SCROLL          NONE              1  
   pmbtotfak            PROTECT                  NONE              2  
   pmbcek               PROTECT                  NONE              2  

CALCS()
ccekisi			pmbcek > 0

SCAN(spmbCEKawl) {IMAGE_OUT=pmbheadCEK} {IMAGE_ROL=pmbrollCEK} {IMAGE_INP=pmbrollCEK} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=ccekisi}
SCAN(spmbPIUB) {IMAGE_OUT=pmbheadCEK} {IMAGE_ROL=pmbrollCEK} {IMAGE_INP=pmbrollCEK} {SELECT_BAR} {ROLL_LINES=8} 

IMAGE(pmbheadbank) 
/-------------Daftar Sisa Hutang---------------\
|  i.NoBuk         i.Jtp         i.angsuran    |
|----------------------------------------------|









|----------------------------------------------|
|      Tekan ESC untuk keluar                  |
\----------------------------------------------/

IMAGE(pmbrollbank) 
  ______________ ______________ _____________ 

FIELD(pmbrollbank)
   pmbnobuk             NOCHANGE SCROLL          NONE              1  
   pmbtgljtp            PROTECT {DD-MM-YY}       NONE              2  
   pmbsdawlbl             PROTECT                  NONE              3  

CALCS()
cpmbbankok	pmbstsprc == "OPEN"

SCAN(spmbbank) {IMAGE_OUT=pmbheadbank} {IMAGE_ROL=pmbrollbank} {IMAGE_INP=pmbrollbank} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(spmbbank1) {IMAGE_OUT=pmbheadbank} {IMAGE_ROL=pmbrollbank} {IMAGE_INP=pmbrollbank} {SELECT_BAR} {ROLL_LINES=8}  {SCAN_SELECT=cpmbbankok}

IMAGE(pmbheadhut) 
/-------------Daftar Sisa Hutang-------------------------------------------------------------------\
|  i.NoBuk        t.NoDo          i.Total       i.Bayar       i.Sisa        i.sisarenc      i.Cab  |
|--------------------------------------------------------------------------------------------------|









|--------------------------------------------------------------------------------------------------|
|      Tekan ESC untuk keluar                                                                      |
\--------------------------------------------------------------------------------------------------/

IMAGE(pmbrollhut) 
  ______________ ________________ ______________ _____________ ______________ ___________ ________

FIELD(pmbrollhut)
   pmbnobuk             NOCHANGE SCROLL          NONE              1  
   pmbnosjll            NOCHANGE SCROLL          NONE              2
   pmbtotfak            PROTECT {DD-MM-YY}       NONE              3  
   pmbtotbyr            PROTECT                  NONE              4  
   pmbsisa              PROTECT                  NONE              5  
   pmbsisprc            PROTECT                  NONE              6  
   pmbcab		PROTECT			 NONE		   7

SCAN(spmbhut) {IMAGE_OUT=pmbheadhut} {IMAGE_ROL=pmbrollhut} {IMAGE_INP=pmbrollhut} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cpmbcab}
SCAN(spmbhut2) {IMAGE_OUT=pmbheadhut} {IMAGE_ROL=pmbrollhut} {IMAGE_INP=pmbrollhut} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cmasihpiub}
SCAN(spmbhut3) {IMAGE_OUT=pmbheadhut} {IMAGE_ROL=pmbrollhut} {IMAGE_INP=pmbrollhut} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cretur}


