IMAGE(pikroll) {POP_UP} {LSTFLD_ADVANCE} {FRSFLD_BACKUP} {BASE_ROW=10} {BASE_COLUMN=20}
  ______________  _______________________________ 

FIELD(pikroll)
   piknobuk              NOCHANGE SCROLL          NONE              1  
   pikktp               PROTECT SCROLL           NONE              2  

CALCS()
cpikplns		mtscab == pikcab       
cpikgd   		pikdvs=="MGA" && piksts == "INPG"
cpikgdllg               pikdvs=="MGA" && piksts == "INPG" && (pikklakon == "WO" || piktgljtp < g_tgltrn - 7)  && pikketbyr == BLANKS
cpikcab			ppscab == pikcab
cpikclm			pikcab == tlmcab && pikdvs == tlmdvs
cpik920le		pikcab == tlmcab && piksts == "TRK1"
cpik920bl		pikcab == tlmcab && piksts == "INPG"

SCAN(spik) {IMAGE_OUT=pikhead} {IMAGE_ROL=pikroll} {IMAGE_INP=pikroll} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(spik2) {IMAGE_OUT=pikhead} {IMAGE_ROL=pikroll} {IMAGE_INP=pikroll} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(spik1) {IMAGE_OUT=pikhead} {IMAGE_ROL=pikroll} {IMAGE_INP=pikroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cpikplns}
SCAN(spikgd) {IMAGE_OUT=pikhead} {IMAGE_ROL=pikroll} {IMAGE_INP=pikroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cpikgd}
SCAN(spikgdllg) {IMAGE_OUT=pikhead} {IMAGE_ROL=pikroll} {IMAGE_INP=pikroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cpikgdllg}
SCAN(spikcab) {IMAGE_OUT=pikhead} {IMAGE_ROL=pikroll} {IMAGE_INP=pikroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cpikcab}
SCAN(spikclm) {IMAGE_OUT=pikhead} {IMAGE_ROL=pikroll} {IMAGE_INP=pikroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cpikclm}
SCAN(spik920le) {IMAGE_OUT=pikhead} {IMAGE_ROL=pikroll} {IMAGE_INP=pikroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cpik920le}
SCAN(spik920bl) {IMAGE_OUT=pikhead} {IMAGE_ROL=pikroll} {IMAGE_INP=pikroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cpik920bl}
