FIELD(btmahsroll)
   btmnobuk             NOCHANGE SCROLL           NONE              2
   btmsts               PROTECT                 NONE            2
   btmkdsam             PROTECT                 NONE            2
   btmcab               PROTECT                 NONE            2


CALCS()
cstatusbtm		btmsts=="712"
ccabbtm			btmlokjual == tlmcab
