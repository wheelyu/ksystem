SCAN(sbtmahs2) {IMAGE_OUT=btmahshead} {IMAGE_ROL=btmahsroll} {IMAGE_INP=btmahsroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cahass2}
SCAN(sbtmCab2) {IMAGE_OUT=btmShead} {IMAGE_ROL=btmSroll} {IMAGE_INP=btmSroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=ccabbtm}
SCAN(sbtm707b) {IMAGE_OUT=btmhead} {IMAGE_ROL=btmroll} {IMAGE_INP=btmroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=c707d}
SCAN(sbtm708) {IMAGE_OUT=btmhead} {IMAGE_ROL=btmroll} {IMAGE_INP=btmroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=c708}
