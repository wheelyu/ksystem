IMAGE(brdroll) 
______________ ____________________ __________________ __________ ________

FIELD(brdroll)
   brdoto            NOCHANGE SCROLL          NONE              1  
   brdnorangka       PROTECT SCROLL           NONE              2  
   brdnomesin        PROTECT SCROLL           NONE              2  
   brdukrwrn         PROTECT SCROLL           NONE              2  
   brdsisprc         PROTECT SCROLL           NONE              2  

CALCS()
cotosamaPpd	g_curfile == "ppd" && (~ppdbrdoto == brdoto || ~ppdbrdoto == BLANKS)
cotosamaMtd	g_curfile == "mtd" && (~mtdbrdoto == brdoto || ~mtdbrdoto == BLANKS)
cotosamaTld	g_curfile == "tld" && (~tldbrdoto == brdoto || ~tldbrdoto == BLANKS)
cotosamaBtd	g_curfile == "btd" && (~tldbrdoto == brdoto || ~tldbrdoto == BLANKS)

ctmplokPpd	brdsisprc + ~ppdjml
ctmplokMtd	brdsisprc + ~mtdjml
ctmplokTld	brdsisprc + ~tldjml
ctmplokBtd	brdsisprc + ~btdjml

cloksama  ((g_curfile =="ppd" && brdlok == ~ppdlok && ((~ppdbrdoto == brdoto || ~ppdbrdoto == BLANKS) && brdsisprc + ~ppdjml > 0)) || brdsisprc > 0) ||
          ((g_curfile =="mtd" && brdlok == ~mtdlok && ((~mtdbrdoto == brdoto || ~mtdbrdoto == BLANKS) && brdsisprc + ~mtdjml > 0)) || brdsisprc > 0) ||
          ((g_curfile =="tld" && brdlok == ~tldlok && ((~tldbrdoto == brdoto || ~tldbrdoto == BLANKS) && brdsisprc + ~tldjml > 0)) || brdsisprc > 0) ||
          ((g_curfile =="btm" && brdlok == ~btmlok && ((~btmbrdoto == brdoto || ~btmbrdoto == BLANKS) && brdsisprc + ~btmjml > 0)) || brdsisprc > 0) ||
          ((g_curfile =="btd" && brdlok == ~btdlok && ((~btdbrdoto == brdoto || ~btdbrdoto == BLANKS) && brdsisprc + ~btdjml > 0)) || brdsisprc > 0)
cloksamaMTR  ((g_curfile =="ppd" && brdlok == ~ppdlok && brdukrwrn == ~btmwrn && ((~ppdbrdoto == brdoto || ~ppdbrdoto == BLANKS) && brdsisprc + ~ppdjml > 0)) || brdsisprc > 0) 
cloksatsama	brdsat == mtdsat

MAP(mtmpbrg)
ctmplokPpd		brdsisprc		DO_CALC_IF cotosamaPpd
ctmplokMtd		brdsisprc		DO_CALC_IF cotosamaMtd
ctmplokTld		brdsisprc		DO_CALC_IF cotosamaTld
ctmplokBtd		brdsisprc		DO_CALC_IF cotosamaBtd

