IMAGE(ppmheadKRE) 
/---------------------------------Daftar Faktur Kredit-------------------\
| Pemohon               NoKontrak       Alamat                           |
|------------------------------------------------------------------------|
|                                                                        |
|                                                                        |
|                                                                        |
|                                                                        |
|                                                                        |
|                                                                        |
|                                                                        |
|                                                                        |
|                                                                        |
\------------------------------------------------------------------------/

IMAGE(ppmrollKRE) 
  ____________________ ______________ _________________________________ 

FIELD(ppmrollKRE)
/* Symbol Name   Input Attribute  Output Attribute  Input Order   */
   ppmnama            NOCHANGE SCROLL   NONE              1  
   ppmnobuk           PROTECT SCROLL    NONE              2  
   ppmket             PROTECT SCROLL    NONE              3  

CALCS()
ccekisi1	ppmcek > 0
cfrF		#ppmfr == "F"
cppmsisok	ppmsisprc + ~bkdtotal > 0
cppmmotortlm	ppmdata == gv_dtpiu && ppmfr == gv_F && (ppmsts == "CLSD" || ppmsts == "INPG") && ppmscr == "614" && ppmcabinduk == tlmcab
cdealerinpg      ppmsts=="INPG"

SCAN(sppm) {IMAGE_OUT=ppmhead} {IMAGE_ROL=ppmroll} {IMAGE_INP=ppmroll} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(sppmdealer) {IMAGE_OUT=ppmhead} {IMAGE_ROL=ppmroll} {IMAGE_INP=ppmroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cdealerinpg}
SCAN(sppmdealer2) {IMAGE_OUT=ppmhead} {IMAGE_ROL=ppmroll} {IMAGE_INP=ppmroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cdealerinpg}
SCAN(sppma) {IMAGE_OUT=ppmhead} {IMAGE_ROL=ppmroll} {IMAGE_INP=ppmroll} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(sppm2) {IMAGE_OUT=ppmhead} {IMAGE_ROL=ppmroll} {IMAGE_INP=ppmroll} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(sppmF) {IMAGE_OUT=ppmhead} {IMAGE_ROL=ppmroll} {IMAGE_INP=ppmroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cfrF}
SCAN(sppmKRE1) {IMAGE_OUT=ppmheadKRE} {IMAGE_ROL=ppmrollKRE} {IMAGE_INP=ppmrollKRE} {SELECT_BAR} {ROLL_LINES=8}
SCAN(sppmKRE2) {IMAGE_OUT=ppmheadKRE} {IMAGE_ROL=ppmrollKRE} {IMAGE_INP=ppmrollKRE} {SELECT_BAR} {ROLL_LINES=8}
SCAN(sppmCEKawl) {IMAGE_OUT=ppmheadCEK} {IMAGE_ROL=ppmrollCEK} {IMAGE_INP=ppmrollCEK} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=ccekisi1}
SCAN(sppmKS) {IMAGE_OUT=ppmhead} {IMAGE_ROL=ppmroll} {IMAGE_INP=ppmroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cppmsisok}
SCAN(sppmF2) {IMAGE_OUT=ppmhead} {IMAGE_ROL=ppmroll} {IMAGE_INP=ppmroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_INDEX=ppmplgstsbuk} {SCAN_TARGET=ppmplg} {SCAN_TARGET2=gv_INPG}
SCAN(sppmmtrtlm) {IMAGE_OUT=ppmhead} {IMAGE_ROL=ppmroll} {IMAGE_INP=ppmroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cppmmotortlm}

SCAN(sppmR) {IMAGE_OUT=ppmheadSLM} {IMAGE_ROL=ppmrollSLM} {IMAGE_INP=ppmrollSLM} {SELECT_BAR} {ROLL_LINES=10} {SCAN_REKAP=ppmsales} {SCAN_SUM_FIELD=ppmsisa}
SCAN(sppmR3) {IMAGE_OUT=ppmheadSLM} {IMAGE_ROL=ppmrollSLM} {IMAGE_INP=ppmrollSLM} {SELECT_BAR} {ROLL_LINES=10} {SCAN_REKAP=ppmsales} {SCAN_SUM_FIELD=ppmsisa}
SCAN(sppmR2) {IMAGE_OUT=ppmheadPLG} {IMAGE_ROL=ppmrollPLG} {IMAGE_INP=ppmrollPLG} {SELECT_BAR} {ROLL_LINES=10} {SCAN_REKAP=ppmplg} {SCAN_SUM_FIELD=ppmsisa}
SCAN(sppmR4) {IMAGE_OUT=ppmheadPLG} {IMAGE_ROL=ppmrollPLG} {IMAGE_INP=ppmrollPLG} {SELECT_BAR} {ROLL_LINES=10} {SCAN_REKAP=ppmplg} {SCAN_SUM_FIELD=ppmsisa}

