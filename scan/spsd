/****************************************************************************/
IMAGE(psdhead) 
/-------------Daftar Nopol--------------------------------\			
|  Kode       Keterangan                Keterangan 2      |
|---------------------------------------------------------|









|---------------------------------------------------------|
|      Tekan ESC untuk keluar                             |
\---------------------------------------------------------/

IMAGE(psdroll) 
  __ __________________ __________________ ____________ ___

FIELD(psdroll)
   psdpsmkode               NOCHANGE SCROLL          NONE              1
   psdkode                  NOCHANGE SCROLL          NONE              1
   psmnama              PROTECT                 NONE            2
   psdstr1            PROTECT SCROLL           NONE              2
   psdket                PROTECT SCROLL           NONE              2

EDITS(psdroll)
. psdkode      VALIDATE psmktpidx mscanpsm 0

MAP(mscanpsm)
psmnama         psmnama         REPLACE


IMAGE(psdhead2)
/-------------Daftar Nopol-------------------------------------------------\
|  Kode                Nama Mitra       Jenis Batu          Keterangan 2   |
|--------------------------------------------------------------------------|









|--------------------------------------------------------------------------|
|      Tekan ESC untuk keluar                                              |
\--------------------------------------------------------------------------/

IMAGE(psdroll2)
  ______________  __________________ _____________________ ______________

FIELD(psdroll2)
   psdpsmkode               NOCHANGE SCROLL          NONE              1
   psmnama		PROTECT			NONE		2
   psdstr1            PROTECT SCROLL           NONE              2
   psdket                PROTECT SCROLL           NONE              2

EDITS(psdroll2)
. psdpsmkode   VALIDATE	psmktpidx mscanpsm 0

IMAGE(psdhead3)
/-------------Daftar Nopol-------------------------------------------------\
|  Kode                Sub Kode       Nip                   Keterangan 2   |
|--------------------------------------------------------------------------|









|--------------------------------------------------------------------------|
|      Tekan ESC untuk keluar                                              |
\--------------------------------------------------------------------------/

IMAGE(psdroll3)
  ______________  __________________ _____________________ ______________

FIELD(psdroll3)
   psdpsmkode               NOCHANGE SCROLL          NONE              1
   psdkode                PROTECT                 NONE            2
   psdstr1            PROTECT SCROLL           NONE              2
   psdket                PROTECT SCROLL           NONE              2


CALCS()
cmitracmo	psdtot == 0 && psdstr2 == "EKSTERNAL" && psdtype3 == "INPG"
cmitracmo2	psdtot2 == 0 && psdstr2 =="EKSTERNAL" && psdtype3 == "INPG"
cagen1		psdkode == tlmplg && (psdstr2 == "AGENHMC" || psdstr2 == "AGENM2W")
cfree1		psdkode == tlmplg && (psdstr2 == "FREELANCEHMC" || psdstr2 == "FREELANCEM2W")
cmitraskr	psdtype == "M4W" && psdstr2 == "EKSTERNAL" && psdtgl1 == g_tgltrn
cscan133	psdstr1 == btmsales

SCAN(spsd) {IMAGE_OUT=psdhead} {IMAGE_ROL=psdroll} {IMAGE_INP=psdroll} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(spsdmitra) {IMAGE_OUT=psdhead2} {IMAGE_ROL=psdroll2} {IMAGE_INP=psdroll2} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cmitracmo}
SCAN(spsdmitra2) {IMAGE_OUT=psdhead2} {IMAGE_ROL=psdroll2} {IMAGE_INP=psdroll2} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cmitracmo2}
SCAN(spsdmitraagen) {IMAGE_OUT=psdhead2} {IMAGE_ROL=psdroll2} {IMAGE_INP=psdroll2} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cagen1}
SCAN(spsdmitrafree) {IMAGE_OUT=psdhead2} {IMAGE_ROL=psdroll2} {IMAGE_INP=psdroll2} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cfree1}
SCAN(spsdmitraskr) {IMAGE_OUT=psdhead} {IMAGE_ROL=psdroll} {IMAGE_INP=psdroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cmitraskr}
SCAN(spsd133) {IMAGE_OUT=psdhead3} {IMAGE_ROL=psdroll3} {IMAGE_INP=psdroll3} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cscan133}


