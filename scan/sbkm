   bkmket               NOCHANGE SCROLL          NONE              1  
   bkmtotal             NOCHANGE SCROLL          NONE              1  
   bkmcab               NOCHANGE SCROLL          NONE              1  

CALCS()
chanyaOPEN	bkmsts == "OPEN"
charini         bkmtgl == svitgl1
cblnini         bkmtgl > ststglprjgl || g_grpnam == "ADHHEAD" || g_grpnam == "ADHDVH" || g_usrkode == "1000635" || g_usrkode == "1027490" || g_usrkode == "1924139"


