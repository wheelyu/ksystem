SCAN(sbkmOPEN) {IMAGE_OUT=bkmhead} {IMAGE_ROL=bkmroll} {IMAGE_INP=bkmroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=chanyaOPEN}
SCAN(sbkmsb) {IMAGE_OUT=bkmheadbank} {IMAGE_ROL=bkmrollbank} {IMAGE_INP=bkmrollbank} {SELECT_BAR} {ROLL_LINES=8} 
SCAN(sbkmplns) {IMAGE_OUT=bkmhead} {IMAGE_ROL=bkmroll} {IMAGE_INP=bkmroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=charini}
SCAN(sbkmblnini) {IMAGE_OUT=bkmhead} {IMAGE_ROL=bkmroll} {IMAGE_INP=bkmroll} {SELECT_BAR} {ROLL_LINES=8} {SCAN_SELECT=cblnini}

