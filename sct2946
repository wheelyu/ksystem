CALCS()
cekAdaForm  djoinspk == 1

/*---------------------------------------------------------------*/
SPCALCS(spmaster)             
      DO_LIB_IF cekAdaForm    ap_dbclc(DNAME dmapmap,DCOMMAND MAPMAP,DMAP mdump);
	   DO_LIB	                ap_jsnmt(lrequestreply,lmsttitle,lmstlabel,lmstfields);

POSTING(master)
