                </structure>
                <structure>
                    <property name="position">58</property>
                    <property name="name">rupiah_pps</property>
                    <property name="nativeName">ppstotal</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select  rpt.rptstr1 as cabang,
        rpt.rptkode2 as nip_sdm,
        psi.psinama as nama_sdm,
        rpt.rptstr2 as dvs_sdm,
        rpt.rpttype2 as grup_sdm,
        rpt.rptkode1 as grup_komisi,
        rpt.rptkode3 as ket_komisi,
        rpt.rpttype1 as thbl_komisi,
        rpt.rpttgl as tgl,

/* KOLEKTOR */
    rpt.rptbl1 as unit_awalz1,
    rpt.rptbl2 as sispok_awalz1,
    rpt.rptjml10 as sispok_awalz1r,
    rpt.rptbl3 as unit_awalz2,
    rpt.rptbl4 as sispok_awalz2,

    rpt.rptbl5 as unit_capaiz1,
    rpt.rptbl6 as sispok_capaiz1,
    rpt.rptjml11 as sispok_capaiz1r,
    rpt.rptbl7 as unit_capaiz2,
    rpt.rptbl8 as sispok_capaiz2,

    rpt.rpttbh1 as kwitansi_awalz1_kol,
    rpt.rpttbh2 as kwitansi_capaiz1_kol,
    rpt.rpttbh4 as kwitansi_awalz2_kol,
    rpt.rpttbh5 as kwitansi_capaiz2_kol,

    rpt.rptbl9 as tgt_sispokz1,
    rpt.rptbl10 as tgt_sispokz1r,
    rpt.rptjml3 as tgt_sispokz2,
    rpt.rpttbh3 as tgt_kwitansiz1,
    rpt.rpttbh6 as tgt_kwitansiz2,

    rpt.rptjml12 as jml_kolektor,
    rpt.rptbl11 as jml_kolcpaitgtalir2,

/* CABANG */
    rpt.rptjml4 as kwitansi_awalz1_cab,
    rpt.rptjml5 as kwitansi_capaiz1_cab,
    rpt.rpttbh9 as tgt_kwiz1_cab,
    rpt.rptjml7 as kwitansi_awalz2_cab,
    rpt.rptjml8 as kwitansi_capaiz2_cab,
    rpt.rpttbh10 as tgt_kwiz2_cab,

/* POTONGAN */
    potongan.rptbl1 as tgt_wo,
    potongan.rptbl2 as capai_wo,
    potongan.rpttbh2 as perc_potwo,
    potongan.rptbl5 as persen_fid,
    potongan.rpttbh4 as perc_potfid,

    potongan.rpttbh6 as pengali_potkwiz1,
    potongan.rpttbh5 as rp_potkwiz1,
    potongan.rpttbh7 as pengali_potkwiz2,
    potongan.rpttbh8 as rp_potkwiz2,
    potongan.rpttbh10 as pengali_potkwiz1z2,
    potongan.rpttbh9 as rp_potkwiz1z2,
    
    potongan.rptbl6 as faktur_dikunjungi,
    potongan.rptbl7 as dikunjungi_sesuai_longlat,
/* NILAI RUPIAH */
    rpt.rpttbh7 as pengaliz1,
    rpt.rpttbh6 as rp_komisiz1,

    rpt.rpttbh8 as pengaliz2,
    rpt.rpttbh2 as rp_komisiz2,
    rpt.rptjml1 as rp_cbgcapai_tgtkwiz1,
    rpt.rpttbh12 as rp_cbgcapai_tgtkwiz2,
    rpt.rptjml9 as rp_kolcapaitgt,

    pps.ppsket as keteranga_ppskomisi,
    pps.ppstotal as rupiah_pps

from rpt as rpt force index (rptdttypkod)

left join psi as psi
    force index (psikodidx) 
        on psi.psikode = rpt.rptkode2

left join rpt as potongan
    force index (rptdttypkod) 
        on potongan.rptdata = 'KOMSPVZ1Z2'
        and potongan.rptth = rpt.rptth
        and potongan.rpttype1 = rpt.rpttype1
        and potongan.rptkode1 = 'POTONGANZ1Z2'

left join pps as pps
    force index (ppsdatplgsts)
        on pps.ppsdata = 'DTHUT'
        and pps.ppsplg = rpt.rptkode2
        and pps.ppssts = 'INPG'
        and pps.ppscab = rpt.rptstr1

where rpt.rptdata = 'KOMSPVZ1Z2'
    and rpt.rptth = ? 
    and rpt.rpttype1 = ?
    and rpt.rptkode1 = 'KOMISIZ1Z2'

group by rpt.rptkode2]]></xml-property>
