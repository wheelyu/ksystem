ljamskrng	INIT	SYSTIME

lmstlabel       INIT    "status"
lmstfields      INIT    "lstatus"
lmsttitle       INIT    ""

l4996		INIT	4996
lm4996		INIT	m4996

CALCS()
cOK		"OK"

MAP(m4996)
