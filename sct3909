lmsttitle               STRING  31
lmstlabel               STRING  100
lmstfields              STRING  100
lstatus			STRING	5

lNoFaktur              	STRING  21
lADSKLIKNS		STRING	11
lVERSI			STRING	21
ljamskrng		TIME	4
l4996			INT2	2
lm4996			STRING	15

IMAGE(master) 
/--------------------------------------------------------\
| /----------------------------------------------------\ |
| |i.NoBuk   : ____________________                    | |
| \----------------------------------------------------/ |
\--------------------------------------------------------/

FIELDS(master)
   lNoFaktur            NONE           INPUTRI          1 

DEFAULTS(master)
