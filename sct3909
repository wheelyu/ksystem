SCREEN 3909 APP_TYPE api_KliknssSPK
SCR_TGLTRN_PASS_OK

LOCAL
PGM_FIELDS
lkopi			STRING	5
lnamfil               	STRING  31
lrequestreply         	STRING  31
linplabels             	STRING  3000
linpfields             	STRING  3000
linpmap			STRING	21
ldatetype             	INT2    2
