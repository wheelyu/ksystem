                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[Select psi.psikode as nip_karyawan,
psi.psists as sts_karyawan,
psi.psicabskr as cab_karyawan,
psi.psinama as nama_karyawan,
cab.cabnama as namacab_karyawan,
cab.cabtwr as gedung_karyawan,
/*cad.cadkode as cabang_ahass,*/
psm.psmktp as ktp_karyawan,
btm.btmnobuk as nobuk620,
btm.btmsurveyor as kodepromo620

from psi

left join cab as cab force index (cabkodidx) on cab.cabkode = psi.psicabskr

/*left join cad as cad force index (cadcabdtidx) on cad.cadkdcab = psi.psicabskr AND
cad.caddata = "CABBIS" AND cad.cadtype = psi.psicabskr AND cad.cadkode = "H2"*/

left join psm as psm force index (psmkodidx) on psm.psmkode = psi.psikode

left join btm as btm force index (btmplgbukidx) on btm.btmplg = psm.psmktp AND
btm.btmsurveyor = "PROGKARYAWAN" AND btm.btmsts = "CLSD"

where psi.psists = "INPG" /*AND cad.cadkode = "H2"*/
AND (cab.cabtwr = ? OR ? = "")

ORDER BY psi.psicabskr
]]></xml-property>
        </oda-data-set>
    </data-sets>
