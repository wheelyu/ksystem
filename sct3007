AFTER_INPUT	cur_field=lfilnamtxt 	DO_LIB_IF cpil1_plgksg ap_systm(lcp3); 
AFTER_INPUT	cur_field=lfilnamtxt 	DO_LIB_IF cpil1 ap_systm(lcp4); 

/* Pilihan 2*/
AFTER_INPUT	cur_field=lpil		DO_MAP SHOW IF cpil3 mtxt
AFTER_INPUT	cur_field=lpil		DO_LIB_IF cpil3 ap_flexp(lfile_bhs,ldelimiter,ldefdte,lrata,lcalc_bhs,lgab_field,lnoscr,g_strksg,l0);

