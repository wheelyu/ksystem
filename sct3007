FIELD(report)
    lprt            ALLCAPS            INPUTRI          1
    lpil            NOCHANGE           INPUTRI          2
    lfilnamtxt      NOCHANGE           INPUTRI ZERO     3

CALCS()
cpil1		lpil == 1
cpil2		lpil == 2
cpil3		lpil == 3
cid		"id"
cen		"en"
cnamtxt		"bhs.txt" 
cnamtxt2	"bhs" + STRIP(stsplg) + ".txt" 
cnamfile	"bhs" + STRIP(stsplg)
cnamfileksg	"bhs" 
cplg000		 bhsprt == "0000" || bhsprt == BLANKS 
cplg111		 bhsprt == lprt    
cnam_plg000	"cplg000"
cnam_plgisi	"cplg111"
ccp_prt		"cp bhs.txt bhs" + STRIP(stsplg) + ".txt" 
ccp2		"cp" + " " + STRIP(lfile) + "_" + STRIP(lbhs) + ".xml" + " txtumum"
ccp3		"cp" + " " + STRIP(lfile) + "_" + STRIP(lbhs) + ".xml" + " txtumum\/datawl"
cmv4		"cp" + " " + STRIP(lfile) + "_" + STRIP(lbhs) + ".xml" + " prg"
cmv42		"cp" + " " + STRIP(lfile) + "_" + STRIP(lbhs) + ".xml" + " prt" + STRIP(lprt)


DEFAULTS(report)
lpil		DFALT_LIST 	1 2 3
lprt		INIT		{stsplg}
ldelimiter	INIT      	1
ldefdte		DFALT_LIST	1 
lrata		DFALT_LIST	0

MAP(mbhs)
