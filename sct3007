cnamfileksg	lfile     	DO_CALC_IF cplgksg
cnam_plg000	lnamacalc	DO_CALC_IF cplgksg
cnam_plgisi	lnamacalc	DO_CALC_IF cplgisi
cnamtxt		lfilnamtxt	DO_CALC_IF cplgksg
cnamtxt2	lfilnamtxt	DO_CALC_IF cplgisi

cid		lbhs		DO_CALC_IF cpil1
cen		lbhs		DO_CALC_IF cpil2
ccp_prt		lcp		DO_CALC_IF cplgisi
ccp2		lcp2		DO_CALC_IF cplgksg
ccp3		lcp3		DO_CALC_IF cplgksg
cmv4		lcp4		DO_CALC_IF cplgksg
cmv42		lcp4		DO_CALC_IF cplgisi


CALCS()
cbhs       	"bhs"
c0		0
/*
cbhs_ok		bhsprt == lprt     
clbhsOk  	"cbhs_ok"
*/
