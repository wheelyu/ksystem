SPCALCS(spcaladdpica)
DO_LIB ap_dbclc(DNAME dupdbkmaddpica,DCOMMAND UPDATE,DTARGET bkmprmidx bkmprm,DMAP mupdbkmpc);
DO_LIB_IF ctglbeda	ap_nxpst(l4540,lm4540); 

SPCALCS(spcalupdpica)
DO_LIB ap_dbclc(DNAME dupdbkmupdpica,DCOMMAND UPDATE,DTARGET bkmprmidx bkmprm,DMAP mupdbkmpc2);
DO_LIB_IF ctglbeda ap_dbclc(DNAME ddeltldabsen,DCOMMAND DELETE_RANGE,DTARGET tldbukurtidx bkmnobuk);
DO_LIB_IF ctglbeda	ap_nxpst(l4540,lm4540); 

SPCALCS(spcaldelpica)
DO_LIB ap_dbclc(DNAME dupdbkmdelpica,DCOMMAND UPDATE,DTARGET bkmprmidx bkmprm,DMAP mupdbkmpc3);
DO_LIB ap_dbclc(DNAME ddeltldabsen2,DCOMMAND DELETE_RANGE,DTARGET tldbukurtidx bkmnobuk);

POSTING(tmptrans)
        PST_ADDCMD      spcaladdpica
        PST_UPDCMD      spcalupdpica
        PST_DELCMD      spcaldelpica

PERMIT(tmptrans)
