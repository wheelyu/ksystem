SCREEN 4340 APP_TYPE t.PostKrmMtr

LOCAL
PGM_FIELDS
loto		STRING		21
lnobuk		STRING		21
lmnext		STRING		31
lnoscr		INT2		2
l4887                   INT2    2
lm4887                  STRING  15
lm4887clsd                  STRING  15
lbtmrekomen		STRING	21
lbtmsoa    		STRING	21
lppmnoll   		STRING	21
lmtdsts			STRING	11
ldum            STRING  1
lHISKLIKNS		STRING	11
lbtmiklan		STRING	21

IMAGE(master)
/--------------------------------------------------------------------------------\
|No Oto  : _________________    No. Bukti  : _________________                   |
|-----------t--------------t-----------t---------t-------t-------t---------------|
|No.Faktur  |  Kode Barang | Jml Unit  |  Tgl DO |Lokasi |Status |  Sisa Unit    |
\-----------.--------------.-----------.---------.-------.-------.---------------/

FIELD(master)
loto		ALLCAPS			INPUTRI		1
lnobuk		ALLCAPS			INPUTRI		2

DEFAULTS(master)
loto		INIT		{r_string1}
lnobuk		INIT		{r_string2}
lmnext			INIT	mnext
l4887           INIT    4887
lm4887          INIT    m4887
lm4887clsd      INIT    m4887clsd
lHISKLIKNS		INIT	"HISKLIKNS"


MAP(mnext)
