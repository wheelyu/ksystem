            <xml-property name="queryText"><![CDATA[SELECT
ppm.ppmnobuk,
ppm.ppmnoll,
ppm.ppmcabpos,
cab.cabnama,
btm.btmsales,
psi.psinama,
psi.psijabatan,
psi.psitglawl,
ppm.ppmtglfak,
ppm.ppmsts,
ppm.ppmstskrm,
btm.btmsoa,
btm.btmmakelar,
nhm.nhmtenor,
btm.btmtypmtr,
btm.btmtypmtr2,
btm.btmthn,
btm.btmwrn,
nhm.nhmhrgpasar,
nhm.nhmbbnhpp,
nhm.nhmbbnjl,
ppm.ppmtglkrm,
nhm.nhmhrgoff,
nhm.nhminsales,
nhm.nhmbiamklr,
nhm.nhmperpok,
nhm.nhmtotdis,
btm.btmdf1,
brg.brgkat4,
brg.brgkat5,
brc.brchrgbl,
ppd.ppdnorangka,
ppd.ppdnomesin,
bns.ppdhrg,
ppd.ppdhrg,
ppm.ppmtotppn

from ppm

left join cab as cab on cab.cabkode = ppm.ppmcabpos
left join btm as btm on btm.btmnobuk = ppm.ppmnoll
left join psi as psi on psi.psikode = btm.btmsales
left join ppd as ppd force index (ppdbukurtidx) on ppd.ppdnobuk = ppmnobuk and ppd.ppdnourt = 1 and ppd.ppdnopsn = ppmnoll
left join brg as brg on brg.brgkode = btm.btmtypmtr AND brg.brgdata = "DTBARANG"
left join brc as brc force index (brcdtbrgidx) on brc.brcbrg = brg.brgkode AND brc.brcdata = "DTBARANG" AND brc.brckode = btm.btmthn AND brc.brccab = btm.btmcabjl
left join nhm as nhm on nhm.nhmnobuk = btm.btmnobuk AND nhm.nhmdata = "BUKUTAMU"
left join ppd as bns on bns.ppdnobuk = ppmnobuk and bns.ppdkat = "BONUS"

where ppm.ppmdata = "DTPIU" AND ppmscr = "614" AND ppm.ppmfr = "F" AND ppm.ppmtglfak >= ? AND ppm.ppmtglfak <= ? AND 
      (ppmsts = "INPG" OR ppmsts = "CLSD") AND (ppmdvs = "H1" OR ppmdvs = "HMC")
]]></xml-property>
        </oda-data-set>
    </data-sets>
