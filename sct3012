SCREEN 3012 QUERY_TYPE s.DaftarTable
SCR_FILE dtm
SCR_LOGFLD dtmkode  
SCR_TGLTRN_PASS_OK

LOCAL
PGM_FIELDS
l0		INT2		2
ltomdet_d    	STRING		30
ltomdet_2d    	STRING		40

lgab_field    		STRING		100
lenter 			STRING	        4
lesc   			STRING	        4
lfile_dtm		STRING	        4
lfile_tmp		STRING	        4
lfile_tbl		STRING	        4
lfile_tbd		STRING	        4
lfile_tbt		STRING	        4
lfile_rmd		STRING	        4

lcalc_dtm		STRING	        30
lcalc_tmp		STRING	        30
lcalc_tbl		STRING	        30
lcalc_tbd		STRING	        30
lcalc_tbt		STRING	        30
lcalc_rmd		STRING	        30

ldelimiter		INT2   		2
ldefdte   		INT2  		2
lrata                   INT2            2


IMAGE(master) 
/--------------------------------------------------------------------------------------------------\
| /-----------------------------------------------------------------------------------------------\|
| | i.Typ          : __________                                                                   ||
| | i.KodeData     : ____________________                                                         ||
| | i.Keterangan   : ______________________________                                               ||
