            </list-property>
            <xml-property name="queryText"><![CDATA[select 	psi.psikode as sct16482p2s6rptdesign,
		psigm.psikode as GM,
		psigm.psinama as NamaGM,
		sgmbuh.sgmstr5 as BUH,
		psibuh.psinama as NamaBUH,
		sgmhead.sgmstr5 as HEAD,
		psihead.psinama as NamaHEAD,
		sgmbm.sgmstr5 as BM,
		psibm.psinama as NamaBM,
		sgmspv.sgmstr5 as SPV,
		psispv.psinama as NamaSPV,
		psi.psicabskr as Cabang,
		cab.cabnama as NamaCabang,
		psi.psikode as SDM,
		psi.psinama as NamaSDM,
		psi.psists as StatusSDM,
		psi.psitglawl as TanggalMasuk,
		abd.abdtgl as TanggalAbsen,
		abd.abdtype as KetAbsen,
		psi.psidep as Divisi,
		psi.psisdep as Departemen,
		if(abd.abdjam1 != "00:00:00",abd.abdjam1,null) as MASUK,
		if(abd.abdjam2 != "00:00:00",abd.abdjam2,null) as PULANG,
		abd.abdsts as STATUS
		
from psi as psi

left join cab as cab force index(cabkodidx) on
	cab.cabkode = psi.psicabskr

left join abd as abd force index(abdkymtglidx) on
	abd.abdkym = psi.psikode and abd.abdtgl >= ? and abd.abdtgl <= ?

left join sgm as sgmhead force index (sgmdatplgth) on
	sgmhead.sgmdata = 'DTPICCAB' and sgmhead.sgmplg = 'H2'
	and sgmhead.sgmbrg = psi.psicabskr and sgmhead.sgmthbl = ? 
	and sgmhead.sgmtype = 'AHASSHEAD'

left join sgm as sgmbuh force index (sgmdatplgth) on
	sgmbuh.sgmdata = 'DTPICCAB' and sgmbuh.sgmplg = 'H2'
	and sgmbuh.sgmbrg = psi.psicabskr and sgmbuh.sgmthbl = ? 
	and sgmbuh.sgmtype = 'BUH'
	
left join sgm as sgmbm force index (sgmdatplgth) on
	sgmbm.sgmdata = 'DTPICCAB' and sgmbm.sgmplg = 'H2'
	and sgmbm.sgmbrg = psi.psicabskr and sgmbm.sgmthbl = ? 
	and sgmbm.sgmtype = 'BM'
	
left join sgm as sgmspv force index (sgmdatplgth) on
	sgmspv.sgmdata = 'DTPICCAB' and sgmspv.sgmplg = 'H2'
	and sgmspv.sgmbrg = psi.psicabskr and sgmspv.sgmthbl = ? 
	and sgmspv.sgmtype = 'AHASSSPV'

left join psi as psigm force index (psikodidx) on
	psigm.psikode = "1012605"

left join psi as psibuh force index (psikodidx) on
	psibuh.psikode = sgmbuh.sgmstr5

left join psi as psihead force index (psikodidx) on
	psihead.psikode = sgmhead.sgmstr5

left join psi as psibm force index (psikodidx) on
	psibm.psikode = sgmbm.sgmstr5
	
left join psi as psispv force index (psikodidx) on
	psispv.psikode = sgmspv.sgmstr5
	
where psi.psists = "INPG" and psi.psidep = "AHASS"

group by psi.psikode, abd.abdtgl]]></xml-property>
        </oda-data-set>
    </data-sets>
