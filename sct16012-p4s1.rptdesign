                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">Cab_jual</property>
                    <property name="nativeName">Cab_jual</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">Komisi_faktur</property>
                    <property name="nativeName">Komisi_faktur</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">Total_jual</property>
                    <property name="nativeName">Total_jual</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select 
bid.bidnobuk2 as Kode_Mkl,
psm.psmnama	as Nama_Mkl,
bid.bidstr11 as No_Bukti,
ppm.ppmtk as Tunai_kre,
ppm.ppmcabpos as Cab_jual,
bid.bidtotal as Komisi_faktur,
bid.bidjml as Total_jual



from bid force index (bidbukstsidx)

left join psm as psm force index(psmktpidx) on psm.psmktp = bid.bidnobuk2
left join ppm as ppm force index(ppmbukidx) on ppm.ppmnobuk = bid.bidstr11

where bid.bidnobuk = ? and bid.bidsts = ? and bid.bidket = "REWAGEN"]]></xml-property>
        </oda-data-set>
    </data-sets>
