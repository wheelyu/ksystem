                    <property name="position">28</property>
                    <property name="name">KetAcc</property>
                    <property name="nativeName">KetAcc</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">29</property>
                    <property name="name">NamaHrd</property>
                    <property name="nativeName">NamaHrd</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select 
hrm.hrmnobuk as Nobuk ,
hrm.hrmsts as StatusLyr , 
hrm.hrmtgl as TanggalBtk ,
hrm.hrmnip2 as Tipe ,
hrm.hrmnip1 as NipSdm ,
hrm.hrmcab as KodeCab ,
hrm.hrmtgl1 as TglPosting , 
cab.cabnama as Namacab ,
psi.psinama as NamaSdm ,
psi.psists as StatusSdm,
psd.psdstr3 as BankBaru ,
psd.psdstr4 as RekBaru ,
psd.psdket2 as NamaRekBaru ,
psd.psdstr5 as KetGanti ,
psd.psdstr1 as BankLama ,
psd.psdstr2 as RekLama ,
psd.psdket as NamLama ,
psd.psdtgl1 as TglUbahRek ,
psd1.psdtgl1 as TglKonfirmasi ,
psm.psmusrapr as NipUsr ,
psi2.psinama as NamaUsr ,
psi2.psijabatan as JabUsr , 
psd2.psdsts as StsUpl ,
psd2.psdtgl1 as TglUpl ,
psd2.psdstr2 as NipHrd ,
psd2.psdtype2 as AccHrd ,
psd2.psdtgl2 as TglAcc ,
psd2.psdket2 as KetAcc ,
psi3.psinama as NamaHrd 

from hrm force index (hrmbukidx)
	left join psi as psi force index (psikodidx) on psi.psikode = hrm.hrmnip1
	left join psm as psm force index (psmkodidx) on psm.psmkode = hrm.hrmnip1
	left join psi as psi2 force index (psikodidx) on psi2.psikode = psm.psmusrapr
	left join cab as cab force index (cabkodidx) on cab.cabkode = hrm.hrmcab 
	left join psd as psd force index (psddatpsmkod) on psd.psddata = "UBAHREKBR" and psd.psdpsmkode = hrm.hrmnobuk and psd.psdkode = hrm.hrmnip1 and psd.psdtype = "UBAHREKBR"
	left join psd as psd1 force index (psddatpsmkod) on psd1.psddata = "KONFREKSDM" and psd1.psdpsmkode = hrm.hrmnobuk and psd1.psdkode = hrm.hrmnip1 and psd1.psdtype="KONFREKSDM"
	left join psd as psd2 force index (psddatpsmkod) on psd2.psddata = "UPLOADREK" and psd2.psdpsmkode = hrm.hrmnobuk and psd2.psdkode = hrm.hrmnip1 and psd2.psdtype = "UPLOADREK"
	left join psi as psi3 force index (psikodidx) on psi3.psikode = psd2.psdstr2 
where hrm.hrmdata = "REKBRSDM" and (hrm.hrmnip2 = "VERIFIKASI" or hrm.hrmnip2 = "UBAH") and hrm.hrmtgl >= ? and hrm.hrmtgl <= ?
]]></xml-property>
