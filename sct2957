                                LEFT JOIN nhm AS nhm ON nhm.nhmdata = 'BUKUTAMU' AND btm.btmnobuk = nhm.nhmnobuk
                                LEFT JOIN pik AS pik ON pik.pikdata = 'DTPIU' AND pik.pikcabpiu = cad.cadkdcab AND pik.piktglfak >= {ltgl1m1} AND pik.piktglfak <= {ltgl2} AND pik.pikca = 'KR'
