                                LEFT JOIN rtm AS rtm1 ON rtm1.rtmdata = 'FLAGBA12' AND rtm1.rtmtype = {lthbl} AND rtm1.rtmnobuk = pikba1.piknobuk
                                LEFT JOIN pik AS pikba2 ON pikba2.pikdata = 'DTPIU' AND pikba2.pikcabpiu = cad.cadkdcab AND pikba2.piktglfak >= {ltgl26min4} AND pikba2.piktglfak <= {ltgl25min3}         
                                LEFT JOIN rtm AS rtm2 ON rtm2.rtmdata = 'FLAGBA12' AND rtm2.rtmtype = {lthbl} AND rtm2.rtmnobuk = pikba2.piknobuk
                                LEFT JOIN pik AS pikba3 ON pikba3.pikdata = 'DTPIU' AND pikba3.pikcabpiu = cad.cadkdcab AND pikba3.piktglfak >= {ltgl26min5} AND pikba3.piktglfak <= {ltgl25min4}
