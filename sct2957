		(tbewarna.tbekettype = 'H1' or tbewarna.tbekettype = 'HMC')
left join log as log on log.lognobuk = tkm.tkmnobuk and
												  log.logtype = 'U' 


left join tbt as tbt1 on tbt1.tbtdata = 'DTKOTA' and
