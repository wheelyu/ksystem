                                COUNT(DISTINCT(CASE WHEN pik.piktglfak >= {ltgl1} AND pik.piktglfak <= {ltgl2} AND psi.psijabatan IN ('SALESNMC', 'SALESMANHMC', 'MKTLAPANGANHMC') THEN pik.piknobuk ELSE NULL END)) AS ActJlLapAll,
