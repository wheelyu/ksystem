LEFT JOIN akt AS aktspk force index(aktkod2typid) ON aktspk.aktkode2 = tkm.tkmnobuk AND aktspk.aktdata = "SPK" AND aktspk.akttype = tkm.tkmplg
LEFT JOIN svi AS sviminat force index(svidatbuktyp) ON sviminat.svidata = "MINAT" AND sviminat.svinobuk = tkm.tkmnobuk AND sviminat.svitype = "MINAT"
LEFT JOIN spk AS spk force index(spkdatbuktyp) ON spk.spkdata = "SPKLCK" AND spk.spknobuk = tkm.tkmnobuk AND spk.spktype = "HASILSPK"
LEFT JOIN spk AS spkreff force index(spkdatbuktyp) ON spkreff.spkdata = "DTREFF" AND spkreff.spknobuk = tkm.tkmnobuk AND spkreff.spktype = "DTREFF"
LEFT JOIN spk AS spkrev force index(spkdatbuktyp) ON spkrev.spkdata = "REVSPKLCK" AND spkrev.spknobuk = tkm.tkmnobuk AND spkrev.spktype = "HASILSPK"
LEFT JOIN akt AS aktevent force index(aktbrgtglidx) ON aktevent.aktbrg = spk.spknobuk AND aktevent.aktdata = "SPKEVENT" AND aktevent.akttype = "SPKEVENT"
LEFT JOIN svi AS svipic force index(svidatbuktyp) ON svipic.svidata = "REVIEWSPK" AND svipic.svinobuk = tkm.tkmnobuk AND svipic.svitype = "REVPICSLS"
LEFT JOIN svi AS svikwl force index(svidatbuktyp) ON svikwl.svidata = "REVIEWSPK" AND svikwl.svinobuk = tkm.tkmnobuk AND svikwl.svitype = "REVKAWILSL"
LEFT JOIN svi AS svidvh force index(svidatbuktyp) ON svidvh.svidata = "REVIEWSPK" AND svidvh.svinobuk = tkm.tkmnobuk AND svidvh.svitype = "REVDVHSLS"
LEFT JOIN svi AS svifoto force index(svidatbuktyp) ON svifoto.svidata = "DTSPK" AND svifoto.svinobuk = tkm.tkmnobuk AND svifoto.svitype ="FOTOSPK" AND svifoto.svikode = "FOTORMHSPK"
LEFT JOIN svi AS svihslfu force index(svidatbuktyp) ON svihslfu.svidata = "SPK" AND svihslfu.svinobuk = tkm.tkmnobuk
LEFT JOIN svi AS svidtreff force index(svidatbuktyp) ON svidtreff.svidata = "DTREFF" AND svidtreff.svinobuk = tkm.tkmnobuk AND svidtreff.svitype = "DTREFF"
LEFT JOIN abd AS abd force index(abdkymtglidx) ON abd.abdkym = tkm.tkmplg AND abd.abdtgl = {ltgl2}
LEFT JOIN sgm AS sgmkwl force index (sgmdatplgth) ON sgmkwl.sgmdata = "DTPICCAB" AND sgmkwl.sgmplg = psi.psidvs AND sgmkwl.sgmbrg = psi.psicabskr AND sgmkwl.sgmthbl = date_format(curdate(),"%y%m") AND sgmkwl.sgmtype = "KAWIL"
LEFT JOIN psi AS psikwl force index (psikodidx) ON psikwl.psikode = sgmkwl.sgmstr5
LEFT JOIN psi as psirev  on psirev.psikode = spkrev.spkkode9
LEFT JOIN pik AS pik force index(pikdatbukidx) ON pik.pikdata = "DTPIU" AND pik.piknobuk = tkm.tkmbuk1
LEFT JOIN alm AS almtagih force index(almdatotobuk) ON almtagih.almdata="ALMTAGIH" AND almtagih.almbukoto=pik.pikplg
LEFT JOIN alm AS alm force index(almdatotobuk) ON alm.almdata = "ALMTAGIH" AND alm.almbukoto = pik.pikplg
LEFT JOIN alm AS almkirim force index(almdatotobuk) ON almkirim.almdata="ALAMATKIRI" AND almkirim.almbukoto=pik.pikplg
LEFT JOIN alm AS almktp force index(almdatotobuk) ON almktp.almdata="PSMKTP" AND almktp.almbukoto=pik.pikplg
LEFT JOIN svi AS svifu force index(svidatbuktyp) ON svifu.svidata = "SPK" AND svifu.svinobuk = tkm.tkmnobuk AND svifu.svitype = "FOLLOWUP" 
LEFT JOIN akt AS aktpk force index(aktkod2typid) ON aktpk.aktkode2 = tkm.tkmnobuk AND aktpk.aktdata = "SPK" AND aktpk.akttype = tkm.tkmplg
LEFT JOIN tlm AS tlm force index(tlmbukidx) ON tlm.tlmnobuk = aktpk.aktlok 
LEFT JOIN btm AS btm force index(btmbukidx) ON btm.btmnobuk = tlm.tlmnoasal
LEFT JOIN log AS log force index(logbuktypusr) ON log.lognobuk = tkm.tkmnobuk AND log.logtype = "U" 
LEFT JOIN tbt AS tbt1 force index(tbtdatkodtyp) ON tbt1.tbtdata = "DTKOTA" AND tbt1.tbtdtmkode = spk.spkkode5 AND tbt1.tbttblkode = spk.spkkode2 AND tbt1.tbttbdkode = spk.spkkode3 AND tbt1.tbttype = 'DTKOTA' AND tbt1.tbtkode = spk.spkkode4
LEFT JOIN tbe AS tbek force index(tbedattypkod) ON tbek.tbedata = "AREASALES" AND tbek.tbetype = tbt1.tbtkode2 AND tbek.tbetblkode = "AREAHMC" AND tbek.tbetbdkode = tkm.tkmplg AND tbek.tbetbtkode = "GARAP" AND tbek.tbetglcrt = tkm.tkmtgl
LEFT JOIN tbt AS tbt2 force index(tbtkodeidx) ON tbt2.tbtkode = tbek.tbetype AND tbt2.tbtdata = "AREAHMC"
LEFT JOIN psm AS psm on psm.psmktp = pik.pikplg
WHERE tkm.tkmnobuk = {tkmnobuk} AND psi.psists = "INPG" AND
   (psi.psijabatan = "SALESREFIMOTOR" OR psi.psijabatan = "SALESDTN" OR
   psi.psijabatan = "CTRSALESREFIMOTOR" OR psi.psijabatan = "SALESMANHMC" OR psi.psijabatan = "SALESNMC" OR
   psi.psijabatan = "COUNTERSALESNMC" OR psi.psijabatan = "KBANMCOFFICER" OR psi.psijabatan = "T.LEADERKBA" OR
   psi.psijabatan = "KOORDAGEN" OR psi.psijabatan = "KOORDAGENHMC" OR psi.psijabatan = "MKTLAPANGANM2W" OR 
   psi.psijabatan = "MKTKBAM2W" OR psi.psijabatan = "MKTCOUNTERM2W" OR psi.psijabatan = "MKTLAPANGANHMC" OR
   psi.psijabatan = "MKTCOUNTERHMC" OR psi.psijabatan = "MKTKBAHMC" OR psi.psijabatan = "KBAM2WOFFICER") 
GROUP BY tkm.tkmnobuk; "

