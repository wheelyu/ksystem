                                SUM(DISTINCT CASE WHEN cad.cadtot4-cad.cadtot5 AND psi.psijabatan IN ('SALESNMC', 'SALESMANHMC', 'MKTLAPANGANHMC') THEN cad.cadtot4-cad.cadtot5 END) AS TgtPKLapTunai,
