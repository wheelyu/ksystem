                </structure>
                <structure>
                    <property name="name">JualAll</property>
                    <expression name="expression" type="javascript">if (dataSetRow["ppmnobuk"] != "  ")
{
1;}
else 0</expression>
                    <property name="dataType">float</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">jlAll</property>
                    <property name="dataType">float</property>
                    <simple-property-list name="aggregateOn">
                        <value>GrupCab</value>
                    </simple-property-list>
                    <property name="aggregateFunction">SUM</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
                            <expression name="value" type="javascript">row["JualAll"]</expression>
                        </structure>
                    </list-property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">NoUrut</property>
                    <expression name="expression" type="javascript">NoUrut;</expression>
                    <property name="dataType">integer</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">%CapaiAll</property>
                    <expression name="expression" type="javascript">if (dataSetRow["cadtot1"] != 0)
{
((row["jlAll"]/dataSetRow["cadtot1"])*100)};</expression>
                    <property name="dataType">float</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">NasTgtAlll</property>
                    <property name="dataType">float</property>
