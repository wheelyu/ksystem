            <xml-property name="queryText"><![CDATA[SELECT
ppm.ppmcabpos,
cab.cabnama,
tgt.cadtot1,
tgt.cadtot2,
tgt.cadtot3,
ppm.ppmnobuk,
ppm.ppmsts,
ppm.ppmstskrm,
ppm.ppmtglkrm,
ppm.ppmtk,
btm.btmnobuk,
btm.btmsts,
ppm.ppmtglfak,
btm.btmdvsjl,
btm.btmtypjl,
btm.btmsales,
psi.psijabatan

from ppm

left join btm as btm on btm.btmnobuk = ppm.ppmnoll
left join cab as cab on cab.cabkode = ppm.ppmcabpos
left join psi as psi on psi.psikode = btm.btmsales
left join cad as tgt force index (cadcabdtidx) on tgt.cadkdcab = ppm.ppmcabpos and 
 tgt.caddata = "TGTMKTHMC" and tgt.cadtype = "TGTMKTHMC" and tgt.cadkode = "2005" /*ppm.ppmthbl*/


where ppm.ppmtglkrm >= ? AND ppm.ppmtglkrm <= ? AND
      ppm.ppmdata = "DTPIU" AND ppmscr = "614" AND ppm.ppmfr = "F" AND
      (ppmsts = "INPG" OR ppmsts = "CLSD") AND (ppmdvs = "H1" OR ppmdvs = "HMC")
]]></xml-property>
        </oda-data-set>
    </data-sets>
