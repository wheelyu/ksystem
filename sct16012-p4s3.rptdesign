            <xml-property name="queryText"><![CDATA[select 

bid.bidnobuk2 as Kode_Pic,
psi.psinama	as Nama_Pic,
bid.bidstr11 as No_Bukti,
psi.psicabskr as Kode_cab,
cab.cabnama as Nama_cab,
bid.bidjml as Total_poin,
bid.bidtotal as Rupiah_komisi,
psi.psijabatan as Jabatan,
psi.psists as status,
psi.psitglawl as Tgl_masuk,
bid.bidjml as Jual_all,
ppm.ppmtk as Type_jual,
bid.bidstr11 as Nomor_faktur


from bid force index (bidbukstsidx)

left join psi as psi force index(psikodidx) on psi.psikode = bid.bidnobuk2
left join cab as cab force index(cabstskodidx) on cab.cabsts = "INPG" and cab.cabkode = psi.psicabskr
left join ppm as ppm force index(ppmbukidx) on ppm.ppmnobuk = bid.bidstr11

where bid.bidnobuk = ? and bid.bidsts = ? and bid.bidket = "KOMPICHMC"]]></xml-property>
