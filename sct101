SCREEN 101 QUERY_TYPE s.JurnalMemorial
SCR_TGLTRN_PASS_OK 
SCR_FILE bkm
SCR_JRNFLD bkmnobuk bkmtgl
SCR_LOGFLD bkmnobuk 
SCR_NXT_POSTING 4203
SCR_NXT_MAP mnext
SCR_NXT_COND cnxtOK
SCR_GRPMENU s.MenuAcc

MAP(mnext)
bkmnobuk    	r_string1     REPLACE
bkmtgl    	r_date1       REPLACE

LOCAL
PGM_FIELDS
lthbl           STRING          5
lno    		INT2   		2
lurt    	INT2   		2
lbkmnobuk   	STRING		{g_len_xl}
lbkmtgl  	DATE		4
ltomdet_d    	STRING		30
lkodebukti		STRING		{g_len_xl}

CALCS()
cDPTT	bkdtype == "D" && bkdnobbm == "133.00.2001"
cKPTT	bkdtype == "K" && bkdnobbm == "133.00.2001"
cDnoPTT	bkdtype == "D" && bkdnobbm != "133.00.2001"
cKnoPTT	bkdtype == "K" && bkdnobbm != "133.00.2001"

DBCALCS(djoinbkdDPTT)
	DBC_COMMAND	JOIN
	DBC_TARGET	bkdbukurtidx	bkmnobuk
	DBC_SELECT	cDPTT

DBCALCS(djoinbkdKPTT)
	DBC_COMMAND	JOIN
	DBC_TARGET	bkdbukurtidx	bkmnobuk
	DBC_SELECT	cKPTT

DBCALCS(dscanbkdD)
	DBC_COMMAND	SCANSCAN
	DBC_TARGET	bkdbukurtidx	bkmnobuk
	DBC_SELECT	cDnoPTT
	DBC_SUM_FIELD	bkdjml

DBCALCS(dscanbkdK)
	DBC_COMMAND	SCANSCAN
	DBC_TARGET	bkdbukurtidx	bkmnobuk
	DBC_SELECT	cKnoPTT
	DBC_SUM_FIELD	bkdjml

CALCS()
cnxtOK 		bkmsts =="OPEN" && 
		(
		(djoinbkdDPTT == 0 && djoinbkdKPTT == 0 && bkmjmld == bkmjmlk) ||
		(djoinbkdDPTT == 1 && djoinbkdKPTT == 0 && dscanbkdD == bkmjmlk) ||
		(djoinbkdDPTT == 0 && djoinbkdKPTT == 1 && bkmjmld == dscanbkdK) ||
		(djoinbkdDPTT == 1 && djoinbkdKPTT == 1 && dscanbkdD == dscanbkdK)
		)

/* ------------------ djoinbkdu --------------*/
MAP(mjoinbkdu)
bkdurt    lurt    REPLACE

DBCALCS(djoinbkdu)
	DBC_COMMAND	JOIN_LAST_SFL
	DBC_TARGET      bkdbukurtidx   bkmnobuk	
        DBC_MAP         mjoinbkdu

CALCS(master)
cgsglbisdvs1	g_sglbisdvs == 1 && g_sglcab == 1
cgsglcabbisdvs1	g_sglcabbisdvs == 1 
cgsglcab1	g_sglcab == 1 


IMAGE(master) 
