							WHERE rptPsd.rptdata = 'DBKNSC'
  							AND rptPsd.rpttype1 = 'PSDCHMC'
  							AND rptSpv.rpttype1 = 'SPKKNSCHMC' "
                                          
IF	cactjmlagen	lperintahsql	INIT		"SELECT
							(SUM(CASE WHEN rptSpk.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '01') THEN rptSpk.rptjml5 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptAct.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '01') THEN rptAct.rptjml11 ELSE 0 END), 0)) AS actjmlagen_jan,
