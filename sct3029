							( SUM(CASE WHEN rptPsd.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '01') THEN rptPsd.rpttbh3 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpv.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '01') THEN rptSpv.rptjml5 ELSE 0 END), 0) ) * 100 AS agnaktstd_jan,
