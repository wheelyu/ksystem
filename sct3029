							( SUM(CASE WHEN rptPsd.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '04') THEN rptPsd.rpttbh3 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpv.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '04') THEN rptSpv.rptjml5 ELSE 0 END), 0) ) * 100 AS agnaktstd_apr,
							( SUM(CASE WHEN rptPsd.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '05') THEN rptPsd.rpttbh3 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpv.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '05') THEN rptSpv.rptjml5 ELSE 0 END), 0) ) * 100 AS agnaktstd_mei,
							( SUM(CASE WHEN rptPsd.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '06') THEN rptPsd.rpttbh3 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpv.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '06') THEN rptSpv.rptjml5 ELSE 0 END), 0) ) * 100 AS agnaktstd_jun,
							( SUM(CASE WHEN rptPsd.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '07') THEN rptPsd.rpttbh3 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpv.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '07') THEN rptSpv.rptjml5 ELSE 0 END), 0) ) * 100 AS agnaktstd_jul,
							( SUM(CASE WHEN rptPsd.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '08') THEN rptPsd.rpttbh3 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpv.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '08') THEN rptSpv.rptjml5 ELSE 0 END), 0) ) * 100 AS agnaktstd_agu,
							( SUM(CASE WHEN rptPsd.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '09') THEN rptPsd.rpttbh3 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpv.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '09') THEN rptSpv.rptjml5 ELSE 0 END), 0) ) * 100 AS agnaktstd_sep,
							( SUM(CASE WHEN rptPsd.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '10') THEN rptPsd.rpttbh3 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpv.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '10') THEN rptSpv.rptjml5 ELSE 0 END), 0) ) * 100 AS agnaktstd_okt,
							( SUM(CASE WHEN rptPsd.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '11') THEN rptPsd.rpttbh3 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpv.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '11') THEN rptSpv.rptjml5 ELSE 0 END), 0) ) * 100 AS agnaktstd_nov,
							( SUM(CASE WHEN rptPsd.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '12') THEN rptPsd.rpttbh3 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpv.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '12') THEN rptSpv.rptjml5 ELSE 0 END), 0) ) * 100 AS agnaktstd_des
							FROM rpt AS rptPsd
