						 	sum(cad.cadtot1) as tgtjual
						 	from cad
						 	where cad.caddata = 'TGTMKTHMC' and cad.cadtype = 'TGTMKTHMC' and cad.cadkode = {lthbl} "						
							
IF	cprodagnstd	lperintahsql	INIT		"SELECT
							(SUM(CASE WHEN rptAct.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '01') THEN rptAct.rpttbh4 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpk.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '01') THEN rptSpk.rptjml5 ELSE 0 END), 0)) * 100 AS prodagnstd_jan,
							(SUM(CASE WHEN rptAct.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '02') THEN rptAct.rpttbh4 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpk.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '02') THEN rptSpk.rptjml5 ELSE 0 END), 0)) * 100 AS prodagnstd_feb,
							(SUM(CASE WHEN rptAct.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '03') THEN rptAct.rpttbh4 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpk.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '03') THEN rptSpk.rptjml5 ELSE 0 END), 0)) * 100 AS prodagnstd_mar,
							(SUM(CASE WHEN rptAct.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '04') THEN rptAct.rpttbh4 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpk.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '04') THEN rptSpk.rptjml5 ELSE 0 END), 0)) * 100 AS prodagnstd_apr,
							(SUM(CASE WHEN rptAct.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '05') THEN rptAct.rpttbh4 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpk.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '05') THEN rptSpk.rptjml5 ELSE 0 END), 0)) * 100 AS prodagnstd_mei,
							(SUM(CASE WHEN rptAct.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '06') THEN rptAct.rpttbh4 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpk.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '06') THEN rptSpk.rptjml5 ELSE 0 END), 0)) * 100 AS prodagnstd_jun,
							(SUM(CASE WHEN rptAct.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '07') THEN rptAct.rpttbh4 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpk.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '07') THEN rptSpk.rptjml5 ELSE 0 END), 0)) * 100 AS prodagnstd_jul,
							(SUM(CASE WHEN rptAct.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '08') THEN rptAct.rpttbh4 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpk.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '08') THEN rptSpk.rptjml5 ELSE 0 END), 0)) * 100 AS prodagnstd_agu,
							(SUM(CASE WHEN rptAct.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '09') THEN rptAct.rpttbh4 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpk.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '09') THEN rptSpk.rptjml5 ELSE 0 END), 0)) * 100 AS prodagnstd_sep,
							(SUM(CASE WHEN rptAct.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '10') THEN rptAct.rpttbh4 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpk.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '10') THEN rptSpk.rptjml5 ELSE 0 END), 0)) * 100 AS prodagnstd_okt,
							(SUM(CASE WHEN rptAct.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '11') THEN rptAct.rpttbh4 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpk.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '11') THEN rptSpk.rptjml5 ELSE 0 END), 0)) * 100 AS prodagnstd_nov,
							(SUM(CASE WHEN rptAct.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '12') THEN rptAct.rpttbh4 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptSpk.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '12') THEN rptSpk.rptjml5 ELSE 0 END), 0)) * 100 AS prodagnstd_des
							FROM rpt AS rptAct
							JOIN rpt AS rptSpk
    							ON rptAct.rptdata = rptSpk.rptdata 
   							AND rptAct.rptth = rptSpk.rptth
							WHERE rptAct.rptdata = 'DBKNSC'
  							AND rptAct.rpttype1 = 'ACTKNSCHMC'
  							AND rptSpk.rpttype1 = 'SPKKNSCHMC' "
  
