							(SUM(CASE WHEN rptSpk.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '03') THEN rptSpk.rptjml5 ELSE 0 END) / NULLIF(SUM(CASE WHEN rptAct.rptth = CONCAT(DATE_FORMAT(NOW(), '%y'), '03') THEN rptAct.rptjml11 ELSE 0 END), 0)) AS actjmlagen_mar,
